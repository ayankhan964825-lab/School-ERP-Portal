0 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_shipping_policy_2 || '<ul><li><strong>Free Shipping:</strong> On all orders above \u20B9499.</li><li><strong>Standard Shipping:</strong> A flat fee of \u20B999 for orders below \u20B9499.</li><li><strong>Express Shipping:</strong> Available at an additional cost during checkout.</li></ul>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_shipping_policy_3" class="block text-sm font-semibold text-secondary mb-1">Delivery Times</label>               <textarea id="page_shipping_policy_3" name="page_shipping_policy_3" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_shipping_policy_3 || '<ul><li><strong>Order Processing:</strong> All orders are processed within 1-2 business days.</li><li><strong>Standard Delivery:</strong> 3-7 business days from dispatch.</li><li><strong>Express Delivery:</strong> 1-3 business days from dispatch.</li></ul><p>Please note that delivery times may vary during peak seasons, holidays, or due to unforeseen circumstances.</p>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_shipping_policy_4" class="block text-sm font-semibold text-secondary mb-1">Order Tracking</label>               <textarea id="page_shipping_policy_4" name="page_shipping_policy_4" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_shipping_policy_4 || '<p>Once your order has been shipped, you will receive a tracking number via email and SMS. You can track your order status through our <a href="/track-order">Track Order</a> page or directly on the courier partner\'s website.</p>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_shipping_policy_5" class="block text-sm font-semibold text-secondary mb-1">Contact Us</label>               <textarea id="page_shipping_policy_5" name="page_shipping_policy_5" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_shipping_policy_5 || '<p>If you have any questions about shipping, please contact us at <a href="mailto:contact@yourstore.com">contact@yourstore.com</a> or call us at +91 9876543210.</p>'}</textarea>             </div>             <hr class="border-gray-100" />            </div>           <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">             <button type="submit" class="btn-primary flex items-center gap-2 px-6 py-2 text-sm" onclick="return confirm('Are you sure you want to save the Shipping Policy page?')">               <span class="save-btn-text">Save Shipping Policy</span>               <svg class="save-btn-spinner hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>             </button>           </div>         </form>       </details>        <!-- Sustainability Content -->       <details data-page="Sustainability" class="group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-4">         <summary class="px-6 py-4 cursor-pointer font-bold text-secondary bg-gray-50 flex justify-between items-center marker:hidden">           <div class="flex items-center gap-2">             <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>             Sustainability Page           </div>           <span class="text-primary group-open:rotate-180 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></span>         </summary>         <form class="settings-section-form border-t border-gray-100" data-page="Sustainability">           <div class="p-6 space-y-6">             <p class="text-xs text-secondary/60 mb-4">The headings on the Sustainability page will dynamically prefix the Brand Name. Fill in the content for each section below.</p>              <div>               <label for="page_sustainability_0" class="block text-sm font-semibold text-secondary mb-1">Introduction</label>               <textarea id="page_sustainability_0" name="page_sustainability_0" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_sustainability_0 || '<p>At The Store Name Name, sustainability isn\'t just a buzzwordit\'s at the core of everything we do. From farm to package, we\'re committed to practices that protect our planet for future generations.</p>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_sustainability_1" class="block text-sm font-semibold text-secondary mb-1">Preserving Nature's Goodness</label>               <textarea id="page_sustainability_1" name="page_sustainability_1" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_sustainability_1 || '<p>Our mission is to provide nutritious dried fruits and vegetables while minimizing our environmental footprint.</p>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_sustainability_2" class="block text-sm font-semibold text-secondary mb-1">Sustainable Farming</label>               <textarea id="page_sustainability_2" name="page_sustainability_2" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_sustainability_2 || '<p>We partner exclusively with farmers who practice sustainable agriculture. This includes:</p>\n  <ul>\n    <li>Organic farming methods that avoid harmful pesticides and chemicals</li>\n    <li>Water conservation techniques to minimize usage</li>\n    <li>Crop rotation to maintain soil health and biodiversity</li>\n    <li>Fair compensation for farmers and agricultural workers</li>\n    <li>Local sourcing whenever possible to reduce transportation emissions</li>\n  </ul>\n  <p>By supporting sustainable farming practices, we ensure that the land remains fertile and productive for generations to come while producing the highest quality fruits and vegetables.</p>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_sustainability_3" class="block text-sm font-semibold text-secondary mb-1">Eco-Friendly Production</label>               <textarea id="page_sustainability_3" name="page_sustainability_3" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_sustainability_3 || '<p>Our dehydration process is designed to minimize environmental impact while preserving maximum nutrition:</p>\n  <ul>\n    <li>Energy-efficient dehydration technology that reduces power consumption</li>\n    <li>Solar power integration at our production facilities</li>\n    <li>Zero-waste approach where fruit and vegetable trimmings are composted</li>\n    <li>Water recycling systems to minimize freshwater usage</li>\n    <li>Regular energy audits to identify further efficiency improvements</li>\n  </ul>\n  <p>We continuously invest in new technologies that allow us to reduce our carbon footprint while maintaining the exceptional quality of our products.</p>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_sustainability_4" class="block text-sm font-semibold text-secondary mb-1">Sustainable Packaging</label>               <textarea id="page_sustainability_4" name="page_sustainability_4" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_sustainability_4 || '<p>We\'re committed to reducing packaging waste through innovative solutions:</p>\n  <ul>\n    <li>Biodegradable and compostable packaging materials</li>\n    <li>Recyclable shipping materials made from post-consumer recycled content</li>\n    <li>Minimalist packaging design that reduces material usage</li>\n    <li>Bulk options that further decrease packaging-to-product ratio</li>\n    <li>Clear recycling instructions on all packaging</li>\n  </ul>\n  <p>Our goal is to transition to 100% sustainable packaging across our entire product line by 2025, without compromising on food safety or product freshness.</p>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_sustainability_5" class="block text-sm font-semibold text-secondary mb-1">Join Us in Our Sustainability Journey</label>               <textarea id="page_sustainability_5" name="page_sustainability_5" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_sustainability_5 || '<p>Every purchase you make supports our sustainable practices and helps us continue to innovate for a greener future.</p>'}</textarea>             </div>             <hr class="border-gray-100" />            </div>           <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">             <button type="submit" class="btn-primary flex items-center gap-2 px-6 py-2 text-sm" onclick="return confirm('Are you sure you want to save the Sustainability page?')">               <span class="save-btn-text">Save Sustainability</span>               <svg class="save-btn-spinner hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>             </button>           </div>         </form>       </details>                <!-- Warranty Content -->       <details data-page="Warranty" class="group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-4">         <summary class="px-6 py-4 cursor-pointer font-bold text-secondary bg-gray-50 flex justify-between items-center marker:hidden">           <div class="flex items-center gap-2">             <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>             Warranty Page           </div>           <span class="text-primary group-open:rotate-180 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></span>         </summary>         <form class="settings-section-form border-t border-gray-100" data-page="Warranty">           <div class="p-6 space-y-6">             <p class="text-xs text-secondary/60 mb-4">The headings on the Warranty page will dynamically prefix the Brand Name. Fill in the content for each section below.</p>              <div>               <label for="page_warranty_0" class="block text-sm font-semibold text-secondary mb-1">Introduction</label>               <textarea id="page_warranty_0" name="page_warranty_0" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_warranty_0 || '<p>At Store Name, we stand behind the quality of our products. Our warranty and returns policies are designed to ensure your complete satisfaction with your purchase.</p>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_warranty_1" class="block text-sm font-semibold text-secondary mb-1">Product Quality Guarantee</label>               <textarea id="page_warranty_1" name="page_warranty_1" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_warranty_1 || '<p>All Store Name products are backed by our quality guarantee. We guarantee that our products will arrive in good condition and match the description provided on our website. If your product doesn\'t meet these standards, we will replace it or offer a refund according to our return policy.</p>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_warranty_2" class="block text-sm font-semibold text-secondary mb-1">Return Policy</label>               <textarea id="page_warranty_2" name="page_warranty_2" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_warranty_2 || '<ul>\n    <li>Returns are accepted within 7 days of delivery.</li>\n    <li>Products must be unused, in their original packaging, and in the same condition you received them.</li>\n    <li>To initiate a return, please contact our customer service team with your order number and reason for return.</li>\n    <li>Once your return is approved, we will provide instructions for shipping the item back.</li>\n    <li>Return shipping costs are the responsibility of the customer unless the return is due to our error (damaged or incorrect item).</li>\n  </ul>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_warranty_3" class="block text-sm font-semibold text-secondary mb-1">Refund Process</label>               <textarea id="page_warranty_3" name="page_warranty_3" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_warranty_3 || '<p>After receiving and inspecting your return, we will process your refund. The time it takes for the refund to appear in your account depends on your payment method:</p>\n  <ul>\n    <li>Credit/debit card refunds typically take 5-7 business days to process.</li>\n    <li>Bank transfers may take 7-10 business days.</li>\n    <li>Store credit is applied immediately upon processing the return.</li>\n  </ul>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_warranty_4" class="block text-sm font-semibold text-secondary mb-1">Damaged or Defective Products</label>               <textarea id="page_warranty_4" name="page_warranty_4" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_warranty_4 || '<p>If you receive a damaged or defective product:</p>\n  <ul>\n    <li>Contact us within 48 hours of receiving your order.</li>\n    <li>Provide photos of the damaged product and packaging.</li>\n    <li>We will arrange for a replacement or refund at no additional cost to you.</li>\n  </ul>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_warranty_5" class="block text-sm font-semibold text-secondary mb-1">Exchanges</label>               <textarea id="page_warranty_5" name="page_warranty_5" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_warranty_5 || '<p>We are happy to exchange products within 7 days of purchase. To request an exchange, please contact our customer service team with your order number and the item you wish to exchange.</p>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_warranty_6" class="block text-sm font-semibold text-secondary mb-1">Contact Us</label>               <textarea id="page_warranty_6" name="page_warranty_6" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_warranty_6 || '<p>If you have any questions about our warranty or return policy, please contact our customer service team at <a href=&quot;mailto:contact@yourstore.com&quot;>contact@yourstore.com</a> or call us at +91 9876543210 / +91 9876543211.</p>'}</textarea>             </div>             <hr class="border-gray-100" />            </div>           <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">             <button type="submit" class="btn-primary flex items-center gap-2 px-6 py-2 text-sm" onclick="return confirm('Are you sure you want to save the Warranty page?')">               <span class="save-btn-text">Save Warranty</span>               <svg class="save-btn-spinner hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>             </button>           </div>         </form>       </details>               <!-- Delivery Content -->       <details data-page="Delivery" class="group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-4">         <summary class="px-6 py-4 cursor-pointer font-bold text-secondary bg-gray-50 flex justify-between items-center marker:hidden">           <div class="flex items-center gap-2">             <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>             Delivery Page           </div>           <span class="text-primary group-open:rotate-180 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></span>         </summary>         <form class="settings-section-form border-t border-gray-100" data-page="Delivery">           <div class="p-6 space-y-6">             <p class="text-xs text-secondary/60 mb-4">The headings on the Delivery page will dynamically prefix the Brand Name. Fill in the content for each section below.</p>              <div>               <label for="page_delivery_0" class="block text-sm font-semibold text-secondary mb-1">Introduction</label>               <textarea id="page_delivery_0" name="page_delivery_0" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_delivery_0 || '<ul>\n    <li><strong>Standard Delivery Time:</strong> Orders are typically delivered within 3 to 7 business days from the date of dispatch.</li>\n    <li><strong>Shipping Coverage:</strong> We currently deliver across India only.</li>\n    <li><strong>Free Shipping:</strong> Applicable on orders valued at Γé╣499 or above.</li>\n    <li><strong>Shipping Charges:</strong> A flat fee of Γé╣99 is charged on orders below Γé╣499.</li>\n    <li><strong>Order Processing Time:</strong> All orders are processed and dispatched within 1ΓÇô2 business days.</li>\n  </ul>\n  <p>You can view your tracking information in the \'My Orders\' section of your account once your order has been shipped.</p>\n\n  <p>At Store Name, we prioritize quality and customer satisfaction. However, due to the consumable nature of our products, returns are accepted only under specific conditions.</p>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_delivery_1" class="block text-sm font-semibold text-secondary mb-1">Eligibility for Return</label>               <textarea id="page_delivery_1" name="page_delivery_1" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_delivery_1 || '<p>A return request will be considered only if:</p>\n  <ul>\n    <li>The product is sealed and unopened</li>\n    <li>And the issue falls under one of the following:\n      <ul>\n        <li>You received a defective product</li>\n        <li>The product is expired</li>\n        <li>An incorrect item was delivered</li>\n      </ul>\n    </li>\n  </ul>\n  <p>Return requests must be submitted within 7 days of receiving the order.</p>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_delivery_2" class="block text-sm font-semibold text-secondary mb-1">Ineligible Returns</label>               <textarea id="page_delivery_2" name="page_delivery_2" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_delivery_2 || '<p>We do not accept returns if:</p>\n  <ul>\n    <li>The product has been opened or used</li>\n    <li>The return is requested after 7 days of delivery</li>\n    <li>The item was delivered correctly and in good condition</li>\n  </ul>'}</textarea>             </div>             <hr class="border-gray-100" />              <div>               <label for="page_delivery_3" class="block text-sm font-semibold text-secondary mb-1">How to Request a Return</label>               <textarea id="page_delivery_3" name="page_delivery_3" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.page_delivery_3 || '<p>To initiate a return:</p>\n  <ol>\n    <li>Log in to your account and navigate to the \'My Orders\' section</li>\n    <li>Select the product(s) you wish to return</li>\n    <li>Upload clear images of the product showing the issue (e.g., damaged, expired, incorrect)</li>\n    <li>Submit your return request for review</li>\n  </ol>\n  <p>You can monitor the status of your return in the \'My Returns\' section of your profile.</p>\n  <p>Once your request is reviewed and approved, we will process either a replacement or a refund, based on the issue.</p>'}</textarea>             </div>             <hr class="border-gray-100" />            </div>           <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">             <button type="submit" class="btn-primary flex items-center gap-2 px-6 py-2 text-sm" onclick="return confirm('Are you sure you want to save the Delivery page?')">               <span class="save-btn-text">Save Delivery</span>               <svg class="save-btn-spinner hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>             </button>           </div>         </form>       </details>             </div>      <div data-tab-content="faq" class="tab-panel space-y-6 hidden">       <!-- FAQ Content -->       <details data-page="FAQ" class="group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-4">         <summary class="px-6 py-4 cursor-pointer font-bold text-secondary bg-gray-50 flex justify-between items-center marker:hidden">           <div class="flex items-center gap-2">             <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>             FAQ Page           </div>           <span class="text-primary group-open:rotate-180 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></span>         </summary>         <form class="settings-section-form border-t border-gray-100" data-page="FAQ" onsubmit="prepareFaqData(event)">           <div class="p-6 space-y-6">             <p class="text-xs text-secondary/60 mb-4">Manage Frequently Asked Questions.</p>                          <div class="flex justify-between items-center mb-4">               <label class="block text-sm font-semibold text-secondary">Questions & Answers</label>               <button type="button" onclick="addFaq()" class="btn-primary px-3 py-1.5 text-xs flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>Add FAQ</button>             </div>                          <input type="hidden" id="faqs_json" name="faqs" value={JSON.stringify(settings.faqs || [               { question: "How long do your products stay fresh?", answer: "Our dehydrated products typically have a shelf life of 12 months when stored in a cool, dry place in their original sealed packaging." },               { question: "Do you offer international Delivery?", answer: "Yes, we ship to select international destinations. Delivery rates and delivery times vary by location. Please contact us for specific details." },               { question: "Are your products organic?", answer: "Many of our products are certified organic. Each product description specifies whether it's organic or conventionally grown." },               { question: "Do you offer wholesale pricing?", answer: "Yes, we offer wholesale pricing for bulk orders. Please contact us directly for wholesale inquiries. We'll send your order details via WhatsApp for confirmation and payment processing." }             ])} />                          <div id="faqs-container" class="space-y-4">               <!-- Dynamically populated via JS -->             </div>           </div>           <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">             <button type="submit" class="btn-primary flex items-center gap-2 px-6 py-2 text-sm" onclick="return confirm('Are you sure you want to save the FAQ page?')">               <span class="save-btn-text">Save FAQ</span>               <svg class="save-btn-spinner hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>             </button>           </div>         </form>       </details>          </div>      <!-- Toast notification -->     <div id="settings-toast" class="fixed bottom-6 right-6 z-50 hidden transform transition-all duration-300 translate-y-4 opacity-0">       <div id="settings-toast-inner" class="flex items-center gap-3 px-5 py-3 rounded-xl shadow-xl text-white text-sm font-medium">         <span id="settings-toast-icon"></span>         <span id="settings-toast-msg"></span>       </div>     </div>   </div>    <script is:inline>     // ΓöÇΓöÇ Form Submission ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ     var forms = document.querySelectorAll('.settings-section-form');     forms.forEach(function(form) {       form.addEventListener('submit', async function(e) {         e.preventDefault();         await handleSaveSettings(form);       });     });      async function handleSaveSettings(form) {       if (!form) return;       var saveBtn = form.querySelector('button[type="submit"]');       var saveBtnText = form.querySelector('.save-btn-text');       var saveBtnSpinner = form.querySelector('.save-btn-spinner');        // Show loading state       if (saveBtn) {         saveBtn.disabled = true;         saveBtn.classList.add('opacity-70', 'cursor-not-allowed');       }       var originalText = saveBtnText ? saveBtnText.textContent : 'Saving...';       if (saveBtnText) saveBtnText.textContent = 'Saving...';       if (saveBtnSpinner) saveBtnSpinner.classList.remove('hidden');        // Collect all form data as JSON from this specific form       var data = {};       var inputs = form.querySelectorAll('input, textarea, select');       for (var i = 0; i < inputs.length; i++) {         var input = inputs[i];         var name = input.name;         if (!name) continue;          if (input.type === 'radio') {           if (input.checked) data[name] = input.value;         } else if (input.type === 'checkbox') {           data[name] = input.checked ? 'true' : 'false';         } else {           data[name] = input.value;         }       }        try {         var res = await fetch('/api/admin/update-settings', {           method: 'POST',           headers: { 'Content-Type': 'application/json' },           body: JSON.stringify(data),           credentials: 'include'         });          var result = await res.json();          if (res.ok && result.success) {           showSettingsToast(originalText.replace('Save ', '') + ' saved successfully!', 'success');           // Reload the page after a brief delay to update the admin sidebar and header logos           setTimeout(() => window.location.reload(), 1200);         } else {           showSettingsToast('Error: ' + (result.error || 'Failed to save'), 'error');         }       } catch (err) {         showSettingsToast('Network error: ' + (err.message || 'Could not reach server'), 'error');       } finally {         // Reset button         if (saveBtn) {           saveBtn.disabled = false;           saveBtn.classList.remove('opacity-70', 'cursor-not-allowed');         }         if (saveBtnText) saveBtnText.textContent = originalText;         if (saveBtnSpinner) saveBtnSpinner.classList.add('hidden');       }     }      // ΓöÇΓöÇ Auto-save Checkboxes ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ     var autoSaveCheckboxes = document.querySelectorAll('.settings-section-form input[type="radio"]');     autoSaveCheckboxes.forEach(function(chk) {       chk.addEventListener('change', function(e) {         if (confirm('Are you sure you want to update this setting?')) {           var form = this.closest('.settings-section-form');           if (form && typeof handleSaveSettings === 'function') {             handleSaveSettings(form);           }         } else {           // It's a radio, reverting is tricky without keeping old state, but UI will reflect change briefly.         }       });     });      // ΓöÇΓöÇ Toast Helper ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ     function showSettingsToast(msg, type) {       var toast = document.getElementById('settings-toast');       var inner = document.getElementById('settings-toast-inner');       var icon = document.getElementById('settings-toast-icon');       var msgEl = document.getElementById('settings-toast-msg');       if (!toast || !inner || !icon || !msgEl) return;        msgEl.textContent = msg;       icon.textContent = type === 'success' ? 'Γ£à' : 'Γ¥î';       inner.className = 'flex items-center gap-3 px-5 py-3 rounded-xl shadow-xl text-white text-sm font-medium ' +         (type === 'success' ? 'bg-green-600' : 'bg-red-600');        toast.classList.remove('hidden');       setTimeout(function() {         toast.classList.remove('translate-y-4', 'opacity-0');       }, 10);        setTimeout(function() {         toast.classList.add('translate-y-4', 'opacity-0');         setTimeout(function() { toast.classList.add('hidden'); }, 300);       }, 3000);       window.dispatchEvent(new CustomEvent('settings-saved', { detail: { type: type } }));     }   </script>    <script is:inline>     // ΓöÇΓöÇ Branding Live Preview ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ     (function() {       var logoInput = document.getElementById('logo_url');       var faviconInput = document.getElementById('favicon_url');       var adminLogoInput = document.getElementById('admin_logo_url');       var adminTitleInput = document.getElementById('admin_title');       var previewLogo = document.getElementById('preview-logo');       var previewAdminLogo = document.getElementById('preview-admin-logo');       var previewAdminTitle = document.getElementById('preview-admin-title');        if (logoInput && previewLogo) {         logoInput.addEventListener('input', function() {           previewLogo.src = this.value || '/logo-Store Name.webp';         });       }       if (adminLogoInput && previewAdminLogo) {         adminLogoInput.addEventListener('input', function() {           previewAdminLogo.src = this.value || '/admin-icons/icon-96.png';         });       }       if (adminTitleInput && previewAdminTitle) {         adminTitleInput.addEventListener('input', function() {           previewAdminTitle.textContent = this.value || 'Admin Panel';         });       }     })();   </script>    <script is:inline>     // ΓöÇΓöÇ Image Upload Handling ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ     async function handleImageUpload(inputEl, targetInputId) {       let btn = null;       let originalText = 'Upload';              try {         if (!inputEl.files || inputEl.files.length === 0) return;         const file = inputEl.files[0];         const formData = new FormData();         formData.append('file', file);                  btn = inputEl.previousElementSibling;         if (btn && btn.tagName === 'BUTTON') {           originalText = btn.innerText || 'Upload';           btn.innerText = '...';           btn.disabled = true;         }          const res = await fetch('/api/admin/upload', {           method: 'POST',           body: formData,           credentials: 'include'         });         let data;         try {           data = await res.json();         } catch (e) {           console.error('Failed to parse JSON:', e);           data = { success: false, error: 'Invalid server response' };         }                  if (data.success) {           const targetInput = document.getElementById(targetInputId);           if (targetInput) {             targetInput.value = data.url;             targetInput.dispatchEvent(new Event('input'));           }           const previewImg = document.getElementById('preview-admin-logo');           if (previewImg) {             previewImg.src = data.url;           }           showSettingsToast('Image uploaded successfully', 'success');         } else {           showSettingsToast('Upload failed: ' + (data.error || 'Unknown error'), 'error');         }       } catch (err) {         console.error('Upload crash:', err);         showSettingsToast('Upload error: ' + err.message, 'error');       } finally {         if (btn && btn.tagName === 'BUTTON') {           btn.innerText = originalText;           btn.disabled = false;         }         inputEl.value = ''; // Reset input so same file can be uploaded again       }     }      // ΓöÇΓöÇ Team Members Management ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ     let teamMembers = [];     try {       const storedTeam = document.getElementById('team_members_json')?.value;       if (storedTeam) {         teamMembers = JSON.parse(storedTeam);       }     } catch(e) { teamMembers = []; }      function renderTeamMembers() {       const container = document.getElementById('team-members-container');       if (!container) return;        if (teamMembers.length === 0) {         container.innerHTML = '<p class="text-sm text-secondary/50 text-center py-4 border border-dashed border-gray-200 rounded-lg">No team members added yet.</p>';         return;       }        container.innerHTML = teamMembers.map((member, index) => `         <div class="team-member-item bg-gray-50 p-4 rounded-xl border border-gray-200 flex flex-col sm:flex-row gap-4 items-start sm:items-center relative">           <div class="flex-1 w-full grid grid-cols-1 sm:grid-cols-2 gap-3">             <div>               <label class="block text-xs font-medium text-secondary mb-1">Name</label>               <input type="text" class="w-full px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none" value="${member.name || ''}" onchange="updateTeamMember(${index}, 'name', this.value)" placeholder="e.g. John Doe" />             </div>             <div>               <label class="block text-xs font-medium text-secondary mb-1">Role</label>               <input type="text" class="w-full px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none" value="${member.role || ''}" onchange="updateTeamMember(${index}, 'role', this.value)" placeholder="e.g. CTO" />             </div>             <div class="sm:col-span-2">               <label class="block text-xs font-medium text-secondary mb-1">Image URL</label>               <div class="flex gap-2">                 <input id="team_img_${index}" type="text" class="flex-1 px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none" value="${member.image_url || ''}" onchange="updateTeamMember(${index}, 'image_url', this.value)" placeholder="https://..." />                 <button type="button" class="px-3 py-1.5 bg-white hover:bg-gray-100 text-secondary text-xs font-medium rounded-md border border-gray-300 transition-colors" onclick="this.nextElementSibling.click()">Upload</button>                 <input type="file" class="hidden" accept="image/*" onchange="handleImageUpload(this, 'team_img_${index}'); setTimeout(() => updateTeamMember(${index}, 'image_url', document.getElementById('team_img_${index}').value), 1500);" />               </div>             </div>           </div>           <div class="flex flex-col gap-2 shrink-0">             ${member.image_url ? '<img src="' + member.image_url + '" class="w-12 h-12 object-cover rounded-full border border-gray-200" />' : '<div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center text-gray-400 text-xs">No Img</div>'}             <button type="button" onclick="removeTeamMember(${index})" class="text-xs text-red-500 hover:text-red-700 font-medium">Remove</button>           </div>         </div>       `).join('');     }      function addTeamMember() {       teamMembers.push({ name: '', role: '', image_url: '' });       renderTeamMembers();     }      function updateTeamMember(index, field, value) {       if (teamMembers[index]) {         teamMembers[index][field] = value;       }       if (field === 'image_url') {         renderTeamMembers(); // re-render to show image       }     }      function removeTeamMember(index) {       if(confirm('Remove this team member?')) {         teamMembers.splice(index, 1);         renderTeamMembers();       }     }      function prepareTeamData(e) {       // Updates the hidden input before form submit       document.getElementById('team_members_json').value = JSON.stringify(teamMembers);     }      // Initialize team render     document.addEventListener('DOMContentLoaded', () => {       renderTeamMembers();     });       // ΓöÇΓöÇ FAQ Management ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ     let faqs = [];     try {       const storedFaqs = document.getElementById('faqs_json')?.value;       if (storedFaqs) {         faqs = JSON.parse(storedFaqs);       }     } catch(e) { faqs = []; }      function renderFaqs() {       const container = document.getElementById('faqs-container');       if (!container) return;              if (faqs.length === 0) {         container.innerHTML = '<p class="text-sm text-secondary/50 text-center py-4 border border-dashed border-gray-200 rounded-lg">No FAQs added yet.</p>';         return;       }              container.innerHTML = faqs.map((faq, index) => `         <div class="faq-item bg-gray-50 p-4 rounded-xl border border-gray-200 flex flex-col gap-3 relative">           <div>             <label class="block text-xs font-medium text-secondary mb-1">Question</label>             <input type="text" class="w-full px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none" value="${faq.question || ''}" onchange="updateFaq(${index}, 'question', this.value)" placeholder="e.g. What is your return policy?" />           </div>           <div>             <label class="block text-xs font-medium text-secondary mb-1">Answer</label>             <textarea rows="3" class="w-full px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none" onchange="updateFaq(${index}, 'answer', this.value)" placeholder="e.g. We offer a 30-day return policy...">${faq.answer || ''}</textarea>           </div>           <button type="button" onclick="removeFaq(${index})" class="absolute top-4 right-4 text-xs text-red-500 hover:text-red-700 font-medium bg-red-50 px-2 py-1 rounded">Remove</button>         </div>       `).join('');     }      function addFaq() {       faqs.push({ question: '', answer: '' });       renderFaqs();       const input = document.getElementById('faqs_json');       if (input) input.value = JSON.stringify(faqs);       if (frame && frame.contentWindow) frame.contentWindow.postMessage({ type: 'faq_update', faqs: faqs }, '*');       if (mobileFrame && mobileFrame.contentWindow) mobileFrame.contentWindow.postMessage({ type: 'faq_update', faqs: faqs }, '*');     }      function updateFaq(index, field, value) {       if (faqs[index]) {         faqs[index][field] = value;         const input = document.getElementById('faqs_json');         if (input) input.value = JSON.stringify(faqs);         if (frame && frame.contentWindow) frame.contentWindow.postMessage({ type: 'faq_update', faqs: faqs }, '*');         if (mobileFrame && mobileFrame.contentWindow) mobileFrame.contentWindow.postMessage({ type: 'faq_update', faqs: faqs }, '*');       }     }      function removeFaq(index) {       if (index >= 0 && index < faqs.length) {         faqs.splice(index, 1);         renderFaqs();         const input = document.getElementById('faqs_json');         if (input) input.value = JSON.stringify(faqs);         if (frame && frame.contentWindow) frame.contentWindow.postMessage({ type: 'faq_update', faqs: faqs }, '*');         if (mobileFrame && mobileFrame.contentWindow) mobileFrame.contentWindow.postMessage({ type: 'faq_update', faqs: faqs }, '*');       }     }      function prepareFaqData(e) {       const input = document.getElementById('faqs_json');       if (input) input.value = JSON.stringify(faqs);     }      document.addEventListener('DOMContentLoaded', () => {       renderFaqs();     });    </script>    <!-- Tab Switching Logic -->   <script is:inline>     // Tab preview URL mapping     var tabPreviewUrls = {       branding: "/",       company: "/",       homepage: "/",       about: "/about",       pages: "/contact",       policies: "/privacy-policy",       faq: "/faq"     };      function switchTab(tabId) {       // Hide all panels       document.querySelectorAll('.tab-panel').forEach(function(panel) {         panel.classList.add('hidden');       });       // Show target panel       var target = document.querySelector('[data-tab-content="' + tabId + '"]');       if (target) target.classList.remove('hidden');        // Update active tab button styling       document.querySelectorAll('.store-tab').forEach(function(btn) {         btn.classList.remove('bg-primary', 'text-white', 'shadow-sm');         btn.classList.add('bg-white', 'text-secondary', 'hover:bg-gray-100');       });       var activeBtn = document.querySelector('.store-tab[data-tab="' + tabId + '"]');       if (activeBtn) {         activeBtn.classList.remove('bg-white', 'text-secondary', 'hover:bg-gray-100');         activeBtn.classList.add('bg-primary', 'text-white', 'shadow-sm');       }        // Update live preview       var url = tabPreviewUrls[tabId] || "/";       var frame = document.getElementById('live-preview-frame');       var badge = document.getElementById('preview-url-badge');       var mobileFrame = document.getElementById('mobile-preview-frame');       var mobileBadge = document.getElementById('mobile-preview-badge');       if (frame) frame.src = url;       if (badge) badge.textContent = url;       if (mobileFrame) mobileFrame.src = url;       if (mobileBadge) mobileBadge.textContent = url;        // Scroll to top of forms panel       var formsPanel = document.querySelector('.lg\\:w-\\[52\\%\\]');       if (formsPanel) formsPanel.scrollTop = 0;     }   </script>  <!-- Live Preview Panel -->   <div class="w-full lg:w-[48%] hidden lg:flex flex-col bg-white border-l border-gray-200 overflow-hidden h-full" style="height: 100%;">     <div class="px-4 py-3 bg-gray-50 border-b border-gray-100 flex justify-between items-center shrink-0">       <span class="text-sm font-bold text-secondary flex items-center gap-2">         <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>         Live Preview       </span>       <div class="flex items-center gap-2">         <span id="preview-url-badge" class="text-xs bg-primary/10 text-primary px-2 py-1 rounded font-mono">/</span>         <button onclick="document.getElementById('live-preview-frame').src = document.getElementById('live-preview-frame').src" class="text-xs bg-gray-200 hover:bg-gray-300 text-gray-600 px-2 py-1 rounded transition-colors" title="Refresh preview">&#8635;</button>       </div>     </div>     <iframe id="live-preview-frame" src="/" class="w-full flex-1 bg-white border-0" style="pointer-events:auto;"></iframe>   </div> </div>  <script is:inline>   (function() {     const frame = document.getElementById("live-preview-frame");     const badge = document.getElementById("preview-url-badge");     const mobileFrame = document.getElementById("mobile-preview-frame");     const mobileBadge = document.getElementById("mobile-preview-badge");      const pageMap = {       "About Us": "/about",       "Bulk Order": "/bulk-order",       "Contact Us": "/contact",       "Privacy Policy": "/privacy-policy",       "Terms": "/terms",       "Refund Policy": "/refund-policy",       "Shipping Policy": "/shipping-policy",       "Sustainability": "/sustainability",       "Warranty": "/warranty",       "Delivery": "/delivery",       "FAQ": "/faq"     };      function updateAllPreviews(page) {       const url = pageMap[page];       if (!url) return;              if (frame) {         frame.src = url;       }       if (badge) {         badge.textContent = url;       }       if (mobileFrame) {         mobileFrame.src = url;       }       if (mobileBadge) {         mobileBadge.textContent = url;       }     }      function syncAllSettingsToFrame(targetFrame) {       if (!targetFrame || !targetFrame.contentWindow) return;       document.querySelectorAll('.settings-section-form input[name], .settings-section-form textarea[name]').forEach(function(el) {         if (!el.name) return;         var val = el.value;         if (el.type === 'checkbox' || el.type === 'radio') {           if (!el.checked) return;           val = el.value;         }         const msg = {           type: 'settings_update',           key: el.name,           value: val         };         targetFrame.contentWindow.postMessage(msg, '*');       });     }      if (frame) {       frame.addEventListener('load', function() {         syncAllSettingsToFrame(frame);       });     }     if (mobileFrame) {       mobileFrame.addEventListener('load', function() {         syncAllSettingsToFrame(mobileFrame);       });     }      // Toggle logic for the exclusive accordion     document.querySelectorAll("details[data-page]").forEach(function(d) {       d.addEventListener("toggle", function() {         if (this.open) {           document.querySelectorAll("details[data-page]").forEach(function(other) {             if (other !== d) other.removeAttribute("open");           });           const page = this.getAttribute("data-page");           updateAllPreviews(page);         }       });     });      // Hook into the toast to auto-reload after save     window.addEventListener('settings-saved', function(e) {       if (e.detail && e.detail.type === "success") {         setTimeout(function() {            if (frame) frame.src = frame.src;            if (mobileFrame) mobileFrame.src = mobileFrame.src;         }, 600);       }     });    // Dynamic scaling removed in favor of native modal      // Realtime Live Preview dispatcher     document.addEventListener('input', function(e) {       if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {         const msg = {           type: 'settings_update',           key: e.target.name,           value: e.target.value         };         if (frame && frame.contentWindow) {           frame.contentWindow.postMessage(msg, '*');         }         if (mobileFrame && mobileFrame.contentWindow) {           mobileFrame.contentWindow.postMessage(msg, '*');         }       }     });   })(); </script>    <!-- Mobile Preview Modal -->   <div id="mobile-preview-modal" class="fixed inset-0 z-[100] hidden flex-col items-center justify-center bg-black/80 backdrop-blur-sm p-4" onclick="if(event.target === this) closeMobilePreviewModal()">     <div class="w-full max-w-[360px] flex flex-col gap-3">       <!-- Modal Header -->       <div class="flex items-center justify-between bg-white/10 p-3 rounded-xl border border-white/20 backdrop-blur-md">         <div class="flex items-center gap-2">           <span id="mobile-preview-badge" class="text-[10px] bg-primary/20 text-white px-2 py-0.5 rounded font-mono">/</span>           <button type="button" onclick="document.getElementById('mobile-preview-frame').src = document.getElementById('mobile-preview-frame').src" class="text-[10px] bg-white/20 hover:bg-white/30 text-white px-2 py-0.5 rounded transition-colors" title="Refresh Mobile">&#8635;</button>         </div>         <button type="button" onclick="closeMobilePreviewModal()" class="text-white hover:text-red-400 bg-white/10 hover:bg-white/20 rounded-full p-1 transition-colors">           <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>         </button>       </div>       <!-- 9:16 Frame Container -->       <div class="w-full relative aspect-[9/16] bg-white rounded-[2rem] overflow-hidden shadow-2xl border-[6px] border-gray-900 mx-auto max-h-[75vh]">         <iframe id="mobile-preview-frame" src="/" class="absolute top-0 left-0 w-full h-full border-0 bg-white"></iframe>       </div>     </div>   </div>  <script is:inline>   function openMobilePreviewModal() {     document.getElementById('mobile-preview-modal').classList.remove('hidden');     document.getElementById('mobile-preview-modal').classList.add('flex');     document.body.style.overflow = 'hidden';   }   function closeMobilePreviewModal() {     document.getElementById('mobile-preview-modal').classList.add('hidden');     document.getElementById('mobile-preview-modal').classList.remove('flex');     document.body.style.overflow = '';   } </script>    <!-- Admin Verification Modal -->   <div id="admin-auth-modal" class="fixed inset-0 z-[200] hidden flex-col items-center justify-center bg-black/80 backdrop-blur-sm p-4" onclick="if(event.target === this) closeAdminAuthModal()">     <div class="w-full max-w-[400px] bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden">       <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center">         <h3 class="font-bold text-secondary flex items-center gap-2">           <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 20 20" fill="currentColor">             <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />           </svg>           Admin Verification Required         </h3>         <button type="button" onclick="closeAdminAuthModal()" class="text-gray-400 hover:text-gray-600 transition-colors">           <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>         </button>       </div>       <div class="p-6">         <p class="text-sm text-secondary/70 mb-4">To save these changes, please verify your identity. Enter your Admin Password or OTP if configured.</p>         <div class="mb-4">           <label class="block text-sm font-semibold text-secondary mb-1">Password or OTP</label>           <input type="password" id="admin-auth-input" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" placeholder="Enter password or OTP..." />           <p id="admin-auth-error" class="text-xs text-red-500 mt-2 hidden"></p>         </div>         <div class="flex justify-end gap-3 mt-6">           <button type="button" onclick="closeAdminAuthModal()" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">Cancel</button>           <button type="button" id="admin-auth-confirm-btn" class="btn-primary px-4 py-2 text-sm">Verify & Save</button>         </div>       </div>     </div>   </div>    <script is:inline>     let pendingForm = null;      function openAdminAuthModal(form) {       pendingForm = form;       document.getElementById('admin-auth-error').classList.add('hidden');       document.getElementById('admin-auth-input').value = '';       document.getElementById('admin-auth-modal').classList.remove('hidden');       document.getElementById('admin-auth-modal').classList.add('flex');       document.body.style.overflow = 'hidden';       setTimeout(() => document.getElementById('admin-auth-input').focus(), 100);     }      function closeAdminAuthModal() {       document.getElementById('admin-auth-modal').classList.add('hidden');       document.getElementById('admin-auth-modal').classList.remove('flex');       document.body.style.overflow = '';       pendingForm = null;     }      // Intercept all settings forms     document.addEventListener('DOMContentLoaded', () => {       document.querySelectorAll('.settings-section-form').forEach(form => {         // Remove native submit, replace with our custom handler         form.addEventListener('submit', (e) => {           e.preventDefault();           openAdminAuthModal(form);         });       });        document.getElementById('admin-auth-confirm-btn').addEventListener('click', submitPendingForm);       document.getElementById('admin-auth-input').addEventListener('keydown', (e) => {         if (e.key === 'Enter') submitPendingForm();       });     });      async function submitPendingForm() {       if (!pendingForm) return;       const authCode = document.getElementById('admin-auth-input').value.trim();       const errorEl = document.getElementById('admin-auth-error');              if (!authCode) {         errorEl.textContent = 'Please enter your password or OTP.';         errorEl.classList.remove('hidden');         return;       }        const btn = document.getElementById('admin-auth-confirm-btn');       btn.disabled = true;       btn.innerHTML = 'Verifying...';       errorEl.classList.add('hidden');        // We handle the form data       const formData = new FormData(pendingForm);       formData.append('admin_auth_code', authCode);        try {         const res = await fetch('/api/admin/update-settings', {           method: 'POST',           body: formData         });         const data = await res.json();                  if (!res.ok) {           throw new Error(data.error || 'Verification failed');         }          // Success         closeAdminAuthModal();         window.dispatchEvent(new CustomEvent('settings-saved', { detail: { type: 'success' } }));         // Show success toast or reload         window.location.search = '?success=true';       } catch (err) {         errorEl.textContent = err.message;         errorEl.classList.remove('hidden');       } finally {         btn.disabled = false;         btn.innerHTML = 'Verify & Save';       }     }   </script> </AdminLayout>  <script>   // Add JS to handle Custom Domain Form   document.addEventListener('DOMContentLoaded', () => {     const domainForm = document.getElementById('custom-domain-form');     const msgBox = document.getElementById('domain-msg');     const submitBtn = document.getElementById('domain-submit-btn');     const removeBtn = document.getElementById('remove-domain-btn');      const showMsg = (msg, type) => {       msgBox.textContent = msg;       msgBox.className = `text-sm p-3 rounded-lg mt-2 ${type === 'error' ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-green-50 text-green-700 border border-green-200'}`;       msgBox.classList.remove('hidden');     };      if (domainForm) {       domainForm.addEventListener('submit', async (e) => {         e.preventDefault();         const customDomain = document.getElementById('custom_domain').value;         if (!customDomain) return;          // UI Loading State         submitBtn.querySelector('.save-btn-text').textContent = 'Connecting...';         submitBtn.querySelector('.save-btn-spinner').classList.remove('hidden');         submitBtn.disabled = true;         msgBox.classList.add('hidden');          try {           const res = await fetch('/api/admin/update-domain', {             method: 'POST',             headers: { 'Content-Type': 'application/json' },             body: JSON.stringify({ custom_domain: customDomain, action: 'add' })           });            const data = await res.json();           if (!res.ok) throw new Error(data.error || 'Failed to connect domain');            showMsg('Domain successfully connected! Please ensure you have added the CNAME record in your registrar.', 'success');           setTimeout(() => window.location.reload(), 2000);         } catch (err) {           showMsg(err.message, 'error');         } finally {           submitBtn.querySelector('.save-btn-text').textContent = 'Connect Domain';           submitBtn.querySelector('.save-btn-spinner').classList.add('hidden');           submitBtn.disabled = false;         }       });     }      if (removeBtn) {       removeBtn.addEventListener('click', async () => {         if (!confirm('Are you sure you want to disconnect this domain? Your store will immediately revert to the VyaparPe subdomain.')) return;                  removeBtn.textContent = 'Removing...';         removeBtn.disabled = true;         msgBox.classList.add('hidden');          try {           const customDomain = document.getElementById('custom_domain').value;           const res = await fetch('/api/admin/update-domain', {             method: 'POST',             headers: { 'Content-Type': 'application/json' },             body: JSON.stringify({ custom_domain: customDomain, action: 'remove' })           });            const data = await res.json();           if (!res.ok) throw new Error(data.error || 'Failed to remove domain');            showMsg('Domain removed successfully.', 'success');           setTimeout(() => window.location.reload(), 1500);         } catch (err) {           showMsg(err.message, 'error');           removeBtn.textContent = 'Remove';           removeBtn.disabled = false;         }       });     }      // --- NEW: Redirect Domains Logic ---     const redirectForm = document.getElementById('redirect-domains-form');     if (redirectForm) {       redirectForm.addEventListener('submit', async (e) => {         e.preventDefault();         const redirectDomainInput = document.getElementById('new_redirect_domain');         const customDomain = redirectDomainInput.value;         if (!customDomain) return;          const btn = document.getElementById('add-redirect-btn');         const msgBox = document.getElementById('redirect-domain-msg');                  btn.querySelector('.save-btn-text').textContent = 'Adding...';         btn.querySelector('.save-btn-spinner').classList.remove('hidden');         btn.disabled = true;         msgBox.classList.add('hidden');          try {           const res = await fetch('/api/admin/update-domain', {             method: 'POST',             headers: { 'Content-Type': 'application/json' },             body: JSON.stringify({ custom_domain: customDomain, action: 'add_redirect' })           });            const data = await res.json();           if (!res.ok) throw new Error(data.error || 'Failed to add redirect domain');            msgBox.textContent = 'Redirect domain added successfully!';           msgBox.className = 'text-sm p-3 rounded-lg mt-2 bg-green-50 text-green-700 border border-green-200';           msgBox.classList.remove('hidden');           setTimeout(() => window.location.reload(), 1500);         } catch (err) {           msgBox.textContent = err.message;           msgBox.className = 'text-sm p-3 rounded-lg mt-2 bg-red-50 text-red-700 border border-red-200';           msgBox.classList.remove('hidden');         } finally {           btn.querySelector('.save-btn-text').textContent = 'Add Redirect';           btn.querySelector('.save-btn-spinner').classList.add('hidden');           btn.disabled = false;         }       });     }      // --- Domain Status Checker ---     window.checkDomainStatus = async function(domain, type) {       if (!domain) return;              let badge, infoBox;       if (type === 'primary') {         badge = document.getElementById('primary-domain-status-badge');         infoBox = document.getElementById('primary-domain-error-info');       } else {         badge = document.getElementById(`redirect-status-${domain.replace(/\./g, '-')}`);       }        if (!badge) return;        badge.textContent = 'Checking...';       badge.className = 'px-2 py-0.5 rounded text-xs bg-yellow-100 text-yellow-800 animate-pulse';       if (infoBox) infoBox.classList.add('hidden');        try {         const res = await fetch(`/api/admin/check-domain?domain=${encodeURIComponent(domain)}`);         const data = await res.json();          if (!res.ok) throw new Error(data.error || 'Check failed');          if (data.verified) {           badge.textContent = 'Active';           badge.className = 'px-2 py-0.5 rounded text-xs font-bold bg-green-100 text-green-800';         } else {           badge.textContent = 'Pending Verification';           badge.className = 'px-2 py-0.5 rounded text-xs font-bold bg-yellow-100 text-yellow-800';                      if (infoBox && data.verification && data.verification.length > 0) {             const v = data.verification[0];             infoBox.innerHTML = `<strong>Action Required:</strong> Missing ${v.type} record.<br/>Host: <code>${v.domain}</code><br/>Value: <code>${v.value}</code>`;             infoBox.classList.remove('hidden');           }         }       } catch (err) {         badge.textContent = 'Error';         badge.className = 'px-2 py-0.5 rounded text-xs font-bold bg-red-100 text-red-800';       }     };      window.removeRedirectDomain = async function(domain) {       if (!confirm(`Are you sure you want to remove ${domain}?`)) return;       try {         const res = await fetch('/api/admin/update-domain', {           method: 'POST',           headers: { 'Content-Type': 'application/json' },           body: JSON.stringify({ custom_domain: domain, action: 'remove_redirect' })         });         if (!res.ok) throw new Error('Failed');         window.location.reload();       } catch (err) {         alert('Failed to remove domain: ' + err.message);       }     };      // Auto-check primary domain on load if it exists     const primaryInput = document.getElementById('custom_domain');     if (primaryInput && primaryInput.value && document.getElementById('primary-domain-status-badge')) {       checkDomainStatus(primaryInput.value, 'primary');     }      // Auto-check all redirect domains on load     const redirectDomainsArr = window.__redirectDomains || [];     redirectDomainsArr.forEach(d => checkDomainStatus(d, 'redirect'));   }); </script>