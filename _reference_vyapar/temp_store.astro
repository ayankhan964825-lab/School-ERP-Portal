4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/></svg>               Redirect Domains             </h2>             <p class="text-xs text-secondary/60">Add secondary domains (like Store Name.in) that will automatically redirect visitors to your primary domain.</p>           </div>           <div class="p-6 space-y-4">             <div class="flex gap-3">               <input                  id="new_redirect_domain"                  type="text"                  placeholder="e.g. Store Name.in"                  class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm"                />               <button type="submit" id="add-redirect-btn" class="px-4 py-2 bg-gray-100 text-gray-800 rounded-lg text-sm font-semibold border border-gray-200 hover:bg-gray-200 transition-colors flex items-center gap-2">                 <span class="save-btn-text">Add Redirect</span>                 <svg class="save-btn-spinner hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>               </button>             </div>             <div id="redirect-domain-msg" class="hidden text-sm p-3 rounded-lg mt-2"></div>                          <!-- List of existing redirect domains -->             <div class="mt-4 space-y-3">               {settings.redirect_domains && Array.isArray(settings.redirect_domains) && settings.redirect_domains.map((rd: string) => (                 <div class="flex justify-between items-center p-3 border border-gray-100 rounded-lg bg-gray-50/50">                   <div>                     <div class="font-semibold text-sm text-secondary">{rd} <span class="text-xs font-normal text-secondary/60 ml-1">&rarr; {settings.custom_domain}</span></div>                     <div id={`redirect-status-${rd.replace(/\./g, '-')}`} class="text-[10px] uppercase font-bold text-yellow-600 tracking-wider mt-1">Checking Status...</div>                   </div>                   <button type="button" onclick={`removeRedirectDomain('${rd}')`} class="text-red-500 hover:text-red-700 text-xs font-medium px-2 py-1 bg-red-50 rounded">Remove</button>                 </div>               ))}               {(!settings.redirect_domains || settings.redirect_domains.length === 0) && (                 <div class="text-sm text-secondary/60 text-center py-4 bg-gray-50 rounded-lg border border-dashed border-gray-200">No redirect domains added yet.</div>               )}             </div>           </div>         </form>         <script define:vars={{ redirectDomains: settings.redirect_domains || [] }}>           window.__redirectDomains = redirectDomains;         </script>       )}     </div>      <div data-tab-content="branding" class="tab-panel space-y-6 hidden">       <!-- Branding & Assets -->       <form class="settings-section-form bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">         <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">           <h2 class="font-bold text-secondary flex items-center gap-2">             <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>             Branding & Assets           </h2>           <p class="text-xs text-secondary/60">Customize logos, favicons, and branding for the main website and admin panel.</p>         </div>         <div class="p-6 space-y-5">           <!-- Main Website -->           <p class="text-sm font-semibold text-secondary">Main Website</p>                      <div class="mb-4