ray-700 text-sm font-medium rounded-lg border border-gray-300 transition-colors" onclick="this.nextElementSibling.click()">Upload</button>                 <input type="file" class="hidden" accept="image/*" onchange="handleImageUpload(this, 'favicon_url')" />               </div>               <p class="text-xs text-secondary/60 mt-1">Browser tab icon for the main website. Leave blank for default.</p>             </div>           </div>           <hr class="border-gray-100" />           <!-- Admin Panel -->           <p class="text-sm font-semibold text-secondary">Admin Panel</p>           <div class="grid grid-cols-1 md:grid-cols-3 gap-4">             <div>               <label for="admin_logo_url" class="block text-sm font-medium text-secondary mb-1">Admin Logo URL</label>               <div class="flex gap-2">                 <input id="admin_logo_url" type="text" name="admin_logo_url" value={settings.admin_logo_url || ''} placeholder="/admin-icons/icon-96.png" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />                 <button type="button" class="px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg border border-gray-300 transition-colors" onclick="this.nextElementSibling.click()">Upload</button>                 <input type="file" class="hidden" accept="image/*" onchange="handleImageUpload(this, 'admin_logo_url')" />               </div>               <p class="text-xs text-secondary/60 mt-1">Sidebar & mobile header logo.</p>             </div>             <div>               <label for="admin_favicon_url" class="block text-sm font-medium text-secondary mb-1">Admin Favicon URL</label>               <div class="flex gap-2">                 <input id="admin_favicon_url" type="text" name="admin_favicon_url" value={settings.admin_favicon_url || ''} placeholder="/admin-icons/icon-192.png" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus: