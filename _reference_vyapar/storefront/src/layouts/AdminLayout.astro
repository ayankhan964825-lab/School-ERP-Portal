function canSeeNav(path: string): boolean {
  if (isSuperAdmin) return true;
  const basePath = path.split('?')[0];
  const section = sectionPermMap[basePath];
  if (!section) return true; // dashboard always visible
  
  const perm = userPermissions[section] || 'none';
  return perm === 'view' || perm === 'manage';
}


