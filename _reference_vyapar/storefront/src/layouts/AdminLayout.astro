---
import '../styles/global.css';
import SpeedInsights from '@vercel/speed-insights/astro';
import LogoLoader from '../components/LogoLoader.astro';
import { ClientRouter } from 'astro:transitions';
import pkg from '../../package.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Admin Dashboard' } = Astro.props;

const isAuthenticated = Astro.cookies.has('admin_auth');
const isLoginPage = Astro.url.pathname === '/admin/login';
const currentPath = Astro.url.pathname;

import { isSupabase as isLiveDb, getSettings, supabaseAdmin } from '../lib/database';
import { getPermissionContext } from '../lib/permissions';
import AdminGuideModal from '../components/admin/AdminGuideModal.astro';

// Read role and permissions from cookies
const ctx = getPermissionContext(Astro.cookies);
const adminRole = ctx.adminRole;
const isSuperAdmin = ctx.isOriginalSuperAdmin;
const hierarchyLevel = ctx.hierarchyLevel;
const isOriginalSuperAdmin = ctx.isOriginalSuperAdmin;
const adminId = ctx.adminId || 'super_admin_root';
// Fetch settings for dynamic admin branding and custom name
const forceStoreId = Astro.locals.storeId;
const adminSettings = await getSettings(forceStoreId);
let pc = adminSettings?.pages_content;
if (typeof pc === 'string') {
  try { pc = JSON.parse(pc); } catch { pc = {}; }
}
if (!pc || typeof pc !== 'object') pc = {};
const customName = pc.super_admin_custom_name || 'Super Admin';

// Override the cookie name for original super admin to ensure immediate dynamic updates
const adminName = isOriginalSuperAdmin ? customName : (ctx.adminName || 'Staff');

let userPermissions: Record<string,string> = ctx.permissions;
const adminEmail = Astro.cookies.get('admin_email')?.value || '';

// Recovery method for this user (from staff record, stored in cookie)
const recoveryMethod = Astro.cookies.get('admin_recovery')?.value || 'contact_super';

const adminLogoUrl = adminSettings?.admin_logo_url || adminSettings?.brand_logo || '';
const adminFaviconUrl = adminSettings?.admin_favicon_url || adminSettings?.brand_favicon || adminSettings?.logo_url || adminSettings?.brand_logo || '/favicon.ico';
const adminBrandTitle = adminSettings?.admin_title || adminSettings?.brand_name || 'Admin Panel';

let forceRedirect: string | null = null;
// Single Active Session Verification
if (isAuthenticated && !isLoginPage) {
  const currentToken = Astro.cookies.get('admin_session_token')?.value;
  const dbEntry = pc.active_sessions?.[adminId];
  // active_sessions stores objects like { token: '...', timestamp: ... }
  const dbToken = dbEntry && typeof dbEntry === 'object' ? dbEntry.token : dbEntry;
  if (dbToken && currentToken !== dbToken) {
    Astro.cookies.delete('admin_auth', { path: '/' });
    Astro.cookies.delete('admin_role', { path: '/' });
    Astro.cookies.delete('admin_id', { path: '/' });
    Astro.cookies.delete('admin_signature', { path: '/' });
    Astro.cookies.delete('admin_session_token', { path: '/' });
    forceRedirect = '/admin/login?error=multidevice';
  }
} else if (!isAuthenticated && !isLoginPage) {
  forceRedirect = '/admin/login';
}

// Permission-gated nav sections mapping
let storeWebsiteUrl = '/';
let storeWebsiteLabel = 'View Website';

// Determine the actual storeId to build the URL for
// If master admin is impersonating, use impersonated store
// Otherwise use current tenant
const isMasterAdmin = Astro.locals?.storeId === 'SUPER_ADMIN_BYPASS';
const urlStoreId = isMasterAdmin ? Astro.url.searchParams.get('id') : null;
const impersonateStoreId = Astro.cookies.get('admin_impersonate')?.value;
const effectiveStoreId = urlStoreId || impersonateStoreId || Astro.locals?.storeId || '';

if (isLiveDb && supabaseAdmin && effectiveStoreId && effectiveStoreId !== 'SUPER_ADMIN_BYPASS') {
  try {
    const { data: storeData } = await supabaseAdmin.from('stores').select('subdomain, custom_domain, name').eq('id', effectiveStoreId).maybeSingle();
    if (storeData) {
      storeWebsiteLabel = storeData.name ? `View: ${storeData.name}` : 'View Website';
      if (storeData.custom_domain) {
        storeWebsiteUrl = `https://${storeData.custom_domain}`;
      } else if (storeData.subdomain) {
        // Build URL based on current host
        const currentHost = Astro.url.host;
        const protocol = Astro.url.protocol;
        // Match: something.vyaparpe.in, something.vyaparpe.com, something.vercel.app, localhost:4321
        const platformMatch = currentHost.match(/^(?:[^.]+\.)?(vyaparpe\.in|vyaparpe\.com|vercel\.app|localhost(?::\d+)?)(.*)$/);
        if (platformMatch) {
          storeWebsiteUrl = `${protocol}//${storeData.subdomain}.${platformMatch[1]}${platformMatch[2]}`;
        } else if (currentHost.startsWith('master.')) {
          storeWebsiteUrl = `${protocol}//${currentHost.replace(/^master\./, storeData.subdomain + '.')}`;
        } else {
          storeWebsiteUrl = `${protocol}//${storeData.subdomain}.${currentHost}`;
        }
      }
    }
  } catch(e) {
    console.error('View Website URL error:', e);
  }
}

