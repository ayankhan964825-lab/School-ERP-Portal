            <label class="block text-xs font-semibold text-secondary/70 mb-1.5 uppercase tracking-wider">Confirm New Password</label>
            <input type="password" id="cp-confirm" required placeholder="Re-enter new password"
              class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition" />
          </div>
          <p id="cp-error" class="hidden text-xs text-red-500 font-medium"></p>
          <div class="flex gap-3 pt-1">
            <button type="button" onclick="window.closeChangePasswordModal()" class="flex-1 px-4 py-2.5 text-sm font-medium text-secondary/60 bg-gray-100 hover:bg-gray-200 rounded-xl transition-colors">Cancel</button>
            <button type="submit" id="cp-submit-btn" class="flex-1 px-4 py-2.5 text-sm font-semibold bg-primary text-white rounded-xl hover:bg-primary/90 active:scale-95 transition-all">Update Password</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ── Password Recovery Request Modal ───────────────────── -->
    <div id="recovery-request-modal" class="fixed inset-0 z-[200] hidden items-center justify-center p-4">
      <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="rr-backdrop"></div>
      <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm animate-modal-in">
        <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100">
          <div>
            <h3 class="text-base font-semibold text-secondary">Request Password Recovery</h3>
            <p class="text-xs text-secondary/50 mt-0.5">Send a reset request to your admin</p>
          </div>
          <button onclick="window.closeRecoveryRequestModal()" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-gray-100 text-secondary/40 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
        <div class="px-6 py-5 space-y-4">
          <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 text-sm text-orange-700">
            <p class="font-semibold mb-1">📩 How it works</p>
            <p class="text-xs">Your password recovery request will be sent to your admin. They will set a new password and notify you.</p>
          </div>
          <div>
            <label class="block text-xs font-semibold text-secondary/70 mb-1.5 uppercase tracking-wider">Message (Optional)</label>
            <textarea id="rr-message" rows="3" placeholder="e.g. I forgot my password, please reset it..."
              class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition resize-none"></textarea>
          </div>
          <div class="flex gap-3 pt-1">
            <button type="button" onclick="window.closeRecoveryRequestModal()" class="flex-1 px-4 py-2.5 text-sm font-medium text-secondary/60 bg-gray-100 hover:bg-gray-200 rounded-xl transition-colors">Cancel</button>
            <button type="button" onclick="window.submitRecoveryRequest()" class="flex-1 px-4 py-2.5 text-sm font-semibold bg-orange-500 text-white rounded-xl hover:bg-orange-600 active:scale-95 transition-all">Send Request</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Admin Guide Modal -->
    <AdminGuideModal />

    <SpeedInsights />
  </body>
</html>

<script is:inline>
  // ── Admin Service Worker Registration ────────────────────────
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/admin-sw.js', { scope: '/admin' })
        .then(reg => {
          reg.update();
          reg.addEventListener('updatefound', () => {
            const nw = reg.installing;
            if (nw) {
              nw.addEventListener('statechange', () => {
                if (nw.state === 'installed' && navigator.serviceWorker.controller) {
                  nw.postMessage('skipWaiting');
                }
              });
            }
          });
        })
        .catch(err => console.warn('[AdminSW] Registration failed:', err));
    });
  }

  // ── PWA Install Prompt ────────────────────────────────────────
  let deferredPrompt = null;
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;

    // Show sidebar install button
    const sideBtn = document.getElementById('pwa-install-btn');
    if (sideBtn) sideBtn.classList.remove('hidden');

    // Show toast after 3s (don't be intrusive)
    const dismissed = sessionStorage.getItem('pwa-toast-dismissed');
    if (!dismissed) {
      setTimeout(() => {
        const toast = document.getElementById('pwa-toast');
        if (toast) toast.classList.remove('hidden');
      }, 3000);
    }
  });

  async function triggerInstall() {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    deferredPrompt = null;
    if (outcome === 'accepted') {
      document.getElementById('pwa-install-btn')?.classList.add('hidden');
      document.getElementById('pwa-toast')?.classList.add('hidden');
    }
  }

  // Define updateConnectionStatus outside to be used anywhere
  function updateConnectionStatus() {
    const online = navigator.onLine;
    const badge = document.getElementById('connection-badge');
    const offlineIndicator = document.getElementById('offline-indicator');

    if (badge) badge.classList.toggle('hidden', online);
    if (offlineIndicator) offlineIndicator.classList.toggle('hidden', online);
  }

  let adminGlobalListenersBound = false;

  document.addEventListener('astro:page-load', () => {
    // ── Reset any stuck scroll locks from previous pages ────────
    document.body.style.overflow = '';

    // ── PWA DOM Bindings ────────────────────────────────────────
    document.getElementById('pwa-install-btn')?.addEventListener('click', triggerInstall);
    document.getElementById('pwa-toast-install')?.addEventListener('click', triggerInstall);
    document.getElementById('pwa-toast-dismiss')?.addEventListener('click', () => {
      document.getElementById('pwa-toast')?.classList.add('hidden');
      sessionStorage.setItem('pwa-toast-dismissed', '1');
    });

    if (!adminGlobalListenersBound) {
      window.addEventListener('appinstalled', () => {
        document.getElementById('pwa-install-btn')?.classList.add('hidden');
        document.getElementById('pwa-toast')?.classList.add('hidden');
      });
      window.addEventListener('online', updateConnectionStatus);
      window.addEventListener('offline', updateConnectionStatus);
      adminGlobalListenersBound = true;
    }
    updateConnectionStatus();

    // ── Notification Badge ───────────────────────────────────────
    // Fetch unread count and show on bell icon
  fetch('/api/admin/notifications/unread-count', { credentials: 'include' })
    .then(r => r.ok ? r.json() : null)
    .then(data => {
      if (data && data.count > 0) {
        const badge = document.getElementById('notif-badge');
        if (badge) {
          badge.textContent = data.count > 9 ? '9+' : data.count;
          badge.classList.remove('hidden');
        }
      }
    })
    .catch(() => {});
    
  // ── Mobile Menu Toggle ───────────────────────────────────────
  const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
  
  document.getElementById('open-mobile-menu')?.addEventListener('click', () => {
    mobileMenuOverlay?.classList.remove('hidden');
    // slight delay for opacity transition
    setTimeout(() => mobileMenuOverlay?.classList.remove('opacity-0'), 10);
    mobileMenuDrawer?.classList.remove('-translate-x-full');
    document.body.style.overflow = 'hidden'; // prevent background scrolling
  });

  document.getElementById('mobile-logo-menu-btn')?.addEventListener('click', () => {
    mobileMenuOverlay?.classList.remove('hidden');
    setTimeout(() => mobileMenuOverlay?.classList.remove('opacity-0'), 10);
    mobileMenuDrawer?.classList.remove('-translate-x-full');
    document.body.style.overflow = 'hidden';
  });

  function closeMobileMenu() {
    mobileMenuDrawer?.classList.add('-translate-x-full');
    mobileMenuOverlay?.classList.add('opacity-0');
    setTimeout(() => mobileMenuOverlay?.classList.add('hidden'), 300);
    document.body.style.overflow = '';
  }

  document.getElementById('close-mobile-menu')?.addEventListener('click', closeMobileMenu);
  mobileMenuOverlay?.addEventListener('click', closeMobileMenu);

  // ── Accordion Nav Logic ───────────────────────────────────────
  document.querySelectorAll('.accordion-nav').forEach(nav => {
    nav.addEventListener('click', (e) => {
      const btn = e.target.closest('.group-btn');
      if (!btn) return;
      
      const group = btn.closest('.nav-group');
      const submenu = group.querySelector('.submenu');
      const chevron = group.querySelector('.chevron');
      
      const isExpanded = submenu.classList.contains('max-h-[1200px]');
      
      // Close all other groups to keep it clean like Shopdeck
      nav.querySelectorAll('.nav-group').forEach(otherGroup => {
        if (otherGroup !== group) {
          otherGroup.querySelector('.submenu')?.classList.remove('max-h-[1200px]', 'opacity-100', 'mt-1');
          otherGroup.querySelector('.submenu')?.classList.add('max-h-0', 'opacity-0');
          otherGroup.querySelector('.chevron')?.classList.remove('rotate-180');
        }
      });

      // Toggle current group
      if (isExpanded) {
        submenu.classList.remove('max-h-[1200px]', 'opacity-100', 'mt-1');
        submenu.classList.add('max-h-0', 'opacity-0');
        chevron.classList.remove('rotate-180');
      } else {
        submenu.classList.remove('max-h-0', 'opacity-0');
        submenu.classList.add('max-h-[1200px]', 'opacity-100', 'mt-1');
        chevron.classList.add('rotate-180');
      }
    });
  });

  // ── Avatar Dropdown Toggle ───────────────────────────────────
  const avatarBtn  = document.getElementById('avatar-dropdown-btn');
  const avatarMenu = document.getElementById('avatar-dropdown-menu');

  avatarBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    avatarMenu?.classList.toggle('hidden');
  });
  document.addEventListener('click', () => avatarMenu?.classList.add('hidden'));

  // ── Change Password Modal ────────────────────────────────────
  const cpModal = document.getElementById('change-password-modal');

  window.openChangePasswordModal = function() {
    avatarMenu?.classList.add('hidden');
    cpModal?.classList.remove('hidden');
    cpModal?.classList.add('flex');
    document.getElementById('cp-error')?.classList.add('hidden');
    document.getElementById('change-password-form')?.reset();
  };
  window.closeChangePasswordModal = function() {
    cpModal?.classList.add('hidden');
    cpModal?.classList.remove('flex');
  };
  document.getElementById('cp-backdrop')?.addEventListener('click', window.closeChangePasswordModal);

  window.handleChangePassword = async function(e) {
    e.preventDefault();
    const current  = document.getElementById('cp-current').value;
    const newPwd   = document.getElementById('cp-new').value;
    const confirm  = document.getElementById('cp-confirm').value;
    const errEl    = document.getElementById('cp-error');
    const submitBtn = document.getElementById('cp-submit-btn');

    errEl.classList.add('hidden');
    if (newPwd !== confirm) {
      errEl.textContent = 'New passwords do not match.';
      errEl.classList.remove('hidden');
      return;
    }
    if (newPwd.length < 6) {
      errEl.textContent = 'Password must be at least 6 characters.';
      errEl.classList.remove('hidden');
      return;
    }

    // Read staff id from meta tag injected by layout
    const staffId = document.querySelector('meta[name="admin-id"]')?.getAttribute('content') || '';
    submitBtn.disabled = true;
    submitBtn.textContent = 'Updating...';

    try {
      const res  = await fetch('/api/admin/staff', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'change_password', id: staffId, current_password: current, new_password: newPwd }),
      });
      const data = await res.json();
      if (data.success) {
        window.closeChangePasswordModal();
        alert('✅ Password changed successfully! Please log in again with your new password.');
      } else {
        errEl.textContent = data.error || 'Failed to update password.';
        errEl.classList.remove('hidden');
      }
    } catch {
      errEl.textContent = 'Network error. Please try again.';
      errEl.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Update Password';
    }
  };

  // ── Recovery Request Modal ────────────────────────────────────
  const rrModal = document.getElementById('recovery-request-modal');

  window.openRecoveryRequestModal = function() {
    avatarMenu?.classList.add('hidden');
    rrModal?.classList.remove('hidden');
    rrModal?.classList.add('flex');
    document.getElementById('rr-message').value = '';
  };
  window.closeRecoveryRequestModal = function() {
    rrModal?.classList.add('hidden');
    rrModal?.classList.remove('flex');
  };
  document.getElementById('rr-backdrop')?.addEventListener('click', window.closeRecoveryRequestModal);

  window.submitRecoveryRequest = async function() {
    const message = document.getElementById('rr-message').value;
    const staffId   = document.querySelector('meta[name="admin-id"]')?.getAttribute('content') || '';
    const staffName = document.querySelector('meta[name="admin-name"]')?.getAttribute('content') || '';
    const staffLevel = parseInt(document.querySelector('meta[name="admin-hierarchy"]')?.getAttribute('content') || '5', 10);
    const recoveryMethod = document.querySelector('meta[name="admin-recovery"]')?.getAttribute('content') || 'contact_super';

    try {
      const res = await fetch('/api/admin/password-recovery', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'request',
          requester_id: staffId,
          requester_name: staffName,
          requester_level: staffLevel,
          recovery_method: recoveryMethod,
          message,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.closeRecoveryRequestModal();
        alert('✅ Recovery request sent! Your admin will reset your password and notify you.');
      } else {
        alert('Error: ' + (data.error || 'Failed to send request.'));
      }
    } catch {
      alert('Network error. Please try again.');
    }
  };

  });
</script>
