<!doctype html>
<html lang="en">
  <head>
    {forceRedirect && <meta http-equiv="refresh" content={`0;url=${forceRedirect}`} />}
    {forceRedirect && <script define:vars={{ forceRedirect }}>window.location.href = forceRedirect;</script>}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={adminFaviconUrl} />
    <title>{title}</title>
    <!-- Universal PWA Link Interceptor -->
    <script>
      document.addEventListener('astro:page-load', () => {
        if (/android/i.test(navigator.userAgent)) {
          document.body.addEventListener('click', (e) => {
            const a = e.target.closest('a');
            if (!a || !a.href) return;
            
            try {
              const url = new URL(a.href);
              if (url.origin === window.location.origin) {
                const isStandalone = window.matchMedia('(display-mode: standalone)').matches || navigator.standalone;
                const isToAdmin = url.pathname.startsWith('/admin');
                const currentIsAdmin = window.location.pathname.startsWith('/admin');
                
                if (isStandalone) {
                  // If in Admin PWA, and crossing boundaries to Storefront
                  if (currentIsAdmin && !isToAdmin) {
                    e.preventDefault();
                    window.open(url.href, '_blank');
                    return;
                  }
                } else {
                  // In Browser: Only force PWA for Storefront links.
                  // Do NOT force PWA for /admin links from the browser, otherwise the Storefront PWA will swallow them!
                  if (!isToAdmin && !currentIsAdmin) {
                    e.preventDefault();
                    const intentUrl = `intent://${url.host}${url.pathname}${url.search}${url.hash}#Intent;scheme=https;S.browser_fallback_url=${encodeURIComponent(a.href)};end`;
                    window.location.href = intentUrl;
                  }
                }
              }
            } catch(err) {}
          });
        }
      });
    </script>

    <!-- Admin identity meta tags (read by JS for API calls) -->
    <meta name="admin-id" content={adminId} />
    <meta name="admin-name" content={adminName} />
    <meta name="admin-hierarchy" content={hierarchyLevel.toString()} />
    <meta name="admin-recovery" content={recoveryMethod} />
    <meta name="tenant-id" content={effectiveStoreId} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

    <!-- Admin PWA -->
    <link rel="manifest" href="/admin-manifest.json" />
    <meta name="theme-color" content="#1a2e1a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={adminBrandTitle} />
    <link rel="apple-touch-icon" sizes="192x192" href={adminFaviconUrl} />
    <link rel="apple-touch-icon" sizes="512x512" href={adminFaviconUrl} />
    <style is:global>
      /* Scale down entire admin UI slightly to show more content */
      html {
        font-size: 14px; /* Base size smaller to fit more options */
      }
      @media (max-width: 768px) {
        /* Scale down everything (text, spacing, sizes) on mobile to fit more content */
        html {
          font-size: 12px; /* Very compact on mobile to prevent cutoffs */
        }
      }
      
      /* Ensure horizontal scrolling for all main content containers */
      .admin-content-wrapper {
        min-width: 0; /* Prevents flex items from overflowing container */
      }
    </style>

    <!-- Cross-Tab Tenant Contamination Interceptors -->
    <script>
      (function() {
        // Read the tenant ID immediately upon page load
        const getTenantId = () => document.querySelector('meta[name="tenant-id"]')?.getAttribute('content') || '';
        
        // 1. Intercept fetch calls to /api/admin/* and /api/super-admin/*
        const originalFetch = window.fetch;
        window.fetch = async function() {
          let [resource, config] = arguments;
          const url = (typeof resource === 'string') ? resource : (resource instanceof Request ? resource.url : '');
          
          if (url && (url.includes('/api/admin/') || url.includes('/api/super-admin/'))) {
            config = config || {};
            config.headers = config.headers || {};
            
            // Standardize headers to an object
            const headersObj = config.headers instanceof Headers 
              ? Object.fromEntries(config.headers.entries()) 
              : config.headers;
              
            headersObj['X-Tenant-Id'] = getTenantId();
            config.headers = headersObj;
          }
          
          const res = await originalFetch(resource, config);
          
          // Fast-fail UX: If the backend detected a tenant mismatch (409 Conflict)
          if (res.status === 409) {
             const data = await res.clone().json().catch(() => ({}));
             if (data.error && data.error.includes('Tenant mismatch')) {
                alert("Security Alert: " + data.error);
                window.location.reload(); // Force refresh to correct the state
             }
          }
          return res;
        };

        // 2. Intercept standard HTML <form method="POST"> submissions
        document.addEventListener('submit', function(e) {
          const form = e.target as HTMLFormElement;
          const actionUrl = form.getAttribute('action') || '';
          const method = form.getAttribute('method')?.toUpperCase() || 'GET';
          
          if (method === 'POST' && (actionUrl.includes('/api/admin/') || actionUrl.includes('/api/super-admin/'))) {
            // Append _tenant_id as a query parameter for standard form POSTs
            const tenantId = getTenantId();
            if (tenantId && !actionUrl.includes('_tenant_id=')) {
              const separator = actionUrl.includes('?') ? '&' : '?';
              form.setAttribute('action', actionUrl + separator + '_tenant_id=' + encodeURIComponent(tenantId));
            }
          }
        }, true);
      })();
    </script>
    <ClientRouter />
  </head>

  <body class="bg-gray-50 text-secondary antialiased font-sans">
    <LogoLoader logoUrl={adminLogoUrl} />

    {isLoginPage ? (
      <slot />
    ) : (
      <div class="flex h-[100dvh] overflow-hidden">

        <!-- Sidebar -->
        <aside class="w-64 md:w-56 lg:w-64 bg-white border-r border-gray-200 flex-shrink-0 hidden md:flex flex-col relative z-50" id="admin-sidebar">
          <!-- Logo -->
          <div class="h-16 flex items-center px-5 border-b border-gray-100 gap-3">
            {adminLogoUrl ? (
              <img src={adminLogoUrl} alt={adminBrandTitle} class="w-8 h-8 rounded-lg object-contain bg-white" />
            ) : (
              <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-lg">
                {adminBrandTitle.charAt(0).toUpperCase()}
              </div>
            )}
            <div>
              <span class="text-base font-serif font-bold text-primary leading-tight block">{adminBrandTitle}</span>
              <span class="text-[10px] font-bold text-white bg-primary px-1.5 py-0.5 rounded uppercase tracking-wider">Admin</span>
            </div>
          </div>

          <!-- Nav -->
          <nav class="flex-1 min-h-0 overflow-y-auto py-4 px-3 space-y-1 accordion-nav">
            {navGroups.map((group) => {
              // Group without items is a standalone link
              if (group.path) {
                const isActive = currentPath === group.path || (group.path !== '/admin' && currentPath.startsWith(group.path));
                if (!canSeeNav(group.path)) return null;
                return (
                  <a
                    href={group.path}
                    class:list={[
                      "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors",
                      isActive ? "bg-primary/10 text-primary" : "text-secondary/70 hover:bg-gray-50 hover:text-secondary"
                    ]}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 flex-shrink-0" style="width:18px;height:18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d={group.icon} />
                    </svg>
                    {group.label}
                  </a>
                );
              }

              // Accordion group
              const visibleItems = group.items.filter(item => item.isNew || canSeeNav(item.path));
              if (visibleItems.length === 0) return null;
              
              const isActiveGroup = visibleItems.some(item => !item.isNew && (currentPath === item.path || currentPath.startsWith(item.path)));
              
              return (
