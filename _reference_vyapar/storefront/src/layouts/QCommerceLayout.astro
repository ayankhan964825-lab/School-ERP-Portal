---
import { SEO } from 'astro-seo';
import { getSettings } from '../lib/database';
import { optimizeImage } from '../lib/image-utils';
import '../styles/global.css';
import CartDrawer from '../components/react/CartDrawer';
import SearchModal from '../components/react/SearchModal';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  settings?: any;
  categories?: any[];
}

const {
  title,
  description = '',
  ogImage = '/og-image.jpg',
  settings: propsSettings,
  categories = [],
} = Astro.props;

const forceStoreId = Astro.locals.storeId;
const settings = propsSettings || await getSettings(forceStoreId);

const storeName = settings?.brand_name || settings?.store_name || 'Store';
const logoUrl = settings?.logo_url || '';
const rawFavicon = settings?.favicon_url || settings?.brand_favicon || settings?.logo_url || settings?.brand_logo || null;
const dynamicFaviconUrl = rawFavicon ? optimizeImage(rawFavicon, { width: 96, height: 96, quality: 100, format: 'png', resize: 'contain' }) : null;
const primaryColor = '#0c831f'; // Hardcoded Blinkit Green

let themePreset = 'warpdeal';
let customColors: Record<string, string> | null = null;
try {
  if (settings?.website_theme) {
    const parsed = typeof settings.website_theme === 'string' ? JSON.parse(settings.website_theme) : settings.website_theme;
    themePreset = parsed.active_preset || 'warpdeal';
    if (parsed.custom_colors && typeof parsed.custom_colors === 'object') {
      customColors = parsed.custom_colors;
    }
  }
} catch (e) {}

const themeMaps: Record<string, Record<string, string>> = {
  warpdeal: { primary: '#010101', 'primary-light': '#1C1C1C', secondary: '#010101', accent: '#EDCF5D', 'accent-warm': '#D4B040', 'section-bg': '#EDCF5D', 'section-text': '#010101', 'section-btn-bg': '#010101', 'section-btn-text': '#EDCF5D', text: '#010101', 'text-muted': '#A4A4A4', background: '#F2F0EA', 'background-alt': '#EDE9E0', surface: '#FFFFFF', border: '#E0DDD5', overlay: '#010101' },
  original: { primary: '#234B34', 'primary-light': '#4F8A43', secondary: '#1E5B63', accent: '#C9A15B', 'accent-warm': '#D97A1E', 'section-bg': '#234B34', 'section-text': '#FAF8F2', 'section-btn-bg': '#FAF8F2', 'section-btn-text': '#234B34', text: '#234B34', 'text-muted': '#1E5B63', background: '#F6F2E8', 'background-alt': '#E8D4B0', surface: '#FAF8F2', border: '#E8D4B0', overlay: '#234B34' },
  quiet_luxury: { primary: '#18181B', 'primary-light': '#3F3F46', secondary: '#52525B', accent: '#B68A45', 'accent-warm': '#D4A85C', text: '#18181B', 'text-muted': '#71717A', background: '#FAF8F3', 'background-alt': '#EEE9DF', surface: '#FFFFFF', border: '#DDD7CC', overlay: '#18181B' },
  nordic_earth: { primary: '#4B5D43', 'primary-light': '#708267', secondary: '#7A6A58', accent: '#C96E47', 'accent-warm': '#D98662', text: '#243022', 'text-muted': '#6C7766', background: '#F7F4ED', 'background-alt': '#EAE4D8', surface: '#FEFCF8', border: '#D9D0C2', overlay: '#344030' },
  clubroom: { primary: '#D4AF37', 'primary-light': '#F0C75E', secondary: '#E5E5E5', accent: '#D4AF37', 'accent-warm': '#F0C75E', text: '#FAFAFA', 'text-muted': '#A3A3A3', background: '#090909', 'background-alt': '#141414', surface: '#1E1E1E', border: '#2F2F2F', overlay: '#000000' },
  apothecary: { primary: '#1E3A5F', 'primary-light': '#335A87', secondary: '#56718D', accent: '#4F8A43', 'accent-warm': '#6AA85D', text: '#102033', 'text-muted': '#64748B', background: '#F8FAFC', 'background-alt': '#EDF3F7', surface: '#FFFFFF', border: '#DDE6EF', overlay: '#1E3A5F' },
  terracotta: { primary: '#7A322C', 'primary-light': '#A34A42', secondary: '#B35A4E', accent: '#E28A26', 'accent-warm': '#F0A243', text: '#2A1512', 'text-muted': '#6F433E', background: '#FFF8F1', 'background-alt': '#F4E9DB', surface: '#FFFFFF', border: '#E7DCC9', overlay: '#7A322C' },
  oceanic: { primary: '#0C4A5A', 'primary-light': '#1E7188', secondary: '#2D8AA3', accent: '#F0A83A', 'accent-warm': '#FFC15A', text: '#082A32', 'text-muted': '#476972', background: '#F4F8F8', 'background-alt': '#E7F0F0', surface: '#FFFFFF', border: '#D6E4E4', overlay: '#0C4A5A' },
  blush: { primary: '#5A2740', 'primary-light': '#7D3D59', secondary: '#A65A77', accent: '#C89B52', 'accent-warm': '#DDB36C', text: '#2A1320', 'text-muted': '#76505E', background: '#FCF7F3', 'background-alt': '#F2E6DF', surface: '#FFFFFF', border: '#E5D8D0', overlay: '#5A2740' },
};

function hexToHSL(hex: string): [number, number, number] {
  const r = parseInt(hex.slice(1,3),16)/255; const g = parseInt(hex.slice(3,5),16)/255; const b = parseInt(hex.slice(5,7),16)/255;
  const max = Math.max(r,g,b), min = Math.min(r,g,b); let h = 0, s = 0; const l = (max+min)/2;
  if (max !== min) {
    const d = max - min; s = l > 0.5 ? d/(2-max-min) : d/(max+min);
    if (max === r) h = ((g-b)/d + (g < b ? 6 : 0)) * 60; else if (max === g) h = ((b-r)/d + 2) * 60; else h = ((r-g)/d + 4) * 60;
  }
  return [Math.round(h), Math.round(s*100), Math.round(l*100)];
}
function hslToHex(h: number, s: number, l: number): string {
  s /= 100; l /= 100; const a = s * Math.min(l, 1-l);
  const f = (n: number) => { const k = (n + h/30) % 12; const color = l - a * Math.max(Math.min(k-3, 9-k, 1), -1); return Math.round(255 * color).toString(16).padStart(2, '0'); };
  return `#${f(0)}${f(8)}${f(4)}`;
}
function deriveFullPalette(seed: Record<string, string>): Record<string, string> {
  const [ph, ps, pl] = hexToHSL(seed.primary || '#1B4332'); const [ah, as, al] = hexToHSL(seed.accent || '#D4A373'); const [bh, bs, bl] = hexToHSL(seed.background || '#FDFBF7');
  return {
    primary: seed.primary || '#1B4332', 'primary-light': hslToHex(ph, Math.max(ps - 5, 0), Math.min(pl + 15, 85)), secondary: hslToHex(ph, Math.max(ps - 20, 5), Math.min(pl + 10, 70)),
    accent: seed.accent || '#D4A373', 'accent-warm': hslToHex((ah + 15) % 360, Math.min(as + 10, 100), al), text: seed.text || '#1A1A2E', 'text-muted': hslToHex(0, 0, 45),
    background: seed.background || '#FDFBF7', 'background-alt': hslToHex(bh, bs, Math.max(bl - 5, 5)), surface: seed.surface || '#FFFFFF', border: hslToHex(bh, bs, Math.max(bl - 8, 10)), overlay: seed.primary || '#1B4332',
  };
}

let activeColors: Record<string, string>;
if (themePreset === 'custom' && customColors) {
  activeColors = deriveFullPalette(customColors);
} else {
  activeColors = { ...(themeMaps[themePreset] || themeMaps.warpdeal) };
}
const canonicalURL = new URL(Astro.url.pathname, Astro.url.origin);
// Resolve OG image dynamically per-store: page prop → DB setting → store logo → static fallback
const resolvedOgImage = ogImage !== '/og-image.jpg' ? ogImage : (settings?.og_image || settings?.brand_logo || settings?.logo_url || '/og-image.jpg');
const absoluteOgImage = new URL(resolvedOgImage, Astro.url.origin).toString();

const rawEta = settings?.delivery_time || '10';
const deliveryEta = rawEta.toString().replace(/mins?|minutes?/ig, '').trim();

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '/qcommerce-home';
const isCategories = currentPath.includes('/products');
const isProfile = currentPath.includes('/account') || currentPath.includes('/profile');
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  {settings?.meta_pixel_id && (
    <>
      <script is:inline define:vars={{ pixelId: settings.meta_pixel_id }}>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        document.addEventListener('astro:page-load', () => {
          fbq('track', 'PageView');
        });
      </script>
      <noscript><img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${settings.meta_pixel_id}&ev=PageView&noscript=1`} /></noscript>
    </>
  )}
  <meta charset="UTF-8" />
  {Astro.url.hostname.includes('treasureflavours') && (
    <meta name="google-site-verification" content="TfWbeBghbtNSrC0rCUPxlTduVqdBbu7rVLONOOsgSZE" />
  )}
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  {dynamicFaviconUrl && <link rel="icon" href={dynamicFaviconUrl} />}
  {dynamicFaviconUrl && <link rel="apple-touch-icon" href={dynamicFaviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <SEO
    title={title}
    description={description}
    canonical={canonicalURL.href}
    openGraph={{ basic: { title, type: 'website', image: absoluteOgImage } }}
  />
  <style is:inline define:vars={{
    'theme-primary': activeColors.primary,
    'theme-primary-light': activeColors['primary-light'],
    'theme-secondary': activeColors.secondary,
    'theme-accent': activeColors.accent,
    'theme-accent-warm': activeColors['accent-warm'],
    'theme-text': activeColors.text,
    'theme-text-muted': activeColors['text-muted'],
    'theme-background': activeColors.background,
    'theme-background-alt': activeColors['background-alt'],
    'theme-surface': activeColors.surface,
    'theme-border': activeColors.border,
    'theme-overlay': activeColors.overlay,
  }}>
    :root {
      /* QCommerce specific tokens now map to global activeColors */
      --qc-primary: var(--theme-primary);
      --qc-bg: var(--theme-background-alt);
      --qc-surface: var(--theme-surface);
      --qc-border: var(--theme-border);
      --qc-text: var(--theme-text);
      --qc-muted: var(--theme-text-muted);
      --qc-sidebar-bg: var(--theme-background-alt);
      --qc-sidebar-active-bar: var(--theme-primary);
      --qc-bottom-nav-h: 60px;
      
      --theme-primary: var(--theme-primary);
      --theme-primary-light: var(--theme-primary-light);
      --theme-secondary: var(--theme-secondary);
      --theme-accent: var(--theme-accent);
      --theme-accent-warm: var(--theme-accent-warm);
      --theme-text: var(--theme-text);
      --theme-text-muted: var(--theme-text-muted);
      --theme-background: var(--theme-background);
      --theme-background-alt: var(--theme-background-alt);
      --theme-surface: var(--theme-surface);
      --theme-border: var(--theme-border);
      --theme-overlay: var(--theme-overlay);
      --radius: 0.75rem;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: var(--qc-bg); color: var(--qc-text); }
    .qc-add-btn {
      border: 1.5px solid var(--qc-primary);
      color: var(--qc-primary);
      background: #fff;
      font-weight: 700;
      font-size: 13px;
      border-radius: 8px;
      padding: 5px 14px;
      cursor: pointer;
      transition: all 0.15s ease;
      letter-spacing: 0.3px;
    }
    .qc-add-btn:hover { background: var(--qc-primary); color: #fff; }
    
    .qc-header-bg {
      background: linear-gradient(180deg, #fdf8c9 0%, #edf6cd 100%);
    }
  </style>
</head>
<body>

  <!-- TOP NAVBAR -->
  <header id="qc-topbar" class="qc-header-bg">
    
    <!-- MOBILE: Top Block (ETA + Icons + Location) - Blinkit Style -->
    <div id="qc-mobile-top-block" class="max-w-screen-xl mx-auto px-4 pt-10 pb-3 sm:hidden relative z-10 transition-all duration-300 origin-top overflow-hidden">
      <!-- Row 1: ETA + Right Icons -->
      <div class="flex items-start justify-between">
        <!-- Left: ETA -->
        <div class="flex flex-col">
          <span class="text-[11px] font-bold text-slate-700 leading-none tracking-wide">{storeName} in</span>
          <div class="flex items-center gap-3 mt-1">
            <span class="text-[34px] font-black text-slate-900 leading-none tracking-tighter" id="qc-dynamic-eta-mobile" style="letter-spacing: -1px;">{deliveryEta} minutes</span>
            <!-- Surge Badge -->
            <span class="inline-flex items-center gap-1 bg-[#dff3e5] text-[#127d33] text-[10px] font-bold px-2 py-1 rounded w-fit">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
              Surge applicable
            </span>
          </div>
        </div>
        <!-- Right: Wallet + Profile -->
        <div class="flex items-center gap-2 mt-1">
          <!-- Wallet Icon -->
          <div class="w-11 h-11 rounded-full bg-white shadow-sm flex flex-col items-center justify-center cursor-pointer relative border border-slate-100">
            <svg class="w-6 h-6 text-[#b69418]" viewBox="0 0 24 24" fill="currentColor"><path d="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-2c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm6 16H6V8h2v2c0 .55.45 1 1 1s1-.45 1-1V8h4v2c0 .55.45 1 1 1s1-.45 1-1V8h2v12z"/></svg>
            <div class="absolute -bottom-1.5 bg-white border border-slate-100 shadow-sm rounded-full px-1.5 py-0.5 min-w-[28px] text-center">
              <span class="text-[9px] font-black text-slate-800 leading-none tracking-tight block">₹0</span>
            </div>
          </div>
          <!-- Profile Icon -->
          <a href="/account" class="w-11 h-11 bg-white shadow-sm rounded-full flex items-center justify-center border border-slate-100">
            <svg class="w-6 h-6 text-slate-800" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          </a>
        </div>
      </div>
      <!-- Row 2: Location -->
      <div class="flex items-center gap-1 mt-2 cursor-pointer" id="qc-location-btn-mobile">
        <span class="text-[14px] text-slate-900 flex items-center gap-0.5 truncate max-w-[300px]" id="qc-address-preview-mobile">
          <strong class="font-extrabold tracking-tight">HOME</strong>&nbsp;-&nbsp;<span class="text-[13px] font-medium text-slate-700 tracking-tight">Select location...</span>
          <svg class="w-4 h-4 text-slate-700 ml-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>
        </span>
      </div>
    </div>
      
    <!-- DESKTOP: Single Row - Sticky -->
    <div class="hidden sm:flex items-center gap-4 max-w-screen-xl mx-auto px-3 py-2.5 sticky top-0 z-50 bg-[--qc-surface] border-b border-[--qc-border]">
        <!-- Logo -->
        <a href="/" class="flex-shrink-0">
          {logoUrl ? (
            <img src={logoUrl} alt={storeName} class="h-8 w-auto object-contain" />
          ) : (
            <span class="font-extrabold text-xl text-[--qc-text] tracking-tight">{storeName}</span>
          )}
        </a>

        <!-- Location Pin -->
        <div class="flex items-center gap-2 cursor-pointer border-r border-[--qc-border] pr-4 flex-shrink-0" id="qc-location-btn">
          <div class="flex flex-col">
            <p class="font-extrabold text-[--qc-text] text-sm" id="qc-pincode-label-desktop">Delivery in <span id="qc-dynamic-eta-desktop">19</span> minutes</p>
            <p class="text-[11px] text-[--qc-muted]" id="qc-delivery-eta-desktop">Select your location</p>
          </div>
          <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
        </div>

        <!-- Search Bar (Desktop) -->
        <div class="flex-1">
          <button class="qc-search-trigger w-full flex items-center gap-2 bg-[#f4f6f9] border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-[--qc-muted] hover:bg-slate-100 transition-all text-left">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <span class="flex-1 truncate tracking-tight font-medium text-slate-500">Search in Minutes</span>
          </button>
        </div>

        <div class="flex items-center gap-3 flex-shrink-0">
          <a href="/account" class="text-sm font-medium text-[--qc-text] hover:text-[--qc-primary] transition-colors">Login</a>
          <button onclick="window.dispatchEvent(new CustomEvent('vyaparpe:open-cart'))" class="flex items-center gap-2 bg-[--qc-primary] text-white text-sm font-bold px-4 py-2.5 rounded-xl">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            My Cart
            <span id="qc-desktop-cart-count" class="hidden bg-white text-[--qc-primary] px-1.5 py-0.5 rounded-full text-[10px] ml-0.5">0</span>
          </button>
        </div>
      </div>

    </div>
  </header>

  <!-- MOBILE ONLY: Search Bar - Sticky (Blinkit Style) -->
  <div class="sm:hidden sticky top-0 z-50 px-3 pb-3 pt-2 transition-all duration-200 qc-header-bg" id="qc-mobile-search-sticky">
    <button class="qc-search-trigger w-full flex items-center bg-white rounded-2xl px-3 py-3.5 border-0 shadow-[0_4px_12px_rgba(0,0,0,0.05)] text-left">
      <svg class="w-6 h-6 text-slate-700 mr-2 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <span class="flex-1 truncate text-[16px] font-medium text-slate-500 tracking-tight">Search "birthday gift"</span>
      <div class="w-px h-6 bg-slate-200 mx-2 flex-shrink-0"></div>
      <svg class="w-6 h-6 text-slate-700 ml-1 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z"/></svg>
    </button>
  </div>

  <!-- MAIN CONTENT SLOT -->
  <main id="qc-main" class="pb-[120px] sm:pb-8">
    <slot />
  </main>

  <!-- BOTTOM NAV (Mobile Only) -->
  <nav id="qc-bottom-nav" class="sm:hidden fixed bottom-4 left-4 right-4 z-50 bg-white/95 backdrop-blur-md rounded-2xl shadow-[0_8px_30px_rgba(0,0,0,0.12)] border border-white flex items-center justify-between px-2 py-2 h-[64px]">
    <a href="/" class={`flex flex-col items-center justify-center gap-1 flex-1 py-1 ${isHome ? 'bg-[#e8f3ea] rounded-xl' : ''}`}>
      {isHome ? (
        <svg class="w-6 h-6 text-[#0c831f]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
      ) : (
        <svg class="w-6 h-6 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
      )}
      <span class={`text-[10px] ${isHome ? 'font-bold text-[#0c831f]' : 'font-medium text-slate-400'}`}>Home</span>
    </a>
    
    <a href="/products?category=all" class="flex flex-col items-center justify-center gap-1 flex-1 py-1">
      {isCategories ? (
        <svg class="w-6 h-6 text-slate-800" fill="currentColor" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg>
      ) : (
        <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg>
      )}
      <span class={`text-[10px] ${isCategories ? 'font-bold text-slate-800' : 'font-medium text-slate-400'}`}>Categories</span>
    </a>

    <a href="/account/orders" class="flex flex-col items-center justify-center gap-1 flex-1 py-1">
