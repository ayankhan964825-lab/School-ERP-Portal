    <button onclick="window.dispatchEvent(new CustomEvent('vyaparpe:open-cart'))" class="flex items-center justify-between gap-6 bg-primary/95 backdrop-blur-md text-surface p-1.5 pr-4 rounded-full font-semibold border border-primary/20" style="min-width: 240px;">
      <div class="flex items-center gap-3">
