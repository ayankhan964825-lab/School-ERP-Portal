  <!-- REACT ISLANDS: Cart Drawer + Search Modal -->
  <div id="cart-drawer-root">
    <CartDrawer client:load />
  </div>
  <SearchModal client:load />

  <SpeedInsights />

    <script>
    import { cartItems, isCartOpen, addCartItem, updateCartItemQuantity } from '../store/cartStore';
    
    // Expose to window so inline scripts (like the bottom sheet) can read the cart state
    if (typeof window !== 'undefined') {
       (window as any).cartItems = cartItems;
    }

    // Bridge: ProductCard vanilla JS -> Nano Store
    window.addEventListener('vyaparpe:add-to-cart', (e) => {
      const item = (e as CustomEvent).detail;
      if (item && item.id && item.name) {
        addCartItem(item);
      }
    });

    window.addEventListener('vyaparpe:update-cart-qty', (e) => {
      const detail = (e as CustomEvent).detail;
      if (detail && detail.id !== undefined && detail.quantity !== undefined) {
        updateCartItemQuantity(detail.id, detail.quantity);
      }
    });

    window.addEventListener('vyaparpe:open-cart', () => {
      isCartOpen.set(true);
    });

    // Global Click Delegator for Add to Cart Buttons
    if (typeof document !== 'undefined') {
      document.addEventListener('click', (e) => {
         const target = e.target;
         const addBtn = target.closest('.qc-btn-add');
         if (addBtn) {
            const card = addBtn.closest('.qc-card');
            if (!card) return;
            
            const priceStr = card.querySelector('.text-xs.font-bold')?.textContent?.replace('₹','') || '0';
            const mrpStr = card.querySelector('.line-through')?.textContent?.replace('₹','') || priceStr;
            const weightStr = card.querySelector('.text-\\[10px\\].font-medium.text-slate-500')?.textContent || '';
            const imgEl = card.querySelector('img');
            
            const vId = addBtn.dataset.variantId;
            const compositeId = vId && vId !== 'undefined' ? card.dataset.productId + '-' + vId : card.dataset.productId;
            
            const item = {
               id: compositeId,
               product_id: card.dataset.productId,
               name: card.querySelector('h3')?.textContent || '',
               price: parseFloat(priceStr),
               mrp: parseFloat(mrpStr),
               weight: weightStr,
               image: imgEl ? imgEl.src : '',
               quantity: 1
            };
            window.dispatchEvent(new CustomEvent('vyaparpe:add-to-cart', { detail: item }));
         }
         
         const minusBtn = target.closest('.qc-btn-minus');
         if (minusBtn) {
            const card = minusBtn.closest('.qc-card');
            const addBtn = card?.querySelector('.qc-btn-add');
            if (!card || !addBtn) return;
            const vId = addBtn.dataset.variantId;
            const cartItemId = vId && vId !== 'undefined' ? card.dataset.productId + '-' + vId : card.dataset.productId;
            const currentQty = parseInt(card.querySelector('.qc-qty-text')?.textContent || '1');
            window.dispatchEvent(new CustomEvent('vyaparpe:update-cart-qty', { detail: { id: cartItemId, quantity: currentQty - 1 } }));
         }

         const plusBtn = target.closest('.qc-btn-plus');
         if (plusBtn) {
            const card = plusBtn.closest('.qc-card');
            const addBtn = card?.querySelector('.qc-btn-add');
            if (!card || !addBtn) return;
            const vId = addBtn.dataset.variantId;
            const cartItemId = vId && vId !== 'undefined' ? card.dataset.productId + '-' + vId : card.dataset.productId;
            const currentQty = parseInt(card.querySelector('.qc-qty-text')?.textContent || '1');
            window.dispatchEvent(new CustomEvent('vyaparpe:update-cart-qty', { detail: { id: cartItemId, quantity: currentQty + 1 } }));
         }
         
         const optionsBtn = target.closest('.qc-btn-options');
         if (optionsBtn) {
            const card = optionsBtn.closest('.qc-card');
            if (!card) return;
            const variantsData = JSON.parse(optionsBtn.dataset.variants || '[]');
            const productName = card.querySelector('h3')?.textContent || 'Product';
            if (window.openVariantSheet) {
               window.openVariantSheet(card.dataset.productId, productName, variantsData);
            }
         }
      });
    }

    // Update UI based on Nano Store state
    cartItems.subscribe((cart) => {
      const count = cart.reduce((s, i) => s + (i.quantity || 1), 0);
      const total = cart.reduce((s, i) => s + ((i.price || 0) * (i.quantity || 1)), 0);

      // --- 1. Update Product Cards UI (- 1 + Pills) ---
      document.querySelectorAll('.qc-card').forEach(card => {
        const addBtn = card.querySelector('.qc-btn-add');
        const qtyPill = card.querySelector('.qc-btn-qty');
        const optionsBtn = card.querySelector('.qc-btn-options');
        if (!qtyPill) return;
        
        const productId = card.dataset.productId;
        const variantId = addBtn ? addBtn.dataset.variantId : null;
        
        let qty = 0;
        if (optionsBtn) {
           qty = cart.filter(i => i.product_id === productId).reduce((s, i) => s + (i.quantity || 1), 0);
        } else if (variantId) {
           const cartItemId = variantId && variantId !== 'undefined' ? productId + '-' + variantId : productId;
           const inCart = cart.find(i => i.id === cartItemId);
           qty = inCart ? inCart.quantity : 0;
        }
        
        if (qty > 0) {
          if (addBtn) addBtn.classList.add('hidden');
          if (optionsBtn) optionsBtn.classList.add('hidden');
          qtyPill.classList.remove('hidden');
          const txt = qtyPill.querySelector('.qc-qty-text');
          if (txt) {
             if (optionsBtn) {
                txt.textContent = qty.toString() + ' In Cart';
                txt.style.width = '100%';
                txt.style.fontSize = '10px';
                qtyPill.querySelector('.qc-btn-minus')?.classList.add('hidden');
                qtyPill.querySelector('.qc-btn-plus')?.classList.add('hidden');
             } else {
                txt.textContent = qty.toString();
                txt.style.width = '';
                txt.style.fontSize = '';
                qtyPill.querySelector('.qc-btn-minus')?.classList.remove('hidden');
                qtyPill.querySelector('.qc-btn-plus')?.classList.remove('hidden');
             }
          }
        } else {
          if (addBtn) addBtn.classList.remove('hidden');
          if (optionsBtn) optionsBtn.classList.remove('hidden');
          qtyPill.classList.add('hidden');
        }
      });
      // ------------------------------------------------

      // --- 2. Update Variant Sheet if open ---
      if (window.renderVariantSheetList) {
         window.renderVariantSheetList();
      }
      // ------------------------------------------------

      const qcCount = document.getElementById('qc-cart-count');
      if (qcCount) { 
        qcCount.textContent = count.toString(); 
      }
      const strip = document.getElementById('qc-cart-strip');
      const promoStrip = document.getElementById('qc-promo-strip');
      const countEl = document.getElementById('qc-strip-count');
      const desktopCountEl = document.getElementById('qc-desktop-cart-count');

      if (count > 0) {
        if (strip) strip.classList.remove('hidden');
        if (promoStrip) promoStrip.classList.add('hidden');
        if (desktopCountEl) {
          desktopCountEl.classList.remove('hidden');
          desktopCountEl.textContent = count.toString();
        }
        
        if (countEl) countEl.textContent = `${count} item${count > 1 ? 's' : ''}`;
        
        // Update avatars
        const avatarsEl = document.getElementById('qc-strip-avatars');
        if (avatarsEl) {
           const maxAvatars = 3;
           const displayItems = cart.slice(0, maxAvatars);
           let html = '';
           displayItems.forEach((item, idx) => {
              const imgSrc = item.image || item.images?.[0] || '/placeholder.webp';
              html += `<div class="w-9 h-9 rounded-full bg-white border-2 border-white overflow-hidden relative z-[${10 - idx}] flex-shrink-0 flex items-center justify-center shadow-sm"><img src="${imgSrc}" class="w-full h-full object-cover" /></div>`;
           });
           if (cart.length > maxAvatars) {
              html += `<div class="w-9 h-9 rounded-full bg-green-800 border-2 border-white flex items-center justify-center text-xs font-bold text-white relative z-[${10 - maxAvatars}] shadow-sm">+${cart.length - maxAvatars}</div>`;
           }
           avatarsEl.innerHTML = html;
        }
      } else {
        if (strip) strip.classList.add('hidden');
        if (promoStrip) promoStrip.classList.remove('hidden');
        if (desktopCountEl) desktopCountEl.classList.add('hidden');
      }
    });
  </script>

  <script is:inline>
    // Location and Dynamic ETA based on location/fulfillment
    const pincode = localStorage.getItem('delivery_pincode') || document.cookie.match(/delivery_pincode=([^;]+)/)?.[1];
    
    let dynamicEta = 14; // Default fallback ETA
    if (pincode) {
      // Simulate dynamic ETA calculation based on fulfillment node distance
      const sum = pincode.split('').reduce((a, b) => a + parseInt(b), 0);
      dynamicEta = 8 + (sum % 12); // Dynamic ETA between 8 and 19 mins
      
      const elMob = document.getElementById('qc-address-preview-mobile');
      const elDesk = document.getElementById('qc-delivery-eta-desktop');
      if (elMob) {
         elMob.innerHTML = '<strong class="font-extrabold tracking-tight">HOME</strong>&nbsp;-&nbsp;<span class="text-[13px] font-medium text-slate-700 tracking-tight">' + pincode + '</span> <svg class="w-4 h-4 text-slate-700 ml-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>';
      }
      if (elDesk) elDesk.textContent = pincode;
    }
    
    const etaMob = document.getElementById('qc-dynamic-eta-mobile');
    const etaDesk = document.getElementById('qc-dynamic-eta-desktop');
    if (etaMob) etaMob.textContent = dynamicEta.toString() + ' minutes';
    if (etaDesk) etaDesk.textContent = dynamicEta.toString();

    // Search trigger → open search modal
    document.querySelectorAll('.qc-search-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-search'));
      });
    });

    // Auto-open cart if URL param is present
    if (new URLSearchParams(window.location.search).get('open_cart') === 'true') {
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('vyaparpe:open-cart'));
        // Clean up URL
        window.history.replaceState({}, document.title, window.location.pathname);
      }, 300);
    }

    // --- Variant Bottom Sheet Logic ---
    window.currentVariantSheetContext = null;

    window.closeVariantSheet = () => {
      const sheet = document.getElementById('qc-variant-sheet');
      const panel = document.getElementById('qc-variant-panel');
      const backdrop = document.getElementById('qc-variant-backdrop');
      if (!sheet) return;
      panel.classList.add('translate-y-full');
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      setTimeout(() => {
         sheet.classList.add('hidden');
         window.currentVariantSheetContext = null;
      }, 300);
    };

    window.renderVariantSheetList = () => {
       const ctx = window.currentVariantSheetContext;
       const list = document.getElementById('qc-variant-list');
       if (!ctx || !list) return;
       const cart = window.cartItems ? window.cartItems.get() : [];
       
       list.innerHTML = ctx.variants.map(v => {
         const isOut = v.out_of_stock;
         const cartItemId = ctx.productId + '-' + v.id;
         const cartItem = cart.find(i => i.id === cartItemId);
         const qty = cartItem ? cartItem.quantity : 0;

         let actionHtml = '';
         if (isOut) {
            actionHtml = '<span class="text-xs font-bold text-slate-400 bg-slate-100 px-2 py-1 rounded">Out of Stock</span>';
         } else if (qty > 0) {
            actionHtml = `
              <div class="flex items-center bg-surface border border-primary text-primary rounded-lg h-8 overflow-hidden shadow-sm active:scale-95 transition-transform min-w-[72px]">
                <button class="flex-1 h-full flex items-center justify-center font-bold text-lg hover:bg-rose-50 transition-colors" onclick="window.updateVariantQty('${cartItemId}', ${qty - 1})">−</button>
                <span class="text-[12px] font-bold text-slate-900 text-center px-1">${qty}</span>
                <button class="flex-1 h-full flex items-center justify-center font-bold text-lg hover:bg-rose-50 transition-colors" onclick="window.updateVariantQty('${cartItemId}', ${qty + 1})">+</button>
              </div>
            `;
         } else {
            actionHtml = `<button class="bg-primary/5 text-primary border border-primary font-bold text-[13px] px-6 py-2 rounded-lg shadow-sm hover:bg-primary/10 active:scale-95 transition-all" onclick="window.addVariantToCart('${ctx.productId}', '${v.id}', ${v.price}, ${v.mrp || v.price}, '${v.weight}', '${(v.image||'').replace(/'/g, "\\'")}', '${ctx.productName.replace(/'/g, "\\'")}')">ADD</button>`;
         }

         return `
           <div class="flex items-center justify-between p-3 border border-slate-200 rounded-xl mb-3 ${isOut ? 'opacity-50' : 'bg-white hover:border-pink-200 transition-colors'}">
             <div class="flex items-center gap-3">
               <div class="w-14 h-14 rounded-lg bg-slate-50 border border-slate-100 flex items-center justify-center overflow-hidden flex-shrink-0">
                 <img src="${v.image}" class="w-[90%] h-[90%] object-contain mix-blend-multiply" />
               </div>
               <div class="flex flex-col">
                 <span class="text-sm font-bold text-slate-800">${v.weight || '1 pc'}</span>
                 <div class="flex items-center gap-1.5 mt-0.5">
                   <span class="text-sm font-bold text-slate-800">₹${v.price}</span>
                   ${v.mrp > v.price ? `<span class="text-[10px] text-slate-400 line-through">₹${v.mrp}</span>` : ''}
                 </div>
               </div>
             </div>
             <div>
               ${actionHtml}
             </div>
           </div>
         `;
       }).join('');
    };

    window.openVariantSheet = (productId, productName, variants) => {
      const sheet = document.getElementById('qc-variant-sheet');
      const panel = document.getElementById('qc-variant-panel');
      const backdrop = document.getElementById('qc-variant-backdrop');
      
      window.currentVariantSheetContext = { productId, productName, variants };
      window.renderVariantSheetList();

      sheet.classList.remove('hidden');
      setTimeout(() => {
        panel.classList.remove('translate-y-full');
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
      }, 10);
    };

    window.updateVariantQty = (cartItemId, newQty) => {
       window.dispatchEvent(new CustomEvent('vyaparpe:update-cart-qty', { detail: { id: cartItemId, quantity: newQty } }));
    };

    window.addVariantToCart = (productId, variantId, price, mrp, weight, image, name) => {
       const cartItemId = productId + '-' + variantId;
       window.dispatchEvent(new CustomEvent('vyaparpe:add-to-cart', { 
         detail: { id: cartItemId, product_id: productId, variant_id: variantId, name, price, mrp, image, weight, quantity: 1 } 
       }));
       // We intentionally do NOT close the sheet anymore, so the user can see the + - controls!
    };
  </script>

  <!-- Variant Selection Bottom Sheet -->
  <div id="qc-variant-sheet" class="fixed inset-0 z-[100] hidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/60 backdrop-blur-[2px] transition-opacity duration-300 opacity-0" id="qc-variant-backdrop" onclick="closeVariantSheet()"></div>
    <!-- Sheet -->
    <div class="absolute bottom-0 left-0 right-0 bg-white rounded-t-3xl shadow-2xl transition-transform duration-300 translate-y-full max-h-[85vh] flex flex-col overflow-hidden" id="qc-variant-panel">
      <!-- Header -->
      <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-pink-50">
        <h3 class="font-bold text-slate-800 text-[17px] tracking-tight">Select Variant</h3>
        <button class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors" onclick="closeVariantSheet()">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <!-- Content (List) -->
      <div class="p-4 overflow-y-auto pb-[100px] bg-[#fffcfd]" id="qc-variant-list">
        <!-- Variants injected here -->
      </div>
    </div>
  </div>
</body>
<script is:inline>
  // Flipkart Minutes / Blinkit Style Scroll Behavior
  document.addEventListener('DOMContentLoaded', () => {
    const topBlock = document.getElementById('qc-mobile-top-block');
    const searchSticky = document.getElementById('qc-mobile-search-sticky');
    const topbar = document.getElementById('qc-topbar');

    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      
      if (scrollY > 40) {
        // Collapse Top Block
        if (topBlock) {
          topBlock.style.opacity = '0';
          topBlock.style.height = '0px';
          topBlock.style.paddingTop = '0px';
          topBlock.style.paddingBottom = '0px';
          topBlock.style.pointerEvents = 'none';
        }
        
        // Solidify Search Bar Background
        if (searchSticky) {
          searchSticky.classList.remove('bg-transparent', 'pt-1');
          searchSticky.classList.add('bg-white', 'shadow-sm', 'pt-3', 'border-b', 'border-gray-100');
        }
      } else {
        // Expand Top Block
        if (topBlock) {
          topBlock.style.opacity = '1';
          topBlock.style.height = ''; // Auto
          topBlock.style.paddingTop = ''; // Restore tailwind class
          topBlock.style.paddingBottom = ''; // Restore tailwind class
          topBlock.style.pointerEvents = 'auto';
        }
        
        // Transparent Search Bar Background (rests on topbar background)
        if (searchSticky) {
          searchSticky.classList.add('bg-transparent', 'pt-1');
          searchSticky.classList.remove('bg-white', 'shadow-sm', 'pt-3', 'border-b', 'border-gray-100');
        }
      }
    });
  });
</script>
</html>
