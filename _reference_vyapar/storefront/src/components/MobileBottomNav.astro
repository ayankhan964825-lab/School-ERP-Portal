---
import { getSettings } from '../lib/database';
import MobileCartIcon from './react/MobileCartIcon.tsx';

const currentPath = Astro.url.pathname;
const settings = await getSettings(Astro.locals?.storeId);

// Check if there are active featured videos for the Play tab
const videos = settings?.featured_videos || [];
const hasActiveVideos = videos.some((v: any) => v.is_active);

const navItems = [
  {
    id: 'home',
    label: 'Home',
    href: '/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>`,
    activeIcon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" /></svg>`,
    isActive: currentPath === '/'
  },
  hasActiveVideos ? {
    id: 'play',
    label: 'Play',
    href: currentPath === '/' ? '#featured-videos' : '/?play=1#featured-videos',
    onclick: currentPath === '/' ? `event.preventDefault(); window.dispatchEvent(new CustomEvent('vyaparpe:open-reel', {detail: {index: 0}}));` : undefined,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    activeIcon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" /></svg>`,
    isActive: currentPath === '/play' || Astro.url.searchParams.get('play') === '1'
  } : {
    id: 'categories',
    label: 'Categories',
    href: '/products#categories',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>`,
    activeIcon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor"><path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>`,
    isActive: currentPath === '/products' && !Astro.url.searchParams.get('deals')
  },
  {
    id: 'deals',
    label: 'Top Deals',
    href: '/products?deals=true',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>`,
    activeIcon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" /></svg>`,
    isActive: currentPath === '/products' && Astro.url.searchParams.get('deals') === 'true'
  },
  {
    id: 'account',
    label: 'Account',
    href: '/account',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>`,
    activeIcon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" /></svg>`,
    isActive: currentPath.startsWith('/account')
  }
];
---

<div id="mobile-bottom-nav" class="fixed bottom-0 left-0 right-0 z-[100] bg-surface border-t border-background-alt shadow-[0_-4px_10px_rgba(0,0,0,0.05)] md:hidden pb-safe transition-transform duration-300">
  <div class="flex justify-around items-center h-[60px] px-2">
    {navItems.map((item) => (
      <a 
        href={item.href} 
        onclick={item.onclick || undefined}
        class={`flex flex-col items-center justify-center w-full h-full gap-1 transition-colors ${item.isActive ? 'text-primary' : 'text-secondary hover:text-primary'}`}
      >
        <div class="relative flex items-center justify-center w-6 h-6">
          {item.isActive ? (
            <div set:html={item.activeIcon} />
          ) : (
            <div set:html={item.icon} />
          )}
        </div>
        <span class={`text-[10px] leading-tight ${item.isActive ? 'font-bold' : 'font-medium'}`}>
          {item.label}
        </span>
      </a>
    ))}

    <!-- Cart Tab -->
    <MobileCartIcon client:load />
  </div>
</div>

<style>
  /* Safe area inset for modern iPhones with home indicator */
  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
</style>

<style is:global>
  body.cart-open #mobile-bottom-nav {
    transform: translateY(100%);
    pointer-events: none;
    opacity: 0;
  }
</style>
