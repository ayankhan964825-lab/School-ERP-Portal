                                    <div class="w-full bg-indigo-300 rounded-t-lg h-[65%] hover:bg-indigo-400 transition-colors cursor-pointer relative group"><div class="opacity-0 group-hover:opacity-100 absolute -top-8 left-1/2 -translate-x-1/2 bg-black text-white text-[10px] px-2 py-1 rounded">Q4</div></div>
