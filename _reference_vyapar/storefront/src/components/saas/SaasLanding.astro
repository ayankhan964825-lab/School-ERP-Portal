                                <div class="h-8 w-full bg-indigo-50 rounded-lg flex items-center justify-center md:justify-start md:px-3 border border-indigo-100"><div class="h-2 w-4 md:w-16 bg-indigo-400 rounded-full"></div></div>
                                <div class="h-8 w-full hover:bg-gray-50 rounded-lg flex items-center justify-center md:justify-start md:px-3"><div class="h-2 w-4 md:w-20 bg-gray-200 rounded-full"></div></div>
                                <div class="h-8 w-full hover:bg-gray-50 rounded-lg flex items-center justify-center md:justify-start md:px-3"><div class="h-2 w-4 md:w-14 bg-gray-200 rounded-full"></div></div>
                                <div class="h-8 w-full hover:bg-gray-50 rounded-lg flex items-center justify-center md:justify-start md:px-3"><div class="h-2 w-4 md:w-24 bg-gray-200 rounded-full"></div></div>
                            </div>
                            <!-- Main Content -->
                            <div class="flex-1 p-6 md:p-8 overflow-hidden flex flex-col">
                                <div class="flex justify-between items-end mb-8">
                                    <div>
                                        <div class="h-3 w-16 bg-gray-300 rounded-full mb-3"></div>
                                        <div class="h-8 w-32 md:w-48 bg-gray-900 rounded-lg"></div>
                                    </div>
                                    <div class="h-8 w-20 md:w-24 bg-indigo-600 rounded-lg shadow-sm shadow-indigo-200"></div>
                                </div>
                                
                                <!-- Chart Area -->
                                <div class="w-full flex-1 bg-white border border-gray-200/60 rounded-xl shadow-sm mb-6 p-6 flex items-end gap-3 justify-between">
                                    <div class="w-full bg-indigo-50 rounded-t-lg h-[30%] hover:bg-indigo-100 transition-colors cursor-pointer relative group"><div class="opacity-0 group-hover:opacity-100 absolute -top-8 left-1/2 -translate-x-1/2 bg-black text-white text-[10px] px-2 py-1 rounded">Q1</div></div>
                                    <div class="w-full bg-indigo-100 rounded-t-lg h-[45%] hover:bg-indigo-200 transition-colors cursor-pointer relative group"><div class="opacity-0 group-hover:opacity-100 absolute -top-8 left-1/2 -translate-x-1/2 bg-black text-white text-[10px] px-2 py-1 rounded">Q2</div></div>
