    <!-- Plan Details Modal -->
    <div id="plan-details-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
        <div class="bg-[#111113] border border-gray-800 rounded-3xl w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl relative" onclick="event.stopPropagation()">
            <!-- Close button -->
            <button onclick="closePlanModal()" class="absolute top-6 right-6 text-gray-500 hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            
            <div class="p-8 md:p-10">
                <div class="inline-block px-3 py-1 bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-[10px] font-bold rounded-lg uppercase tracking-wider mb-4" id="modal-plan-badge">Plan Details</div>
                <h3 class="text-3xl font-extrabold text-white mb-2" id="modal-plan-title">Starter Plan</h3>
                <p class="text-gray-400 mb-8" id="modal-plan-desc">Perfect for testing the waters and setting up your initial catalog.</p>
                
                <div class="space-y-6" id="modal-features-container">
                    <!-- Features injected via JS -->
                </div>
                
                <div class="mt-10 pt-8 border-t border-gray-800 flex justify-end">
                    <button onclick="closePlanModal()" class="px-6 py-2.5 bg-gray-800 hover:bg-gray-700 text-white text-sm font-bold rounded-xl transition-colors">Close</button>
                </div>
            </div>
        </div>
    </div>


    <!-- Scroll Animation Script -->
    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.fade-in-up').forEach(el => observer.observe(el));
        });

        // Plan Details Modal Logic
        const planData = {
            'Starter': {
                title: 'Starter',
                desc: 'A great way to begin your online journey completely free.',
                badge: 'Free Forever',
                features: [
                    { name: 'Storefront', val: 'Basic vyaparpe subdomain' },
                    { name: 'Product Limit', val: '50 Products' },
                    { name: 'Order Processing', val: 'Unlimited' },
                    { name: 'Platform Fee', val: '5% per successful transaction' },
                    { name: 'Support', val: 'Email only (48h response)' },
                    { name: 'Custom Domain', val: '❌ Not available' },
                    { name: 'Theme Engine', val: '❌ Default theme only' }
                ]
            },
            'Growth': {
                title: 'Growth',
                desc: 'For serious sellers who want their own brand identity and lower fees.',
                badge: 'Most Popular',
                features: [
                    { name: 'Storefront', val: 'Custom .com domain connection' },
                    { name: 'Product Limit', val: '1000 Products' },
                    { name: 'Order Processing', val: 'Unlimited' },
                    { name: 'Platform Fee', val: 'Reduced to 2%' },
                    { name: 'Support', val: 'Priority Email & Chat (12h response)' },
                    { name: 'Theme Engine', val: '✅ Access to all premium themes' },
                    { name: 'Staff Accounts', val: 'Up to 3 staff members' },
                    { name: 'Analytics', val: 'Advanced AI insights & reports' }
                ]
            },
            'Partner': {
                title: 'Ad-Spend Partner',
                desc: 'You handle the inventory, we handle the entire tech, website, and marketing.',
                badge: 'Fully Managed',
                features: [
                    { name: 'Management', val: '100% Fully Managed Store & Ads' },
                    { name: 'Ad Spend Required', val: 'Minimum ₹1000/day on Meta/Google Ads' },
                    { name: 'Product Limit', val: '500 Products (Managed)' },
                    { name: 'Platform Fee', val: '3% Revenue Share' },
                    { name: 'Account Manager', val: '✅ Dedicated Whatsapp Group' },
                    { name: 'Creatives', val: '✅ We provide ad copy & creatives' },
                    { name: 'Setup Fee', val: '₹0 (Waived off)' }
                ]
            },
            'Lifetime': {
                title: 'Lifetime Ownership',
                desc: 'One time payment. Total control over your data with the lowest possible fees.',
                badge: 'Enterprise',
                features: [
                    { name: 'Licensing', val: 'Lifetime core engine access' },
                    { name: 'Product Limit', val: 'Unlimited Products' },
                    { name: 'Platform Fee', val: 'Absolute lowest 1% gateway markup' },
                    { name: 'Maintenance', val: '₹2000/year for server & DB costs' },
                    { name: 'Customization', val: '✅ Request custom UI/UX features' },
                    { name: 'API Access', val: '✅ Full Headless API access' },
                    { name: 'Priority Support', val: '✅ Direct Phone Support' }
                ]
            }
        };

        function openPlanModal(planKey) {
            const data = planData[planKey];
            if(!data) return;
            
            document.getElementById('modal-plan-title').innerText = data.title;
            document.getElementById('modal-plan-desc').innerText = data.desc;
            document.getElementById('modal-plan-badge').innerText = data.badge;
            
            let html = '';
            data.features.forEach(f => {
                html += `
                <div class="flex flex-col sm:flex-row sm:items-center justify-between p-4 bg-gray-900/50 rounded-xl border border-gray-800">
                    <span class="text-sm font-bold text-gray-300 mb-1 sm:mb-0">${f.name}</span>
                    <span class="text-sm font-medium text-gray-400 sm:text-right">${f.val}</span>
                </div>`;
            });
            document.getElementById('modal-features-container').innerHTML = html;
            
            const modal = document.getElementById('plan-details-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closePlanModal() {
            const modal = document.getElementById('plan-details-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }
        
        // Close modal on outside click
        document.getElementById('plan-details-modal').addEventListener('click', closePlanModal);
    </script>
</body>
</html>
