                    Start building for free
                </a>
                <a href="#demo" class="w-full sm:w-auto px-8 py-4 bg-white text-black rounded-full font-bold text-base border border-gray-200 hover:border-gray-300 hover:bg-gray-50 transition-colors shadow-sm flex items-center justify-center gap-2">
                    <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path></svg>
