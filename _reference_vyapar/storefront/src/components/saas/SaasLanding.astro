                                    <div class="w-full bg-indigo-600 rounded-t-lg h-[100%] shadow-[0_0_20px_rgba(79,70,229,0.4)] relative group"><div class="absolute -top-8 left-1/2 -translate-x-1/2 bg-black text-white text-[10px] px-2 py-1 rounded">Q7</div></div>
