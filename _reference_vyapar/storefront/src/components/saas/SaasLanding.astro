---
import { getCollection } from 'astro:content';
import '../../styles/global.css';

// Force static rendering for landing page to ensure max performance
export const prerender = true;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VyaparPe | Launch Your E-Commerce Empire</title>
    <meta name="description" content="The most powerful platform to build, manage, and scale your online store. Get custom domains, secure payments, and AI-driven analytics out of the box." />
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-base: #ffffff; 
            --text-main: #09090b; /* Zinc 950 */
            --brand: #000000;
        }

        body { 
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-base);
            color: var(--text-main);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Nav Glass */
        .glass-nav {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        /* Typography Polish */
        h1 {
            letter-spacing: -0.05em;
            line-height: 1.05;
        }
        h2 {
            letter-spacing: -0.04em;
            line-height: 1.1;
        }
        h3 {
            letter-spacing: -0.02em;
        }

        .gradient-text-hero {
            background: linear-gradient(135deg, #111827 0%, #4b5563 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            color: transparent;
        }
        
        .gradient-text-accent {
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            color: transparent;
        }

        /* Hero Dashboard Mockup */
        .dashboard-mockup {
            background: #ffffff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(0,0,0,0.05);
            transform: perspective(1000px) rotateX(10deg);
            transform-origin: top;
            transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .hero-section:hover .dashboard-mockup {
            transform: perspective(1000px) rotateX(0deg);
        }
        
        /* Floating notification card */
        .floating-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 20px 40px -10px rgba(0,0,0,0.1);
            animation: float-soft 6s ease-in-out infinite;
        }

        @keyframes float-soft {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-15px) scale(1.02); }
        }

        /* Marquee */
        .marquee-container {
            display: flex;
            overflow: hidden;
            user-select: none;
            gap: 4rem;
            mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
            -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
        }
        .marquee-content {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: space-around;
            gap: 4rem;
            min-width: 100%;
            animation: scroll 30s linear infinite;
        }
        @keyframes scroll {
            0% { transform: translateX(0); }
            100% { transform: translateX(-100%); }
        }

        /* Bento Grid */
        .bento-item {
            background: #fafafa;
            border: 1px solid rgba(0,0,0,0.05);
            border-radius: 24px;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        .bento-item:hover {
            box-shadow: 0 20px 40px -15px rgba(0,0,0,0.05);
            transform: translateY(-4px);
            background: #ffffff;
            border-color: rgba(0,0,0,0.1);
        }
        .bento-item-dark {
            background: #09090b;
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 24px;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        .bento-item-dark:hover {
            box-shadow: 0 20px 40px -15px rgba(0,0,0,0.8);
            transform: translateY(-4px);
            background: #111113;
            border-color: rgba(255,255,255,0.1);
        }

        /* Custom buttons */
        .btn-black {
            background-color: #09090b;
            color: #ffffff;
            transition: all 0.2s ease;
        }
        .btn-black:hover {
            background-color: #27272a;
            transform: scale(1.02);
        }

        /* Ad-Spend Partner Premium Card */
        .premium-card {
            background: linear-gradient(180deg, #1e1b4b 0%, #111827 100%);
            border: 1px solid rgba(99, 102, 241, 0.4);
            box-shadow: 0 0 40px rgba(99, 102, 241, 0.2) inset, 0 20px 40px -10px rgba(0,0,0,0.5);
            position: relative;
        }
        .premium-ribbon {
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(90deg, #6366f1, #a855f7);
            color: white;
            padding: 4px 16px;
            border-radius: 100px;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            box-shadow: 0 4px 10px rgba(99, 102, 241, 0.4);
            white-space: nowrap;
        }

        /* Scroll Animations */
        .fade-in-up {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .fade-in-up.visible {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
<body class="selection:bg-gray-200 selection:text-black">

    <!-- Navigation -->
    <nav class="fixed w-full z-50 glass-nav">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="flex items-center justify-between h-[72px]">
