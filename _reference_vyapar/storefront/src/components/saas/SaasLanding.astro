        <div class="absolute top-[-20%] left-[50%] translate-x-[-50%] w-[800px] h-[500px] bg-gradient-to-r from-blue-100/50 via-purple-100/50 to-pink-100/50 blur-3xl rounded-full z-[-1]"></div>

        <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center relative z-10">
            
