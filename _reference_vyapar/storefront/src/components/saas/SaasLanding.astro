                    <a href="#pricing" class="text-sm font-semibold text-gray-500 hover:text-black transition">Pricing</a>
                    <a href="/marketplace" class="text-sm font-semibold text-gray-500 hover:text-black transition">Marketplace</a>
                </div>
                <div class="flex items-center gap-4">
                    <a href="/start" class="px-5 py-2 btn-black text-sm font-bold rounded-full whitespace-nowrap">Get Started</a>
                </div>
