                            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 3h12M6 8h12m-6 5l8.5 8M6 13h3M9 13c6.667 0 6.667-10 0-10"></path></svg>
                        </div>
                        <div class="text-left">
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5">New Order</p>
                            <p class="text-lg font-extrabold text-gray-900 leading-none">₹4,250.00</p>
                        </div>
                    </div>

                    <!-- Floating Card: User -->
                    <div class="floating-card absolute -right-4 md:-right-12 bottom-16 md:bottom-24 z-30 rounded-2xl p-4 flex items-center gap-3 hidden sm:flex border border-white/50 bg-white/80 backdrop-blur-xl shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)]" style="animation-delay: -3s;">
                        <div class="w-10 h-10 bg-blue-100 rounded-full overflow-hidden border-2 border-white shadow-sm">
                            <img src="https://ui-avatars.com/api/?name=Rahul+K&background=bfdbfe&color=1e3a8a" alt="User" class="w-full h-full object-cover">
                        </div>
                        <div class="text-left">
                            <p class="text-xs font-bold text-gray-500 leading-tight">Rahul K. joined</p>
                            <p class="text-[11px] font-bold text-blue-600 uppercase tracking-wide mt-0.5">Premium Member</p>
                        </div>
                    </div>

                    <!-- The Dashboard Body -->
                    <div class="dashboard-mockup flex flex-col h-[500px] border border-gray-200/60 bg-white">
                        <!-- Browser Header -->
                        <div class="bg-gray-50/80 backdrop-blur-sm border-b border-gray-200/60 h-12 flex items-center px-4 gap-2">
                            <div class="flex gap-1.5">
                                <div class="w-3 h-3 rounded-full bg-red-400 shadow-sm border border-red-500/20"></div>
                                <div class="w-3 h-3 rounded-full bg-yellow-400 shadow-sm border border-yellow-500/20"></div>
                                <div class="w-3 h-3 rounded-full bg-green-400 shadow-sm border border-green-500/20"></div>
                            </div>
                            <div class="mx-auto bg-white border border-gray-200/60 rounded-md text-[10px] text-gray-400 font-mono px-16 md:px-24 py-1.5 shadow-sm flex items-center gap-2">
                                <svg class="w-3 h-3 text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>
                                vyaparpe.com/admin
                            </div>
                        </div>
                        
                        <!-- App Inner -->
                        <div class="flex flex-1 overflow-hidden bg-[#fafafa]">
                            <!-- Sidebar -->
                            <div class="w-16 md:w-48 border-r border-gray-200/60 p-4 flex flex-col gap-3 bg-white">
