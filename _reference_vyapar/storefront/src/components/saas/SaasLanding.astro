            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-auto">
                
                <!-- Bento 1: Large spanning 2 cols -->
                <div class="bento-item md:col-span-2 overflow-hidden flex flex-col md:flex-row relative fade-in-up min-h-[450px] md:min-h-[380px]">
