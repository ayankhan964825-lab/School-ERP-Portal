                    </div>
                    <div class="md:w-1/2 relative min-h-[280px] md:min-h-0 bg-indigo-50/30 mt-4 md:mt-0 flex items-center justify-center p-6 md:p-8 border-l border-gray-100/50">
                        <!-- Browser Window Mockup -->
