                        <div class="text-3xl font-extrabold text-white">₹499 <span class="text-sm font-medium text-gray-500">per block</span></div>
                    </div>

                    <div class="bg-[#111113] rounded-2xl p-8 border border-gray-800 flex flex-col relative overflow-hidden hover:border-fuchsia-500/30 transition-colors group">
                        <div class="absolute -right-6 -top-6 w-32 h-32 bg-gradient-to-br from-fuchsia-500 to-purple-600 rounded-full blur-[40px] opacity-20 group-hover:opacity-40 transition-opacity"></div>
                        <div class="w-12 h-12 bg-fuchsia-500/10 border border-fuchsia-500/20 rounded-xl flex items-center justify-center mb-6 relative z-10">
                            <svg class="w-6 h-6 text-fuchsia-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
                        </div>
                        <h4 class="text-xl font-bold text-white mb-2 relative z-10">Custom UX Theme</h4>
                        <p class="text-gray-400 text-sm mb-6 flex-1 leading-relaxed relative z-10">Stand out from the crowd with a completely bespoke, highly-converting premium storefront design.</p>
                        <div class="text-3xl font-extrabold text-white mt-auto relative z-10">₹9,999 <span class="text-sm font-medium text-gray-500">one time</span></div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-[#050505] py-20 text-gray-500 text-sm text-center border-t border-gray-900">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex items-center justify-center gap-3 mb-8">
                <div class="w-10 h-10 bg-gray-900 border border-gray-800 rounded-xl flex items-center justify-center shadow-lg">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <span class="text-2xl font-extrabold text-white tracking-tight">VyaparPe</span>
            </div>
            <p class="mb-8 font-medium">© 2026 VyaparPe Technologies Inc. All rights reserved.</p>
            <div class="flex justify-center gap-8 font-semibold">
                <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
                <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
                <a href="#" class="hover:text-white transition-colors">Contact Support</a>
            </div>
