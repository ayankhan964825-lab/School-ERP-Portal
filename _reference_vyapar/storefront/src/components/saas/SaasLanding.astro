            <!-- Dashboard HTML Mockup -->
            <div class="mt-20 md:mt-28 relative mx-auto max-w-5xl z-20 fade-in-up px-4 sm:px-8" style="transition-delay: 400ms;">
                
                <div class="relative max-w-4xl mx-auto">
                    <!-- Floating Card: Revenue -->
                    <div class="floating-card absolute -left-4 md:-left-12 top-16 md:top-24 z-30 rounded-2xl p-4 flex items-center gap-4 hidden sm:flex border border-white/50 bg-white/80 backdrop-blur-xl shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)]">
