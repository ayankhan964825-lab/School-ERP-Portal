</header>

<script is:inline>
  function initNavbar() {
    // Mobile menu toggle — clone to remove stale listeners
    var mobileMenuBtn = document.getElementById('mobile-menu-btn');
    var mobileMenu    = document.getElementById('mobile-menu');
    var menuIconOpen  = document.getElementById('menu-icon-open');
    var menuIconClose = document.getElementById('menu-icon-close');

    if (mobileMenuBtn) {
      var newBtn = mobileMenuBtn.cloneNode(true);
      mobileMenuBtn.parentNode.replaceChild(newBtn, mobileMenuBtn);
      newBtn.addEventListener('click', function() {
        var isOpen = !mobileMenu.classList.contains('hidden');
        mobileMenu.classList.toggle('hidden', isOpen);
        if (menuIconOpen)  menuIconOpen.classList.toggle('hidden', !isOpen);
        if (menuIconClose) menuIconClose.classList.toggle('hidden', isOpen);
        newBtn.setAttribute('aria-expanded', String(!isOpen));
      });
    }

    // Cart count from localStorage — update on every navigation
    if (!window.updateCartCount) {
      window.updateCartCount = function() {
        var cart = JSON.parse(localStorage.getItem(`vyaparpe-cart-${window.location.hostname}`) || '[]');
        var count = cart.reduce(function(sum, item) { return sum + (item.qty || 0); }, 0);
        var cartCount = document.getElementById('cart-count');
        if (cartCount) {
          if (count > 0) {
            cartCount.textContent = String(count > 99 ? '99+' : count);
            cartCount.classList.remove('hidden');
          } else {
            cartCount.classList.add('hidden');
          }
        }
      };
      window.addEventListener('cart-updated', window.updateCartCount);
    }
    window.updateCartCount();

    // Wishlist count from localStorage
    if (!window.updateWishlistCount) {
      window.updateWishlistCount = function() {
        try {
          var wishlist = JSON.parse(localStorage.getItem(`vyaparpe-wishlist-${window.location.hostname}`) || '[]');
          var count = wishlist.length;
          var wishlistCount = document.getElementById('wishlist-count');
          if (wishlistCount) {
            if (count > 0) {
              wishlistCount.textContent = String(count > 99 ? '99+' : count);
              wishlistCount.classList.remove('hidden');
            } else {
              wishlistCount.classList.add('hidden');
            }
          }
        } catch(e) {}
      };
      window.addEventListener('wishlist-updated', window.updateWishlistCount);
    }
    window.updateWishlistCount();
    // Scroll behavior for Announcement Bar
    if (!window.initScrollHeader) {
      window.initScrollHeader = true;
      var lastScrollY = window.scrollY || 0;
      var header = document.getElementById('site-header');
      
      window.addEventListener('scroll', function() {
        if (!header) return;
        var currentScrollY = window.scrollY;
        
        // Don't hide if near the top
        if (currentScrollY <= 40) {
          header.style.transform = 'translateY(0)';
        }
        // Scrolling down
        else if (currentScrollY > lastScrollY) {
          header.style.transform = 'translateY(-34px)';
        } 
        // Scrolling up
        else if (currentScrollY < lastScrollY) {
          header.style.transform = 'translateY(0)';
        }
        
        lastScrollY = currentScrollY;
      }, { passive: true });
    }
  }

  document.addEventListener('DOMContentLoaded', initNavbar);
</script>
