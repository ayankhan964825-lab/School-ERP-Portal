---
import { getSettings, getCoupons, getActiveMilestone, getFlashSales } from '../lib/database';

export interface Props {
  showBackBtn?: boolean;
  showMobileCart?: boolean;
}

const { showBackBtn = false, showMobileCart = false } = Astro.props;

const DEFAULT_NAV_LINKS = [
  { label: 'Home', href: '/' },
  { label: 'Products', href: '/products' },
  { label: 'About', href: '/about' },
  { label: 'Blog', href: '/blog' },
  { label: 'Track Order', href: '/track-order' },
  { label: 'Contact', href: '/contact' },
];

import CartIcon from './react/CartIcon.tsx';
import LocationPrompt from './react/LocationPrompt.tsx';

import { verifyCustomerAuth } from '../lib/auth';
const isLoggedIn = !!verifyCustomerAuth(Astro.cookies.get('customer_auth')?.value);
const settings = await getSettings(Astro.locals?.storeId);
const freeShippingThreshold = settings?.free_shipping_threshold ?? 499;
const logoUrl = settings?.logo_url;
const storeName = settings?.brand_name || settings?.store_name || 'Store Name';

const initialPincode = Astro.cookies.get('delivery_pincode')?.value || '';
const initialCity = Astro.cookies.get('delivery_city')?.value || '';
const initialEta = Astro.cookies.get('delivery_eta')?.value || '';
let headerNav: { id: string; label: string; url?: string; children?: { label: string; url: string }[] }[] = [];
let useDynamicNav = false;
try {
  if (settings?.website_navigation) {
    const parsed = typeof settings.website_navigation === 'string'
      ? JSON.parse(settings.website_navigation)
      : settings.website_navigation;
    if (parsed?.header && Array.isArray(parsed.header) && parsed.header.length > 0) {
      headerNav = parsed.header;
      useDynamicNav = true;
    }
  }
} catch (e) {}

const s = (key: string, fallback?: string) => {
  const val = settings?.[key];
  return (val !== undefined && val !== null) ? val : fallback || '';
};

// Collect existing URLs from headerNav (if dynamic) or DEFAULT_NAV_LINKS
const existingUrls = new Set();
if (useDynamicNav) {
  headerNav.forEach(link => {
    if (link.url) existingUrls.add(link.url);
    if (link.children) {
      link.children.forEach(child => existingUrls.add(child.url));
    }
  });
} else {
  DEFAULT_NAV_LINKS.forEach(link => existingUrls.add(link.href));
}

const companyLinks = [
  { label: 'About Us', href: '/about' },
  { label: 'Contact', href: '/contact' },
  { label: 'Blog', href: '/blog' },
  { label: 'Sustainability', href: '/sustainability' },
  { label: 'FAQ', href: '/faq' },
].filter(link => settings?.[`show_footer_link_${link.label.replace(/\s+/g, '_')}`] !== 'false' && !existingUrls.has(link.href));

const supportLinks = [
  { label: 'Track Order', href: '/track-order' },
  { label: 'Delivery & Returns', href: '/delivery' },
  { label: 'Shipping Policy', href: '/shipping-policy' },
  { label: 'Product Guarantee', href: '/warranty' },
  { label: 'Bulk Orders', href: '/bulk-order' },
  { label: 'Refund Policy', href: '/refund-policy' },
  { label: 'Terms of Service', href: '/terms' },
  { label: 'Privacy Policy', href: '/privacy-policy' },
].filter(link => settings?.[`show_footer_link_${link.label.replace(/\s+/g, '_')}`] !== 'false' && !existingUrls.has(link.href));

const storeNameCompact = storeName.replace(/\s+/g, '');
const rawWhatsapp = s('social_whatsapp') || s('contact_phone') || '919876543211';
const firstWhatsapp = rawWhatsapp.split(/[\/,]/)[0];
const whatsappNumber = firstWhatsapp.replace(/\D/g, '');

// Fetch dynamic marquee data
const forceStoreId = Astro.locals?.storeId;
const [coupons, milestone, flashSales] = await Promise.all([
  getCoupons(forceStoreId).catch(() => []),
  getActiveMilestone(forceStoreId).catch(() => null),
  getFlashSales(forceStoreId).catch(() => [])
]);

const activeCoupons = (coupons || []).filter((c: any) => c.is_public && c.is_active);

const rawTaglines = settings?.announcement_taglines || "";
const taglines = rawTaglines.split('\n').map((t: string) => t.trim()).filter(Boolean);

// Announcement Toggles (Default to true if not explicitly disabled)
const showShipping = settings?.announcement_show_shipping !== 'false' && settings?.announcement_show_shipping !== false;
const showMilestones = settings?.announcement_show_milestones !== 'false' && settings?.announcement_show_milestones !== false;
const showCoupons = settings?.announcement_show_coupons !== 'false' && settings?.announcement_show_coupons !== false;
const showFlashSales = settings?.announcement_show_flash_sales !== 'false' && settings?.announcement_show_flash_sales !== false;
const showPrepaid = settings?.announcement_show_prepaid !== 'false' && settings?.announcement_show_prepaid !== false;

const marqueeItems = [];
if (showShipping) {
  if (freeShippingThreshold > 0) {
    marqueeItems.push(`Free Shipping on Orders Above ₹${freeShippingThreshold}`);
  } else {
    marqueeItems.push(`Free Shipping on All Orders`);
  }
}

if (showMilestones && milestone && milestone.is_active && milestone.tiers && milestone.tiers.length > 0) {
  const sortedTiers = milestone.tiers.sort((a: any, b: any) => (a.target || 0) - (b.target || 0));
  sortedTiers.forEach((tier: any) => {
    if (tier.target && tier.discount) {
      marqueeItems.push(`Milestone Offer: Spend ₹${tier.target} to get ${tier.discount}% OFF!`);
    } else if (tier.message) {
      marqueeItems.push(`Milestone Offer: ${tier.message}`);
    }
  });
}

if (showCoupons) {
  activeCoupons.forEach((c: any) => {
    let discountStr = c.discount_type === 'percentage' ? `${c.discount_value}% OFF` : `₹${c.discount_value} OFF`;
    marqueeItems.push(`Use Code ${c.code} for ${discountStr}!`);
  });
}

const nowTime = new Date().toISOString();
const activeFlashSales = flashSales.filter((s: any) => s.status === 'active' && s.startDate <= nowTime && s.endDate > nowTime);
if (showFlashSales && activeFlashSales.length > 0) {
  marqueeItems.push(`⚡ Live Now: Flash Sale! Grab your favorites at huge discounts!`);
}

const isPrepaidEnabled = settings?.prepaid_discount_enabled === 'true' || settings?.prepaid_discount_enabled === true;
if (showPrepaid && isPrepaidEnabled) {
  const pVal = Number(settings?.prepaid_discount_value || 0);
  if (pVal > 0) {
    const pType = settings?.prepaid_discount_type || 'percentage';
    const discountText = pType === 'percentage' ? `${pVal}%` : `₹${pVal}`;
    const minOrderText = Number(settings?.prepaid_discount_min_order || 0) > 0 ? ` on orders above ₹${settings.prepaid_discount_min_order}` : '!';
    marqueeItems.push(`💳 Pay online & get extra ${discountText} OFF${minOrderText}`);
  }
}

marqueeItems.push(...taglines);
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <!-- Announcement Bar -->
  <style>
    .marquee-container {
      width: 100%;
      overflow: hidden;
      white-space: nowrap;
      position: relative;
      display: flex;
    }
    .marquee-content {
      display: inline-flex;
      animation: marquee 25s linear infinite;
      width: max-content;
    }
    .marquee-container:hover .marquee-content {
      animation-play-state: paused;
    }
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  </style>
  <div class="bg-theme-section text-xs py-2 font-sans tracking-wide font-semibold border-b border-black/10 relative flex items-center h-[34px] marquee-container">
    <div class="marquee-content items-center">
      {marqueeItems.map((item, index) => (
        <span class="inline-flex items-center shrink-0">
          {index === 0 && <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-3.5 w-3.5 text-accent-warm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>}
          {item}
          <span class="mx-6 sm:mx-10 opacity-30">|</span>
        </span>
      ))}
      {marqueeItems.map((item, index) => (
        <span class="inline-flex items-center shrink-0" aria-hidden="true">
          {index === 0 && <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-3.5 w-3.5 text-accent-warm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>}
          {item}
          <span class="mx-6 sm:mx-10 opacity-30">|</span>
        </span>
      ))}
    </div>
  </div>

  <!-- Main Navbar -->
  <nav class="bg-surface/95 backdrop-blur-md border-b border-background-alt shadow-sm">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="flex items-center justify-between h-16">

        <!-- Logo -->
        <div class="flex items-center gap-1.5 md:gap-2 shrink-0">
          {showBackBtn && (
            <button onclick="history.back()" class="md:hidden p-1.5 -ml-1 text-secondary hover:text-primary transition-colors flex-shrink-0" aria-label="Go back">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            </button>
          )}
          <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label={`${storeName} Home`}>
            {logoUrl ? (
              <img
                src={logoUrl}
                alt={`${storeName} Logo`}
                class="h-9 w-auto transition-transform duration-300 group-hover:scale-105"
                loading="eager"
                data-setting="logo_url"
              />
            ) : (
              <div class="h-9 w-9 bg-primary/10 rounded flex items-center justify-center text-primary shrink-0" title="Upload Logo">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              </div>
            )}
            <span class="hidden sm:block text-lg font-serif font-bold text-primary whitespace-nowrap shrink-0" data-setting="store_name">{storeName}</span>
          </a>
          
          <!-- Location / Pincode -->
          <div class={showBackBtn ? "hidden md:block" : ""}>
            <LocationPrompt 
              client:load 
              googleMapsApiKey={settings?.google_maps_api_key || null}
              initialPincode={initialPincode}
              initialCity={initialCity}
              initialEta={initialEta} 
            />
          </div>
        </div>

        <!-- Desktop Nav Links -->
        <div class="hidden md:flex items-center gap-0.5 lg:gap-1">
          {useDynamicNav ? headerNav.map(link => (
            link.children && link.children.length > 0 ? (
              <div class="relative group">
                <a
                  href={link.url || '#'}
                  class="relative px-2 lg:px-4 py-2 text-[13px] lg:text-sm font-medium text-primary hover:text-accent-warm transition-colors duration-200 rounded-full hover:bg-primary/5 group inline-flex items-center gap-1"
                >
                  {link.label}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 lg:h-3.5 w-3 lg:w-3.5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </a>
                <div class="absolute top-full left-0 mt-1 bg-surface rounded-xl shadow-lg border border-background-alt py-1.5 min-w-[180px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  {link.children.map(child => (
                    <a href={child.url || '#'} class="block px-4 py-2 text-sm text-primary hover:text-accent-warm hover:bg-primary/5 transition-colors">{child.label}</a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={link.url || '#'}
                class="relative px-2 lg:px-4 py-2 text-[13px] lg:text-sm font-medium text-primary hover:text-accent-warm transition-colors duration-200 rounded-full hover:bg-primary/5 group"
              >
                {link.label}
                <span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-primary rounded-full transition-all duration-300 group-hover:w-4"></span>
              </a>
            )
          )) : DEFAULT_NAV_LINKS.map(link => (
            <a
              href={link.href}
              class="relative px-2 lg:px-4 py-2 text-[13px] lg:text-sm font-medium text-primary hover:text-accent-warm transition-colors duration-200 rounded-full hover:bg-primary/5 group"
            >
              {link.label}
              <span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-primary rounded-full transition-all duration-300 group-hover:w-4"></span>
            </a>
          ))}
        </div>

        <!-- Right Side Actions -->
        <div class="flex items-center gap-2 shrink-0">
          <!-- Search -->
          <button
            id="search-btn"
            aria-label="Search products"
            class="p-2 rounded-full text-primary hover:text-accent-warm hover:bg-primary/5 transition-all duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>

          <!-- Wishlist (Hidden on mobile) -->
          <a
            href="/account/wishlist"
            id="wishlist-nav-btn"
            aria-label="View wishlist"
            class="hidden md:block relative p-2 rounded-full text-primary hover:text-accent-warm hover:bg-primary/5 transition-all duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
            <span id="wishlist-count" class="absolute -top-1 -right-1 bg-accent-warm text-surface text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center hidden animate-in zoom-in duration-300"></span>
          </a>

          <!-- Cart -->
          <div class={showMobileCart ? "" : "hidden md:block"}>
            <CartIcon client:load />
          </div>

          <!-- Login / Profile (Hidden on mobile) -->
          {isLoggedIn ? (
            <a
              href="/account"
              id="profile-btn"
              aria-label="Your Account"
              class="hidden md:flex relative items-center justify-center p-2 rounded-full bg-green-50 text-green-600 hover:bg-green-100 transition-colors border border-green-200"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-green-500 rounded-full border-2 border-white"></span>
            </a>
          ) : (
            <a
              href="/account/login"
              id="login-btn"
              aria-label="Login to your account"
              class="hidden md:flex items-center justify-center p-2 rounded-full text-primary hover:text-accent-warm hover:bg-primary/5 transition-all duration-200"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </a>
          )}

          <!-- Mobile Menu Toggle -->
          <button
            id="mobile-menu-btn"
            aria-label="Toggle mobile menu"
            aria-expanded="false"
            class="md:hidden p-2 rounded-full text-primary hover:text-accent-warm hover:bg-primary/5 transition-all duration-200"
          >
            <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden bg-surface border-t border-background-alt max-h-[calc(100vh-64px)] overflow-y-auto overscroll-contain">
      <div class="px-4 py-4 flex flex-col gap-1">
        {useDynamicNav ? headerNav.map(link => (
            link.children && link.children.length > 0 ? (
              <details class="group">
                <summary class="list-none px-4 py-3 text-sm font-medium text-primary hover:text-accent-warm hover:bg-primary/5 rounded-xl transition-all duration-200 cursor-pointer flex items-center justify-between">
                  {link.label}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 opacity-50 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </summary>
                <div class="pl-4 mt-1 space-y-1">
                  {link.children.map(child => (
                    <a href={child.url || '#'} class="block px-4 py-2 text-sm text-primary/80 hover:text-primary hover:bg-primary/5 rounded-xl transition-all">{child.label}</a>
                  ))}
                </div>
              </details>
            ) : (
              <a href={link.url || '#'} class="px-4 py-3 text-sm font-medium text-primary hover:text-accent-warm hover:bg-primary/5 rounded-xl transition-all duration-200">{link.label}</a>
            )
          )) : DEFAULT_NAV_LINKS.map(link => (
            <a
              href={link.href}
              class="px-4 py-3 text-sm font-medium text-primary hover:text-accent-warm hover:bg-primary/5 rounded-xl transition-all duration-200"
            >
              {link.label}
            </a>
          ))}
          
        {/* Support & Company Links (Moved from Footer for Mobile) */}
        <div class="pt-2 mt-2 border-t border-background-alt space-y-1">
          <p class="px-4 py-2 text-xs font-semibold text-primary/50 uppercase tracking-wider">Help & Information</p>
          {[...companyLinks, ...supportLinks].map(link => (
             <a href={link.href} class="block px-4 py-2.5 text-sm font-medium text-primary/80 hover:text-primary hover:bg-primary/5 rounded-xl transition-all duration-200">
               {link.label}
             </a>
          ))}
        </div>

        <div class="pt-2 border-t border-background-alt mt-2">
          {isLoggedIn ? (
            <a href="/account" class="btn-primary w-full justify-center !bg-green-600 hover:!bg-green-700 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              My Account (Active)
            </a>
          ) : (
            <a href="/account/login" class="btn-primary w-full justify-center">Login / Sign Up</a>
          )}
        </div>
      </div>
      
      {/* Contact & Address Section (Moved from Footer) */}
      <div class="px-4 py-6 pb-32 border-t border-background-alt mt-2 bg-background-alt/30">
        <div class="flex items-center gap-3 mb-4">
           {logoUrl ? <img src={logoUrl} alt={storeName} class="h-8 object-contain" /> : <div class="h-8 w-8 bg-primary/10 rounded flex items-center justify-center text-primary shrink-0"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>}
           <span class="font-serif font-bold text-lg text-primary">{storeName}</span>
        </div>
        <p class="text-xs text-primary/70 leading-relaxed mb-4">
          {s('parent_company_name') && (
            <Fragment>A Brand by <span data-setting="parent_company_name">{s('parent_company_name')}</span>.<br/></Fragment>
          )}
          <span data-setting="footer_description">{s('footer_description', 'Premium products directly from the manufacturer. 100% genuine and high quality.')}</span>
        </p>
        
        <div class="text-xs text-primary/70 space-y-1 mb-4">
          {s('parent_company_name') && <p class="font-semibold text-primary uppercase" data-setting="parent_company_name">{s('parent_company_name')}</p>}
          <p class="whitespace-pre-line" data-setting="contact_address" data-setting-html><Fragment set:html={s('contact_address')} /></p>
          {s('contact_email') && <p class="pt-2"><a href={`mailto:${s('contact_email')}`} class="hover:text-accent-warm transition-colors font-medium" data-setting="contact_email">{s('contact_email')}</a></p>}
          {s('contact_phone') && <p class="font-medium" data-setting="contact_phone">{s('contact_phone')}</p>}
        </div>

        {/* Socials */}
        <div class="flex items-center gap-3 mt-4 mb-4">
          {s('social_facebook') && (
            <a href={s('social_facebook')} aria-label="Facebook" target="_blank" rel="noopener" class="p-2 rounded-full bg-primary/5 hover:bg-primary hover:text-surface transition-all duration-300">
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
            </a>
          )}
          {s('social_instagram') && (
            <a href={s('social_instagram')} aria-label="Instagram" target="_blank" rel="noopener" class="p-2 rounded-full bg-primary/5 hover:bg-primary hover:text-surface transition-all duration-300">
