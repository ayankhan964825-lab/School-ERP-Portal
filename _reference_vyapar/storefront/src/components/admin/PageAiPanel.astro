---
// PageAiPanel.astro
// Embedded per-page AI Assistant with Guide + Chat tabs
// Props:
//   page       - page identifier (e.g. "orders", "products")
//   pageDataJson - JSON string of page's live data for AI context
//   quickActions - array of { label, query } for suggestion chips
//   guideHtml  - HTML content for Guide tab (EN)
//   guideHtmlHi - HTML content for Guide tab (HI)
//   guideTitleEn / guideTitleHi - guide tab title

export interface Props {
  page: string;
  title?: string;
  pageDataJson?: string;
  quickActions?: { label: string; query: string }[];
  guideHtml?: string;
  guideHtmlHi?: string;
  guideTitleEn?: string;
  guideTitleHi?: string;
}

const {
  page,
  title = 'AI Assistant',
  pageDataJson = '{}',
  quickActions = [],
  guideHtml = '<p>No guide available for this section.</p>',
  guideHtmlHi = '<p>Is section ke liye guide available nahi hai.</p>',
  guideTitleEn = 'Page Guide',
  guideTitleHi = 'Page ki Jankari',
} = Astro.props;

const panelId = `ai-panel-${page}`;
---

<!-- ── AI Panel Wrapper (embedded in page header area) ─────────────── -->
<div id={panelId} class="mb-6">

  <!-- Toggle Button Row -->
  <div class="flex items-center gap-3">
    <button
      id={`${panelId}-toggle`}
      class="flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-violet-600 to-indigo-600 text-white text-sm font-semibold shadow-md shadow-indigo-500/20 hover:shadow-indigo-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
      aria-expanded="false"
      aria-controls={`${panelId}-body`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
      </svg>
      <span>✨ {title}</span>
      <svg id={`${panelId}-chevron`} xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform duration-200 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
  </div>

  <!-- Panel Body (collapsed by default) -->
  <div
    id={`${panelId}-body`}
    class="hidden mt-3 bg-white border border-gray-200 rounded-2xl shadow-lg shadow-gray-100 overflow-hidden"
  >

    <!-- Tab Bar -->
    <div class="flex border-b border-gray-100 bg-gray-50/50">
      <button
        id={`${panelId}-tab-guide`}
        class="ai-tab-btn flex items-center gap-1.5 px-4 py-3 text-sm font-semibold text-violet-600 border-b-2 border-violet-600 transition-all"
        data-tab="guide"
      >
        📖 Guide
      </button>
      <button
        id={`${panelId}-tab-chat`}
        class="ai-tab-btn flex items-center gap-1.5 px-4 py-3 text-sm font-semibold text-secondary/50 border-b-2 border-transparent hover:text-secondary transition-all"
        data-tab="chat"
      >
        ⚡ AI Chat
      </button>
    </div>

    <!-- ── Guide Tab ──────────────────────────────────────────────── -->
    <div id={`${panelId}-panel-guide`} class="ai-tab-panel p-5">
      <div class="flex justify-between items-center mb-4">
        <h3 id={`${panelId}-guide-title`} class="font-bold text-secondary text-sm">{guideTitleEn}</h3>
        <div class="flex gap-1 bg-gray-100 p-0.5 rounded-lg">
          <button class="guide-lang-btn active-lang px-3 py-1 text-xs font-semibold rounded-md bg-white text-violet-600 shadow-sm transition-all" data-lang="en">EN</button>
          <button class="guide-lang-btn px-3 py-1 text-xs font-semibold rounded-md text-secondary/50 hover:text-secondary transition-all" data-lang="hi">HI</button>
        </div>
      </div>
      <div id={`${panelId}-guide-content`} class="prose prose-sm prose-p:text-secondary/80 prose-li:text-secondary/80 max-w-none text-sm">
        <Fragment set:html={guideHtml} />
      </div>
    </div>

    <!-- ── Chat Tab ───────────────────────────────────────────────── -->
    <div id={`${panelId}-panel-chat`} class="ai-tab-panel hidden flex flex-col" style="height: 420px;">

      <!-- Messages -->
      <div id={`${panelId}-messages`} class="flex-1 overflow-y-auto p-4 space-y-3 scroll-smooth">
        <!-- Welcome message -->
        <div class="flex gap-2.5">
          <div class="w-7 h-7 rounded-full bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
          </div>
          <div class="bg-violet-50 border border-violet-100 rounded-2xl rounded-tl-sm px-3.5 py-2.5 text-sm text-secondary max-w-[85%]">
            Namaste! Main is section ka AI assistant hoon. Aap mujhse kuch bhi pooch sakte hain ya action karne ko bol sakte hain. ✨
          </div>
        </div>
      </div>

      <!-- Quick Action Chips -->
      <div id={`${panelId}-chips`} class="px-4 pb-2 flex flex-wrap gap-1.5">
      </div>

      <!-- Confirm Dialog (hidden by default) -->
      <div id={`${panelId}-confirm`} class="hidden mx-4 mb-3 p-3 bg-amber-50 border border-amber-200 rounded-xl">
        <p id={`${panelId}-confirm-msg`} class="text-sm text-amber-800 font-medium mb-2"></p>
        <div class="flex gap-2">
          <button id={`${panelId}-confirm-yes`} class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold rounded-lg transition-colors">✓ Haan, karo</button>
          <button id={`${panelId}-confirm-no`} class="px-3 py-1.5 bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs font-bold rounded-lg transition-colors">✗ Nahi</button>
        </div>
      </div>

      <!-- Input Row -->
      <div class="border-t border-gray-100 p-3 flex gap-2">
        <input
          id={`${panelId}-input`}
          type="text"
          placeholder="Type your question or command..."
          class="flex-1 px-3.5 py-2.5 text-sm border border-gray-200 rounded-xl focus:border-violet-400 focus:ring-2 focus:ring-violet-400/20 outline-none bg-gray-50 transition-all"
          autocomplete="off"
        />
        <button
          id={`${panelId}-send`}
          class="px-3.5 py-2.5 bg-gradient-to-r from-violet-600 to-indigo-600 text-white rounded-xl hover:opacity-90 active:scale-95 transition-all flex items-center gap-1 text-sm font-semibold"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </button>
        <button
          id={`${panelId}-clear`}
          class="px-2.5 py-2.5 text-secondary/40 hover:text-red-500 rounded-xl transition-colors text-xs"
          title="Clear chat history"
        >🗑</button>
      </div>
    </div>

  </div>
</div>

<!-- ── Script ──────────────────────────────────────────────────────────── -->
<script define:vars={{ panelId, page, pageDataJson, quickActions, guideHtml, guideHtmlHi, guideTitleEn, guideTitleHi }}>
(function() {
  // ── Constants ──────────────────────────────────────────────────────
  var STORAGE_KEY = 'ai-chat-' + page;

  // ── DOM Helpers ────────────────────────────────────────────────────
  var $ = function(id) { return document.getElementById(id); };
  var toggleBtn    = $(panelId + '-toggle');
  var chevron      = $(panelId + '-chevron');
  var body         = $(panelId + '-body');
  var modeBadge    = $(panelId + '-mode-badge');
  var tabGuideBtn  = $(panelId + '-tab-guide');
  var tabChatBtn   = $(panelId + '-tab-chat');
  var panelGuide   = $(panelId + '-panel-guide');
  var panelChat    = $(panelId + '-panel-chat');
  var messages     = $(panelId + '-messages');
  var input        = $(panelId + '-input');
  var sendBtn      = $(panelId + '-send');
  var clearBtn     = $(panelId + '-clear');
  var chipsEl      = $(panelId + '-chips');
  var confirmBox   = $(panelId + '-confirm');
  var confirmMsg   = $(panelId + '-confirm-msg');
  var confirmYes   = $(panelId + '-confirm-yes');
  var confirmNo    = $(panelId + '-confirm-no');
  var guideTitle   = $(panelId + '-guide-title');
  var guideContent = $(panelId + '-guide-content');

  var pendingAction = null;
  var currentLang   = 'en';
  var isLoading     = false;

  // ── Chat History (localStorage) ────────────────────────────────────
  function loadHistory() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
    catch { return []; }
  }
  function saveHistory(hist) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(hist.slice(-30))); } // keep last 30 msgs
    catch {}
  }

  // ── Panel Toggle ───────────────────────────────────────────────────
  toggleBtn && toggleBtn.addEventListener('click', function() {
    var open = body.classList.contains('hidden');
    body.classList.toggle('hidden', !open);
    chevron && chevron.classList.toggle('rotate-180', open);
    toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) {
      // Restore saved history on open
      restoreHistoryUI();
      if (input) setTimeout(function() { input.focus(); }, 100);
    }
  });

  // ── Tab Switching ──────────────────────────────────────────────────
  function setTab(tab) {
    var isGuide = tab === 'guide';
    panelGuide && panelGuide.classList.toggle('hidden', !isGuide);
    panelChat  && panelChat.classList.toggle('hidden', isGuide);

    tabGuideBtn && tabGuideBtn.classList.toggle('text-violet-600', isGuide);
    tabGuideBtn && tabGuideBtn.classList.toggle('border-violet-600', isGuide);
    tabGuideBtn && tabGuideBtn.classList.toggle('text-secondary/50', !isGuide);
    tabGuideBtn && tabGuideBtn.classList.toggle('border-transparent', !isGuide);

    tabChatBtn && tabChatBtn.classList.toggle('text-violet-600', !isGuide);
    tabChatBtn && tabChatBtn.classList.toggle('border-violet-600', !isGuide);
    tabChatBtn && tabChatBtn.classList.toggle('text-secondary/50', isGuide);
    tabChatBtn && tabChatBtn.classList.toggle('border-transparent', isGuide);
  }

  tabGuideBtn && tabGuideBtn.addEventListener('click', function() { setTab('guide'); });
  tabChatBtn  && tabChatBtn.addEventListener('click', function() { setTab('chat'); });

  // ── Guide Language Toggle ──────────────────────────────────────────
  var langBtns = document.querySelectorAll('#' + panelId + ' .guide-lang-btn');
  langBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var lang = btn.getAttribute('data-lang');
      currentLang = lang;
      langBtns.forEach(function(b) {
        var active = b.getAttribute('data-lang') === lang;
        b.classList.toggle('bg-white', active);
        b.classList.toggle('text-violet-600', active);
        b.classList.toggle('shadow-sm', active);
        b.classList.toggle('text-secondary/50', !active);
      });
      if (guideTitle) guideTitle.textContent = lang === 'en' ? guideTitleEn : guideTitleHi;
      if (guideContent) guideContent.innerHTML = lang === 'en' ? guideHtml : guideHtmlHi;
    });
  });

  // ── Quick Action Chips ─────────────────────────────────────────────
  if (chipsEl && quickActions.length) {
    quickActions.forEach(function(qa) {
      var chip = document.createElement('button');
      chip.className = 'px-3 py-1.5 text-xs font-medium bg-gray-100 hover:bg-violet-100 hover:text-violet-700 text-secondary/70 rounded-lg border border-transparent hover:border-violet-200 transition-all whitespace-nowrap';
      chip.textContent = qa.label;
      chip.addEventListener('click', function() {
        if (input) input.value = qa.query;
        setTab('chat');
        sendMessage();
      });
      chipsEl.appendChild(chip);
    });
  }

  // ── Message Rendering ──────────────────────────────────────────────
  function addMessage(role, content, actionBtn) {
    if (!messages) return;
    var bubble = document.createElement('div');
    bubble.className = 'flex gap-2.5 ' + (role === 'user' ? 'flex-row-reverse' : '');

    var avatar = document.createElement('div');
    avatar.className = role === 'user'
      ? 'w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold text-secondary/60'
      : 'w-7 h-7 rounded-full bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center shrink-0 mt-0.5';
    avatar.innerHTML = role === 'user'
      ? '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>'
      : '<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>';

    var textWrap = document.createElement('div');
    textWrap.className = 'max-w-[85%]';

    var msgDiv = document.createElement('div');
    msgDiv.className = role === 'user'
      ? 'bg-violet-600 text-white rounded-2xl rounded-tr-sm px-3.5 py-2.5 text-sm'
      : 'bg-gray-100 rounded-2xl rounded-tl-sm px-3.5 py-2.5 text-sm text-secondary';
    msgDiv.textContent = content;

    textWrap.appendChild(msgDiv);

    if (actionBtn) {
      var btnEl = document.createElement('button');
      btnEl.className = 'mt-1.5 flex items-center gap-1.5 px-3 py-1.5 bg-violet-600 hover:bg-violet-700 text-white text-xs font-semibold rounded-lg transition-colors';
      btnEl.innerHTML = '▶ ' + actionBtn.label;
      btnEl.addEventListener('click', actionBtn.onClick);
      textWrap.appendChild(btnEl);
    }

    bubble.appendChild(avatar);
    bubble.appendChild(textWrap);
    messages.appendChild(bubble);
    messages.scrollTop = messages.scrollHeight;
  }

  function addTypingIndicator() {
    if (!messages) return null;
    var el = document.createElement('div');
    el.id = panelId + '-typing';
    el.className = 'flex gap-2.5';
    el.innerHTML = '<div class="w-7 h-7 rounded-full bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center shrink-0"><svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg></div><div class="bg-gray-100 rounded-2xl rounded-tl-sm px-4 py-3 flex gap-1 items-center"><span class="w-2 h-2 bg-violet-400 rounded-full animate-bounce" style="animation-delay:0ms"></span><span class="w-2 h-2 bg-violet-400 rounded-full animate-bounce" style="animation-delay:150ms"></span><span class="w-2 h-2 bg-violet-400 rounded-full animate-bounce" style="animation-delay:300ms"></span></div>';
    messages.appendChild(el);
    messages.scrollTop = messages.scrollHeight;
    return el;
  }

  // ── Restore History from localStorage ─────────────────────────────
  function restoreHistoryUI() {
    var hist = loadHistory();
    if (!hist.length || !messages) return;
    // Clear welcome message
    while (messages.children.length > 1) messages.removeChild(messages.lastChild);
    hist.forEach(function(m) { addMessage(m.role, m.content); });
  }

  // ── Confirm Dialog ─────────────────────────────────────────────────
  function showConfirm(message, onConfirm) {
    pendingAction = onConfirm;
    if (confirmMsg) confirmMsg.textContent = message;
    confirmBox && confirmBox.classList.remove('hidden');
  }

  confirmYes && confirmYes.addEventListener('click', function() {
    confirmBox && confirmBox.classList.add('hidden');
    if (pendingAction) { pendingAction(); pendingAction = null; }
  });
  confirmNo && confirmNo.addEventListener('click', function() {
    confirmBox && confirmBox.classList.add('hidden');
    pendingAction = null;
    addMessage('assistant', 'Theek hai, action cancel kar diya gaya.');
  });

  // ── Execute Page Actions ───────────────────────────────────────────
  // This function is called after AI responds and we need to perform UI action
  function executeAction(action, params) {
    if (!action) return;
    // Dispatch custom event — page's own script listens and handles it
    document.dispatchEvent(new CustomEvent('ai-action', { detail: { action: action, params: params || {} } }));
  }

  // ── Send Message ───────────────────────────────────────────────────
  async function sendMessage() {
    var query = input && input.value.trim();
    if (!query || isLoading) return;
    if (input) input.value = '';

    isLoading = true;
    if (sendBtn) sendBtn.disabled = true;

    // Add user message
    addMessage('user', query);

    // Update chat history
    var hist = loadHistory();
    hist.push({ role: 'user', content: query });

    // Show typing indicator
    var typing = addTypingIndicator();

    try {
      var resp = await fetch('/api/admin/ai-assistant', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          page: page,
          query: query,
          pageData: JSON.parse(pageDataJson || '{}'),
          history: hist.slice(-10)
        })
      });

      var data = await resp.json();

      // Remove typing indicator
      typing && typing.remove();

      // Update mode badge
      if (modeBadge) {
        if (data.mode === 'gemini') {
          modeBadge.textContent = 'Gemini ✦';
          modeBadge.className = 'text-[10px] font-bold px-2 py-1 rounded-full bg-violet-100 text-violet-700 border border-violet-200';
        } else {
          modeBadge.textContent = 'Smart Match';
          modeBadge.className = 'text-[10px] font-bold px-2 py-1 rounded-full bg-amber-100 text-amber-700 border border-amber-200';
        }
      }

      // Save assistant reply to history
      hist.push({ role: 'assistant', content: data.reply });
      saveHistory(hist);

      // Build action button if needed
      var actionBtn = null;
      if (data.action && data.action !== 'null') {
        var actionLabel = getActionLabel(data.action);
        var actionFn = data.confirmRequired
          ? function() {
              showConfirm(
                data.confirmMessage || 'Kya aap sure hain?',
                function() { executeAction(data.action, data.params); }
              );
            }
          : function() { executeAction(data.action, data.params); };

        actionBtn = { label: actionLabel, onClick: actionFn };
      }

      addMessage('assistant', data.reply, actionBtn);

      // Auto-execute non-destructive actions immediately
      if (data.action && !data.confirmRequired && data.action !== 'null') {
        setTimeout(function() { executeAction(data.action, data.params); }, 200);
      }

    } catch (err) {
      typing && typing.remove();
      addMessage('assistant', 'Network error. Please try again.');
    }

    isLoading = false;
    if (sendBtn) sendBtn.disabled = false;
    if (input) input.focus();
  }

  function getActionLabel(action) {
    var labels = {
      filter_status: '🔍 Filter Apply Karein',
      filter_date: '📅 Date Filter Lagayein',
      search_order: '🔍 Order Dhundhein',
      bulk_print: '🖨️ Print Karein',
      bulk_status_update: '✏️ Status Update Karein',
      navigate: '→ Navigate Karein',
      select_by_status: '✓ Select Karein',
      select_by_date: '✓ Date Se Select Karein',
      print_invoices: '🖨️ Invoices Print Karein',
      print_labels: '🏷️ Labels Print Karein',
      export_csv: '📊 CSV Export Karein',
      clear_selection: '✗ Clear Karein',
      search_product: '🔍 Product Dhundhein',
      filter_category: '📂 Category Filter',
      toggle_stock: '📦 Stock Toggle',
      navigate_edit: '✏️ Edit Pe Jaayein',
      generate_description: '✨ Description Banayein',
      scroll_to: '↓ Section Pe Jaayein',
      create_campaign: '🚀 Campaign Banayein',
      open_offer_modal: '+ Offer Kholein',
      toggle_flash_sale: '⚡ Flash Sale Toggle',
      search_customer: '🔍 Customer Dhundhein',
      generate_coupon_code: '🎟️ Code Generate Karein',
      open_add_form: '+ Form Kholein',
      filter_rating: '⭐ Rating Filter',
      filter_product: '📦 Product Filter',
      approve_review: '✓ Approve Karein',
      reject_review: '✗ Reject Karein',
      mark_all_read: '✓ Sab Read Mark Karein',
      generate_meta: '✨ SEO Generate Karein',
      generate_outline: '📝 Outline Banayein',
      generate_listing: '✨ Listing Generate Karein',
      // Agentic form fill labels:
      fill_settings: '✨ Settings Fill Karein',
      fill_category_form: '✨ Category Details Bharein',
      fill_coupon_form: '🎟️ Coupon Details Bharein',
      fill_flash_sale_setup: '⚡ Flash Sale Setup Karein',
      fill_hero_slide: '🖼️ Slide Details Bharein',
      fill_global_seo: '🔍 SEO Details Bharein',
      fill_marketing_ids: '📊 Marketing IDs Bharein',
      fill_blog_post: '📝 Blog Post Bharein',
      open_invite_form: '👤 Staff Invite Form Kholein',
      filter_notifications: '🔔 Notifications Filter',
      filter_reviews: '⭐ Reviews Filter',
      switch_tab: '📑 Tab Switch Karein',
      resolve_all_feedback: '✓ Sab Resolve Karein',
      mark_all_bulk_contacted: '✓ Sab Contacted Mark Karein',
      approve_all_pending: '✓ Sab Approve Karein',
      open_add_zone_modal: '📦 Zone Add Karein',
      new_post: '📝 New Post Likhein',
      show_all: '📋 Sab Dikhayein',
      update_awb: '📝 AWB Fill Karein',
      update_status: '✏️ Status Change Karein'
    };
    return labels[action] || '▶ Action Karein';
  }

  // ── Input Events ───────────────────────────────────────────────────
  input && input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  });
  sendBtn && sendBtn.addEventListener('click', sendMessage);

  // ── Clear History ──────────────────────────────────────────────────
  clearBtn && clearBtn.addEventListener('click', function() {
    localStorage.removeItem(STORAGE_KEY);
    if (messages) {
