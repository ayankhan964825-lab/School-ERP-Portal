---
import Layout from '../layouts/Layout.astro';
import { getBlogPosts, getSettings } from '../lib/database';

// Smart cache: serve from CDN for 60s, refresh in background
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const rawSettings = await getSettings();
const settings = rawSettings || {};
const brandName = settings?.brand_name || 'Our Store';

const allPosts = await getBlogPosts();
const posts = allPosts.filter((p: any) => p.is_published !== false);

const displayPosts = posts;
---

<Layout title={`Blog - ${brandName}`} description="Read our latest articles on health, nutrition, and sustainable living.">
  <div class="bg-surface min-h-screen">
    <!-- Header -->
    <div class="bg-primary/5 py-10 lg:py-16 border-b border-theme-section-muted">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-secondary mb-4">The {brandName} Journal</h1>
        <p class="text-secondary/70 text-lg" data-setting="blog_subtitle">{settings?.blog_subtitle || 'Health tips, recipes, and stories from our farms.'}</p>
      </div>

      {displayPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {displayPosts.map((post: any) => {
            const imageUrl = post.cover_image || post.featured_image_url || '';
            const postUrl = `/blog/${post.slug}`;
            const category = post.category || (post.tags && post.tags[0]) || 'Article';
            return (
              <a href={postUrl} class="group block">              <article class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md transition-shadow h-full flex flex-col">
                  {imageUrl && (
                  <div class="aspect-[16/10] bg-gray-100 overflow-hidden">
                    <img
                      src={imageUrl}
                      alt={post.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      onerror="this.src='https://placehold.co/600x375/e2e8f0/64748b?text=Blog'"
                    />
                  </div>
                  )}
                  <div class="p-5 flex flex-col flex-1">
                    <div class="flex items-center gap-3 mb-3">
                      <span class="text-xs font-medium text-primary bg-primary/10 px-2.5 py-0.5 rounded-full capitalize">{category}</span>
                      <span class="text-xs text-secondary/40">
                        {new Date(post.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                      </span>
                    </div>
                    <h2 class="text-lg font-serif font-bold text-secondary group-hover:text-primary transition-colors mb-2 line-clamp-2">
                      {post.title}
                    </h2>
                    <p class="text-sm text-secondary/60 line-clamp-3 flex-1">{post.excerpt}</p>
                    <div class="mt-4 text-sm font-semibold text-primary group-hover:underline flex items-center gap-1">
                      Read More
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                    </div>
                  </div>
                </article>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-12 md:py-20 bg-white rounded-2xl border border-gray-100">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-.586-1.414l-4.5-4.5A2 2 0 0012.586 3H12" />
          </svg>
          <h2 class="text-xl font-serif font-bold text-gray-900 mb-2">No Articles Yet</h2>
          <p class="text-gray-500 max-w-md mx-auto">Check back soon for new articles, tips, and updates from {brandName}.</p>
        </div>
      )}

    </div>
  </div>
</Layout>
