---
/**
 * qcommerce-category.astro
 * Category Deep-Dive (Split View)
 * - Left Sidebar: Vertical categories
 * - Right Pane: Filters, Sort, 2-column Product Grid
 */

import QCommerceLayout from '../layouts/QCommerceLayout.astro';
import QProductCard from '../components/QProductCard.astro';
import { getStorefrontProducts, getCategories, getSettings, getCategoryTree } from '../lib/database';

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=120');

const forceStoreId = Astro.locals.storeId;
let currentCatSlug = Astro.url.searchParams.get('category') || 'all';

const [allProductsRaw, dbCategoryTree, dbCategoriesFlat, settings] = await Promise.all([
  getStorefrontProducts(forceStoreId, Astro.cookies.get('delivery_pincode')?.value),
  getCategoryTree(forceStoreId),
  getCategories(forceStoreId),
  getSettings(forceStoreId),
]);

const storeName = settings?.brand_name || settings?.store_name || 'Store';
const rawEta = settings?.delivery_time || '10';
const deliveryEta = rawEta.toString().replace(/mins?|minutes?/ig, '').trim();

let webConfig: any = {};
try {
  if (settings?.website_configuration) {
    const parsed = typeof settings.website_configuration === 'string' ? JSON.parse(settings.website_configuration) : settings.website_configuration;
    webConfig = { ...parsed };
  }
} catch(e) {}

const hideOutOfStock = webConfig.hide_out_of_stock === true || webConfig.hide_out_of_stock === 'true';

const allProducts = allProductsRaw
  .filter((p: any) => p.is_active !== false)
  .filter((p: any) => {
    if (!hideOutOfStock) return true;
    return (p.variants || []).some((v: any) => !v.is_hidden && !v.is_out_of_stock);
  })
  .map((p: any) => ({ ...p, variants: (p.variants || []).filter((v: any) => !v.is_hidden) }))
  .filter((p: any) => p.variants.length > 0);

// 1. Find active category from flat list
// 1. Find active category from flat list
currentCatSlug = Astro.url.searchParams.get('category') || 'all';
let activeCategory = dbCategoriesFlat.find((c: any) => c.slug === currentCatSlug);
if (!activeCategory) {
  currentCatSlug = 'all';
  activeCategory = { name: 'All Products', slug: 'all', id: 'all' };
}

// 2. Figure out Sidebar items (Level 2 Siblings) and Filter Pills (Level 3 Children)
let sidebarCategories: any[] = [];
let filterPills: any[] = [];
let pageHeaderTitle = activeCategory.name;

if (currentCatSlug === 'all') {
  // If 'all', show ALL Level 2 categories in sidebar
  sidebarCategories = dbCategoryTree.flatMap((mega: any) => mega.children || []);
} else {
  // Find which Mega category (Level 1) this active category belongs to
  let parentMega = dbCategoryTree.find((mega: any) => 
    mega.slug === activeCategory.slug || // If it's a Mega itself
    (mega.children || []).some((l2: any) => 
      l2.slug === activeCategory.slug || 
      (l2.children || []).some((l3: any) => l3.slug === activeCategory.slug)
    )
  );
  
  if (parentMega) {
    sidebarCategories = parentMega.children || [];
    
    // Find active Level 2 to get its Level 3 children for pills
    const activeL2 = sidebarCategories.find((l2: any) => 
      l2.slug === activeCategory.slug || 
      (l2.children || []).some((l3: any) => l3.slug === activeCategory.slug)
    );
    if (activeL2) {
      filterPills = activeL2.children || [];
      if (activeL2.slug !== activeCategory.slug) {
        // We are viewing a Level 3 category, so set it as active in the pill but keep L2 active in sidebar
      }
    }
  } else {
    // Fallback if not found in tree
    sidebarCategories = [activeCategory];
  }
}

// Ensure unique sidebar categories
sidebarCategories = [...new Map(sidebarCategories.map(item => [item.slug, item])).values()];

// Recursive function to get all descendant categories for the active category
const validCategoryIds = new Set<string>();
const validCategorySlugs = new Set<string>();

if (currentCatSlug !== 'all') {
  validCategoryIds.add(activeCategory.id);
  validCategorySlugs.add(activeCategory.slug);
  
  const collectDescendants = (parentId: string) => {
    const children = dbCategoriesFlat.filter((c: any) => c.parent_id === parentId);
    for (const child of children) {
      if (!validCategoryIds.has(child.id)) {
        validCategoryIds.add(child.id);
        validCategorySlugs.add(child.slug);
        collectDescendants(child.id);
      }
    }
  };
  collectDescendants(activeCategory.id);
}

// 3. Filter products
const displayedProducts = currentCatSlug === 'all' 
  ? allProducts 
  : allProducts.filter((p: any) => 
      validCategorySlugs.has(p.category) || 
      validCategoryIds.has(p.category_id) ||
      (filterPills.length > 0 && filterPills.some((pill: any) => p.category === pill.slug || p.category_id === pill.id))
    );

---

<QCommerceLayout title={`${activeCategory.name} - ${storeName}`} settings={settings}>
  
  <div class="flex h-[calc(100vh-130px)] bg-white overflow-hidden mt-[1px]">
    <!-- LEFT SIDEBAR -->
    <div class="w-[76px] sm:w-[85px] flex-shrink-0 bg-slate-50 border-r border-slate-100 overflow-y-auto qc-scrollbar-hide pb-20">
      <a href="/qcommerce-category?category=all" class={`flex flex-col items-center gap-1.5 p-2 relative ${currentCatSlug === 'all' ? 'bg-white' : 'hover:bg-slate-100 transition-colors'}`}>
        {currentCatSlug === 'all' && <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-primary rounded-r-md"></div>}
        <div class={`w-[46px] h-[46px] bg-[#f4f6f9] rounded-2xl flex items-center justify-center overflow-hidden p-1.5 border ${currentCatSlug === 'all' ? 'border-primary bg-primary/5 shadow-sm' : 'border-transparent'}`}>
          <img src="/placeholder-category.svg" alt="All" class="w-full h-full object-contain mix-blend-multiply opacity-50" onerror="this.style.display='none'" />
        </div>
        <span class={`text-[10px] text-center font-medium leading-tight ${currentCatSlug === 'all' ? 'text-slate-900 font-bold' : 'text-slate-600'}`}>All</span>
      </a>
      
      {sidebarCategories.map((cat: any) => {
        // Check if this L2 is active, OR if any of its L3 children is active
        const isL2Active = currentCatSlug === cat.slug || (cat.children || []).some((l3: any) => l3.slug === currentCatSlug);
        
        return (
          <a href={`/qcommerce-category?category=${cat.slug}`} class={`flex flex-col items-center gap-1.5 p-2 relative ${isL2Active ? 'bg-white' : 'hover:bg-slate-100 transition-colors'}`}>
            {isL2Active && <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-primary rounded-r-md"></div>}
            <div class={`w-[46px] h-[46px] bg-[#f4f6f9] rounded-2xl flex items-center justify-center overflow-hidden p-1.5 border ${isL2Active ? 'border-primary bg-primary/5 shadow-sm' : 'border-transparent'}`}>
              {cat.image ? (
                <img src={cat.image} alt={cat.name} class="w-full h-full object-contain mix-blend-multiply" loading="lazy" />
              ) : (
                <span class="text-xl text-slate-400">{cat.name.charAt(0)}</span>
              )}
            </div>
            <span class={`text-[10px] text-center font-medium leading-tight ${isL2Active ? 'text-slate-900 font-bold' : 'text-slate-600'}`}>{cat.name}</span>
          </a>
        );
      })}
    </div>

    <!-- RIGHT PANE -->
    <div class="flex-1 bg-[#f4f6f9] overflow-y-auto pb-24 relative">
      
      <!-- HEADER with Back Button -->
      <div class="sticky top-0 z-20 bg-white border-b border-slate-100 px-3 py-3 flex items-center justify-between shadow-sm">
        <div class="flex items-center gap-2">
          <button onclick="history.back()" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-100">
            <svg class="w-5 h-5 text-slate-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <div class="flex flex-col">
            <h1 class="text-[15px] font-bold text-slate-800 leading-tight">{pageHeaderTitle}</h1>
            <p class="text-[10px] font-medium text-[#0c831f]">Delivering to your location</p>
          </div>
        </div>
        <div class="flex items-center gap-1">
          <button class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-100" onclick="document.dispatchEvent(new CustomEvent('qc:openSearch'))">
            <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </button>
          <button class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-100">
            <svg class="w-4 h-4 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          </button>
        </div>
      </div>

      <!-- Filters Strip (Level 3 Sub-categories) -->
      <div class="bg-white border-b border-slate-100 p-2.5 flex items-center gap-2 overflow-x-auto qc-scrollbar-hide sticky top-[48px] z-10 shadow-[0_4px_6px_-6px_rgba(0,0,0,0.1)]">
        <button class="flex items-center gap-1.5 px-3 py-1.5 border border-slate-200 rounded-lg text-[11px] font-medium text-slate-700 bg-white flex-shrink-0 shadow-sm">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12v2m0 4v2m0 4v2m-6-10h12m-12 4h12m-12 4h12"/></svg>
          Filters ▾
        </button>
        <button class="flex items-center gap-1.5 px-3 py-1.5 border border-slate-200 rounded-lg text-[11px] font-medium text-slate-700 bg-white flex-shrink-0 shadow-sm">
          ↑↓ Sort ▾
        </button>
        
        {filterPills.length > 0 && <div class="w-px h-4 bg-slate-300 mx-1 flex-shrink-0"></div>}
        
        {filterPills.map((pill: any) => (
          <a href={`/qcommerce-category?category=${pill.slug}`} class={`flex items-center gap-1.5 px-3 py-1.5 border rounded-lg text-[11px] font-medium flex-shrink-0 shadow-sm transition-colors ${currentCatSlug === pill.slug ? 'border-[#0c831f] bg-green-50 text-[#0c831f]' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50'}`}>
            {pill.name}
          </a>
        ))}
      </div>

      <!-- Category Header -->
      <div class="p-4 pb-2">
        <h1 class="text-xl font-extrabold text-slate-900">{activeCategory.name}</h1>
        <p class="text-[11px] text-slate-600 mt-0.5">Nutritional goodness in every bite</p>
      </div>

      <!-- Grid -->
      <div class="p-3 grid grid-cols-2 gap-3 max-w-2xl mx-auto" id="qc-products-grid">
        {displayedProducts.length > 0 ? (
          displayedProducts.map((p: any, index: number) => (
            <div class={index >= 16 ? 'hidden qc-paginated-item' : 'qc-paginated-item'}>
              <QProductCard {...p} categoryName={activeCategory.name} categorySlug={activeCategory.slug} deliveryMins={deliveryEta} storeName={storeName} />
            </div>
          ))
        ) : (
          <div class="col-span-2 text-center py-12 text-slate-500">
            <svg class="w-12 h-12 mx-auto mb-2 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
            <p>No products found in this category.</p>
          </div>
        )}
      </div>

      <!-- Load More Trigger -->
      {displayedProducts.length > 16 && (
        <div id="qc-load-more-trigger" class="py-8 flex justify-center pb-24">
           <svg class="animate-spin h-6 w-6 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        </div>
      )}

    </div>
  </div>
</QCommerceLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('qc-load-more-trigger');
    if (!trigger) return;

    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        // Find next 16 hidden items
        const hiddenItems = Array.from(document.querySelectorAll('.qc-paginated-item.hidden'));
        const batch = hiddenItems.slice(0, 16);
        
        if (batch.length > 0) {
           // Small delay for natural infinite scroll feel
           setTimeout(() => {
             batch.forEach(item => item.classList.remove('hidden'));
             // Disconnect if no more
             if (hiddenItems.length <= 16) {
                trigger.style.display = 'none';
                observer.disconnect();
             }
           }, 300);
        }
      }
    }, { rootMargin: '200px 0px', threshold: 0 });

    observer.observe(trigger);
  });
</script>
