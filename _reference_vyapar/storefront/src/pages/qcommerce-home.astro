---
import QCommerceLayout from '../layouts/QCommerceLayout.astro';
import QProductCard from '../components/QProductCard.astro';
import { getStorefrontProducts, getCategories, getHeroSlides, getSettings, getFlashSales, getCategoryTree } from '../lib/database';

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=120');
Astro.response.headers.set('Vary', 'Host');

const forceStoreId = Astro.locals.storeId;
const activeTab = Astro.url.searchParams.get('tab') || 'for-you';

const [allProductsRaw, dbCategoryTree, dbSlides, settings, dbSalesRaw] = await Promise.all([
  getStorefrontProducts(forceStoreId, Astro.cookies.get('delivery_pincode')?.value),
  getCategoryTree(forceStoreId),
  getHeroSlides(forceStoreId),
  getSettings(forceStoreId),
  getFlashSales(forceStoreId),
]);

const storeName = settings?.brand_name || settings?.store_name || 'Store';
const rawEta = settings?.delivery_time || '18';
const deliveryEta = rawEta.toString().replace(/mins?|minutes?/ig, '').trim();

let webConfig: any = {};
try {
  if (settings?.website_configuration) {
    const parsed = typeof settings.website_configuration === 'string' ? JSON.parse(settings.website_configuration) : settings.website_configuration;
    webConfig = { ...parsed };
  }
} catch(e) {}
let pagesContent: any = {};
try {
  if (settings?.pages_content) {
    const parsed = typeof settings.pages_content === 'string' ? JSON.parse(settings.pages_content) : settings.pages_content;
    pagesContent = { ...parsed };
  }
} catch(e) {}

const qcHomeConfig = pagesContent.qc_home_config || {};

const hideOutOfStock = webConfig.hide_out_of_stock === true || webConfig.hide_out_of_stock === 'true';

const allProducts = allProductsRaw
  .filter((p: any) => p.is_active !== false)
  .filter((p: any) => {
    if (!hideOutOfStock) return true;
    return (p.variants || []).some((v: any) => !v.is_hidden && !v.is_out_of_stock);
  })
  .map((p: any) => ({ ...p, variants: (p.variants || []).filter((v: any) => !v.is_hidden) }))
  .filter((p: any) => p.variants.length > 0);

// Flash Sales
const now = new Date();
const activeFlashSales = dbSalesRaw.filter((s: any) => {
  const start = new Date(s.startDate);
  const end = new Date(s.endDate);
  if (end <= now) return false;
  if (start > now) return false;
  return true;
});

const flashSaleProducts = allProducts.filter((p: any) =>
  p.variants.some((v: any) => v.isFlashSale)
).slice(0, 12);

// Categories
const topCategories = dbCategoryTree || [];
const festProducts = allProducts.filter((p: any) => p.category === qcHomeConfig?.themed_fest?.target_category_slug).slice(0, 12);

---

<QCommerceLayout title={`${storeName} - Quick Delivery`} settings={settings}>
  
  <!-- CATEGORY STRIP (shares header gradient - Blinkit style) -->
  {topCategories.length > 0 && (
    <div class="sm:hidden qc-header-bg sticky top-[52px] z-40 border-b border-slate-200/30 shadow-sm" id="qc-category-strip">
      <div class="overflow-x-auto qc-scrollbar-hide px-4 flex items-end gap-3 pb-0">
        <!-- "All" Tab (Active by default on home) -->
        <a href="/" class="flex flex-col items-center justify-end gap-1.5 pb-2 pt-3 w-[60px] flex-shrink-0 relative">
          <svg class="w-10 h-10 text-slate-900" fill="currentColor" viewBox="0 0 24 24"><path d="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-2c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm6 16H6V8h2v2c0 .55.45 1 1 1s1-.45 1-1V8h4v2c0 .55.45 1 1 1s1-.45 1-1V8h2v12z"/></svg>
          <span class="text-[11px] font-bold text-slate-900 text-center leading-tight">All</span>
          <!-- Active underline bar -->
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[80%] h-[3px] bg-slate-900 rounded-t-full"></div>
        </a>

        {topCategories.map((megaCat: any) => (
          <a href={`/qcommerce-category?category=${megaCat.slug}`} class="flex flex-col items-center justify-end gap-1.5 pb-2 pt-3 w-[68px] flex-shrink-0 relative group">
            {megaCat.image ? (
              <img src={megaCat.image} alt={megaCat.name} class="w-10 h-10 object-contain drop-shadow-sm" />
            ) : (
              <svg class="w-10 h-10 text-slate-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/></svg>
            )}
            <span class="text-[10px] font-bold text-slate-700 text-center leading-[1.1] group-hover:text-slate-900 transition-colors w-full line-clamp-2">{megaCat.name}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- PAGE CONTENT -->
  <div class="max-w-screen-xl mx-auto pb-20 bg-surface min-h-screen">

    <!-- HERO & BANNERS (Exact BB Now Match) -->
    {activeTab === 'for-you' && (
      <>
        <section class="px-3 pt-4 mb-4">
          <!-- Welcome Perks Banner -->
          <div class="bg-gradient-to-r from-[#d6f6e1] to-[#bcf5ce] rounded-2xl p-3 relative overflow-hidden flex shadow-sm">
            <!-- Left Side Text & Image -->
            <div class="w-[35%] flex flex-col justify-center pr-1 z-10">
              <h3 class="text-[13px] font-black text-slate-900 leading-tight">Your first basket comes with perks</h3>
              <div class="mt-2 w-12 h-14 bg-[#14945b] rounded-t-lg rounded-b flex flex-col items-center justify-center relative shadow-sm">
                 <!-- Basket handle pseudo -->
                 <div class="absolute -top-3 w-6 h-4 border-2 border-[#14945b] rounded-t-full"></div>
                 <span class="text-white font-bold text-xs">bb</span>
                 <!-- Gold coin -->
                 <div class="absolute -top-2 left-2 w-5 h-5 bg-[#ffdb00] rounded-full border-2 border-white flex items-center justify-center text-[10px] font-black text-slate-900 shadow-sm">₹</div>
                 <!-- Veggies mockup behind -->
                 <div class="absolute -top-1 -right-1 w-3 h-3 bg-red-400 rounded-full"></div>
                 <div class="absolute -top-1.5 -left-1 w-3 h-3 bg-orange-400 rounded-full"></div>
              </div>
            </div>
            <!-- Right Side Tags -->
            <div class="w-[65%] flex flex-col gap-1.5 justify-center z-10 pl-1">
              <div class="flex items-center gap-1.5">
                <!-- Tag 1 -->
                <div class="bg-gradient-to-b from-[#fbf8d1] to-[#e4e6bd] border border-[#d2d4a6] rounded-xl px-2 py-1.5 flex-1 text-center shadow-sm relative">
                  <span class="text-[13px] font-black text-slate-900 leading-none tracking-tight">₹50</span>
                  <span class="text-[10px] font-black text-slate-900 leading-none ml-0.5">OFF</span><br/>
                  <span class="text-[8px] font-bold text-slate-600 block mt-0.5">on ₹299</span>
                </div>
                <!-- Tag 2 -->
                <div class="bg-gradient-to-b from-[#fbf8d1] to-[#e4e6bd] border border-[#d2d4a6] rounded-xl px-2 py-1.5 flex-1 text-center shadow-sm relative">
                  <span class="text-[13px] font-black text-slate-900 leading-none tracking-tight">₹150</span>
                  <span class="text-[10px] font-black text-slate-900 leading-none ml-0.5">OFF</span><br/>
                  <span class="text-[8px] font-bold text-slate-600 block mt-0.5">on ₹399</span>
                </div>
              </div>
              <!-- Tag 3 -->
              <div class="bg-gradient-to-b from-[#fbf8d1] to-[#e4e6bd] border border-[#d2d4a6] rounded-full px-3 py-1 w-full text-center shadow-sm flex items-center justify-center gap-1">
                <div class="bg-[#ffdb00] text-slate-900 text-[8px] font-black px-1.5 py-0.5 rounded-full border border-yellow-400">Free delivery</div>
                <span class="text-[9px] font-bold text-slate-700">on your first 4 orders</span>
              </div>
            </div>
          </div>
        </section>

        <section class="px-3 mb-6">
          <!-- Daily Fresh Deals Banner -->
          <div class="bg-gradient-to-br from-primary to-primary-light rounded-2xl p-3 relative overflow-hidden shadow-lg flex flex-col justify-between min-h-[160px]">
            <!-- Sparkles -->
            <svg class="absolute top-2 left-[40%] w-4 h-4 text-white/60" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.5 6.5L20 10l-6.5 1.5L12 18l-1.5-6.5L4 10l6.5-1.5L12 2z"/></svg>
            <svg class="absolute bottom-6 left-[30%] w-3 h-3 text-[#ffdb00]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.5 6.5L20 10l-6.5 1.5L12 18l-1.5-6.5L4 10l6.5-1.5L12 2z"/></svg>
            <svg class="absolute top-8 right-3 w-4 h-4 text-[#ffdb00]/80" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.5 6.5L20 10l-6.5 1.5L12 18l-1.5-6.5L4 10l6.5-1.5L12 2z"/></svg>
            
            <div class="z-10 mt-1 max-w-[50%] flex flex-col items-start">
              <h2 class="text-[34px] font-black text-white leading-[0.9] tracking-tighter" style="font-family: Impact, system-ui, sans-serif;">DAILY<br/>FRESH<br/>DEALS</h2>
              <button class="bg-white text-slate-900 text-[12px] font-black px-4 py-1.5 rounded-full mt-3 shadow-sm flex items-center gap-1">
                 Shop now
              </button>
            </div>
            
            <!-- Images on right -->
            <!-- Transparent Onions Image -->
            <div class="absolute -top-4 -right-4 w-[160px] h-[160px]">
              <img src="https://images.unsplash.com/photo-1618512496248-a07fe83aa8cb?w=400&q=80" class="w-full h-full object-cover rounded-full drop-shadow-2xl" style="clip-path: circle(40% at 50% 50%); mix-blend-mode: multiply; opacity: 0.8;" />
            </div>
            <!-- Basket Image -->
            <div class="absolute -bottom-2 -right-4 w-[180px] h-[120px]">
               <img src="https://images.unsplash.com/photo-1598170845058-32b9d6a5da37?w=400&q=80" class="w-full h-full object-cover rounded-[100px] drop-shadow-xl" style="clip-path: ellipse(50% 40% at 50% 50%); mix-blend-mode: multiply; opacity: 0.9;" />
            </div>
            
            <!-- Floating Tags -->
            <div class="absolute top-4 right-[25%] bg-primary/90 border-2 border-white/50 backdrop-blur-sm rounded px-1.5 py-0.5 rotate-[5deg] shadow-lg text-center z-20">
               <span class="text-[10px] font-black text-white leading-tight block uppercase tracking-wide">BUY 1<br/>GET 1<br/>FREE</span>
            </div>
            <div class="absolute bottom-5 right-[35%] bg-accent rounded-bl-2xl rounded-tr-2xl px-2.5 py-0.5 rotate-[-8deg] shadow-lg text-center border-2 border-white z-20">
               <span class="text-[16px] font-black text-primary leading-none">₹10</span><br/>
               <span class="text-[10px] font-black text-primary/80 leading-none">corner</span>
            </div>
          </div>
        </section>

        <!-- REORDER & SAVE Section -->
        <section class="px-3 mb-6 mt-4">
           <h2 class="text-3xl font-black text-slate-900 tracking-tighter italic" style="font-family: Impact, system-ui, sans-serif;">REORDER <span class="text-primary">&</span> SAVE</h2>
           <div class="flex border-b border-slate-200 mt-2">
             <button class="flex-1 text-center py-2 border-b-2 border-primary text-primary font-bold text-sm">Order again</button>
             <button class="flex-1 text-center py-2 text-slate-500 font-medium text-sm">Best prices</button>
           </div>
           
           <div class="overflow-x-auto qc-scrollbar-hide -mx-3 px-3 mt-4">
              <div class="flex gap-3 pb-3" style="min-width: max-content;">
                {allProducts.slice(0, 5).map((p: any) => (
                  <div class="w-[140px] flex-shrink-0 snap-start bg-white rounded-xl overflow-hidden">
                    <QProductCard
                      id={p.id}
                      name={p.name}
                      slug={p.slug}
                      variants={p.variants}
                      image={p.image}
                      rating={p.rating}
                      storeName={storeName}
                    />
                  </div>
                ))}
              </div>
           </div>
        </section>
      </>
    )}

    <!-- CATEGORY SECTIONS -->
    {topCategories.some((c: any) => c.children && c.children.length > 0) ? (
      topCategories.map((megaCat: any) => {
        const level2Cats = megaCat.children || [];
        if (level2Cats.length === 0) return null;

        const megaCatProducts = allProducts.filter((p: any) => 
          p.category === megaCat.slug || 
          p.category_id === megaCat.id ||
          level2Cats.some((l2: any) => p.category === l2.slug || p.category_id === l2.id || (l2.children || []).some((l3: any) => p.category === l3.slug || p.category_id === l3.id))
        ).slice(0, 8);

        return (
          <section id={`section-${megaCat.slug}`} class="mb-8 scroll-mt-28">
            <div class="mb-3 px-3 flex items-center justify-between">
              <h2 class="font-black text-slate-900 text-[18px] tracking-tight">{megaCat.name}</h2>
              <a href={`/qcommerce-category?category=${megaCat.slug}`} class="w-6 h-6 bg-slate-100 rounded-full flex items-center justify-center">
                 <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
            
            {megaCatProducts.length > 0 && (
              <div class="overflow-x-auto qc-scrollbar-hide -mx-3 px-3 mb-4">
                <div class="flex gap-3 pb-3" style="min-width: max-content;">
                  {megaCatProducts.map((p: any) => (
                    <div class="w-[140px] flex-shrink-0 snap-start">
                      <QProductCard
                        id={p.id}
                        name={p.name}
                        slug={p.slug}
                        variants={p.variants}
                        image={p.image}
                        rating={p.rating}
                        storeName={storeName}
                      />
                    </div>
                  ))}
                </div>
              </div>
            )}
          </section>
        );
      })
    ) : (
       <div class="text-center py-10 text-slate-500">Categories setup pending</div>
    )}
      </>
    )}

    {activeTab !== 'for-you' && (
      (() => {
        const megaCat = topCategories.find((c: any) => c.slug === activeTab);
        if (!megaCat) return <div class="p-10 text-center text-slate-500">Category not found</div>;
        
        const subCats = megaCat.children || [];
        const megaProducts = allProducts.filter((p: any) => 
          p.category === megaCat.slug || 
          p.category_id === megaCat.id ||
          subCats.some((l2: any) => p.category === l2.slug || p.category_id === l2.id || (l2.children || []).some((l3: any) => p.category === l3.slug || p.category_id === l3.id))
        );
        const featured = megaProducts.slice(0, 10);
        const rest = megaProducts.slice(10);
        
        return (
          <div class="animate-in fade-in slide-in-from-bottom-4 duration-500 pb-10">
            <!-- 1. Explore Categories (Subcategories grid) -->
            {subCats.length > 0 && (
              <section class="p-4 bg-white mb-2 shadow-sm rounded-b-2xl border-b border-rose-50">
                <h2 class="font-bold text-slate-800 text-[16px] tracking-tight mb-4">Explore by Category</h2>
                <div class="grid grid-cols-4 gap-y-5 gap-x-2">
                  {subCats.slice(0, 8).map((sub: any) => (
                    <a href={`/qcommerce-category?category=${sub.slug}`} class="flex flex-col items-center gap-2 group">
                      <div class="w-[72px] h-[72px] bg-[#f8f9fa] rounded-[16px] flex items-center justify-center border border-slate-100/50 shadow-sm overflow-hidden group-hover:border-pink-200 transition-colors">
                        <img src={sub.image || '/placeholder.webp'} alt={sub.name} class="w-[52px] h-[52px] object-contain mix-blend-multiply transition-transform group-hover:scale-110" loading="lazy" />
                      </div>
                      <span class="text-[10px] font-semibold text-slate-700 text-center leading-tight line-clamp-2 px-1">{sub.name}</span>
                    </a>
                  ))}
                </div>
              </section>
            )}
            
            <!-- 2. Featured Picks -->
            {featured.length > 0 && (
              <section class="pt-4 mb-5">
                <div class="px-3 mb-3 flex items-center justify-between">
                  <h2 class="font-black text-slate-900 text-[18px] tracking-tight">Featured Picks</h2>
                </div>
                <div class="overflow-x-auto qc-scrollbar-hide px-3 pb-2 -mx-3">
                  <div class="flex gap-3 pb-2 px-3" style="min-width: max-content;">
                    {featured.map((p: any) => (
                      <div class="w-[140px] flex-shrink-0 snap-start">
                        <QProductCard id={p.id} name={p.name} slug={p.slug} variants={p.variants} image={p.image} rating={p.rating} storeName={storeName} />
                      </div>
                    ))}
                  </div>
                </div>
              </section>
            )}
            
            <!-- 3. All Products Grid -->
            {rest.length > 0 && (
              <section class="px-3 mb-8">
                <h2 class="font-black text-slate-900 text-[18px] tracking-tight mb-4">All in {megaCat.name}</h2>
                <div class="grid grid-cols-2 gap-3">
                  {rest.map((p: any) => (
                    <div class="w-full">
                      <QProductCard id={p.id} name={p.name} slug={p.slug} variants={p.variants} image={p.image} rating={p.rating} storeName={storeName} />
                    </div>
                  ))}
                </div>
              </section>
            )}
          </div>
        );
      })()
    )}

  </div>
<script>
  // Scroll Spy Logic for Category Strip
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      let visibleSection = null;
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          visibleSection = entry.target.id;
        }
      });
      
      if (visibleSection) {
        // Reset all active states
        document.querySelectorAll('[data-category-slug]').forEach(el => {
          const imgWrap = el.querySelector('div.w-12');
          const text = el.querySelector('span');
          if (imgWrap) imgWrap.classList.remove('ring-2', 'ring-rose-500');
          if (text) text.classList.replace('text-slate-800', 'text-slate-600');
        });
        
        // Set new active state
        const targetSlug = visibleSection.replace('section-', '');
        const activeNav = document.querySelector(`[data-category-slug="${targetSlug}"]`);
        if (activeNav) {
          const imgWrap = activeNav.querySelector('div.w-12');
          const text = activeNav.querySelector('span');
          if (imgWrap) imgWrap.classList.add('ring-2', 'ring-rose-500');
          if (text) text.classList.replace('text-slate-600', 'text-slate-800');
          // Scroll strip to bring active item into view without affecting vertical page scroll
          const container = activeNav.closest('.overflow-x-auto');
          if (container) {
            const scrollLeft = activeNav.offsetLeft - (container.clientWidth / 2) + (activeNav.clientWidth / 2);
            container.scrollTo({ left: scrollLeft, behavior: 'smooth' });
          }
        }
      }
    }, { rootMargin: '-100px 0px -60% 0px', threshold: 0.1 });
    
    document.querySelectorAll('section[id^="section-"]').forEach(section => {
      observer.observe(section);
    });
  });
</script>
</QCommerceLayout>


