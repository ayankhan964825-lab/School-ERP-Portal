---
import Layout from '../layouts/Layout.astro';
import { getSettings } from '../lib/database';

const rawSettings = await getSettings();
const settings = rawSettings || {};
const s = (key: string, fallback?: string) => {
  const val = settings[key];
  return (val !== undefined && val !== null && val !== '') ? val : '';
};
const brandName = settings?.brand_name || '';

let faqs = [
  {
    question: "How long do your products stay fresh?",
    answer: "Our products typically have a shelf life of 12 months when stored in a cool, dry place in their original sealed packaging."
  },
  {
    question: "Do you offer international Delivery?",
    answer: "Yes, we ship to select international destinations. Delivery rates and delivery times vary by location. Please contact us for specific details."
  },
  {
    question: "Are your products organic?",
    answer: "Many of our products are certified organic. Each product description specifies whether it's organic or conventionally grown."
  },
  {
    question: "Do you offer wholesale pricing?",
    answer: "Yes, we offer wholesale pricing for bulk orders. Please contact us directly for wholesale inquiries. We'll send your order details via WhatsApp for confirmation and payment processing."
  }
];

if (settings?.faqs && Array.isArray(settings.faqs) && settings.faqs.length > 0) {
  faqs = settings.faqs;
}
---

<Layout bodyClass="bg-surface" title={`Frequently Asked Questions - ${brandName}`} description={`Find answers to common questions about ${brandName} products, ordering process, delivery, and more.`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((faq: any) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  }).replace(/</g, '\\u003c')} />
  <div class="bg-surface min-h-screen pt-12 pb-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-secondary mb-4">Frequently Asked Questions</h1>
        <p class="text-secondary/70 text-lg">
          Find answers to common questions about {brandName} products, ordering process, and more.
        </p>
      </div>

      <div class="space-y-6">
        {faqs.map((faq: any) => (
          <div class="bg-background-alt p-6 rounded-2xl border border-background-alt hover:border-primary/20 transition-colors">
            <h3 class="text-lg font-bold text-secondary mb-3">{faq.question}</h3>
            <p class="text-secondary/70 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>

      <div class="mt-16 text-center bg-primary/10 p-8 rounded-3xl border border-primary/20">
        <h2 class="text-2xl font-serif font-bold text-secondary mb-3">Still Have Questions?</h2>
        <p class="text-secondary/70 mb-6">Our customer service team is here to help. Reach out to us directly.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href={s('contact_email') ? `mailto:${s('contact_email')}` : '/contact'} class="btn-primary">Email Us</a>
          <a href="/contact" class="btn-secondary bg-white text-secondary border border-background-alt">Contact Form</a>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    window.addEventListener('message', (event) => {
      if (event.data && event.data.type === 'faq_update') {
        const faqs = event.data.faqs || [];
        const container = document.querySelector('.space-y-6');
        if (container) {
          container.innerHTML = faqs.map(faq => `
            <div class="bg-background-alt p-6 rounded-2xl border border-background-alt hover:border-primary/20 transition-colors">
              <h3 class="text-lg font-bold text-secondary mb-3">${faq.question || ''}</h3>
              <p class="text-secondary/70 leading-relaxed">${faq.answer || ''}</p>
            </div>
          `).join('');
        }
      }
    });
  </script>
</Layout>
