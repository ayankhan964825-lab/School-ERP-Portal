---
import { getPermissionContext, canManageSection } from '../../../lib/permissions';
const ctx = getPermissionContext(Astro.cookies);

if (Astro.request.method === "POST" && !canManageSection(ctx, "finance_remittance")) {
  return new Response("Forbidden", { status: 403 });
}
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabaseAdmin, supabase, isSupabase } from '../../../lib/database';

let remittances: any[] = [];
if (isSupabase) {
  const client = supabaseAdmin || supabase;
  if (client) {
    const { data } = await client.from('remittances').select('*').eq('store_id', Astro.locals.storeId).order('created_at', { ascending: false });
    remittances = data || [];
  }
}

const totalExpected = remittances.filter(r => r.status === 'expected').reduce((sum, r) => sum + Number(r.amount), 0);
const totalSettled = remittances.filter(r => r.status === 'settled').reduce((sum, r) => sum + Number(r.amount), 0);
---

<AdminLayout title="Remittances | Vyapaarpe Admin" description="Track payment payouts and settlements.">
  <!-- Page Header -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-serif font-bold text-secondary">Remittance Dashboard</h1>
      <p class="text-sm text-secondary/60 mt-1">Track expected payouts and settled amounts from Payment Gateways & Couriers.</p>
    </div>
    <button class="px-4 py-2 bg-primary text-white text-sm font-semibold rounded-lg hover:bg-primary/90 transition">
      + Add Manual Payout
    </button>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm flex items-center gap-4">
      <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      </div>
      <div>
        <p class="text-sm font-semibold text-secondary/50 uppercase tracking-wider">Expected Payouts</p>
        <p class="text-2xl font-bold text-secondary">₹{totalExpected.toLocaleString('en-IN')}</p>
      </div>
    </div>
    <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm flex items-center gap-4">
      <div class="w-12 h-12 rounded-full bg-green-50 text-green-600 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      </div>
      <div>
        <p class="text-sm font-semibold text-secondary/50 uppercase tracking-wider">Total Settled</p>
        <p class="text-2xl font-bold text-secondary">₹{totalSettled.toLocaleString('en-IN')}</p>
      </div>
    </div>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto w-full">
      <table class="min-w-full text-sm text-left">
        <thead class="text-xs text-secondary/60 uppercase bg-gray-50/80 border-b border-gray-100">
          <tr>
            <th class="px-5 py-3.5 font-semibold">ID</th>
            <th class="px-5 py-3.5 font-semibold">Provider</th>
            <th class="px-5 py-3.5 font-semibold">UTR Number</th>
            <th class="px-5 py-3.5 font-semibold">Settlement Date</th>
            <th class="px-5 py-3.5 font-semibold text-right">Amount</th>
            <th class="px-5 py-3.5 font-semibold text-center">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          {remittances.map(r => (
            <tr class="hover:bg-gray-50/40 transition-colors">
              <td class="px-5 py-4 font-bold text-secondary text-xs">{r.id}</td>
              <td class="px-5 py-4 font-semibold text-secondary">{r.provider}</td>
              <td class="px-5 py-4 text-secondary/60">{r.utr_number || '—'}</td>
              <td class="px-5 py-4 text-secondary/60">{new Date(r.settlement_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</td>
              <td class="px-5 py-4 font-bold text-secondary text-right">₹{r.amount.toLocaleString('en-IN')}</td>
              <td class="px-5 py-4 text-center">
                <span class={`inline-block text-[10px] uppercase font-bold tracking-wide px-2.5 py-1 rounded-full ${r.status === 'settled' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800'}`}>
                  {r.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
