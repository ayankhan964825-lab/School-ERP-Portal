---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
const ctx = getPermissionContext(Astro.cookies);

if (Astro.request.method === "POST" && !canManageSection(ctx, "flash_sales")) {
  return new Response("Forbidden", { status: 403 });
}
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageAiPanel from '../../components/admin/PageAiPanel.astro';
import { getFlashSales, getProducts, getSettings } from '../../lib/database';

const dbSales = await getFlashSales();
const catalogProducts = await getProducts(Astro.locals?.storeId);
const settings = await getSettings(Astro.locals?.storeId);
const flashSaleConfig = settings?.flash_sale_config || { active: false, title: 'Flash Sale', type: 'simple', banner: '' };

// Auto-determine status from dates
const now = new Date();
const offers = dbSales.map((s: any) => {
  const start = new Date(s.startDate);
  const end = new Date(s.endDate);
  let status = s.status || 'scheduled';
  if (status !== 'expired') {
    if (start <= now && end > now) status = 'active';
    else if (end <= now) status = 'expired';
    else if (start > now) status = 'scheduled';
  }
  const discountPct = s.originalPrice > 0 ? Math.round(((s.originalPrice - s.salePrice) / s.originalPrice) * 100) : 0;
  return { ...s, status, discountPct };
});

const activeCount = offers.filter((o: any) => o.status === 'active').length;
const scheduledCount = offers.filter((o: any) => o.status === 'scheduled').length;
const productsOnSale = offers.filter((o: any) => o.status === 'active' || o.status === 'scheduled').length;

// Build product list for modal from catalog
const productNames = [...new Set((catalogProducts as any[]).map((p: any) => p.name))];
const uniqueProducts = productNames.map((name: string) => {
  const variants = (catalogProducts as any[])
    .filter((p: any) => p.name === name)
    .flatMap((p: any) => (p.variants || []).map((v: any) => ({
      name: v.weight || v.name || 'Default',
      price: v.price || p.price || 0,
      mrp: v.mrp || v.price || p.price || 0,
      is_out_of_stock: v.is_out_of_stock || p.is_out_of_stock || false,
      is_hidden: v.is_hidden || p.is_hidden || false
    })))
    .filter((v: any) => v.name && !v.is_out_of_stock && !v.is_hidden);
  // deduplicate by name
  const uniqueVars = [];
  const seen = new Set();
  for (const v of variants) {
    const isAlreadyOnSale = offers.some((o: any) => 
      o.product === name && 
      (o.variant === v.name || o.variant === 'all' || !o.variant) &&
      (o.status === 'active' || o.status === 'scheduled')
    );
    if (!seen.has(v.name) && !isAlreadyOnSale) {
      seen.add(v.name);
      uniqueVars.push(v);
    }
  }
  return { name, variants: uniqueVars, image: (catalogProducts as any[]).find(p => p.name === name)?.images?.[0] || '' };
}).filter((p: any) => p.variants.length > 0);

const offersJson = JSON.stringify(offers);
const productsJson = JSON.stringify(uniqueProducts);

const flashSalesForAI = JSON.stringify({
  activeCount,
  scheduledCount,
  campaigns: flashSaleConfig.campaigns,
  availableProducts: uniqueProducts.map(p => ({
    name: p.name,
    variants: p.variants.map(v => ({ name: v.name || v.weight || v, mrp: v.mrp, regularPrice: v.price }))
  })),
  currentOffers: offers.slice(0, 20).map((o: any) => ({
    product: o.product,
    variant: o.variant,
    status: o.status,
    salePrice: o.salePrice
  }))
});
