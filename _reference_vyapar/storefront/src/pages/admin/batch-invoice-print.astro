---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
import { getSettings } from '../../lib/database';
const ctx = getPermissionContext(Astro.cookies);
const settings = await getSettings(Astro.locals?.storeId);

if (Astro.request.method === "POST" && !canManageSection(ctx, "batch_invoice")) {
  return new Response("Forbidden", { status: 403 });
}

const storeName = settings?.store_name || 'Store Name';
const brandName = settings?.brand_name || storeName;
const rawLogo = settings?.logo_url || `/logo-${brandName.replace(/\s+/g, '-').toLowerCase()}.webp`;
const storeLogo = encodeURI(rawLogo);
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Batch Invoices | Admin Panel</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700&family=Libre+Barcode+39&display=swap" rel="stylesheet" />
  <style>
    :root { --text: #000; --border: #000; --muted: #333; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', -apple-system, sans-serif; color: var(--text); background: #f3f4f6; }

    /* The interactive UI */
    #action-screen { display: none; align-items: center; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; justify-content: center; min-height: 100vh; flex-direction: column; gap: 24px; background: #f3f4f6; }
    .action-card { background: white; padding: 40px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); text-align: center; max-width: 400px; width: 100%; }
    .btn-group { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; }
    .btn { padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; border: none; font-size: 14px; transition: 0.2s; display: flex; justify-content: center; align-items: center; gap: 8px; }
    .btn-download { background: #10b981; color: white; }
    .btn-download:hover { background: #059669; }
    .btn-print { background: #000; color: white; }
    .btn-print:hover { background: #333; }
    .btn-back { background: transparent; color: #666; text-decoration: underline; margin-top: 10px; }

    #loading-screen { display: flex; align-items: center; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; justify-content: center; min-height: 100vh; flex-direction: column; gap: 16px; background: #fff; }
    #loading-screen .spinner { width: 48px; height: 48px; border: 4px solid #f3f3f3; border-top-color: #10b981; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    
    #error-screen { display: none; align-items: center; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; justify-content: center; min-height: 100vh; flex-direction: column; gap: 16px; background: #fff; }

    /* HIDDEN INVOICE WRAPPER - Offscreen but fully rendered for html2pdf and print */
    .page-wrapper { position: relative; width: 800px; background: white; margin: 0 auto; }
    .invoice-page { page-break-after: always; background: #fff; padding: 20px; }
    
    /* Invoice Inner Styles */
    .amz-border { border: 2px solid #000; }
    .amz-border-bottom { border-bottom: 2px solid #000; }
    .amz-border-right { border-right: 2px solid #000; }
    .amz-flex { display: flex; }
    .amz-flex-col { display: flex; flex-direction: column; }
    .amz-text-center { text-align: center; }
    .amz-text-right { text-align: right; }
    .amz-bold { font-weight: bold; }
    .amz-p10 { padding: 10px; }
    
    table.amz-table { width: 100%; border-collapse: collapse; border-top: 2px solid #000; border-bottom: 2px solid #000; }
    table.amz-table th, table.amz-table td { border: 1px solid #000; padding: 6px; font-size: 11px; }
    table.amz-table th { font-weight: bold; text-align: center; }

    @media print {
      body { background: white !important; margin: 0; }
      #action-screen, #loading-screen, #error-screen { display: none !important; }
      .page-wrapper { position: static !important; left: 0 !important; width: 100% !important; margin: 0; padding: 0; max-width: none; display: block !important; }
      .invoice-page { padding: 0; margin-bottom: 0; }
      @page { margin: 0; size: A4; }
    }
  </style>
</head>
<body>

  <div id="loading-screen"><div class="spinner"></div><p>Processing batch data...</p></div>
  <div id="error-screen"><h2>No orders found</h2><a href="/admin/batch-invoice">← Back to Batch Print</a></div>

  <div id="action-screen">
    <div class="action-card">
      <div style="width: 64px; height: 64px; background: #ecfdf5; color: #10b981; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
      </div>
      <h2 style="font-size: 20px; font-weight: bold; margin-bottom: 8px;">Invoices Ready</h2>
      <p style="color: #666; font-size: 14px;" id="order-count-label">X orders processed</p>
      
      <div class="btn-group">
        <button id="btn-download" class="btn btn-download">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          Download PDF Batch
        </button>
        <button onclick="window.print()" class="btn btn-print">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
          Send to Printer
        </button>
        <a href="/admin/batch-invoice" class="btn btn-back">Return to Admin</a>
      </div>
    </div>
  </div>

  <div class="page-wrapper" id="page-wrapper"></div>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jsbarcode/3.11.5/JsBarcode.all.min.js" data-astro-rerun></script>
<script is:inline src="/js/logo-b64.js" data-astro-rerun></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js" data-astro-rerun></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js" data-astro-rerun></script>
  <script is:inline define:vars={{ settings, storeLogo }} data-astro-rerun>
    
    function generateBarcodeBase64(value) {
      if (!value) return '';
      const canvas = document.createElement('canvas');
      try {
        JsBarcode(canvas, value, {
          format: "CODE128",
          displayValue: false,
          height: 45,
          width: 1.8,
          margin: 0
        });
        return canvas.toDataURL("image/png");
      } catch (e) {
        return '';
      }
    }

    function numberToWords(n) {
      if (n === 0) return 'Zero';
      const ones = ['','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen'];
      const tens = ['','','Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];
      if (n < 20) return ones[n];
      if (n < 100) return tens[Math.floor(n/10)] + (n%10 ? ' ' + ones[n%10] : '');
      if (n < 1000) return ones[Math.floor(n/100)] + ' Hundred' + (n%100 ? ' and ' + numberToWords(n%100) : '');
      if (n < 100000) return numberToWords(Math.floor(n/1000)) + ' Thousand' + (n%1000 ? ' ' + numberToWords(n%1000) : '');
      if (n < 10000000) return numberToWords(Math.floor(n/100000)) + ' Lakh' + (n%100000 ? ' ' + numberToWords(n%100000) : '');
      return numberToWords(Math.floor(n/10000000)) + ' Crore' + (n%10000000 ? ' ' + numberToWords(n%10000000) : '');
    }

    function esc(str) { return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    
    function buildInvoiceHTML(order) {
      const customer = order.customer || {};
      // Resolve address: prefer master_orders.shipping_address, then order.address, then customer
      const addr = order.address || {};
      const shipping = (typeof addr === 'object' && Object.keys(addr).length > 0) ? addr : (order.shipping || customer);
      const custName = customer.name || order.customer_name || order.customerName || 'Customer';
      const shipName = shipping.name || custName;
      const shipAddr = shipping.address || shipping.street_address || shipping.street || '';
      const shipCity = shipping.city || '';
      const shipState = shipping.state || '';
      const shipPincode = shipping.pincode || shipping.postal_code || '';

      // Quick Commerce detection
      const isQCommerce = order.delivery_type === 'q_commerce_inhouse';

      const awb = order.awb || order.awb_number || null;
      const routing = order.routingCode || order.routing_code || 'STD';
      const courier = order.courierPartner || order.courier_partner || '';
      const weight = order.packageWeight || order.package_weight || '0.50 KG';

      const payMethod = (order.paymentMethod || order.payment_method || order.payment || 'cod').toLowerCase();
      const isCOD = payMethod === 'cod';
      const isPaid = (order.paymentStatus || order.payment_status || '').toLowerCase() === 'paid';

      
      const items = order.items || [];
      const subtotal = order.subtotal !== undefined ? Number(order.subtotal) : items.reduce((s, i) => s + ((i.price || 0) * (i.quantity || i.qty || 1)), 0);
      const totalQty = items.reduce((s, i) => s + (i.quantity || i.qty || 1), 0);
      const shipCost = order.shipping !== undefined ? Number(order.shipping) : (subtotal >= (settings.free_shipping_threshold || 499) ? 0 : (settings.flat_shipping_rate || 60));
      const totalOrderDiscount = order.discount !== undefined ? Number(order.discount) : 0;
      const grandTotal = order.amount !== undefined ? Number(order.amount) : (subtotal + shipCost - totalOrderDiscount);

      const orderId = order.orderId || order.order_id || order.id || '';
      const orderNum = order.order_number || orderId;
      const invoiceNumber = `IN-${orderId.replace(/[^0-9]/g, '').slice(-5)}`;
      const createdAt = order.createdAt || order.created_at || order.date || Date.now();
      
      const invoiceDateRaw = new Date(createdAt);
      const invoiceDate = invoiceDateRaw.toLocaleDateString('en-GB'); 
      const topBarcodeSrc = (!isQCommerce && awb) ? generateBarcodeBase64(awb) : '';
      const btmBarcodeSrc = generateBarcodeBase64(orderNum);
      const _intPart1 = Math.floor(grandTotal);
      const _decPart1 = Math.round((grandTotal - _intPart1) * 100);
      const amountInWords = (typeof numberToWords === 'function') 
        ? (_decPart1 > 0 
            ? numberToWords(_intPart1) + ' Rupees and ' + numberToWords(_decPart1) + ' Paise Only' 
            : numberToWords(_intPart1) + ' Rupees Only')
        : (_decPart1 > 0 
            ? `${_intPart1} Rupees and ${_decPart1} Paise Only` 
            : `${_intPart1} Rupees Only`);

      const storeName = settings.store_name || 'Admin Panel';
      const storeAddr = settings.store_address || '123 Demo Street, City, State, 123456';
      const storeGst = settings.gst_number || '22AAAAA0000A1Z5';
      const storeFssai = settings.fssai_number || '10000000000000';

      let totalTaxAmount = 0;
      const isIntraState = shipState.toLowerCase().includes('uttar pradesh') || shipState.toLowerCase() === 'up';

      const invRowsHTML = items.map((item, idx) => {
        const hsn = item.hsn_code || '0813';
        const gstRate = item.gst_rate !== undefined && item.gst_rate !== null ? parseFloat(item.gst_rate) : 5;
        const variantText = item.weight || item.variant || '';
        const displayName = variantText ? `${esc(item.name)} - ${esc(variantText)}` : esc(item.name);
        const skuText = item.sku ? `SKU: ${esc(item.sku)} | HSN: ${esc(hsn)}` : `HSN: ${esc(hsn)}`;
        const qty = item.quantity || item.qty || 1;
        
        const lineGross = (item.price || 0) * qty;
        
        // Distribute discount proportionally based on item gross value
        let itemDiscount = 0;
        if (subtotal > 0 && totalOrderDiscount > 0) {
            itemDiscount = (lineGross / subtotal) * totalOrderDiscount;
        }
        
        const lineNetAfterDiscount = lineGross - itemDiscount;
        const baseRate = lineNetAfterDiscount / (1 + (gstRate / 100));
        const taxAmount = lineNetAfterDiscount - baseRate;
        totalTaxAmount += taxAmount;
        
        let taxTypeStr = isIntraState ? `CGST/SGST` : `IGST`;
        let taxRateStr = isIntraState ? `${gstRate/2}%` : `${gstRate}%`;
        let taxAmtStr = `₹${taxAmount.toFixed(2)}`;

        return `<tr style="border-bottom: 1px solid #ddd;">
          <td style="padding: 6px; border-right: 1px solid #000;">${idx+1}</td>
          <td style="padding: 6px; border-right: 1px solid #000; text-align: left;">
            <div style="font-weight:600">${displayName}</div>
            <div style="font-size:9px;color:#333;margin-top:2px;">${skuText}</div>
          </td>
          <td style="padding: 6px; border-right: 1px solid #000;">${esc(hsn)}</td>
          <td style="padding: 6px; border-right: 1px solid #000;">${qty}</td>
          <td style="padding: 6px; border-right: 1px solid #000;">₹${((item.price || 0)).toFixed(2)}</td>
          <td style="padding: 6px; border-right: 1px solid #000;">₹${lineGross.toFixed(2)}</td>
          <td style="padding: 6px; border-right: 1px solid #000; color: #16a34a;">-₹${itemDiscount.toFixed(2)}</td>
          <td style="padding: 6px; border-right: 1px solid #000;">₹${baseRate.toFixed(2)}</td>
          <td style="padding: 6px; border-right: 1px solid #000;">${taxTypeStr} (${taxRateStr})<br/>${taxAmtStr}</td>
          <td style="padding: 6px; font-weight: bold;">₹${lineNetAfterDiscount.toFixed(2)}</td>
        </tr>`;
      }).join('');

      let shippingRow = '';
      if (shipCost > 0) {
        let taxTypeStr = isIntraState ? `CGST/SGST` : `IGST`;
        let shipBase = shipCost / 1.18;
        let shipTax = shipCost - shipBase;
        totalTaxAmount += shipTax;
        shippingRow = `<tr>
          <td style="padding: 6px; border-right: 1px solid #000;">${items.length + 1}</td>
          <td style="padding: 6px; border-right: 1px solid #000; text-align: left;"><div style="font-weight:600">Shipping Charges</div></td>
          <td style="padding: 6px; border-right: 1px solid #000;">9968</td>
          <td style="padding: 6px; border-right: 1px solid #000;">1</td>
          <td style="padding: 6px; border-right: 1px solid #000;">₹${shipCost.toFixed(2)}</td>
          <td style="padding: 6px; border-right: 1px solid #000;">₹${shipCost.toFixed(2)}</td>
          <td style="padding: 6px; border-right: 1px solid #000;">-₹0.00</td>
          <td style="padding: 6px; border-right: 1px solid #000;">₹${shipBase.toFixed(2)}</td>
          <td style="padding: 6px; border-right: 1px solid #000;">${taxTypeStr} (18%)<br/>₹${shipTax.toFixed(2)}</td>
          <td style="padding: 6px; font-weight: bold;">₹${shipCost.toFixed(2)}</td>
        </tr>`;
      }
    
      // We remove page-break inside this wrapper to keep it single page.
      const storeLogoUrl = typeof storeLogo !== 'undefined' ? storeLogo : (settings.store_logo || '');
      const logoImg = storeLogoUrl ? `<img src="${storeLogoUrl}" style="height:14px; filter:grayscale(100%); object-fit:contain; vertical-align:middle;" onerror="this.style.display='none'" />` : '';

      return `
      <div class="invoice-page" style="width: 100%; max-width: 800px; margin: 0 auto; border: 2px solid #000; font-family: 'Inter', sans-serif; background: white;">
        
        
        <!-- Row 0: Header -->
        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #000; padding: 10px 15px;">
          <div style="display: flex; align-items: center; gap: 10px;">
            ${storeLogoUrl ? `<img src="${storeLogoUrl}" style="height:40px; filter:grayscale(100%); object-fit:contain; image-rendering:-webkit-optimize-contrast;" onerror="this.style.display='none'" />` : ''}
            <div style="font-size: 24px; font-weight: bold; font-family: serif;">${esc(storeName)}</div>
          </div>
          <div style="font-size: 14px; font-weight: bold;">${(order.source === 'quotation' || order.status === 'quotation') ? 'QUOTATION' : 'TAX INVOICE'}</div>
        </div>
        
        <!-- Row 1: TO and AWB Barcode -->
        <div style="display: flex; border-bottom: 2px solid #000;">
          <!-- LEFT: TO Details -->
          <div style="flex: 1; padding: 15px; border-right: 2px solid #000;">
            <div style="font-size: 14px; font-weight: bold; margin-bottom: 5px;">To:</div>
            <div style="font-size: 18px; font-weight: 800; text-transform: uppercase;">${esc(shipName)}</div>
            <div style="font-size: 13px; line-height: 1.4; margin-top: 5px;">
              ${esc(shipAddr)}<br/>
              ${esc(shipCity)}, ${esc(shipState)}<br/>
              <span style="font-weight: bold;">${esc(shipPincode)}</span>
            </div>
          </div>
          
          <!-- RIGHT: Barcode / Q-Commerce Details -->
          <div style="width: 350px; padding: 15px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
            ${isQCommerce ? `
              <div style="font-size: 14px; font-weight: bold; color: #059669; margin-bottom: 8px;">⚡ Quick Commerce Delivery</div>
              <div style="font-size: 12px; color: #666;">Delivered by in-house rider</div>
            ` : `
              <div style="font-size: 12px; margin-bottom: 5px;">AWB: ${esc(awb || 'Not Assigned')}</div>
              ${topBarcodeSrc ? `<div style="padding: 5px 0;"><img src="${topBarcodeSrc}" style="height: 52px; width: auto;" /></div>` : ''}
              <div style="font-size: 12px; margin-top: 5px; font-weight: bold;">Routing Code: ${esc(routing)}</div>
              <div style="font-size: 11px; margin-top: 10px; text-align: left; width: 100%; display: flex; justify-content: space-between;">
                <span>Dimensions: 13*13*13 CM</span>
                <span>Weight: ${esc(weight)}</span>
              </div>
            `}
          </div>
        </div>

        <!-- Row 2: COD Info -->
        <div style="display: flex; border-bottom: 2px solid #000; padding: 8px 15px; font-weight: bold; font-size: 13px; justify-content: space-between;">
          <div>${isCOD ? (isPaid ? 'COD (PAID)' : 'COD') : 'PREPAID'} (Collectable Value: Rs. ${(isCOD && !isPaid) ? grandTotal.toFixed(2) : '0.00'})</div>
          <div>${isQCommerce ? 'Quick Commerce' : esc(courier)}</div>
        </div>

        <!-- Row 3: Order Stats -->
        <div style="display: flex; border-bottom: 2px solid #000; padding: 8px 15px; font-weight: bold; font-size: 12px; justify-content: space-between;">
          <div>Number of Skus: ${items.length}</div>
          <div>Total Quantity: ${totalQty}</div>
          <div>Order Id: ${esc(orderId)}</div>
        </div>

        <!-- Row 4: FROM Details & Order Barcode -->
        <div style="display: flex; border-bottom: 2px solid #000;">
          <!-- LEFT: FROM Details -->
          <div style="flex: 1; padding: 15px; border-right: 2px solid #000;">
            <div style="font-size: 12px; font-style: italic;">From:</div>
            <div style="font-size: 16px; font-weight: bold; font-style: italic; margin-bottom: 5px;">${storeName}</div>
            <div style="font-size: 11px; line-height: 1.4; color: #333;">
              ${storeAddr}<br/>
              <span style="font-weight:bold;">GSTIN:</span> ${storeGst}
            </div>
          </div>
          
          <!-- RIGHT: Invoice details -->
          <div style="width: 350px; padding: 15px; display:flex; flex-direction:column; justify-content:center;">
            <div style="font-size: 11px; margin-bottom: 5px; display: flex; justify-content: space-between;">
              <span><span style="font-weight:bold;">${(order.source === 'quotation' || order.status === 'quotation') ? 'Quotation' : 'Invoice'} No:</span> ${invoiceNumber}</span>
              <span><span style="font-weight:bold;">Date:</span> ${invoiceDate}</span>
            </div>
            <div style="text-align: center; margin-top: 5px; padding: 5px 0;"><img src="${btmBarcodeSrc}" style="height: 40px; width: auto;" /></div>
            <div style="font-size: 11px; margin-top: 8px; text-align: center;"><span style="font-weight:bold;">Place of Supply:</span> <span style="font-weight:bold; text-transform:uppercase;">${esc(shipState)}</span></div>
          </div>
        </div>

        <!-- Row 5: Product Table (Amazon Tax Style) -->
        <table style="width: 100%; border-collapse: collapse; font-size: 11px; text-align: center;">
          <thead>
            <tr style="border-bottom: 2px solid #000; font-weight: bold;">
              <th style="padding: 6px; border-right: 1px solid #000; width: 30px;">#</th>
              <th style="padding: 6px; border-right: 1px solid #000; text-align: left;">Product Name</th>
              <th style="padding: 6px; border-right: 1px solid #000;">HSN</th>
              <th style="padding: 6px; border-right: 1px solid #000; width: 35px;">Qty</th>
              <th style="padding: 6px; border-right: 1px solid #000;">Unit<br/>Price</th>
              <th style="padding: 6px; border-right: 1px solid #000;">Gross<br/>Amt</th>
              <th style="padding: 6px; border-right: 1px solid #000;">Discount</th>
              <th style="padding: 6px; border-right: 1px solid #000;">Taxable<br/>Amt</th>
              <th style="padding: 6px; border-right: 1px solid #000;">Tax</th>
              <th style="padding: 6px; width: 65px;">Total</th>
            </tr>
          </thead>
          <tbody>
            ${invRowsHTML}
            ${shippingRow}
          </tbody>
          <tfoot>
            <tr style="border-top: 2px solid #000;">
              <td colspan="8" style="padding: 8px; text-align: right; font-weight: bold; border-right: 1px solid #000;">GRAND TOTAL (Incl. GST):</td>
              <td style="padding: 8px; font-weight: bold; border-right: 1px solid #000;">₹${totalTaxAmount.toFixed(2)}</td>
              <td style="padding: 8px; font-weight: bold;">₹${grandTotal.toFixed(2)}</td>
            </tr>
          </tfoot>
        </table>

        <!-- Row 6: Footer -->
        <div style="border-top: 2px solid #000; padding: 10px 15px;">
          <div style="font-size: 11px; font-weight: bold; margin-bottom: 5px;">Amount in Words: ${amountInWords}</div>
          <div style="font-size: 10px; color: #333;">
            <span style="font-weight: bold; color: #000;">NOTE:</span> If outer packaging/label is found tempered/damaged, do not accept parcel. All disputes are subject to Uttar Pradesh jurisdiction only.
          </div>
        </div>
        <div style="border-top: 1px solid #000; padding: 8px 15px; display: flex; align-items: center; justify-content: space-between; font-size: 11px;">
          <div style="display: flex; align-items: center; gap: 6px;">
