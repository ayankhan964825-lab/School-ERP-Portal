                                      {text: 'ORIGINAL FOR RECIPIENT', fontSize: 10, margin: [0,4,0,10]},
                                      {
                                          columns: [
                                              {stack: [{text: (order.source === 'quotation' || order.status === 'quotation') ? 'Quotation No.' : 'Invoice No.', bold: true}, {text: orderIdObj, margin: [0,4,0,0]}]},
                                              {stack: [{text: (order.source === 'quotation' || order.status === 'quotation') ? 'Quotation Date' : 'Invoice Date', bold: true}, {text: invoiceDate, margin: [0,4,0,0]}]}
                                          ]
                                      }
                                  ],
                                  margin: [10, 10, 10, 10]
                              }
                          ]
                      ]
                  },
                  layout: {
                      hLineWidth: i => i===0 ? 1 : 0,
                      vLineWidth: i => (i===0 || i===2) ? 1 : i===1 ? 1 : 0,
                      paddingLeft: ()=>0, paddingRight: ()=>0, paddingTop: ()=>0, paddingBottom: ()=>0
                  }
              },
              
              // Bill To / Ship To
              {
                  table: {
                      widths: ['*', 250],
                      body: [
                          [
                              {
                                  stack: [
                                      {text: 'BILL TO', bold: true, margin: [0,0,0,6]},
                                      {text: custName.toUpperCase(), bold: true, fontSize: 12},
                                      {text: `Address: ${custAddr}\n${custCity}, ${custState}, ${custPincode}`, margin: [0,2,0,2]},
                                      {text: `GSTIN: ${custGstin}     Place of Supply: ${shipState}`},
                                      {text: `Mobile: ${custPhone}`, margin: [0,2,0,0]}
                                  ],
                                  margin: [10, 10, 10, 10]
                              },
                              {
                                  stack: [
