              {},{},{},{},{},{},
              {text: `₹${receivedAmount.toFixed(2)}`, alignment: 'right', bold: true}
          ]);
      }
      
      const amountDue = grandTotal - receivedAmount;
      if (amountDue > 0) {
          tableBody.push([
              {text: 'BALANCE DUE', colSpan: 7, alignment: 'center', bold: true, color: '#dc2626'},
              {},{},{},{},{},{},
              {text: `₹${amountDue.toFixed(2)}`, alignment: 'right', bold: true, color: '#dc2626'}
          ]);
      }

      const breakdownBody = [];
      if (isIntraState) {
          breakdownBody.push([
              {text: 'HSN/SAC', rowSpan: 2, bold: true, alignment: 'center'},
              {text: 'Taxable Value', rowSpan: 2, bold: true, alignment: 'center'},
              {text: 'CGST', colSpan: 2, bold: true, alignment: 'center'},
              {},
              {text: 'SGST', colSpan: 2, bold: true, alignment: 'center'},
              {},
              {text: 'Total Tax Amount', rowSpan: 2, bold: true, alignment: 'center'}
          ]);
          breakdownBody.push([
              {}, {},
              {text: 'Rate', bold: true, alignment: 'center'}, {text: 'Amount', bold: true, alignment: 'center'},
              {text: 'Rate', bold: true, alignment: 'center'}, {text: 'Amount', bold: true, alignment: 'center'},
              {}
          ]);
          
          Object.keys(gstBreakdown).forEach(hsn => {
            const bd = gstBreakdown[hsn];
            const h = bd.taxAmount / 2, r = bd.rate / 2;
            breakdownBody.push([
                {text: hsn, alignment: 'center'},
                {text: bd.taxableValue.toFixed(2), alignment: 'right'},
                {text: `${r}%`, alignment: 'right'},
                {text: h.toFixed(2), alignment: 'right'},
                {text: `${r}%`, alignment: 'right'},
                {text: h.toFixed(2), alignment: 'right'},
                {text: `₹${bd.taxAmount.toFixed(2)}`, alignment: 'right'}
            ]);
          });
      } else {
          breakdownBody.push([
              {text: 'HSN/SAC', rowSpan: 2, bold: true, alignment: 'center'},
              {text: 'Taxable Value', rowSpan: 2, bold: true, alignment: 'center'},
              {text: 'IGST', colSpan: 2, bold: true, alignment: 'center'},
              {},
              {text: 'Total Tax Amount', rowSpan: 2, bold: true, alignment: 'center'}
          ]);
          breakdownBody.push([
              {}, {},
              {text: 'Rate', bold: true, alignment: 'center'}, {text: 'Amount', bold: true, alignment: 'center'},
              {}
          ]);
          
          Object.keys(gstBreakdown).forEach(hsn => {
            const bd = gstBreakdown[hsn];
            breakdownBody.push([
