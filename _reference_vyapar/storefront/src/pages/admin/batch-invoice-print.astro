  async function fetchLogoAsBase64(url) {
      if (!url) return null;
      try {
          const resp = await fetch(url);
          if (!resp.ok) return null;
          const blob = await resp.blob();
          return await new Promise((resolve) => {
              const reader = new FileReader();
              reader.onloadend = () => resolve(reader.result);
              reader.readAsDataURL(blob);
          });
      } catch (e) {
          return null;
      }
  }

  async function generatePdf(orders, isBatch = false) {
      const docDefinitions = [];
      let logoB64 = window.LOGO_BASE64 || null; 
      let signatureB64 = null;

      if (typeof storeLogo !== 'undefined' && storeLogo) {
          const dynamicLogo = await fetchLogoAsBase64(storeLogo);
          if (dynamicLogo) {
              logoB64 = dynamicLogo;
          }
      }
      
      if (typeof settings.authorized_signatory_image !== 'undefined' && settings.authorized_signatory_image) {
          const dynamicSig = await fetchLogoAsBase64(settings.authorized_signatory_image);
          if (dynamicSig) {
              signatureB64 = dynamicSig;
          }
      }

      orders.forEach(order => {
          if(!order) return;
          if (order.is_b2b || (order.customer && order.customer.is_b2b)) {
              const def = getB2BDefinition(order, settings, logoB64, signatureB64);
              if(def) docDefinitions.push(def);
          } else {
              const def = getB2CDefinition(order, settings, logoB64, signatureB64);
              if(def) docDefinitions.push(def);
          }
      });

      const finalDoc = {
          content: [],
          pageMargins: [20,20,20,20],
          defaultStyle: { font: 'Roboto' }
      };

      docDefinitions.forEach((def, index) => {
          if (index > 0 && def.content[0]) {
              def.content[0].pageBreak = 'before';
          }
          finalDoc.content.push(...def.content);
      });

      const firstOrder = orders.find(o => o);
      const brandName = settings.brand_name || settings.store_name || 'Invoice';
      const filename = isBatch 
          ? `${brandName}_Batch_Invoices_${new Date().toISOString().slice(0,10)}.pdf`
          : `${brandName}_Invoice_${firstOrder ? (firstOrder.orderId || firstOrder.order_number || Date.now()) : Date.now()}.pdf`;

      pdfMake.createPdf(finalDoc).download(filename, () => {
          const btn = document.getElementById('btn-download');
          if(btn) {
            btn.innerHTML = btn.dataset.origHtml || 'Download PDF';
            btn.disabled = false;
          }
          if(loadingEl) loadingEl.style.display = 'none';
          
          const successEl = document.getElementById('success-screen');
          if(successEl) successEl.style.display = 'flex';
          else if(actionEl) actionEl.style.display = 'flex'; 
      });
  }

  if (countLabel) {
      try {
        const raw = localStorage.getItem('Store Name-batch-print-orders');
        if (!raw) throw new Error('No data');
        const orders = JSON.parse(raw);
        if (!orders || orders.length === 0) throw new Error('Empty');

        countLabel.textContent = `${orders.length} orders processed successfully`;
        if(loadingEl) loadingEl.style.display = 'none';
        if(actionEl) actionEl.style.display = 'flex';

        if(btnDownload) {
            btnDownload.addEventListener('click', () => {
                btnDownload.dataset.origHtml = btnDownload.innerHTML;
                btnDownload.disabled = true;
                btnDownload.innerHTML = 'Generating PDF... (Please Wait)';
                generatePdf(orders, true);
            });
        }
      } catch(err) {
          console.error(err);
          if(loadingEl) loadingEl.style.display = 'none';
          if(errorEl) errorEl.style.display = 'flex';
      }
  } 
  else {
      if (typeof order !== 'undefined') {
          generatePdf([order], false);
      } else {
          alert('Error: Order data not found.');
      }
  }
});

