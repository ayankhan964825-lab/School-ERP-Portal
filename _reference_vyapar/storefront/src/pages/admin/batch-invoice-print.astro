                {text: bd.taxableValue.toFixed(2), alignment: 'right'},
                {text: `${bd.rate}%`, alignment: 'right'},
                {text: bd.taxAmount.toFixed(2), alignment: 'right'},
                {text: `₹${bd.taxAmount.toFixed(2)}`, alignment: 'right'}
            ]);
          });
      }

      const _intPart3 = Math.floor(grandTotal);
      const _decPart3 = Math.round((grandTotal - _intPart3) * 100);
      const amountInWords = (typeof numberToWords === 'function') 
        ? (_decPart3 > 0 
            ? numberToWords(_intPart3) + ' Rupees and ' + numberToWords(_decPart3) + ' Paise Only' 
            : numberToWords(_intPart3) + ' Rupees Only')
        : (_decPart3 > 0 
            ? `${_intPart3} Rupees and ${_decPart3} Paise Only` 
            : `${_intPart3} Rupees Only`);
      const orderIdObj = String(order.orderId || order.order_number || order.id || Date.now());
      const invoiceDate = safeDate(order.createdAt || order.created_at || Date.now()).toLocaleDateString('en-GB');

      return {
