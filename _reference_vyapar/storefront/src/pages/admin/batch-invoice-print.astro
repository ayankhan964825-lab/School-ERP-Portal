                                                      {text: `GSTIN: ${storeGst} | Mobile: ${String(storeSettings.contact_phone || '9876543211')}`, fontSize: 10, bold: true, margin: [0,4,0,0]},
                                                      {text: `PAN: ${String(storeSettings.pan_number || 'ACHFA6676K')} | Email: ${String(storeSettings.contact_email || 'sales.Store Name@gmail.com')}`, fontSize: 10}
                                                  ]
                                              }
                                          ]
                                      }
                                  ],
                                  margin: [10, 10, 10, 10]
                              },
                              {
                                  stack: [
