---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSettings } from '../../../lib/database';
import { getPermissionContext, canViewSection } from '../../../lib/permissions';

const ctx = getPermissionContext(Astro.cookies);
if (!ctx.adminRole || ctx.adminRole === 'guest') {
  return Astro.redirect('/admin/login');
}
if (!canViewSection(ctx, 'website_designs')) {
  return Astro.redirect('/admin');
}

const settings = await getSettings(Astro.locals?.storeId);

let webConfig: any = {};
if (settings?.website_configuration) {
  try {
    webConfig = typeof settings.website_configuration === 'string' 
      ? JSON.parse(settings.website_configuration) 
      : settings.website_configuration;
  } catch (e) {}
}
const isQCommerce = webConfig?.theme === 'qcommerce';
let designConfig = {
  active_design: 'classic'
};

try {
  if (settings?.website_design) {
    const parsed = typeof settings.website_design === 'string' 
      ? JSON.parse(settings.website_design) 
      : settings.website_design;
    designConfig = { ...designConfig, ...parsed };
  }
} catch (e) {
  console.error("Failed to parse website design", e);
}

const designs = [
  { id: 'classic', name: 'Classic (Default)', niche: 'Reliable & Clean', desc: 'The original classic storefront structural layout.', icon: 'M4 6h16M4 12h16M4 18h16' },
  { id: 'beauty', name: 'Soft & Approachable', niche: 'Skincare & Modern Retail', desc: 'Pill-shaped buttons, heavily rounded cards, soft floating drop shadows, and friendly Outfit typography.', icon: 'M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { id: 'energy', name: 'Neo-Brutalist', niche: 'Tech & Streetwear', desc: 'Razor sharp edges, thick bold borders, solid block shadows, and heavy uppercase Fredoka fonts.', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { id: 'earthy', name: 'Editorial Luxury', niche: 'Premium & High Fashion', desc: 'Zero shadows, flat minimalist borders, and elegant Playfair Display serif headings.', icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
];

if (isQCommerce) {
  designs.unshift({ id: 'qcommerce', name: 'Q-Commerce Layout', niche: 'Quick Commerce UI', desc: 'Dense grid layout with persistent fast-add buttons.', icon: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z' });
  designConfig.active_design = 'qcommerce';
}

---

<AdminLayout title="Global Designs | Admin Panel" description="Manage storefront structural layout designs.">
  <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-2xl font-serif font-bold text-secondary">Global Designs</h1>
      <p class="text-sm text-secondary/60 mt-1">Choose the structural layout and aesthetics of your storefront.</p>
    </div>
    <div class="flex items-center gap-3">
      <button id="save-design-btn" class="btn-primary !px-6 !py-2.5 !rounded-xl text-sm font-bold flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        Save Design
      </button>
    </div>
  </div>

  {isQCommerce && (
    <div class="mb-6 flex items-start gap-3 bg-amber-50 border border-amber-200 rounded-xl p-4 shadow-sm">
      <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" /></svg>
      <div>
        <p class="font-bold text-amber-800">Q-Commerce Theme is Active</p>
        <p class="text-amber-700 text-sm mt-1">Your store is currently using the dedicated Quick Commerce layout. If you select and save any standard design below, your store will <strong>automatically revert to the Standard E-commerce UI</strong> to prevent visual breakage.</p>
      </div>
    </div>
  )}

  <div class="bg-blue-50 border border-blue-100 rounded-2xl p-4 mb-8 flex gap-3">
    <div class="mt-0.5"><svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></div>
    <div>
      <h3 class="font-bold text-blue-900 text-sm">Theme vs Design</h3>
      <p class="text-xs text-blue-800 mt-1"><strong>Global Themes</strong> control the colors (Primary, Accent, Background). <strong>Global Designs</strong> control the structure (shapes, shadows, fonts, borders).</p>
    </div>
  </div>

  <!-- Design Grid -->
  <h2 class="text-lg font-bold text-secondary mb-3">Structural Layouts</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    {designs.map(design => (
      <label class={`theme-card cursor-pointer border-2 rounded-2xl p-5 flex flex-col gap-4 transition-all relative overflow-hidden ${designConfig.active_design === design.id ? 'border-primary bg-primary/5 ring-2 ring-primary/20' : 'border-gray-100 bg-white hover:border-gray-300'}`}>
        <input type="radio" name="active_design" value={design.id} class="peer sr-only" checked={designConfig.active_design === design.id} />
        
        <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-gray-50 shadow-inner border border-gray-100 flex-shrink-0">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" set:html={`<path stroke-linecap="round" stroke-linejoin="round" d="${design.icon}" />`}></svg>
        </div>

        <div>
          <h3 class="font-bold text-secondary text-sm">{design.name}</h3>
          <span class="text-[10px] uppercase tracking-wider text-primary/70 font-semibold">{design.niche}</span>
          <p class="text-xs text-secondary/50 mt-1 leading-relaxed">{design.desc}</p>
        </div>

        <div class="absolute top-4 right-4 text-primary opacity-0 peer-checked:opacity-100 transition-opacity">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
        </div>
      </label>
    ))}
  </div>

  <div id="designs-data" data-webconfig={JSON.stringify(webConfig)} class="hidden"></div>

<script is:inline data-astro-rerun>
  (function() {
    const dataEl = document.getElementById('designs-data');
    if (dataEl && dataEl.dataset.webconfig) {
      try {
        window.__currentWebConfig = JSON.parse(dataEl.dataset.webconfig);
      } catch(e) {}
    }
    const saveBtn = document.getElementById('save-design-btn');
    if (saveBtn) {
      saveBtn.onclick = async () => {
        saveBtn.innerHTML = 'Saving...';
        saveBtn.disabled = true;
        
        const active_design = document.querySelector('input[name="active_design"]:checked')?.value || 'classic';
        
        const payload = { active_design };
        
        // Existing WebConfig to preserve other settings like hide_out_of_stock
        const currentWebConfig = window.__currentWebConfig || {};
        let updatedWebConfig = currentWebConfig;
        // If they save a standard design, we MUST reset theme to standard so QCommerce is disabled safely
        if (active_design !== 'qcommerce') {
          updatedWebConfig = { ...currentWebConfig, theme: 'standard' };
        }
        
        let success = false;
        try {
          const res = await fetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              action: 'update', 
              settings: { 
                website_design: JSON.stringify(payload),
                website_configuration: JSON.stringify(updatedWebConfig)
              } 
            })
          });
          const data = await res.json();
          if(data.success) {
            success = true;
            saveBtn.innerHTML = '✅ Design Saved!';
            saveBtn.style.backgroundColor = '#16a34a';
            saveBtn.style.borderColor = '#16a34a';
            saveBtn.style.color = '#fff';
            setTimeout(() => {
              saveBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Save Design`; 
              saveBtn.style.backgroundColor = '';
              saveBtn.style.borderColor = '';
              saveBtn.style.color = '';
              saveBtn.disabled = false;
            }, 2000);
          } else {
            alert('Error saving design: ' + data.error);
          }
        } catch(err) {
          alert('Network error while saving.');
        }
        
        if (!success) {
          saveBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Save Design`; 
          saveBtn.disabled = false; 
        }
      };
    }

    // Basic styling for cards
    const cards = document.querySelectorAll('.theme-card');
    const radios = document.querySelectorAll('input[name="active_design"]');
    
    radios.forEach(radio => {
      radio.onchange = (e) => {
        cards.forEach(c => {
          c.classList.remove('border-primary', 'bg-primary/5', 'ring-2', 'ring-primary/20');
          c.classList.add('border-gray-100', 'bg-white');
        });
        
        const parent = e.target.closest('.theme-card');
        if (parent) {
          parent.classList.remove('border-gray-100', 'bg-white');
          parent.classList.add('border-primary', 'bg-primary/5', 'ring-2', 'ring-primary/20');
        }
      };
    });
  })();
</script>

</AdminLayout>
