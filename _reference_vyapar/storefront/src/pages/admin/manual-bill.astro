              <input type="text" id="product-search" autocomplete="off" placeholder="Type to search product..." class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none bg-gray-50/50">
