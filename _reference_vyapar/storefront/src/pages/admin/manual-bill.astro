---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
import { getProducts, getSettings, getCoupons, getActiveMilestone, supabaseAdmin, isSupabase } from '../../lib/database';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageAiPanel from '../../components/admin/PageAiPanel.astro';

const ctx = getPermissionContext(Astro.cookies);
if (!canManageSection(ctx, "orders_manual")) {
  return new Response("Forbidden", { status: 403 });
}

const products = await getProducts(Astro.locals?.storeId);
const settings = await getSettings(Astro.locals?.storeId);
const coupons = await getCoupons();
const milestoneOffer = await getActiveMilestone();

// Filter only active/inStock products
const activeProducts = products.filter((p: any) => p.inStock !== false && !p.outOfStock);

const productsJson = JSON.stringify(activeProducts.map((p: any) => ({
  id: p.id,
  name: p.name,
  price: p.price,
  originalPrice: p.originalPrice,
  hsn_code: p.hsn_code || settings.default_hsn_code || '0813',
  gst_rate: p.gst_rate || settings.default_gst_rate || 12,
  image: p.images?.[0] || '',
  hasVariants: p.hasVariants || (p.variants && p.variants.length > 0),
  variants: p.variants || []
})));

const settingsJson = JSON.stringify({
  free_shipping_threshold: settings.free_shipping_threshold || 499,
  flat_shipping_rate: settings.flat_shipping_rate || 60,
  prepaid_discount_enabled: settings.prepaid_discount_enabled,
  prepaid_discount_value: settings.prepaid_discount_value,
  prepaid_discount_type: settings.prepaid_discount_type,
  prepaid_discount_min_order: settings.prepaid_discount_min_order,
  allow_coupon_stacking: settings.allow_coupon_stacking,
  pos_upi_id: settings.pos_upi_id || ''
});

const couponsJson = JSON.stringify(coupons || []);
const milestoneJson = JSON.stringify(milestoneOffer || {});

let locations: any[] = [];
if (isSupabase && supabaseAdmin && Astro.locals?.storeId) {
  const { data } = await supabaseAdmin
    .from('locations')
    .select('id, name, is_default')
    .eq('store_id', Astro.locals.storeId)
    .eq('is_active', true)
    .order('created_at', { ascending: false });
  if (data) locations = data;
}
const locationsJson = JSON.stringify(locations);
---

<AdminLayout title="Manual Bill Generator | Your Brand Admin">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <div class="h-10 w-10 bg-primary/10 rounded-xl flex items-center justify-center">
