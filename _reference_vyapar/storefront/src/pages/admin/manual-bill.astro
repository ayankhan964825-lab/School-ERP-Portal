            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <h1 class="text-2xl font-serif font-bold text-secondary">WhatsApp / Manual Bill</h1>
      </div>
      <p class="text-sm text-secondary/55 ml-[52px]">Quickly generate bills for direct orders</p>
    </div>
  </div>

  <PageAiPanel 
    page="manual-bill"
    title="Manual Billing Assistant"
    pageDataJson={JSON.stringify({})}
    guideTitleEn="Manual Billing Guide"
    guideTitleHi="Manual Billing Guide"
    guideHtml={`<ul class="space-y-2">
      <li><strong>Customer:</strong> Enter guest checkout details.</li>
      <li><strong>Products:</strong> Search and add products, select variants if applicable.</li>
      <li><strong>Coupons:</strong> Enter a valid public or private coupon code to apply system discounts.</li>
      <li><strong>Discount:</strong> Add arbitrary flat discounts to negotiate via WhatsApp.</li>
      <li><strong>Print:</strong> Click Generate Bill to instantly get the printable PDF.</li>
    </ul>`}
    guideHtmlHi={`<ul class="space-y-2">
      <li><strong>Customer:</strong> Customer ki details dalein.</li>
      <li><strong>Products:</strong> Products search karke add karein.</li>
      <li><strong>Coupons:</strong> Coupon code (public ya private) apply kar sakte hain.</li>
      <li><strong>Discount:</strong> WhatsApp par bargaining handle karne ke liye manual discount de sakte hain.</li>
      <li><strong>Print:</strong> Generate dabaate hi invoice PDF taiyaar ho jayegi.</li>
    </ul>`}
    quickActions={[]}
  />

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-32">
    <!-- Left Column: Customer & Products -->
    <div class="lg:col-span-2 space-y-6">
      
