---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSettings } from '../../lib/database';
const settings = await getSettings(Astro.locals?.storeId);
const otpLength = parseInt(settings.otp_length || '4', 10);
---
<AdminLayout title="Forgot Password | Admin Panel">
  <div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
      <div class="flex justify-center">
        <a href="/" class="text-3xl font-serif font-bold text-primary tracking-tight">Your Brand</a>
      </div>
      <h2 class="mt-6 text-center text-2xl font-bold text-secondary">
        Reset Password
      </h2>
      <p class="mt-2 text-center text-sm text-secondary/60">
        Enter your email to request a password reset.
      </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
      <div class="bg-white py-8 px-4 shadow-sm sm:rounded-2xl sm:px-10 border border-gray-100">
        
        <!-- UI States managed by JS below -->
        <div id="state-success" class="hidden text-center">
          <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-green-100 mb-4">
            <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-lg font-medium text-secondary">Request Sent</h3>
          <p class="mt-2 text-sm text-gray-500">
            Your password reset request has been forwarded to your branch administrator. 
            Please contact them to get your new password.
          </p>
          <div class="mt-6">
            <a href="/admin/login" class="text-sm font-semibold text-primary hover:text-accent">
              Return to login
            </a>
          </div>
        </div>

        <div id="state-superadmin" class="hidden text-center">
          <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-orange-100 mb-4">
            <svg class="h-6 w-6 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="text-lg font-medium text-secondary">Request Sent</h3>
          <p class="mt-2 text-sm text-gray-500" id="superadmin-message">
            Request has been sent to developer (but use email recovery to change password instantly).
          </p>
          <div class="mt-6 flex flex-col gap-3">
            <button id="btn-email-recovery" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-semibold text-white bg-primary hover:bg-accent focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-all">
              Use Email Recovery
            </button>
            <a href="/admin/login" class="text-sm font-semibold text-gray-500 hover:text-gray-900">
              Return to login
            </a>
          </div>
        </div>

        <div id="state-otp" class="hidden">
          <form class="space-y-6" id="otp-form">
            <input type="hidden" name="action" value="verify_and_reset" />
            <input type="hidden" name="email" id="otp-email" />
            
            <div id="otp-error-alert" class="hidden bg-red-50 border border-red-200 rounded-xl px-4 py-3 text-sm text-red-700 font-medium"></div>
            
            <div>
              <label for="otp" class="block text-sm font-medium text-secondary">Enter Verification OTP</label>
              <div class="mt-1">
                <input id="otp" name="otp" type="text" required maxlength={otpLength} class="appearance-none block w-full px-4 py-2.5 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary sm:text-sm" />
              </div>
            </div>
            
            <div>
              <label for="new_password" class="block text-sm font-medium text-secondary">New Password</label>
              <div class="mt-1">
                <input id="new_password" name="new_password" type="password" required minlength="6" class="appearance-none block w-full px-4 py-2.5 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary sm:text-sm" />
              </div>
            </div>

            <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-semibold text-white bg-primary hover:bg-accent focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-all">
              Reset Password & Login
            </button>
          </form>
        </div>

        <div id="state-initial">
          <form class="space-y-6" id="forgot-password-form">
            <input type="hidden" name="action" value="request_reset" />
            
            <div id="error-alert" class="hidden bg-red-50 border border-red-200 rounded-xl px-4 py-3 text-sm text-red-700 font-medium"></div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-secondary">
                Email address
              </label>
              <div class="mt-1">
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="your@email.com"
                  class="appearance-none block w-full px-4 py-2.5 border border-gray-300 rounded-xl shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary sm:text-sm transition-all"
                />
              </div>
            </div>

            <div class="flex items-center justify-between gap-4">
              <a href="/admin/login" class="text-sm font-medium text-secondary/60 hover:text-secondary">
                Back to login
              </a>
              <button
                type="submit"
                class="flex justify-center py-2.5 px-6 border border-transparent rounded-full shadow-sm text-sm font-semibold text-white bg-primary hover:bg-accent focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors"
              >
                Send Request
              </button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </div>


<script is:inline data-astro-rerun>
  // Initial URL success check for backward compatibility
  if (new URLSearchParams(window.location.search).get('success') === 'true') {
    document.getElementById('state-initial').classList.add('hidden');
    document.getElementById('state-success').classList.remove('hidden');
  }

  let savedEmail = '';

  document.getElementById('forgot-password-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    const originalText = btn.innerText;
    btn.innerText = 'Sending...';
    btn.disabled = true;

    const email = form.querySelector('input[name="email"]').value;
    savedEmail = email; // Store for OTP step
    const action = form.querySelector('input[name="action"]').value;
    const errorAlert = document.getElementById('error-alert');
    if(errorAlert) errorAlert.classList.add('hidden');

    try {
      const res = await fetch('/api/admin/staff', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, email })
      });
      const data = await res.json();
      
      if (res.ok && data.success) {
        document.getElementById('state-initial').classList.add('hidden');
        if (data.isSuperAdmin) {
          document.getElementById('superadmin-message').textContent = data.message;
          document.getElementById('state-superadmin').classList.remove('hidden');
        } else {
          document.getElementById('state-success').classList.remove('hidden');
        }
      } else {
        if(errorAlert) {
            errorAlert.textContent = data.error || 'Failed to send request.';
            errorAlert.classList.remove('hidden');
        } else {
            alert(data.error || 'Failed to send request.');
        }
      }
    } catch (err) {
      if(errorAlert) {
          errorAlert.textContent = 'Network error. Please try again.';
          errorAlert.classList.remove('hidden');
      } else {
          alert('Network error. Please try again.');
      }
    } finally {
      btn.innerText = originalText;
      btn.disabled = false;
    }
  });

  // Handle Email Recovery Click
  document.getElementById('btn-email-recovery')?.addEventListener('click', async (e) => {
    const btn = e.target;
    const originalText = btn.innerText;
    btn.innerText = 'Sending OTP...';
    btn.disabled = true;

    try {
      const res = await fetch('/api/admin/password-recovery', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'send_otp', email: savedEmail })
      });
      const data = await res.json();
      
      if (res.ok && data.success) {
        document.getElementById('state-superadmin').classList.add('hidden');
        document.getElementById('state-otp').classList.remove('hidden');
        document.getElementById('otp-email').value = savedEmail;
      } else {
        alert(data.error || 'Failed to send OTP.');
      }
    } catch (err) {
      alert('Network error. Please try again.');
    } finally {
      btn.innerText = originalText;
      btn.disabled = false;
    }
  });

  // Handle OTP Form
  document.getElementById('otp-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    const originalText = btn.innerText;
    btn.innerText = 'Verifying...';
    btn.disabled = true;

    const email = form.querySelector('input[name="email"]').value;
    const otp = form.querySelector('input[name="otp"]').value;
    const new_password = form.querySelector('input[name="new_password"]').value;
    const action = form.querySelector('input[name="action"]').value;
    
    const errorAlert = document.getElementById('otp-error-alert');
    if(errorAlert) errorAlert.classList.add('hidden');

    try {
      const res = await fetch('/api/admin/password-recovery', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, email, otp, new_password })
      });
      const data = await res.json();
      
      if (res.ok && data.success) {
        // Success! They are logged in immediately.
        window.location.href = '/admin';
      } else {
        if(errorAlert) {
            errorAlert.textContent = data.error || 'Failed to verify OTP.';
            errorAlert.classList.remove('hidden');
        } else {
            alert(data.error || 'Failed to verify OTP.');
        }
      }
    } catch (err) {
      if(errorAlert) {
          errorAlert.textContent = 'Network error. Please try again.';
          errorAlert.classList.remove('hidden');
      } else {
          alert('Network error. Please try again.');
      }
    } finally {
      btn.innerText = originalText;
      btn.disabled = false;
    }
  });
</script>

</AdminLayout>
