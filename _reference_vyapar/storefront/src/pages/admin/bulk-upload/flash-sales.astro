---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageAiPanel from '../../../components/admin/PageAiPanel.astro';
import { getFlashSales, getProducts } from '../../../lib/database';

const sales = await getFlashSales();
const salesJson = JSON.stringify(sales, null, 2);

const products = await getProducts(Astro.locals?.storeId);
const productsJson = JSON.stringify(products, null, 2);
const catalogContext = products.map((p: any) => `- Name: ${p.name} (MRP: ₹${p.mrp || p.price || 0}, Regular Price: ₹${p.price || 0})`).join('\n');

const promptText = `Act as an e-commerce promotional strategist. Generate a JSON configuration for a series of upcoming Flash Sales.
Your output must be a valid JSON object containing a single key "campaigns", which is an array of flash sale campaign objects.

Use the provided Active Product Catalog to find valid product names and understand their current pricing.

Active Product Catalog:
${catalogContext}

Each campaign object MUST contain the following keys exactly:
- "title": The internal name of the sale campaign (e.g. "Summer Kickoff Sale")
- "discount_percentage": Number (e.g. 15 for 15%)
- "discount_basis": String, either "mrp" or "regular_price" based on user's prompt (default to regular_price)
- "startDate": ISO 8601 string without seconds (e.g. "2026-06-01T10:00")
- "endDate": ISO 8601 string without seconds (e.g. "2026-06-05T23:59")
- "product_names": Array of strings (Exact product names from the catalog above)

Example Output Format:
{
  "campaigns": [
    {
      "title": "Summer Kickoff Sale",
      "discount_percentage": 15,
      "discount_basis": "regular_price",
      "startDate": "2026-06-01T10:00",
      "endDate": "2026-06-05T23:59",
      "product_names": ["Almond Cookies", "Mixed Berries"]
    }
  ]
}

Please generate at least 3 creative, strategic flash sales spanning the upcoming holidays or weekends.`;
---

<AdminLayout title="Bulk Upload | Flash Sales" description="Generate bulk flash sales using AI.">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex items-center gap-4 mb-8">
      <a href="/admin/flash-sales" class="p-2 rounded-lg border border-gray-200 text-secondary hover:bg-gray-50 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      </a>
      <div>
        <h1 class="text-2xl font-serif font-bold text-secondary flex items-center gap-2">
          Flash Sales AI Generator
        </h1>
        <p class="text-sm text-secondary/60 mt-1">Generate multi-day promotional campaigns and bulk flash sales in one go.</p>
      </div>
    </div>

    <!-- AI Assistant Panel -->
    <PageAiPanel
      page="flash-sales"
      title="Flash Sales AI"
      pageDataJson="{}"
      guideTitleEn="How to use AI for Flash Sales"
      guideTitleHi="Flash Sales ke liye AI Guide"
      guideHtml={`<ul class="space-y-2">
        <li><strong>Auto Mode:</strong> Simply type what you want (e.g. "Make a weekend sale for all Mango products") and click Generate. The AI will look up your active products automatically.</li>
        <li><strong>Manual (BYO-AI):</strong> Copy the Super-Prompt, paste it into ChatGPT/Claude, and paste the JSON back here.</li>
      </ul>`}
      guideHtmlHi={`<ul class="space-y-2">
        <li><strong>Auto Mode:</strong> Bas likho aapko kaisa sale chahiye (e.g. "Weekend sale for Mango products") aur Generate dabao. AI khud products check kar lega.</li>
        <li><strong>Manual Mode:</strong> Super-Prompt copy karke ChatGPT mein paste karein, aur result wapas idhar paste karein.</li>
      </ul>`}
      quickActions={[
        { label: '🚀 Generate Weekend Sale', query: 'Make a weekend flash sale at 15% off' },
        { label: '🤖 Copy AI Prompt (Manual)', query: 'ai_prompt' }
      ]}
    />

    <!-- AI Generation Form -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 mt-6 mb-8">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-4">
          <h2 class="text-base font-bold text-secondary">AI Generation</h2>
          <!-- Toggle Switch -->
          <div class="flex items-center gap-2 bg-gray-100 p-1 rounded-lg">
            <button id="tab-auto" type="button" class="px-4 py-1.5 text-sm font-semibold rounded-md bg-white text-primary shadow-sm transition-all">Auto AI</button>
            <button id="tab-manual" type="button" class="px-4 py-1.5 text-sm font-semibold rounded-md text-gray-500 hover:text-secondary transition-all">Manual (BYO-AI)</button>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" id="download-json-btn" class="text-xs bg-gray-100 hover:bg-gray-200 text-secondary px-3 py-1.5 rounded-lg font-medium transition-colors flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Download Existing Sales
          </button>
          <button type="button" id="copy-prompt-btn" class="hidden text-xs bg-gray-100 hover:bg-gray-200 text-secondary px-3 py-1.5 rounded-lg font-medium transition-colors flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            Copy Super-Prompt
          </button>
        </div>
      </div>
      
      <!-- Script block to pass server data to client -->
      <script id="current-sales-data" type="application/json" set:html={salesJson}></script>
      <script id="catalog-products" type="application/json" set:html={productsJson}></script>
      <script id="catalog-context" type="text/plain" set:html={catalogContext} data-astro-rerun></script>
      
      <!-- Hidden textarea containing the prompt to copy -->
      <textarea id="ai-prompt-text" class="hidden">{promptText}</textarea>

      <form id="json-form" class="space-y-4">
        
        <!-- AUTO AI MODE -->
        <div id="mode-auto" class="space-y-3">
          <label class="text-sm font-medium text-secondary">What kind of flash sale do you want?</label>
          <div class="flex gap-3">
            <textarea id="auto-prompt" rows="2" class="flex-1 px-4 py-3 border border-gray-300 rounded-xl focus:ring-primary focus:border-primary text-sm bg-gray-50" placeholder='e.g. "Create a Diwali flash sale at 20% off for all Almond products next weekend"'></textarea>
            <button type="button" id="btn-auto-generate" class="btn-primary !px-6 flex items-center gap-2 self-start mt-1">
              <span>Generate ✨</span>
              <svg class="hidden animate-spin h-4 w-4" id="auto-spinner" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
            </button>
          </div>
        </div>

        <!-- MANUAL BYO-AI MODE -->
        <div id="mode-manual" class="hidden">
          <label class="block text-sm font-medium text-secondary mb-2">Paste JSON Here:</label>
          <textarea id="json-input" rows="10" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-primary focus:border-primary text-sm font-mono" placeholder='{\n  "flash_sales": [\n    ...\n  ]\n}'></textarea>
        </div>
        
        <div id="step-2-preview" class="hidden">
          <div class="p-4 bg-gray-50 border border-gray-200 rounded-xl mb-4">
            <h3 class="text-sm font-bold text-gray-700 mb-2">Data Preview (Please review before saving)</h3>
            <div id="json-preview-box" class="text-sm text-gray-600 overflow-auto max-h-80 p-2 bg-white border border-gray-100 rounded-lg"></div>
          </div>
        </div>

        <div id="json-error" class="hidden bg-red-50 text-red-700 p-3 rounded-lg text-sm border border-red-100"></div>
        <div id="json-success" class="hidden bg-green-50 text-green-700 p-3 rounded-lg text-sm border border-green-100 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
          <span id="json-success-text">Flash sales successfully created!</span>
        </div>
        
        <div class="flex justify-end gap-3" id="action-buttons">
          <button type="button" class="hidden btn-primary flex items-center gap-2 px-6 py-2" id="json-preview-btn">
            <span>Preview Data</span>
          </button>
          <button type="button" class="hidden px-6 py-2 rounded-xl text-sm font-semibold border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors" id="btn-edit-again">
            Edit JSON
          </button>
          <button type="submit" class="hidden btn-primary flex items-center gap-2 px-6 py-2 !bg-green-600 hover:!bg-green-700" id="json-submit-btn">
            <span>Confirm & Save</span>
            <svg class="hidden animate-spin h-4 w-4" id="json-spinner" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
          </button>
        </div>
      </form>
    </div>
  </div>


<script is:inline data-astro-rerun>
  // Tabs Logic
  const tabAuto = document.getElementById('tab-auto');
  const tabManual = document.getElementById('tab-manual');
  const modeAuto = document.getElementById('mode-auto');
  const modeManual = document.getElementById('mode-manual');
  const copyPromptBtn = document.getElementById('copy-prompt-btn');
  const previewBtn = document.getElementById('json-preview-btn');

  tabAuto.addEventListener('click', () => {
    tabAuto.classList.replace('text-gray-500', 'text-primary');
    tabAuto.classList.replace('hover:text-secondary', 'bg-white');
    tabAuto.classList.add('shadow-sm');
    
    tabManual.classList.replace('text-primary', 'text-gray-500');
    tabManual.classList.replace('bg-white', 'hover:text-secondary');
    tabManual.classList.remove('shadow-sm');
    
    modeAuto.classList.remove('hidden');
    modeManual.classList.add('hidden');
    copyPromptBtn.classList.add('hidden');
    previewBtn.classList.add('hidden');
  });

  tabManual.addEventListener('click', () => {
    tabManual.classList.replace('text-gray-500', 'text-primary');
    tabManual.classList.replace('hover:text-secondary', 'bg-white');
    tabManual.classList.add('shadow-sm');
    
    tabAuto.classList.replace('text-primary', 'text-gray-500');
    tabAuto.classList.replace('bg-white', 'hover:text-secondary');
    tabAuto.classList.remove('shadow-sm');
    
    modeManual.classList.remove('hidden');
    modeAuto.classList.add('hidden');
    copyPromptBtn.classList.remove('hidden');
    previewBtn.classList.remove('hidden');
  });

  // Copy Prompt Logic
  copyPromptBtn.addEventListener('click', () => {
    const text = (document.getElementById('ai-prompt-text')).value;
    navigator.clipboard.writeText(text);
    const originalHtml = copyPromptBtn.innerHTML;
    copyPromptBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg> <span class="text-green-700">Copied!</span>`;
    setTimeout(() => {
      copyPromptBtn.innerHTML = originalHtml;
    }, 2000);
  });

  // Download JSON Logic
  document.getElementById('download-json-btn')?.addEventListener('click', () => {
    const dataScript = document.getElementById('current-sales-data');
    if (!dataScript) return;
    try {
      const data = JSON.parse(dataScript.textContent || '[]');
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'Your Brand-flash-sales.json';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch (e) {
      console.error('Failed to parse and download JSON', e);
      alert('Failed to download existing data.');
    }
  });

  // Handle Quick Actions
  document.addEventListener('page-ai-query', ((e) => {
    const query = e.detail;
    if (query === 'ai_prompt') {
      tabManual.click();
      copyPromptBtn.click();
    } else {
      tabAuto.click();
      const autoPrompt = document.getElementById('auto-prompt');
      autoPrompt.value = query;
      document.getElementById('btn-auto-generate')?.click();
    }
  }));

  // Core Preview / Generate / Submit variables
  const submitBtn = document.getElementById('json-submit-btn');
  const editBtn = document.getElementById('btn-edit-again');
  const step2 = document.getElementById('step-2-preview');
  const previewBox = document.getElementById('json-preview-box');
  const errorDiv = document.getElementById('json-error');
  const successDiv = document.getElementById('json-success');
  const successText = document.getElementById('json-success-text');
  const input = document.getElementById('json-input');
  const autoPrompt = document.getElementById('auto-prompt');
  const btnAutoGenerate = document.getElementById('btn-auto-generate');
  const autoSpinner = document.getElementById('auto-spinner');
  let payload = null;
  let apiPayload = null;

  function generateApiPayloadAndHtml(jsonPayload) {
    const productsEl = document.getElementById('catalog-products');
    let allProducts = [];
    if (productsEl) {
      allProducts = JSON.parse(productsEl.textContent || '[]');
    }

    const campaigns = jsonPayload.campaigns || [];
    const finalSales = [];
    let html = `<table class="w-full text-left text-sm mt-2 border border-gray-100"><thead class="bg-gray-50 text-gray-500 uppercase text-xs"><tr><th class="p-2">Campaign</th><th class="p-2">Product</th><th class="p-2">Variant</th><th class="p-2">Price Info</th><th class="p-2">Sale Price</th></tr></thead><tbody>`;
    
    if (!campaigns.length) {
      html += `<tr><td colspan="5" class="p-2 text-center text-red-500">No campaigns found in JSON. Expected {"campaigns": [...]} format.</td></tr>`;
    }

    campaigns.forEach((camp) => {
      const pNames = camp.product_names || [];
      pNames.forEach((pName) => {
        const productData = allProducts.find(p => p.name.toLowerCase() === pName.toLowerCase());
        if (!productData) {
           html += `<tr class="bg-red-50"><td class="p-2">${camp.title}</td><td class="p-2 text-red-600 font-medium">${pName} (NOT FOUND)</td><td colspan="3"></td></tr>`;
           return;
        }

        const variants = productData.variants || [];
        variants.forEach((v) => {
          const vName = v.weight || v.name || 'Default';
          const mrp = parseFloat(v.mrp) || parseFloat(v.price) || parseFloat(productData.mrp) || parseFloat(productData.price) || 0;
          const regPrice = parseFloat(v.price) || parseFloat(productData.price) || 0;
          const discountPct = parseFloat(camp.discount_percentage) || 0;
          const discountBasis = camp.discount_basis === 'mrp' ? 'mrp' : 'regular_price';
          const baseValue = discountBasis === 'mrp' ? mrp : regPrice;
          const salePrice = Math.floor(baseValue * (1 - discountPct / 100));

          finalSales.push({
            product: productData.name,
            variant: vName,
            originalPrice: mrp,
            salePrice: salePrice,
            startDate: camp.startDate,
            endDate: camp.endDate,
            image: productData.images?.[0] || '',
            stockType: 'none',
            totalStock: null,
            soldStock: 0,
            fakePercentage: null
          });

          html += `<tr class="border-t border-gray-100"><td class="p-2 text-xs">${camp.title}</td><td class="p-2 font-medium">${productData.name}</td><td class="p-2 text-xs text-gray-500">${vName}</td><td class="p-2 text-xs text-gray-500"><span class="line-through text-gray-400">₹${mrp}</span> <br/> ₹${regPrice}</td><td class="p-2 font-bold text-green-600">₹${salePrice} <br/><span class="text-xs font-normal text-green-500">(-${discountPct}% off ${discountBasis})</span></td></tr>`;
        });
      });
    });

    html += `</tbody></table>`;
    return { html, apiPayload: finalSales };
  }

  // Auto Generate Action
  btnAutoGenerate.addEventListener('click', async () => {
    if (!autoPrompt.value.trim()) return;
    
    errorDiv.classList.add('hidden');
    successDiv.classList.add('hidden');
    btnAutoGenerate.disabled = true;
    autoSpinner.classList.remove('hidden');

    const catalogContext = document.getElementById('catalog-context')?.textContent || '';

    try {
      let currentData = null;
      if (input.value && input.value.trim()) {
        try { currentData = JSON.parse(input.value); } catch (e) { console.warn('Could not parse current flash sale data', e); }
      }
      const res = await fetch('/api/admin/generate-flash-sale', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt: autoPrompt.value, catalogContext, currentData })
      });
      
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'API Failed');

      // Populate textarea so edit works seamlessly
      input.value = JSON.stringify(data, null, 2);
      payload = data;

      // Show preview
      const processed = generateApiPayloadAndHtml(payload);
      apiPayload = processed.apiPayload;
      previewBox.innerHTML = processed.html;
      
      modeAuto.classList.add('hidden');
      modeManual.classList.add('hidden');
      step2.classList.remove('hidden');
      editBtn.classList.remove('hidden');
      submitBtn.classList.remove('hidden');

    } catch (err) {
      errorDiv.textContent = 'Failed to generate: ' + err.message;
      errorDiv.classList.remove('hidden');
    } finally {
      btnAutoGenerate.disabled = false;
      autoSpinner.classList.add('hidden');
    }
  });

  // Manual Preview Action
  previewBtn.addEventListener('click', () => {
    errorDiv.classList.add('hidden');
    successDiv.classList.add('hidden');
    
    try {
      payload = JSON.parse(input.value);
      const processed = generateApiPayloadAndHtml(payload);
      apiPayload = processed.apiPayload;
      previewBox.innerHTML = processed.html;
      
      modeManual.classList.add('hidden');
      modeAuto.classList.add('hidden');
      step2.classList.remove('hidden');
      previewBtn.classList.add('hidden');
      editBtn.classList.remove('hidden');
      submitBtn.classList.remove('hidden');
    } catch (err) {
      errorDiv.textContent = 'Invalid JSON: ' + err.message;
      errorDiv.classList.remove('hidden');
    }
  });

  // Edit Again Action
  editBtn.addEventListener('click', () => {
    step2.classList.add('hidden');
    editBtn.classList.add('hidden');
    submitBtn.classList.add('hidden');
    
    // We always bring them back to Manual mode to tweak the JSON
    tabManual.click();
  });

  // Final Submit Action
  document.getElementById('json-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!payload) return;

    const spinner = document.getElementById('json-spinner');
    errorDiv.classList.add('hidden');
    successDiv.classList.add('hidden');

    // We use the apiPayload that was generated during the Preview step
    if (!apiPayload || !apiPayload.length) {
      errorDiv.textContent = 'No valid products mapped for this campaign.';
      errorDiv.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    spinner.classList.remove('hidden');

    try {
      const res = await fetch('/api/admin/flash-sales', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'create_bulk',
          sales: apiPayload 
        })
      });
      
      const data = await res.json();
      
      if (res.ok && data.success) {
        successText.textContent = `Successfully created ${data.count} flash sales!`;
        successDiv.classList.remove('hidden');
        input.value = ''; // clear on success
        step2.classList.add('hidden');
        editBtn.classList.add('hidden');
        submitBtn.classList.add('hidden');
        tabAuto.click();
      } else {
        throw new Error(data.error || 'Failed to generate flash sales');
      }
    } catch (err) {
      errorDiv.textContent = err.message || 'Network error occurred';
      errorDiv.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      spinner.classList.add('hidden');
    }
  });
</script>

</AdminLayout>
