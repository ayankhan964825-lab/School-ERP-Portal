---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageAiPanel from '../../../components/admin/PageAiPanel.astro';
import { getShippingZones } from '../../../lib/database';

const zones = await getShippingZones();
const zonesJson = JSON.stringify(zones.map((z: any) => ({
  name: z.name,
  type: z.type,
  regions: z.regions,
  rates: z.rates,
  is_active: z.is_active
})), null, 2);

const promptText = `Act as an E-commerce Logistics Manager. Generate a JSON configuration for a well-structured list of shipping zones and their delivery rates.
Your output must be a valid JSON object containing a single key "zones", which is an array of shipping zone objects.

Each zone object MUST contain the following keys exactly:
- "name": The display name of the zone (e.g. "Metro Cities", "North India", "Rest of India")
- "type": Must be one of ["domestic", "international"]
- "regions": An array of region/state strings this zone covers (e.g. ["Maharashtra", "Delhi", "Karnataka"])
- "rates": An array of rate objects. Each rate object must have:
  - "name": Rate name (e.g. "Standard Delivery", "Express Delivery")
  - "price": Number representing the shipping cost (e.g. 50, 100)
  - "condition": Condition type (e.g. "weight", "price", "none")
  - "min": Minimum value for condition
  - "max": Maximum value for condition (use a very high number for infinity)
- "is_active": true or false

Example Output Format:
{
  "zones": [
    {
      "name": "Metro Cities",
      "type": "domestic",
      "regions": ["Delhi", "Maharashtra", "Karnataka", "Tamil Nadu", "West Bengal", "Telangana"],
      "rates": [
        {
          "name": "Standard Delivery",
          "price": 50,
          "condition": "weight",
          "min": 0,
          "max": 2
        }
      ],
      "is_active": true
    }
  ]
}

Please generate at least 3 logical shipping zones (e.g., Metro, Regional, Rest of India) with appropriate states and rates.`;
---

<AdminLayout title="Bulk Upload | Shipping" description="Generate bulk shipping zones using AI.">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex items-center gap-4 mb-8">
      <a href="/admin/shipping" class="p-2 rounded-lg border border-gray-200 text-secondary hover:bg-gray-50 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      </a>
      <div>
        <h1 class="text-2xl font-serif font-bold text-secondary flex items-center gap-2">
          Shipping BYO-AI
        </h1>
        <p class="text-sm text-secondary/60 mt-1">Generate your entire shipping zone strategy and rates in one go.</p>
      </div>
    </div>

    <!-- AI Assistant Panel -->
    <PageAiPanel
      page="shipping"
      title="Shipping AI"
      pageDataJson="{}"
      guideTitleEn="How to use BYO-AI for Shipping"
      guideTitleHi="Shipping ke liye BYO-AI Guide"
      guideHtml={`<ul class="space-y-2">
        <li><strong>Step 1:</strong> Copy the Super-Prompt below.</li>
        <li><strong>Step 2:</strong> Paste it into ChatGPT or Claude. You can also provide specific rules (e.g. "Free shipping above 500 for Metro") and let AI formulate the JSON!</li>
        <li><strong>Step 3:</strong> Paste the generated JSON output into the text box and click Process.</li>
      </ul>`}
      guideHtmlHi={`<ul class="space-y-2">
        <li><strong>Step 1:</strong> Niche diya gaya Super-Prompt copy karein.</li>
        <li><strong>Step 2:</strong> Ise ChatGPT/Claude mein paste karein. Aap apne specific rules (e.g. "Delhi ke liye 50 rs") bata sakte hain.</li>
        <li><strong>Step 3:</strong> Wahan se mila hua JSON yahan paste karke Submit karein.</li>
      </ul>`}
      quickActions={[
        { label: '🤖 Copy AI Prompt', query: 'ai_prompt' }
      ]}
    />

    <!-- BYO-AI Implementation Form -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 mt-6 mb-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-base font-bold text-secondary">JSON Input (BYO-AI)</h2>
        <div class="flex items-center gap-2">
          <button type="button" id="download-json-btn" class="text-xs bg-gray-100 hover:bg-gray-200 text-secondary px-3 py-1.5 rounded-lg font-medium transition-colors flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Download Existing Zones
          </button>
          <button type="button" id="copy-prompt-btn" class="text-xs bg-gray-100 hover:bg-gray-200 text-secondary px-3 py-1.5 rounded-lg font-medium transition-colors flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            Copy Super-Prompt
          </button>
        </div>
      </div>
      
      <!-- Script block to pass server data to client -->
      <script id="current-shipping-data" type="application/json" set:html={zonesJson}></script>
      
      <!-- Hidden textarea containing the prompt to copy -->
      <textarea id="ai-prompt-text" class="hidden">{promptText}</textarea>

      <form id="json-form" class="space-y-4">
        <div id="step-1-input">
          <textarea id="json-input" rows="15" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-primary focus:border-primary text-sm font-mono" placeholder='{\n  "zones": [\n    {\n      "name": "Metro Cities",\n      "type": "domestic",\n      "regions": ["Delhi", "Maharashtra"],\n      "rates": [\n        {\n          "name": "Standard",\n          "price": 50,\n          "condition": "weight",\n          "min": 0,\n          "max": 2\n        }\n      ],\n      "is_active": true\n    }\n  ]\n}' required></textarea>
        </div>
        
        <div id="step-2-preview" class="hidden">
          <div class="p-4 bg-gray-50 border border-gray-200 rounded-xl mb-4">
            <h3 class="text-sm font-bold text-gray-700 mb-2">Data Preview (Please review before saving)</h3>
            <pre id="json-preview-box" class="text-xs font-mono text-gray-600 overflow-auto max-h-80 p-2 bg-white border border-gray-100 rounded-lg"></pre>
          </div>
        </div>

        <div id="json-error" class="hidden bg-red-50 text-red-700 p-3 rounded-lg text-sm border border-red-100"></div>
        <div id="json-success" class="hidden bg-green-50 text-green-700 p-3 rounded-lg text-sm border border-green-100 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
          <span id="json-success-text">Zones successfully created!</span>
        </div>
        
        <div class="flex justify-end gap-3" id="action-buttons">
          <button type="button" class="btn-primary flex items-center gap-2 px-6 py-2" id="json-preview-btn">
            <span>Preview Data</span>
          </button>
          <button type="button" class="hidden px-6 py-2 rounded-xl text-sm font-semibold border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors" id="btn-edit-again">
            Edit JSON
          </button>
          <button type="submit" class="hidden btn-primary flex items-center gap-2 px-6 py-2 !bg-green-600 hover:!bg-green-700" id="json-submit-btn">
            <span>Confirm & Save</span>
            <svg class="hidden animate-spin h-4 w-4" id="json-spinner" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
          </button>
        </div>
      </form>
    </div>
  </div>


<script is:inline data-astro-rerun>
  // Copy Prompt Logic
  document.getElementById('copy-prompt-btn')?.addEventListener('click', () => {
    const text = (document.getElementById('ai-prompt-text')).value;
    navigator.clipboard.writeText(text);
    const btn = document.getElementById('copy-prompt-btn');
    const originalHtml = btn.innerHTML;
    btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg> <span class="text-green-700">Copied!</span>`;
    setTimeout(() => {
      btn.innerHTML = originalHtml;
    }, 2000);
  });

  // Download JSON Logic
  document.getElementById('download-json-btn')?.addEventListener('click', () => {
    const dataScript = document.getElementById('current-shipping-data');
    if (!dataScript) return;
    try {
      const data = JSON.parse(dataScript.textContent || '[]');
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'Your Brand-shipping.json';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch (e) {
      console.error('Failed to parse and download JSON', e);
      alert('Failed to download existing data.');
    }
  });

  // Handle Quick Actions
  document.addEventListener('page-ai-query', ((e) => {
    const query = e.detail;
    if (query === 'ai_prompt') {
      document.getElementById('copy-prompt-btn')?.click();
    }
  }));

  // Form Submission & Preview Logic
  const previewBtn = document.getElementById('json-preview-btn');
  const submitBtn = document.getElementById('json-submit-btn');
  const editBtn = document.getElementById('btn-edit-again');
  const step1 = document.getElementById('step-1-input');
  const step2 = document.getElementById('step-2-preview');
  const previewBox = document.getElementById('json-preview-box');
  const errorDiv = document.getElementById('json-error');
  const successDiv = document.getElementById('json-success');
  const successText = document.getElementById('json-success-text');
  const input = document.getElementById('json-input');
  const spinner = document.getElementById('json-spinner');

  let payload = null;

  previewBtn?.addEventListener('click', () => {
    errorDiv.classList.add('hidden');
    successDiv.classList.add('hidden');
    
    try {
      payload = JSON.parse(input.value);
      previewBox.textContent = JSON.stringify(payload, null, 2);
      
      step1?.classList.add('hidden');
      step2?.classList.remove('hidden');
      previewBtn.classList.add('hidden');
      editBtn?.classList.remove('hidden');
      submitBtn.classList.remove('hidden');
    } catch (err: any) {
      errorDiv.textContent = 'Invalid JSON: ' + err.message;
      errorDiv.classList.remove('hidden');
    }
  });

  editBtn?.addEventListener('click', () => {
    step2?.classList.add('hidden');
    step1?.classList.remove('hidden');
    editBtn.classList.add('hidden');
    submitBtn.classList.add('hidden');
    previewBtn?.classList.remove('hidden');
  });

  document.getElementById('json-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!payload) return;

    errorDiv.classList.add('hidden');
    successDiv.classList.add('hidden');

    if (!payload || !Array.isArray(payload.zones)) {
      errorDiv.textContent = 'JSON must contain a "zones" array.';
      errorDiv.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    spinner.classList.remove('hidden');

    try {
      const res = await fetch('/api/admin/shipping', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'create_bulk_zones',
          zones: payload.zones
        })
      });
      
      const data = await res.json();
      
      if (res.ok && data.success) {
        successText.textContent = `Successfully created ${data.count} shipping zones!`;
        successDiv.classList.remove('hidden');
        input.value = ''; // clear on success
      } else {
        throw new Error(data.error || 'Failed to generate shipping zones');
      }
    } catch (err: any) {
      errorDiv.textContent = err.message || 'Network error occurred';
      errorDiv.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      spinner.classList.add('hidden');
    }
  });
</script>

</AdminLayout>
