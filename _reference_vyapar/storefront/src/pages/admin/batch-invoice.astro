---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
const ctx = getPermissionContext(Astro.cookies);

if (Astro.request.method === "POST" && !canManageSection(ctx, "batch_invoice")) {
  return new Response("Forbidden", { status: 403 });
}
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageAiPanel from '../../components/admin/PageAiPanel.astro';
import { getOrders } from '../../lib/database';

let dbOrders = await getOrders(Astro.locals?.storeId);
dbOrders = dbOrders.filter((o: any) => !(o.is_b2b || (o.customer && o.customer.is_b2b)));

// Map DB orders to batch format
const formattedOrders = dbOrders.map((o: any) => {
  const items = (o.items || []).map((i: any) => `${i.name} ${i.weight || i.variant || ''} × ${(i.quantity || i.qty || 1)}`).join(', ');
  const totalWeight = (o.items || []).reduce((sum: number, i: any) => sum + (i.quantity || i.qty || 1), 0);
  return {
    id: o.orderId || o.id,
    customer: o.customer?.name || 'Unknown',
    phone: o.customer?.phone || '',
    address: o.customer?.address || '',
    city: o.customer?.city || '',
    state: o.customer?.state || '',
    pincode: o.customer?.pincode || '',
    amount: o.amount || 0,
    status: (o.status || 'pending').toLowerCase(),
    date: o.createdAt || o.created_at || new Date().toISOString().slice(0, 10),
    payment: o.paymentMethod || 'COD',
    weight: `${totalWeight * 100}g`,
    items: items || 'No items',
  };
});

type OrderStatus = 'pending' | 'confirmed' | 'shipped' | 'delivered' | 'cancelled';
type PaymentMethod = 'COD' | 'Prepaid' | 'UPI' | 'Card';

const statusConfig: Record<string, { label: string; classes: string; dot: string }> = {
  pending:   { label: 'Pending',   classes: 'bg-amber-50 text-amber-700 border-amber-200',   dot: 'bg-amber-400' },
  confirmed: { label: 'Confirmed', classes: 'bg-blue-50 text-blue-700 border-blue-200',      dot: 'bg-blue-400' },
  shipped:   { label: 'Shipped',   classes: 'bg-violet-50 text-violet-700 border-violet-200', dot: 'bg-violet-400' },
  delivered: { label: 'Delivered', classes: 'bg-emerald-50 text-emerald-700 border-emerald-200', dot: 'bg-emerald-400' },
  cancelled: { label: 'Cancelled', classes: 'bg-red-50 text-red-700 border-red-200',         dot: 'bg-red-400' },
};

const paymentConfig: Record<string, string> = {
  COD:     'bg-orange-50 text-orange-700 border-orange-200',
  Prepaid: 'bg-green-50 text-green-700 border-green-200',
  UPI:     'bg-purple-50 text-purple-700 border-purple-200',
  Card:    'bg-sky-50 text-sky-700 border-sky-200',
};

const ordersJsonForScript = JSON.stringify(
  formattedOrders.reduce((acc: any, o: any) => {
    acc[o.id] = o;
    return acc;
  }, {})
);

const rawOrdersJsonForScript = JSON.stringify(
  dbOrders.reduce((acc: any, o: any) => {
    acc[o.orderId || o.id] = o;
    return acc;
  }, {})
);

const batchOrdersForAI = JSON.stringify(formattedOrders.slice(0, 100).map((o: any) => ({
  id: o.id,
  status: o.status,
  date: o.date,
  customer: o.customer,
  total: o.amount
})));
---

<AdminLayout title="Batch Invoice & Label Print | Your Brand Admin">

  <!-- ── Page Header ─────────────────────────────────────────── -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <div class="h-10 w-10 bg-primary/10 rounded-xl flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
        </div>
        <h1 class="text-2xl font-serif font-bold text-secondary">Batch Invoice & Label Print</h1>
      </div>
      <p class="text-sm text-secondary/55 ml-[52px]">Select multiple orders to print all invoices at once</p>
    </div>
  </div>

  <!-- AI Assistant Panel -->
  <PageAiPanel
    page="batch-invoice"
    title="Batch Invoice Assistant"
    pageDataJson={batchOrdersForAI}
    guideTitleEn="Batch Print Guide"
    guideTitleHi="Batch Print Guide"
    guideHtml={`<ul class="space-y-2">
      <li><strong>Selection:</strong> Use checkboxes to select multiple orders for batch processing.</li>
      <li><strong>Filter:</strong> Filter by date, status, or search to find specific orders.</li>
      <li><strong>Print Invoices:</strong> Prints standard A4/A5 invoices for selected orders.</li>
    </ul>`}
    guideHtmlHi={`<ul class="space-y-2">
      <li><strong>Selection:</strong> Ek saath multiple orders select karne ke liye checkboxes use karein.</li>
      <li><strong>Filter:</strong> Date, status, ya search se orders jaldi dhundhein.</li>
      <li><strong>Print Invoices:</strong> Selected orders ke invoices print karne ke liye click karein.</li>
    </ul>`}
    quickActions={[
      { label: '📦 Pending select', query: 'saare pending orders select karo' },
      { label: '✅ Confirmed select', query: 'saare confirmed orders select karo' },
      { label: '🖨️ Print invoices', query: 'selected orders ke invoices print karo' },
      { label: '📊 Export CSV', query: 'CSV export karo' },
      { label: '✗ Clear', query: 'selection clear karo' }
    ]}
  />

  <!-- ── Filter Bar ──────────────────────────────────────────── -->
  <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-4 mb-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <!-- Date From -->
      <div class="relative">
        <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase tracking-wider">From Date</label>
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute left-3 top-1/2 -translate-y-1/2 text-secondary/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <input type="date" id="filter-from" class="w-full pl-9 pr-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none text-secondary/80 bg-gray-50/50" />
        </div>
      </div>
      <!-- Date To -->
      <div>
        <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase tracking-wider">To Date</label>
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute left-3 top-1/2 -translate-y-1/2 text-secondary/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <input type="date" id="filter-to" class="w-full pl-9 pr-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none text-secondary/80 bg-gray-50/50" />
        </div>
      </div>
      <!-- Status -->
      <div>
        <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase tracking-wider">Status</label>
        <select id="filter-status" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none text-secondary/80 bg-gray-50/50 appearance-none">
          <option value="">All Statuses</option>
          <option value="pending">Pending</option>
          <option value="confirmed">Confirmed</option>
          <option value="shipped">Shipped</option>
          <option value="delivered">Delivered</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </div>
      <!-- Payment Method -->
      <div>
        <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase tracking-wider">Payment Method</label>
        <select id="filter-payment" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none text-secondary/80 bg-gray-50/50 appearance-none">
          <option value="">All Methods</option>
          <option value="COD">COD</option>
          <option value="Prepaid">Prepaid</option>
