          <option value="date-asc">Date (Oldest)</option>
          <option value="amount-desc">Amount ↓</option>
          <option value="amount-asc">Amount ↑</option>
        </select>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-xs text-secondary/50 uppercase tracking-wider bg-gray-50/80 border-b border-gray-100">
          <tr>
            <th class="px-5 py-3 w-10"></th>
            <th class="px-5 py-3 text-left font-semibold">Order ID</th>
            <th class="px-5 py-3 text-left font-semibold">Customer</th>
            <th class="px-5 py-3 text-left font-semibold">Items</th>
            <th class="px-5 py-3 text-right font-semibold">Amount</th>
            <th class="px-5 py-3 text-left font-semibold">Status</th>
            <th class="px-5 py-3 text-left font-semibold">Date</th>
            <th class="px-5 py-3 text-left font-semibold">Payment</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50" id="orders-tbody">
          {formattedOrders.map((order) => {
            const sc = statusConfig[order.status] || { label: order.status || 'Unknown', classes: 'bg-gray-50 text-gray-700 border-gray-200', dot: 'bg-gray-400' };
            const pc = paymentConfig[order.payment] || 'bg-gray-50 text-gray-700 border-gray-200';
            return (
              <tr
                class="order-row hover:bg-primary/5 transition-colors cursor-pointer group"
