                </td>
                <!-- Order ID -->
                <td class="px-5 py-4">
                  <span class="font-bold text-secondary font-mono text-xs tracking-wide">{order.id}</span>
                </td>
                <!-- Customer -->
                <td class="px-5 py-4">
                  <div class="font-semibold text-secondary text-sm">{order.customer}</div>
                  <div class="text-xs text-secondary/45 mt-0.5">{order.phone}</div>
                  <div class="text-xs text-secondary/35 mt-0.5 max-w-[160px] truncate">{order.city}, {order.state}</div>
                </td>
                <!-- Items -->
                <td class="px-5 py-4">
                  <div class="text-xs text-secondary/65 max-w-[180px] line-clamp-2">{order.items}</div>
                  <div class="text-xs text-secondary/40 mt-0.5">Wt: {order.weight}</div>
                </td>
                <!-- Amount -->
                <td class="px-5 py-4 text-right">
                  <span class="font-bold text-secondary text-base">₹{order.amount.toLocaleString('en-IN')}</span>
                </td>
                <!-- Status -->
                <td class="px-5 py-4">
                  <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold border ${sc.classes}`}>
                    <span class={`h-1.5 w-1.5 rounded-full ${sc.dot}`}></span>
                    {sc.label}
                  </span>
                </td>
                <!-- Date -->
                <td class="px-5 py-4">
                  <span class="text-xs text-secondary/65 font-medium">
                    {new Date(order.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </span>
                </td>
                <!-- Payment -->
                <td class="px-5 py-4">
                  <span class={`inline-block px-2.5 py-1 rounded-lg text-xs font-bold border ${pc}`}>
                    {order.payment}
                  </span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <!-- Empty state (hidden by default) -->
    <div id="empty-state" class="hidden py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-3 text-secondary/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <p class="text-secondary/40 text-sm font-medium">No orders match your filters</p>
      <button onclick="document.getElementById('clear-filters').click()" class="mt-3 text-xs text-primary font-semibold hover:underline">Clear filters</button>
    </div>
  </div>

  <!-- ── Floating Action Bar (shown when orders selected) ───── -->
  <div id="action-bar" class="fixed bottom-0 left-0 right-0 z-40 hidden md:left-64">
    <div class="bg-secondary text-white shadow-2xl border-t border-white/10">
      <div class="max-w-screen-xl mx-auto px-6 py-3.5 flex flex-wrap items-center gap-4">
        <!-- Count + deselect -->
        <div class="flex items-center gap-3 mr-auto">
          <div class="h-8 w-8 bg-primary rounded-lg flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-bold leading-tight"><span id="bar-count">0</span> orders selected</p>
            <p class="text-xs text-white/50 leading-tight">Ready to print</p>
          </div>
          <button id="deselect-all" class="ml-2 text-xs text-white/50 hover:text-white underline underline-offset-2 transition-colors">
            Deselect all
          </button>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2.5 flex-wrap">
          <button id="print-invoices-btn" class="flex items-center gap-2 px-4 py-2 bg-primary hover:bg-primary/90 text-white text-sm font-semibold rounded-xl transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Print All Invoices
          </button>
          <!-- Export CSV -->
          <button id="export-csv-btn" class="flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-sm font-semibold rounded-xl transition-colors border border-white/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Export to CSV
          </button>
        </div>
      </div>
    </div>
  </div>





<!-- ── Toast Notification ───────────────────────────────────── -->
<div id="toast" class="fixed top-6 right-6 z-50 hidden">
  <div class="bg-secondary text-white px-5 py-3.5 rounded-xl shadow-xl flex items-center gap-3 text-sm font-medium min-w-[220px]">
    <svg id="toast-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span id="toast-message">Done!</span>
  </div>
</div>

<!-- ── Print Styles ──────────────────────────────────────────── -->
<style>
  @media print {
    body * { visibility: hidden !important; }
    #print-area, #print-area * { visibility: visible !important; }
    #print-area {
      position: fixed !important;
      top: 0; left: 0;
      width: 100%; height: auto;
      background: white !important;
    }
  }
  .order-row { transition: background-color 0.15s ease; }
  .order-row.selected { background-color: rgba(var(--color-primary-rgb, 139,90,43), 0.06); }
</style>

<!-- Hidden data for client-side JS -->
<script type="application/json" id="orders-data-json" set:html={ordersJsonForScript.replace(/</g, '\\u003c')}></script>
<script type="application/json" id="raw-orders-data-json" set:html={rawOrdersJsonForScript.replace(/</g, '\\u003c')}></script>

<div id="print-area" class="hidden"></div>

<script data-astro-rerun>
  // ─── Data Store ───────────────────────────────────────────────────
  

  function escapeHTML(str) {
    if (typeof str !== 'string') return str;
    return str.replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;')
              .replace(/'/g, '&#39;');
  }

  // Build data from DOM rows
  function getOrderDataFromRow(row) {
    return {
      id:       row.dataset.id || '',
      customer: row.dataset.customer || '',
      phone:    row.querySelector('td:nth-child(3) div:nth-child(2)')?.textContent?.trim() || '',
      address:  row.querySelector('td:nth-child(3) div:nth-child(3)')?.textContent?.trim() || '',
      city:     row.dataset.id ? (() => {
        const parts = (row.querySelector('td:nth-child(3) div:nth-child(3)')?.textContent || '').split(',');
        return parts[0]?.trim() || '';
      })() : '',
      state:    '',
      pincode:  '',
      amount:   parseInt(row.dataset.amount || '0'),
      status:   row.dataset.status || '',
      date:     row.dataset.date || '',
      payment:  row.dataset.payment || '',
      weight:   row.querySelector('td:nth-child(4) div:nth-child(2)')?.textContent?.replace('Wt:', '').trim() || '',
      items:    row.querySelector('td:nth-child(4) div:nth-child(1)')?.textContent?.trim() || '',
    };
  }

  // ─── Full order data (from database) ──────────────────────────────
  const allOrderData = JSON.parse(document.getElementById('orders-data-json')?.textContent || '{}');
  const rawOrderData = JSON.parse(document.getElementById('raw-orders-data-json')?.textContent || '{}');

  // ─── State ────────────────────────────────────────────────────────
  let selectedIds = new Set();

  // ─── DOM Refs ─────────────────────────────────────────────────────
  const selectAll      = document.getElementById('select-all');
  const actionBar      = document.getElementById('action-bar');
  const barCount       = document.getElementById('bar-count');
  const headerCount    = document.getElementById('selected-count-header');
  const tableCount     = document.getElementById('table-count');
  const deselectAll    = document.getElementById('deselect-all');
  const printInvoicesBtn = document.getElementById('print-invoices-btn');
  const exportCsvBtn   = document.getElementById('export-csv-btn');

  // ─── Selection Logic ──────────────────────────────────────────────
  function getVisibleRows() {
    return Array.from(document.querySelectorAll('.order-row'))
      .filter(r => r.style.display !== 'none');
  }

  function updateUI() {
    const count = selectedIds.size;
    barCount.textContent = String(count);
    if (headerCount) headerCount.textContent = `${count} selected`;

    if (count > 0) {
      actionBar.classList.remove('hidden');
    } else {
      actionBar.classList.add('hidden');
    }

    // Update Select All indeterminate state
    const visible = getVisibleRows();
    const visibleSelected = visible.filter(r => selectedIds.has(r.dataset.id || ''));
    if (visibleSelected.length === 0) {
      selectAll.checked = false;
      selectAll.indeterminate = false;
    } else if (visibleSelected.length === visible.length) {
      selectAll.checked = true;
      selectAll.indeterminate = false;
    } else {
      selectAll.checked = false;
      selectAll.indeterminate = true;
    }

    // Sync individual checkboxes
    document.querySelectorAll('.order-checkbox').forEach(cb => {
      const id = cb.dataset.orderId || '';
      const isSelected = selectedIds.has(id);
      cb.checked = isSelected;
      const row = cb.closest('tr');
      if (isSelected) {
        row?.classList.add('selected', 'bg-primary/5');
      } else {
        row?.classList.remove('selected', 'bg-primary/5');
      }
    });
  }

  function toggleRow(id, checked) {
    if (checked) {
      selectedIds.add(id);
    } else {
      selectedIds.delete(id);
    }
    updateUI();
  }

  // Row checkboxes
  document.querySelectorAll('.order-checkbox').forEach(cb => {
    cb.addEventListener('change', () => {
      toggleRow(cb.dataset.orderId || '', cb.checked);
    });
  });

  // Click on row body to toggle
  document.querySelectorAll('.order-row').forEach(row => {
    row.addEventListener('click', (e) => {
      const target = e.target;
      if (target.tagName === 'INPUT' || target.tagName === 'LABEL' || target.closest('label')) return;
      const id = row.dataset.id || '';
      const isNowSelected = !selectedIds.has(id);
      toggleRow(id, isNowSelected);
      const cb = row.querySelector('.order-checkbox');
      if (cb) cb.checked = isNowSelected;
    });
  });

  // Select All
  selectAll.addEventListener('change', () => {
    const rows = getVisibleRows();
    rows.forEach(row => {
      const id = row.dataset.id || '';
      if (selectAll.checked) {
        selectedIds.add(id);
      } else {
        selectedIds.delete(id);
      }
    });
    updateUI();
  });

  // Deselect All
  deselectAll.addEventListener('click', () => {
    selectedIds.clear();
    updateUI();
  });

  // ─── Filters ──────────────────────────────────────────────────────
  function applyFilters() {
    const fromVal   = (document.getElementById('filter-from')).value;
    const toVal     = (document.getElementById('filter-to')).value;
    const statusVal = (document.getElementById('filter-status')).value;
    const payVal    = (document.getElementById('filter-payment')).value;
    const searchVal = (document.getElementById('filter-search')).value.toLowerCase();

    const rows = document.querySelectorAll('.order-row');
    let visible = 0;

    rows.forEach(row => {
      const date    = row.dataset.date || '';
      const status  = row.dataset.status || '';
      const payment = row.dataset.payment || '';
      const id      = (row.dataset.id || '').toLowerCase();
      const customer = (row.dataset.customer || '').toLowerCase();

      const inDate    = (!fromVal || date >= fromVal) && (!toVal || date <= toVal);
      const inStatus  = !statusVal || status === statusVal;
      const inPayment = !payVal || payment === payVal;
      const inSearch  = !searchVal || id.includes(searchVal) || customer.includes(searchVal);

      const show = inDate && inStatus && inPayment && inSearch;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    tableCount.textContent = `${visible} order${visible !== 1 ? 's' : ''}`;
    const emptyState = document.getElementById('empty-state');
    if (emptyState) emptyState.style.display = visible === 0 ? 'block' : 'none';

    // Deselect hidden rows
    rows.forEach(row => {
      if (row.style.display === 'none') {
        selectedIds.delete(row.dataset.id || '');
      }
    });
    updateUI();
  }

  ['filter-from','filter-to','filter-status','filter-payment','filter-search'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', applyFilters);
    document.getElementById(id)?.addEventListener('change', applyFilters);
  });

  document.getElementById('clear-filters')?.addEventListener('click', () => {
    (document.getElementById('filter-from')).value = '';
    (document.getElementById('filter-to')).value = '';
    (document.getElementById('filter-status')).value = '';
    (document.getElementById('filter-payment')).value = '';
    (document.getElementById('filter-search')).value = '';
    applyFilters();
  });

  // ─── Print Invoices ───────────────────────────────────────────────
  printInvoicesBtn.addEventListener('click', () => {
    if (selectedIds.size === 0) return;
    const ids = Array.from(selectedIds);

    // Save full order objects to localStorage so print page doesn't need a DB call (works across tabs)
    const selectedOrders = ids.map(id => rawOrderData[id]).filter(Boolean);
    if (selectedOrders.length === 0) {
      showToast('Could not find order data. Please refresh and try again.', 'error');
      return;
    }
    localStorage.setItem('Your Brand-batch-print-orders', JSON.stringify(selectedOrders));

    showToast(`Opening ${selectedOrders.length} invoice${selectedOrders.length > 1 ? 's' : ''} for printing…`);
    setTimeout(() => {
      window.open('/admin/batch-invoice-print', '_blank');
    }, 300);
  });



  // ─── Export CSV ───────────────────────────────────────────────────
  exportCsvBtn.addEventListener('click', () => {
    if (selectedIds.size === 0) return;
    const orders = Array.from(selectedIds).map(id => allOrderData[id]).filter(Boolean);
    const headers = ['Order ID','Customer','Phone','Address','City','State','Pincode','Amount','Status','Date','Payment','Weight','Items'];
    const rows = orders.map(o => [
      o.id, o.customer, o.phone,
      `"${o.address}"`, o.city, o.state, o.pincode,
      o.amount, o.status, o.date, o.payment, o.weight,
      `"${o.items}"`
    ]);
    const csv = [headers, ...rows].map(r => r.join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Your Brand-orders-${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
    showToast(`Exported ${orders.length} orders to CSV`);
  });

  // ─── Toast Helper ─────────────────────────────────────────────────
  function showToast(msg) {
    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toast-message');
    toastMsg.textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 3500);
  }

  // ─── Initial state ────────────────────────────────────────────────
  updateUI();

  // ── AI Action Handler (from PageAiPanel) ──────────────────────────────
  document.addEventListener('ai-action', function(e) {
    var action = e.detail.action;
    var params = e.detail.params || {};

    if (action === 'select_by_status') {
      var filterEl = document.getElementById('filter-status');
      if (filterEl) { filterEl.value = params.status || ''; filterEl.dispatchEvent(new Event('change')); applyFilters(); }
      setTimeout(() => { selectAll.checked = true; selectAll.dispatchEvent(new Event('change')); }, 100);
    }
    else if (action === 'print_invoices') {
      if (selectedIds.size === 0) alert('No orders selected. Select orders first.');
      else {
        var btn = document.getElementById('print-invoices-btn');
        if (btn) {
          btn.classList.add('ring-2', 'ring-violet-500', 'ring-offset-2');
          const orig = btn.innerHTML;
          btn.innerHTML = '✨ Click to Print';
          setTimeout(() => { btn.classList.remove('ring-2', 'ring-violet-500', 'ring-offset-2'); btn.innerHTML = orig; }, 4000);
        }
      }
    }
    else if (action === 'export_csv') {
      if (selectedIds.size === 0) alert('No orders selected. Select orders first.');
      else {
        var btn = document.getElementById('export-csv-btn');
        if (btn) {
          btn.classList.add('ring-2', 'ring-violet-500', 'ring-offset-2');
          const orig = btn.innerHTML;
          btn.innerHTML = '✨ Click to Export';
          setTimeout(() => { btn.classList.remove('ring-2', 'ring-violet-500', 'ring-offset-2'); btn.innerHTML = orig; }, 4000);
        }
      }
    }
    else if (action === 'print_labels') {
      if (selectedIds.size === 0) alert('No orders selected. Select orders first.');
      else {
        var btn = document.getElementById('print-labels-btn');
        if (btn) {
          btn.classList.add('ring-2', 'ring-violet-500', 'ring-offset-2');
          const orig = btn.innerHTML;
          btn.innerHTML = '✨ Click to Print Labels';
          setTimeout(() => { btn.classList.remove('ring-2', 'ring-violet-500', 'ring-offset-2'); btn.innerHTML = orig; }, 4000);
        }
      }
    }
    else if (action === 'select_by_date') {
      var filterFrom = document.getElementById('filter-from');
      var filterTo = document.getElementById('filter-to');
      if (filterFrom && filterTo) {
        filterFrom.value = params.date || '';
        filterTo.value = params.date || '';
        filterFrom.dispatchEvent(new Event('change'));
        applyFilters();
      }
      setTimeout(() => { selectAll.checked = true; selectAll.dispatchEvent(new Event('change')); }, 100);
    }
    else if (action === 'clear_selection') {
      selectedIds.clear(); updateUI();
    }
    else if (action === 'navigate') {
      if (params.url) window.location.href = params.url;
    }
  });
</script>

</AdminLayout>
