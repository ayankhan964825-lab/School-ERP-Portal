            <span class="save-btn-text">Save Notifications</span>
            <svg class="save-btn-spinner hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
          </button>
        </div>
      </form>


      <!-- Ads & Tracking -->
      <form class="settings-section-form bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
          <h2 class="font-bold text-secondary">Ads & Tracking</h2>
          <p class="text-xs text-secondary/60">Google Tag Manager, Meta Pixel, and Google Ads IDs.</p>
        </div>
        <div class="p-6 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label for="gtm_id" class="block text-sm font-medium text-secondary mb-1">GTM Container ID</label>
              <input autocomplete="new-password" id="gtm_id" type="text" name="gtm_id" value={settings.gtm_id || ''} placeholder="GTM-XXXXXXX" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />
            </div>
            <div>
              <label for="meta_pixel_id" class="block text-sm font-medium text-secondary mb-1">Meta Pixel ID</label>
              <input autocomplete="new-password" id="meta_pixel_id" type="text" name="meta_pixel_id" value={settings.meta_pixel_id || ''} class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />
            </div>
            <div>
              <label for="google_ads_id" class="block text-sm font-medium text-secondary mb-1">Google Ads ID</label>
              <input autocomplete="new-password" id="google_ads_id" type="text" name="google_ads_id" value={settings.google_ads_id || ''} placeholder="AW-XXXXXXXXX" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />
            </div>
          </div>

          <hr class="border-gray-100" />
          
          <div class="bg-blue-50/50 p-4 rounded-xl border border-blue-100">
            <h3 class="text-sm font-bold text-secondary mb-3">Server-Side Tracking (Meta CAPI)</h3>
            <label for="meta_capi_token" class="block text-sm font-medium text-secondary mb-1">Meta Conversions API Token</label>
            <input autocomplete="new-password" id="meta_capi_token" type="password" name="meta_capi_token" value={settings.meta_capi_token ? '[HIDDEN]' : ''} placeholder="EAAG..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />
            <p class="text-xs text-secondary/60 mt-1">Required for accurate purchase tracking, especially with iOS 14+ users.</p>
          </div>
        </div>
        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">
          <button type="submit" class="btn-primary flex items-center gap-2 px-6 py-2 text-sm">
            <span class="save-btn-text">Save Tracking</span>
            <svg class="save-btn-spinner hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
          </button>
        </div>
      </form>

      <!-- Maps & Geocoding -->
      <form class="settings-section-form bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
          <h2 class="font-bold text-secondary flex items-center gap-2">
            🗺️ Maps & Geocoding
          </h2>
          <p class="text-xs text-secondary/60">Configure mapping APIs for precise delivery radiuses and address searches.</p>
        </div>
        <div class="p-6 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
              <label for="google_maps_api_key" class="block text-sm font-medium text-secondary mb-1">Google Maps API Key (Optional)</label>
              <input autocomplete="new-password" id="google_maps_api_key" type="password" name="google_maps_api_key" value={settings.google_maps_api_key ? '[HIDDEN]' : ''} placeholder="AIzaSy..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />
              <p class="text-xs text-secondary/60 mt-1">If provided, the admin panel and storefront will use Google Maps. If left blank, it defaults to the free OpenStreetMap/Photon fallback.</p>
            </div>
          </div>
        </div>
        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">
          <button type="submit" class="btn-primary flex items-center gap-2 px-6 py-2 text-sm">
            <span class="save-btn-text">Save Maps Config</span>
            <svg class="save-btn-spinner hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
          </button>
        </div>
      </form>



    </div>
    
    <!-- Toast notification -->
    <div id="settings-toast" class="fixed bottom-6 right-6 z-50 hidden transform transition-all duration-300 translate-y-4 opacity-0">
      <div id="settings-toast-inner" class="flex items-center gap-3 px-5 py-3 rounded-xl shadow-xl text-white text-sm font-medium">
        <span id="settings-toast-icon"></span>
        <span id="settings-toast-msg"></span>
      </div>
    </div>
  </div>

  <script is:inline data-astro-rerun>
    // ── Toast Helper ────────────────────────────────────────────────────
    function showSettingsToast(msg, type) {
      var toast = document.getElementById('settings-toast');
      var inner = document.getElementById('settings-toast-inner');
      var icon = document.getElementById('settings-toast-icon');
      var msgEl = document.getElementById('settings-toast-msg');
      if (!toast || !inner || !icon || !msgEl) return;

      msgEl.textContent = msg;
      icon.textContent = type === 'success' ? '✅' : '❌';
      inner.className = 'flex items-center gap-3 px-5 py-3 rounded-xl shadow-xl text-white text-sm font-medium ' +
        (type === 'success' ? 'bg-green-600' : 'bg-red-600');

      toast.classList.remove('hidden');
      setTimeout(function() {
        toast.classList.remove('translate-y-4', 'opacity-0');
      }, 10);

      setTimeout(function() {
        toast.classList.add('translate-y-4', 'opacity-0');
        setTimeout(function() { toast.classList.add('hidden'); }, 300);
      }, 4000);
    }

    // ── Main Save Handler (Handles multiple forms) ────────────
    var forms = document.querySelectorAll('.settings-section-form');
    forms.forEach(function(form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        await handleSaveSettings(form);
      });
    });

    async function handleSaveSettings(form) {
      if (!form) return;
      var saveBtn = form.querySelector('button[type="submit"]');
      var saveBtnText = form.querySelector('.save-btn-text');
      var saveBtnSpinner = form.querySelector('.save-btn-spinner');

      // Payment method validation (only if submitting the Store Settings form)
      var cod = form.querySelector('#cod-toggle');
      var rzp = form.querySelector('#razorpay-toggle');
      var pp = form.querySelector('#phonepe-toggle');
      if (cod && rzp && pp && !cod.checked && !rzp.checked && !pp.checked) {
        alert('At least one payment method (COD, Razorpay, or PhonePe) must be active.');
        return;
      }

      // Show loading state
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.classList.add('opacity-70', 'cursor-not-allowed');
      }
      var originalText = saveBtnText ? saveBtnText.textContent : 'Saving...';
      if (saveBtnText) saveBtnText.textContent = 'Saving...';
      if (saveBtnSpinner) saveBtnSpinner.classList.remove('hidden');

      // Collect all form data from this specific form
      var data = {};
      var inputs = form.querySelectorAll('input, textarea, select');
      for (var i = 0; i < inputs.length; i++) {
        var input = inputs[i];
        var name = input.name;
        if (!name) continue;

        if (input.type === 'checkbox') {
          data[name] = input.checked ? 'true' : 'false';
        } else if (input.type === 'radio') {
          if (input.checked) data[name] = input.value;
        } else {
          data[name] = input.value;
        }
      }

      try {
        var res = await fetch('/api/admin/update-settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          credentials: 'include'
        });

        var result = await res.json();

        if (res.ok && result.success) {
          showSettingsToast(originalText.replace('Save ', '') + ' saved successfully!', 'success');
        } else {
          showSettingsToast('Error: ' + (result.error || 'Failed to save'), 'error');
        }
      } catch (err) {
        showSettingsToast('Network error: ' + (err.message || 'Could not reach server'), 'error');
      } finally {
        // Reset button
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.classList.remove('opacity-70', 'cursor-not-allowed');
        }
        if (saveBtnText) saveBtnText.textContent = originalText;
        if (saveBtnSpinner) saveBtnSpinner.classList.add('hidden');
      }
    }

    // ── Auto-save Checkboxes ─────────────────────────────────────────
    var autoSaveCheckboxes = document.querySelectorAll('.settings-section-form input[type="checkbox"]');
    autoSaveCheckboxes.forEach(function(chk) {
      chk.addEventListener('change', function(e) {
        if (confirm('Are you sure you want to update this setting?')) {
          var form = this.closest('.settings-section-form');
          if (form && typeof handleSaveSettings === 'function') {
            handleSaveSettings(form);
          }
        } else {
          this.checked = !this.checked; // Revert
        }
      });
    });

    // ── AI Action Handler (from PageAiPanel) ──────────────────────────────
    document.addEventListener('ai-action', function(e) {
      var action = e.detail.action;
      var params = e.detail.params || {};

      if (action === 'scroll_to_section') {
        var section = params.section;
        var el;
        if (section === 'payment') el = document.getElementById('cod-toggle');
        else if (section === 'shipping') el = document.getElementById('free_shipping_threshold');
        else if (section === 'homepage') el = document.getElementById('trending-slider-toggle');
        else if (section === 'ai') el = document.getElementById('gemini_api_key');
        else if (section === 'notifications') el = document.getElementById('telegram_bot_token');
        else if (section === 'ads') el = document.getElementById('gtm_id');
        
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      else if (action === 'fill_settings') {
        if (params.admin_email !== undefined) document.getElementById('admin_email').value = params.admin_email;
        if (params.test_otp_mode_enabled !== undefined) document.getElementById('otp-toggle').checked = params.test_otp_mode_enabled === 'true' || params.test_otp_mode_enabled === true;
        

        var saveBtn2 = document.getElementById('save-settings-btn');
        if (saveBtn2) {
          var origText = document.getElementById('save-btn-text');
          if (origText) origText.textContent = '✨ Review & Save';
          saveBtn2.classList.add('ring-2', 'ring-violet-500', 'ring-offset-2');
          setTimeout(function() {
            if (origText) origText.textContent = 'Save Settings';
            saveBtn2.classList.remove('ring-2', 'ring-violet-500', 'ring-offset-2');
          }, 3000);
        }
      }
      else if (action === 'navigate') {
        if (params.url) window.location.href = params.url;
      }
    });

    // ── Test Gemini API Key ─────────────────────────────────────────────
    var testGeminiBtn = document.getElementById('test-gemini-btn');
    var geminiInput = document.getElementById('gemini_api_key');
    var geminiResult = document.getElementById('gemini-test-result');

    if (testGeminiBtn && geminiInput && geminiResult) {
      testGeminiBtn.addEventListener('click', async function() {
        var apiKey = geminiInput.value.trim();
        if (!apiKey) {
          geminiResult.textContent = 'Please enter an API key first.';
          geminiResult.className = 'text-sm mt-2 font-medium text-amber-600 block';
          return;
        }

        var originalHtml = testGeminiBtn.innerHTML;
        testGeminiBtn.innerHTML = '<span class="animate-spin inline-block mr-2">⟳</span> Testing...';
        testGeminiBtn.disabled = true;
        testGeminiBtn.classList.add('opacity-70', 'cursor-not-allowed');
        geminiResult.classList.add('hidden');

        try {
          var res = await fetch('/api/admin/test-gemini', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ apiKey: apiKey })
          });
          var data = await res.json();

          geminiResult.classList.remove('hidden');
          if (data.success) {
            geminiResult.textContent = '✅ ' + data.message;
            geminiResult.className = 'text-sm mt-2 font-medium text-green-600 block';
          } else {
            geminiResult.textContent = '❌ ' + (data.error || 'Invalid API Key');
            geminiResult.className = 'text-sm mt-2 font-medium text-red-600 block';
          }
        } catch (err) {
          geminiResult.classList.remove('hidden');
          geminiResult.textContent = '❌ Network error. Could not test API key.';
          geminiResult.className = 'text-sm mt-2 font-medium text-red-600 block';
        } finally {
          testGeminiBtn.innerHTML = originalHtml;
          testGeminiBtn.disabled = false;
          testGeminiBtn.classList.remove('opacity-70', 'cursor-not-allowed');
        }
      });
    }

    // ── Cleanup Storage API ─────────────────────────────────────────────
    var cleanupBtn = document.getElementById('btn-cleanup-uploads');
    var cleanupResult = document.getElementById('cleanup-result');
    if (cleanupBtn && cleanupResult) {
      cleanupBtn.addEventListener('click', async function() {
        var originalHtml = cleanupBtn.innerHTML;
        cleanupBtn.innerHTML = '<span class="animate-spin inline-block mr-2">⟳</span> Cleaning...';
        cleanupBtn.disabled = true;
        cleanupBtn.classList.add('opacity-70', 'cursor-not-allowed');
        cleanupResult.classList.add('hidden');

        try {
          var res = await fetch('/api/admin/cleanup-uploads', { method: 'POST' });
          var data = await res.json();
          cleanupResult.classList.remove('hidden');
          if (res.ok && data.success) {
            cleanupResult.textContent = '✅ ' + data.message;
            cleanupResult.className = 'text-xs mt-1 font-medium text-green-600 block';
          } else {
            cleanupResult.textContent = '❌ ' + (data.error || 'Failed to clean up');
            cleanupResult.className = 'text-xs mt-1 font-medium text-red-600 block';
          }
        } catch (err) {
          cleanupResult.classList.remove('hidden');
          cleanupResult.textContent = '❌ Network error.';
          cleanupResult.className = 'text-xs mt-1 font-medium text-red-600 block';
        } finally {
          cleanupBtn.innerHTML = originalHtml;
          cleanupBtn.disabled = false;
          cleanupBtn.classList.remove('opacity-70', 'cursor-not-allowed');
        }
      });
    }

  </script>

  <script is:inline data-astro-rerun>
    // ── Auth Mode Card Selection ────────────────────────────────────────
    (function() {
      var cards = document.querySelectorAll('.auth-mode-card');
      var hiddenInput = document.getElementById('auth-mode-input');

      cards.forEach(function(card) {
        var radio = card.querySelector('input[type="radio"]');
        if (!radio || radio.disabled) return;

        card.addEventListener('click', function() {
          var value = radio.value;
          if (!hiddenInput) return;
          if (hiddenInput.value === value) return; // already selected
          
          if (!confirm('Are you sure you want to change the Authentication Mode?')) {
            return;
          }

          hiddenInput.value = value;

          // Update visual state of all cards
          cards.forEach(function(c) {
            var r = c.querySelector('input[type="radio"]');
            if (!r || r.disabled) return;
            var isSelected = r.value === value;
            r.checked = isSelected;
            c.classList.toggle('border-primary', isSelected);
            c.classList.toggle('bg-primary/5', isSelected);
            c.classList.toggle('border-gray-200', !isSelected);
            c.classList.toggle('bg-white', !isSelected);
          });
          
          // Auto-save the form
          var form = card.closest('.settings-section-form');
          if (form && typeof handleSaveSettings === 'function') {
            handleSaveSettings(form);
          }
        });
      });
    })();
  </script>
  <script is:inline data-astro-rerun>
    // ── OTP Length Card Selection ────────────────────────────────────────
    (function() {
      var otpCards = document.querySelectorAll('label:has(input[name="otp_length"])');
      otpCards.forEach(function(card) {
        var radio = card.querySelector('input[type="radio"]');
        if (!radio) return;
        
        card.addEventListener('click', function(e) {
          if (e.target.tagName !== 'INPUT') {
            radio.checked = true;
          }
          
          if (!confirm('Are you sure you want to change the OTP Length?')) {
            e.preventDefault();
            return;
          }

          var value = radio.value;
          
          otpCards.forEach(function(c) {
            var r = c.querySelector('input[type="radio"]');
            var isSelected = r.value === value;
            r.checked = isSelected;
            c.classList.toggle('border-primary', isSelected);
            c.classList.toggle('bg-primary/5', isSelected);
            c.classList.toggle('border-gray-200', !isSelected);
            c.classList.toggle('bg-gray-50', !isSelected);
            
            var dot = c.querySelector('.w-5.h-5');
            if (dot) {
              dot.classList.toggle('border-primary', isSelected);
              dot.classList.toggle('bg-primary', isSelected);
              dot.classList.toggle('border-gray-300', !isSelected);
              if (isSelected && !dot.querySelector('.w-2')) {
                dot.innerHTML = '<div class="w-2 h-2 bg-white rounded-full"></div>';
              } else if (!isSelected) {
                dot.innerHTML = '';
              }
            }
          });
          
          var form = card.closest('.settings-section-form');
          if (form && typeof handleSaveSettings === 'function') {
            handleSaveSettings(form);
          }
        });
      });
    })();
  </script>

  <script is:inline data-astro-rerun>


  </script>
