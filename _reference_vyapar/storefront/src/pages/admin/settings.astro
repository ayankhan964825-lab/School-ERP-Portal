      <script is:inline data-astro-rerun>
        function toggleCourierInputs() {
          const defaultPartner = document.getElementById('default_courier_partner').value;
          const hyperPartner = document.getElementById('hyperlocal_courier_partner').value;
          
          document.getElementById('icarry-settings-group').style.display = (defaultPartner === 'icarry') ? 'block' : 'none';
          document.getElementById('shiprocket-settings-group').style.display = (defaultPartner === 'shiprocket') ? 'block' : 'none';
          document.getElementById('porter-settings-group').style.display = (hyperPartner === 'porter') ? 'block' : 'none';
        }
        
        // Run once on mount
        document.addEventListener('DOMContentLoaded', toggleCourierInputs);
