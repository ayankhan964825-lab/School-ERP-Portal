---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
const ctx = getPermissionContext(Astro.cookies);

if (Astro.request.method === "POST" && !canManageSection(ctx, "settings")) {
  return new Response("Forbidden", { status: 403 });
}
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageAiPanel from '../../components/admin/PageAiPanel.astro';
import { getSettings } from '../../lib/database';

const storeId = Astro.locals?.storeId;
const isMasterAdmin = storeId === 'SUPER_ADMIN_BYPASS';
const targetStoreId = isMasterAdmin ? Astro.url.searchParams.get('id') : storeId;

const settings = await getSettings(targetStoreId);

const success = Astro.url.searchParams.get('success') === 'true';
const error = Astro.url.searchParams.get('error') === 'true';

const settingsForAI = JSON.stringify({
  ...settings,
  razorpay_key_secret: settings.razorpay_key_secret ? '[HIDDEN]' : '',
  phonepe_salt_key: settings.phonepe_salt_key ? '[HIDDEN]' : '',
  gemini_api_key: settings.gemini_api_key ? '[HIDDEN]' : '',
  telegram_bot_token: settings.telegram_bot_token ? '[HIDDEN]' : '',
  resend_api_key: settings.resend_api_key ? '[HIDDEN]' : '',
  twilio_auth_token: settings.twilio_auth_token ? '[HIDDEN]' : '',
  google_maps_api_key: settings.google_maps_api_key ? '[HIDDEN]' : ''
});
---

<AdminLayout title="API Settings | Admin Panel" description="Manage API keys and integrations.">
  <div class="max-w-4xl">
    <div class="mb-4">
      <h1 class="text-2xl font-serif font-bold text-secondary">API & Integrations</h1>
      <p class="text-sm text-secondary/60 mt-1">Manage credentials for payment gateways, AI, and notifications.</p>
    </div>

    <!-- AI Assistant Panel -->
    <PageAiPanel
    page="settings"
    title="Settings Assistant"
      pageDataJson={settingsForAI}
      guideTitleEn="Settings Guide"
      guideTitleHi="Settings Guide"
      guideHtml={`<ul class="space-y-2">
        <li><strong>Payment:</strong> Enable or disable COD, Razorpay, or PhonePe and configure gateway API keys.</li>
        <li><strong>Auth:</strong> Choose customer login mode (Phone OTP, Email OTP, or both).</li>
        <li><strong>Integrations:</strong> Set up API keys for SMS, Email, Telegram, AI, and logistics partners.</li>
        <li><strong>Note:</strong> Shipping rules & discount rules are in the Shipping and Store Details pages.</li>
      </ul>`}
      guideHtmlHi={`<ul class="space-y-2">
        <li><strong>Payment:</strong> COD, Razorpay aur PhonePe ko yahan se chalu/band karein.</li>
        <li><strong>Auth:</strong> Customer login mode yahan se set karein (Phone/Email OTP).</li>
        <li><strong>Integrations:</strong> SMS, Email, Telegram aur AI ke API keys configure karein.</li>
      </ul>`}
      quickActions={[
        { label: '💳 Payment', query: 'payment settings pe le chalo' },
        { label: '🔐 Auth Mode', query: 'customer login mode kaise change karein' },
        { label: '🚚 Courier', query: 'logistics aur courier settings pe scroll karo' },
        { label: '🤖 AI', query: 'gemini api kaha hai' }
      ]}
    />

    {success && (
      <div class="mb-6 bg-green-50 text-green-800 p-4 rounded-lg border border-green-200 text-sm font-medium">
        Settings saved successfully.
      </div>
    )}
    
    {error && (
      <div class="mb-6 bg-red-50 text-red-800 p-4 rounded-lg border border-red-200 text-sm font-medium">
        Failed to save settings. Please try again.
      </div>
    )}

    <div class="space-y-6">
      
            <!-- Seller & Invoicing Details -->
      <form class="settings-section-form bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
          <h2 class="font-bold text-secondary flex items-center gap-2">
            📄 Store & Seller Details
          </h2>
          <p class="text-xs text-secondary/60">Manage details printed on customer invoices and shipping labels.</p>
        </div>
        <div class="p-6 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="store_name" class="block text-sm font-medium text-secondary mb-1">Store Name</label>
              <input autocomplete="new-password" id="store_name" type="text" name="store_name" value={settings.store_name || 'Admin Panel'} placeholder="Admin Panel" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />
            </div>
            <div>
              <label for="gst_number" class="block text-sm font-medium text-secondary mb-1">GST Number</label>
              <input autocomplete="new-password" id="gst_number" type="text" name="gst_number" value={settings.gst_number || '22AAAAA0000A1Z5'} placeholder="GSTIN..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />
            </div>
            <div>
              <label for="fssai_number" class="block text-sm font-medium text-secondary mb-1">FSSAI Number</label>
              <input autocomplete="new-password" id="fssai_number" type="text" name="fssai_number" value={settings.fssai_number || '10000000000000'} placeholder="FSSAI..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />
            </div>
            <div class="md:col-span-2">
              <label for="store_address" class="block text-sm font-medium text-secondary mb-1">Store Address (For Invoices)</label>
              <textarea id="store_address" name="store_address" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm">{settings.store_address || '123 Demo Street, City, State, 123456'}</textarea>
            </div>
          </div>
        </div>
        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">
          <button type="submit" class="btn-primary flex items-center gap-2 px-6 py-2 text-sm">
            <span class="save-btn-text">Save Seller Details</span>
            <svg class="save-btn-spinner hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
          </button>
        </div>
      </form>

      <!-- Store Settings -->
      <form class="settings-section-form bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
          <h2 class="font-bold text-secondary flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            Store Settings
          </h2>
          <p class="text-xs text-secondary/60">Control core store behaviour — payment methods, customer auth, OTP settings, and security limits.</p>
        </div>
        <div class="p-6 space-y-6">
          <!-- Payment Method Toggles -->
          <div>
            <p class="text-sm font-semibold text-secondary mb-3">Active Payment Methods</p>
            <div class="space-y-3">
              <!-- COD Toggle -->
              <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-100">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-amber-100 rounded-xl flex items-center justify-center text-amber-600 text-lg font-bold">₹</div>
                  <div>
                    <p class="text-sm font-semibold text-secondary">Cash on Delivery (COD)</p>
                    <p class="text-xs text-secondary/60">Customer pays at doorstep. Available for all pin codes.</p>
                  </div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" name="cod_enabled" id="cod-toggle" checked={settings.cod_enabled !== false && settings.cod_enabled !== 'false'} class="sr-only peer" />
                  <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary relative"></div>
                </label>
              </div>
              <!-- Razorpay Toggle -->
              <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-100">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center">
                    <svg class="h-5 w-5 text-blue-600" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1.41 16.09V20h-2.67v-1.93c-1.71-.36-3.16-1.46-3.27-3.4h1.96c.1 1.05.82 1.87 2.65 1.87 1.96 0 2.4-.98 2.4-1.59 0-.83-.44-1.61-2.67-2.14-2.48-.6-4.18-1.62-4.18-3.67 0-1.72 1.39-2.84 3.11-3.21V4h2.67v1.95c1.86.45 2.79 1.86 2.85 3.39H14.3c-.05-1.11-.64-1.87-2.22-1.87-1.5 0-2.4.68-2.4 1.64 0 .84.65 1.39 2.67 1.91s4.18 1.39 4.18 3.91c-.01 1.83-1.38 2.83-3.12 3.16z"/></svg>
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-secondary">Razorpay — Online Payments</p>
                    <p class="text-xs text-secondary/60">Cards, UPI, Net Banking, Wallets, EMI</p>
                  </div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" name="razorpay_enabled" id="razorpay-toggle" checked={settings.razorpay_enabled !== false && settings.razorpay_enabled !== 'false'} class="sr-only peer" />
                  <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary relative"></div>
                </label>
              </div>
              <!-- PhonePe Toggle -->
              <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-100">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-purple-100 rounded-xl flex items-center justify-center">
                    <svg class="h-5 w-5 text-purple-600" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-secondary">PhonePe — UPI Payments</p>
                    <p class="text-xs text-secondary/60">PhonePe, GPay, Paytm UPI, other UPI apps</p>
                  </div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" name="phonepe_enabled" id="phonepe-toggle" checked={settings.phonepe_enabled !== false && settings.phonepe_enabled !== 'false'} class="sr-only peer" />
                  <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary relative"></div>
                </label>
              </div>
            </div>

            <!-- POS UPI ID -->
            <div class="mt-4">
              <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">Merchant UPI ID (For POS QR)</label>
              <input autocomplete="new-password" type="text" name="pos_upi_id" value={settings.pos_upi_id || ''} class="w-full px-4 py-2 border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none" placeholder="e.g. merchant@upi" />
              <p class="text-xs text-secondary/60 mt-1.5">This UPI ID will be used to generate payment QR codes for offline POS billing.</p>
            </div>
            </div>

          <hr class="border-gray-100" />

          <!-- Customer Login Mode -->
          <div>
            <p class="text-sm font-semibold text-secondary mb-1">Customer Login Mode</p>
            <p class="text-xs text-secondary/50 mb-3">Choose how customers verify their identity. Options require corresponding API keys to be configured.</p>
            <input type="hidden" name="auth_mode" id="auth-mode-input" value={settings.auth_mode || 'phone_only'} />
            <div class="grid grid-cols-1 gap-3" id="auth-mode-cards">

              <!-- Phone Only -->
              <label id="auth-card-phone" data-mode="phone_only"
                class={`auth-mode-card flex items-center gap-4 p-4 rounded-xl border-2 transition-all duration-200 select-none
                  ${!(settings.twilio_account_sid && settings.twilio_auth_token)
                    ? 'opacity-40 cursor-not-allowed border-gray-100 bg-gray-50'
                    : (settings.auth_mode || 'phone_only') === 'phone_only'
                      ? 'border-primary bg-primary/5 cursor-pointer'
                      : 'border-gray-200 bg-white hover:border-primary/40 cursor-pointer'}`}
              >
                <input type="radio" name="auth_mode_radio" value="phone_only" class="sr-only"
                  checked={(settings.auth_mode || 'phone_only') === 'phone_only'}
                  disabled={!(settings.twilio_account_sid && settings.twilio_auth_token)} />
                <div class={`w-10 h-10 rounded-xl flex items-center justify-center text-xl flex-shrink-0 ${(settings.auth_mode || 'phone_only') === 'phone_only' ? 'bg-primary/10' : 'bg-gray-100'}`}>📱</div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-secondary">Phone Only</p>
                  <p class="text-xs text-secondary/60">SMS OTP via Twilio. Current default behaviour.</p>
                  {!(settings.twilio_account_sid && settings.twilio_auth_token) && (
                    <p class="text-xs text-amber-600 mt-0.5">⚠ Configure Twilio</p>
                  )}
                </div>
                <div class={`w-5 h-5 rounded-full border-2 flex items-center justify-center flex-shrink-0 transition-all ${(settings.auth_mode || 'phone_only') === 'phone_only' ? 'border-primary bg-primary' : 'border-gray-300'}`}>
                  {(settings.auth_mode || 'phone_only') === 'phone_only' && <div class="w-2 h-2 bg-white rounded-full"></div>}
                </div>
              </label>

              <!-- Email Only -->
              <label id="auth-card-email" data-mode="email_only"
                class={`auth-mode-card flex items-center gap-4 p-4 rounded-xl border-2 transition-all duration-200 select-none
                  ${!settings.resend_api_key
                    ? 'opacity-40 cursor-not-allowed border-gray-100 bg-gray-50'
                    : settings.auth_mode === 'email_only'
                      ? 'border-primary bg-primary/5 cursor-pointer'
                      : 'border-gray-200 bg-white hover:border-primary/40 cursor-pointer'}`}
              >
                <input type="radio" name="auth_mode_radio" value="email_only" class="sr-only"
                  checked={settings.auth_mode === 'email_only'}
                  disabled={!settings.resend_api_key} />
                <div class={`w-10 h-10 rounded-xl flex items-center justify-center text-xl flex-shrink-0 ${settings.auth_mode === 'email_only' ? 'bg-primary/10' : 'bg-gray-100'}`}>📧</div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-secondary">Email Only</p>
                  <p class="text-xs text-secondary/60">Email OTP via Resend. Users login with email address.</p>
                  {!settings.resend_api_key && <p class="text-xs text-amber-600 mt-0.5">⚠ Configure Resend API key first</p>}
                </div>
                <div class={`w-5 h-5 rounded-full border-2 flex items-center justify-center flex-shrink-0 transition-all ${settings.auth_mode === 'email_only' ? 'border-primary bg-primary' : 'border-gray-300'}`}>
                  {settings.auth_mode === 'email_only' && <div class="w-2 h-2 bg-white rounded-full"></div>}
                </div>
              </label>

              <!-- Both -->
              <label id="auth-card-both" data-mode="both"
                class={`auth-mode-card flex items-center gap-4 p-4 rounded-xl border-2 transition-all duration-200 select-none
                  ${!((settings.twilio_account_sid && settings.twilio_auth_token)) || !(settings.resend_api_key)
                    ? 'opacity-40 cursor-not-allowed border-gray-100 bg-gray-50'
                    : settings.auth_mode === 'both'
                      ? 'border-primary bg-primary/5 cursor-pointer'
                      : 'border-gray-200 bg-white hover:border-primary/40 cursor-pointer'}`}
              >
                <input type="radio" name="auth_mode_radio" value="both" class="sr-only"
                  checked={settings.auth_mode === 'both'}
                  disabled={!((settings.twilio_account_sid && settings.twilio_auth_token)) || !(settings.resend_api_key)} />
                <div class={`w-10 h-10 rounded-xl flex items-center justify-center text-xl flex-shrink-0 ${settings.auth_mode === 'both' ? 'bg-primary/10' : 'bg-gray-100'}`}>🔄</div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-secondary">Phone + Email</p>
                  <p class="text-xs text-secondary/60">New users → Phone OTP only. Returning users with verified email → Email OTP. Users can verify email from their profile.</p>
                  {!settings.resend_api_key && <p class="text-xs text-amber-600 mt-0.5">⚠ Requires Twilio + Resend both configured</p>}
                </div>
                <div class={`w-5 h-5 rounded-full border-2 flex items-center justify-center flex-shrink-0 transition-all ${settings.auth_mode === 'both' ? 'border-primary bg-primary' : 'border-gray-300'}`}>
                  {settings.auth_mode === 'both' && <div class="w-2 h-2 bg-white rounded-full"></div>}
                </div>
              </label>

            </div>
          </div>

          <hr class="border-gray-100" />

          <!-- Storage Management -->
          <div>
            <div class="flex items-center gap-2 mb-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path><path d="M12 12v9"></path><path d="m8 17 4 4 4-4"></path></svg>
              <h2 class="text-lg font-bold text-secondary">Storage Management</h2>
            </div>
            <p class="text-sm text-secondary/60 mb-4">Clean up abandoned files that customers uploaded but never completed the order for.</p>
            
            <div class="p-4 bg-gray-50 border border-gray-100 rounded-xl flex items-center justify-between">
              <div>
                <p class="text-sm font-semibold text-secondary">Clean Up Abandoned Uploads</p>
                <p class="text-xs text-secondary/60 mt-0.5">Scans your Supabase 'products/customer-uploads' bucket and deletes files older than 24 hours that are not linked to any order.</p>
                <p id="cleanup-result" class="text-xs font-medium mt-1 hidden"></p>
              </div>
              <button type="button" id="btn-cleanup-uploads" class="ml-4 whitespace-nowrap px-4 py-2 bg-white border border-gray-200 text-sm font-medium text-secondary hover:bg-gray-50 rounded-lg transition-colors">
                Clean Up Now
              </button>
            </div>
          </div>

          <hr class="border-gray-100" />

          <!-- OTP Length -->
          <div class="mt-8">
            <p class="text-sm font-semibold text-secondary mb-3">OTP Length</p>
            <div class="flex gap-4">
              <label class={`flex-1 relative border rounded-2xl p-4 cursor-pointer transition-all ${settings.otp_length === '6' ? 'border-gray-200 bg-gray-50' : 'border-primary bg-primary/5 ring-1 ring-primary/20'}`}>
                <input type="radio" name="otp_length" value="4" class="sr-only" checked={settings.otp_length !== '6'} />
                <div class="flex items-center gap-3">
                  <div class={`w-5 h-5 rounded-full border-2 flex items-center justify-center flex-shrink-0 transition-all ${settings.otp_length !== '6' ? 'border-primary bg-primary' : 'border-gray-300'}`}>
                    {settings.otp_length !== '6' && <div class="w-2 h-2 bg-white rounded-full"></div>}
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-secondary">4 Digits</p>
                    <p class="text-xs text-secondary/60">Standard length (e.g. 1234)</p>
                  </div>
                </div>
              </label>
              
              <label class={`flex-1 relative border rounded-2xl p-4 cursor-pointer transition-all ${settings.otp_length === '6' ? 'border-primary bg-primary/5 ring-1 ring-primary/20' : 'border-gray-200 bg-gray-50'}`}>
                <input type="radio" name="otp_length" value="6" class="sr-only" checked={settings.otp_length === '6' ? true : undefined} />
                <div class="flex items-center gap-3">
                  <div class={`w-5 h-5 rounded-full border-2 flex items-center justify-center flex-shrink-0 transition-all ${settings.otp_length === '6' ? 'border-primary bg-primary' : 'border-gray-300'}`}>
                    {settings.otp_length === '6' && <div class="w-2 h-2 bg-white rounded-full"></div>}
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-secondary">6 Digits</p>
                    <p class="text-xs text-secondary/60">Higher security (e.g. 123456)</p>
                  </div>
                </div>
              </label>
            </div>
          </div>

          <hr class="border-gray-100" />

          <!-- Security & Rate Limits -->
          <div>
            <p class="text-sm font-semibold text-secondary mb-3">Security & Rate Limits</p>
            <p class="text-xs text-secondary/60 mb-4">Set limits for OTP requests and failed attempts. Leave blank or 0 to disable (no limits).</p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Phone Limits -->
              <div class="p-4 bg-gray-50 rounded-xl border border-gray-100">
                <h3 class="font-semibold text-sm text-secondary mb-3 flex items-center gap-2">📱 Phone OTP Limits</h3>
                <div class="space-y-3">
                  <div>
                    <label for="rate_limit_phone_otp_requests" class="block text-xs font-medium text-secondary/80 mb-1">Max Requests</label>
                    <input id="rate_limit_phone_otp_requests" type="number" name="rate_limit_phone_otp_requests" value={settings.rate_limit_phone_otp_requests || ''} placeholder="e.g. 3" class="w-full px-3 py-1.5 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />
                  </div>
                  <div>
                    <label for="rate_limit_phone_otp_window_minutes" class="block text-xs font-medium text-secondary/80 mb-1">Time Window (Minutes)</label>
                    <input id="rate_limit_phone_otp_window_minutes" type="number" name="rate_limit_phone_otp_window_minutes" value={settings.rate_limit_phone_otp_window_minutes || ''} placeholder="e.g. 60" class="w-full px-3 py-1.5 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" />
                  </div>
                  <div>
