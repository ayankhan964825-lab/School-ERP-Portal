---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
const ctx = getPermissionContext(Astro.cookies);

if (Astro.request.method === "POST" && !canManageSection(ctx, "reviews") && !canManageSection(ctx, "reviews")) {
  return new Response("Forbidden", { status: 403 });
}
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageAiPanel from '../../components/admin/PageAiPanel.astro';
import { getAdminReviews, getProducts } from '../../lib/database';

const [reviews, catalog] = await Promise.all([getAdminReviews(), getProducts()]);

const pending = reviews.filter((r: any) => r.status === 'pending').length;
const approved = reviews.filter((r: any) => r.status === 'approved').length;
const rejected = reviews.filter((r: any) => r.status === 'rejected').length;
const avgRating = (reviews.filter((r: any) => r.status === 'approved').reduce((s: number, r: any) => s + (r.rating || 0), 0) / (approved || 1)).toFixed(1);

const reviewsForAI = JSON.stringify(reviews.slice(0, 50).map((r: any) => {
  const prod = catalog.find((p: any) => p.slug === r.product_slug);
  return {
    id: r.id,
    product: prod ? prod.name : (r.product || r.product_slug),
    customer: r.customer_name || r.customer,
    rating: r.rating,
    status: r.status,
    title: r.title,
    body: r.comment || r.body
  };
}));
---

<AdminLayout title="Reviews & Ratings | Admin Panel">
  <div class="flex justify-between items-center mb-4">
    <div>
      <h1 class="text-2xl font-serif font-bold text-secondary">Reviews & Ratings</h1>
      <p class="text-sm text-secondary/60 mt-1">Approve, reject or feature customer reviews before they appear on the storefront.</p>
    </div>
    <div class="flex gap-3">
      <a href="/admin/bulk-upload/reviews" class="btn-primary !py-2.5 flex items-center gap-2 shrink-0 whitespace-nowrap">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Bulk Upload
      </a>
    </div>
  </div>

  <!-- AI Assistant Panel -->
  <PageAiPanel
    page="reviews"
    title="Reviews Assistant"
    pageDataJson={reviewsForAI}
    guideTitleEn="Reviews Guide"
    guideTitleHi="Reviews Guide"
    guideHtml={`<ul class="space-y-2">
      <li><strong>Filter:</strong> Filter reviews by status (Pending, Approved, Rejected).</li>
      <li><strong>Action:</strong> Approve or Reject reviews to control what's shown to customers.</li>
      <li><strong>Feature:</strong> Highlight the best reviews as "Featured".</li>
    </ul>`}
    guideHtmlHi={`<ul class="space-y-2">
      <li><strong>Filter:</strong> Reviews ko status ke hisaab se filter karein (Pending, Approved, Rejected).</li>
      <li><strong>Action:</strong> Naye reviews ko padh kar unhe approve ya reject karein.</li>
      <li><strong>Feature:</strong> Sabse acche reviews ko "Featured" mark karein.</li>
    </ul>`}
    quickActions={[
      { label: '⏳ Pending', query: 'pending reviews dikhao' },
      { label: '⭐ Approved', query: 'approved reviews dikhao' },
      { label: '🗑️ Rejected', query: 'rejected reviews dikhao' },
      { label: '✅ Approve all', query: 'sab pending reviews ko approve karo' }
    ]}
  />

  <!-- Stats Row -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    {[
      { label: 'Pending Review', value: pending, color: 'text-yellow-600', bg: 'bg-yellow-50', border: 'border-yellow-100' },
      { label: 'Approved', value: approved, color: 'text-green-600', bg: 'bg-green-50', border: 'border-green-100' },
      { label: 'Rejected', value: rejected, color: 'text-red-500', bg: 'bg-red-50', border: 'border-red-100' },
      { label: 'Avg Rating', value: avgRating + ' ★', color: 'text-amber-500', bg: 'bg-amber-50', border: 'border-amber-100' },
    ].map(s => (
      <div class={`${s.bg} border ${s.border} rounded-2xl p-5`}>
        <div class={`text-2xl font-bold ${s.color}`}>{s.value}</div>
        <div class="text-sm text-secondary/60 mt-1">{s.label}</div>
      </div>
    ))}
  </div>

  <!-- Filter Tabs -->
  <div class="flex gap-2 mb-6">
    {['all','pending','approved','rejected'].map(status => (
      <button class="review-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold border border-gray-200 text-secondary/60 bg-white hover:border-primary hover:text-primary transition-colors capitalize" data-status={status}>
        {status === 'all' ? 'All Reviews' : status}
      </button>
    ))}
  </div>

  <!-- Reviews List -->
  {reviews.length === 0 ? (
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-16 text-center">
      <div class="text-5xl mb-4 text-secondary/20">⭐</div>
      <p class="text-secondary/60 text-lg font-medium">No reviews yet</p>
      <p class="text-secondary/40 text-sm mt-1">Customer reviews will appear here once submitted.</p>
    </div>
  ) : (
    <div class="space-y-4">
      {reviews.map((review: any) => {
        const statusStyleMap: any = {
          pending:  'bg-yellow-100 text-yellow-800',
          approved: 'bg-green-100 text-green-800',
          rejected: 'bg-red-100 text-red-800',
        };
        const stars = '★'.repeat(review.rating || 0) + '☆'.repeat(5 - (review.rating || 0));
        return (
          <div class="review-card bg-white rounded-2xl shadow-sm border border-gray-100 p-5" data-status={review.status} data-id={review.id}>
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="flex-1">
                <!-- Product + Customer -->
                <div class="flex items-center gap-2 flex-wrap mb-2">
                  <span class="text-xs font-bold bg-primary/10 text-primary px-2.5 py-0.5 rounded-full">{catalog.find((p: any) => p.slug === review.product_slug)?.name || review.product || review.product_slug}</span>
                  {review.variant && <span class="text-xs text-secondary/50">{review.variant}</span>}
                  <span class={`review-status-badge text-xs font-bold px-2.5 py-0.5 rounded-full capitalize ${statusStyleMap[review.status] || 'bg-gray-100 text-gray-600'}`}>{review.status}</span>
                </div>
                <!-- Rating + Title -->
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-amber-400 text-sm tracking-tight">{stars}</span>
                  <span class="text-xs text-secondary/40">({review.rating}/5)</span>
                </div>
                {review.title && <p class="font-bold text-secondary text-sm mb-1">{review.title}</p>}
                <p class="text-sm text-secondary/70 leading-relaxed">{review.comment || review.body}</p>
                <!-- Customer -->
                <div class="mt-3 flex items-center gap-2 text-xs text-secondary/50">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                  <span class="font-medium text-secondary/70">{review.customer_name || review.customer}</span>
                  <span>·</span>
                  <span>{review.phone}</span>
                  <span>·</span>
                  <span>{review.created_at ? new Date(review.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'}</span>
                </div>
              </div>
              <!-- Action Buttons -->
              <div class="flex flex-col gap-2 shrink-0">
                {review.status !== 'approved' && (
                  <button
                    class="review-action-btn flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-green-100 text-green-700 rounded-xl hover:bg-green-600 hover:text-white transition-colors"
                    data-id={review.id} data-action="approve"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    Approve
                  </button>
                )}
                {review.status !== 'rejected' && (
                  <button
                    class="review-action-btn flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-red-50 text-red-600 rounded-xl hover:bg-red-600 hover:text-white transition-colors"
                    data-id={review.id} data-action="reject"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                    Reject
                  </button>
                )}
                <button
                  class="review-action-btn flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-amber-50 text-amber-600 rounded-xl hover:bg-amber-500 hover:text-white transition-colors"
                  data-id={review.id} data-action="feature"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
                  Feature
                </button>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )}
</AdminLayout>

<script data-astro-rerun>
  // Filter
  document.querySelectorAll('.review-filter-btn').forEach(btn => {
    btn.addEventListener('click', function(this) {
      document.querySelectorAll('.review-filter-btn').forEach(b => {
        (b).className = 'review-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold border border-gray-200 text-secondary/60 bg-white hover:border-primary hover:text-primary transition-colors capitalize';
      });
      this.className = 'review-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold border border-primary bg-primary text-white transition-colors capitalize';
      const status = this.dataset.status;
      document.querySelectorAll('.review-card').forEach(card => {
        (card).style.display = (status === 'all' || (card).dataset.status === status) ? '' : 'none';
      });
    });
  });
  (document.querySelector('.review-filter-btn[data-status="all"]'))?.click();

  // Actions — real API calls
  document.querySelectorAll('.review-action-btn').forEach(btn => {
    btn.addEventListener('click', async function(this) {
      const action = this.dataset.action;
      const id = this.dataset.id;
      if (!action || !id) return;

      // Instant visual feedback
      const card = this.closest('.review-card');
      const actionLabels = { approve: '✅ Approved', reject: '❌ Rejected', feature: '⭐ Featured' };
      const actionColors = { approve: 'border-green-300 bg-green-50', reject: 'border-red-200 bg-red-50', feature: 'border-amber-200 bg-amber-50' };
      const statusMap = { approve: 'approved', reject: 'rejected', feature: 'approved' };

      if (card) {
        card.dataset.status = statusMap[action] || action;
        card.className = `review-card bg-white rounded-2xl shadow-sm border p-5 ${actionColors[action] || 'border-gray-100'}`;
        const badge = card.querySelector('.review-status-badge');
        const statusStyle = { approve: 'bg-green-100 text-green-800', reject: 'bg-red-100 text-red-800', feature: 'bg-amber-100 text-amber-800' };
        if (badge) { badge.textContent = actionLabels[action] || action; badge.className = `review-status-badge text-xs font-bold px-2.5 py-0.5 rounded-full capitalize ${statusStyle[action]}`; }
      }

      // API call
      try {
        await fetch('/api/admin/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action, id }),
        });
      } catch (err) {
        console.error('Failed to update review:', err);
      }
    });
  });

  // ── AI Action Handler (from PageAiPanel) ──────────────────────────────
  document.addEventListener('ai-action', function(e) {
    var action = e.detail.action;
    var params = e.detail.params || {};

    if (action === 'filter_reviews') {
      var status = params.status || 'all';
      var btn = document.querySelector('.review-filter-btn[data-status="' + status + '"]');
      if (btn) btn.click();
    }
    else if (action === 'approve_all_pending') {
      var btns = Array.from(document.querySelectorAll('.review-action-btn[data-action="approve"]')).filter(function(btn) {
        return btn.closest('.review-card').style.display !== 'none';
      });
      btns.forEach(function(btn) { 
        btn.classList.add('ring-2', 'ring-violet-500', 'ring-offset-2');
        btn.innerHTML = '✨ Click to Approve';
        setTimeout(() => {
          btn.classList.remove('ring-2', 'ring-violet-500', 'ring-offset-2');
          btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg> Approve';
        }, 4000);
      });
    }
    else if (action === 'navigate') {
      if (params.url) window.location.href = params.url;
    }
  });
</script>
</AdminLayout>
