  <script is:inline>
    // ── Image Upload Handling ─────────────────────────────────────────
    async function handleImageUpload(inputEl, targetInputId) {
      let btn = null;
      let originalText = 'Upload';
      
      try {
        if (!inputEl.files || inputEl.files.length === 0) return;
        const file = inputEl.files[0];
        const formData = new FormData();
        formData.append('file', file);
        
        btn = inputEl.previousElementSibling;
        if (btn && btn.tagName === 'BUTTON') {
          originalText = btn.innerText || 'Upload';
          btn.innerText = '...';
          btn.disabled = true;
        }

        const res = await fetch('/api/admin/upload?_tenant_id=' + encodeURIComponent(window.__targetStoreId), {
          method: 'POST',
          body: formData,
          credentials: 'include'
        });
        let data;
        try {
          data = await res.json();
        } catch (e) {
          console.error('Failed to parse JSON:', e);
          data = { success: false, error: 'Invalid server response' };
        }
        
        if (data.success) {
          const targetInput = document.getElementById(targetInputId);
          if (targetInput) {
            targetInput.value = data.url;
            targetInput.dispatchEvent(new Event('input'));
            
            // Explicitly sync team members if it's a team image
            const match = targetInputId.match(/team_img_(\d+)/);
            if (match && typeof updateTeamMember === 'function') {
              updateTeamMember(parseInt(match[1]), 'image_url', data.url);
            }
          }
          const previewImg = document.getElementById('preview-admin-logo');
          if (previewImg) {
            previewImg.src = data.url;
          }
          showSettingsToast('Image uploaded successfully', 'success');
        } else {
          showSettingsToast('Upload failed: ' + (data.error || 'Unknown error'), 'error');
        }
      } catch (err) {
        console.error('Upload crash:', err);
        showSettingsToast('Upload error: ' + err.message, 'error');
      } finally {
        if (btn && btn.tagName === 'BUTTON') {
          btn.innerText = originalText;
          btn.disabled = false;
        }
        inputEl.value = ''; // Reset input so same file can be uploaded again
      }
    }

    // ── Team Members Management ───────────────────────────────────────
    let teamMembers = [];
    
    function initTeamData() {
      try {
        const dataDiv = document.getElementById('team-members-data');
        if (dataDiv && dataDiv.dataset.members) {
          let parsed = JSON.parse(decodeURIComponent(dataDiv.dataset.members));
          if (typeof parsed === 'string') parsed = JSON.parse(parsed);
          if (Array.isArray(parsed)) {
            teamMembers = parsed;
          }
        }
        const visibility = dataDiv ? dataDiv.dataset.visibility : 'visible';
        const radio = document.querySelector(`input[name="team_visibility"][value="${visibility}"]`);
        if (radio) radio.checked = true;
        
        if (teamMembers.length === 0) {
          const storedTeam = document.getElementById('team_members_json')?.value;
          if (storedTeam && storedTeam !== '[]') {
            let parsed = JSON.parse(decodeURIComponent(storedTeam));
            if (typeof parsed === 'string') parsed = JSON.parse(parsed);
            if (Array.isArray(parsed)) {
              teamMembers = parsed;
            }
          }
        }
      } catch(e) {
        console.error("Error parsing team data:", e);
        teamMembers = [];
      }
      
      const input = document.getElementById('team_members_json');
      if (input) input.value = JSON.stringify(teamMembers);
    }

    function renderTeamMembers() {
      const container = document.getElementById('team-members-container');
      if (!container) return;

      if (!Array.isArray(teamMembers)) teamMembers = [];

      if (teamMembers.length === 0) {
        container.innerHTML = '<p class="text-sm text-secondary/50 text-center py-4 border border-dashed border-gray-200 rounded-lg">No team members added yet.</p>';
        return;
      }

      container.innerHTML = teamMembers.map((member, index) => `
        <div class="team-member-item bg-gray-50 p-4 rounded-xl border border-gray-200 flex flex-col sm:flex-row gap-4 items-start sm:items-center relative">
          <div class="flex-1 w-full grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-secondary mb-1">Name</label>
              <input type="text" class="w-full px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none" value="${member.name || ''}" oninput="updateTeamMember(${index}, 'name', this.value)" placeholder="e.g. John Doe" />
            </div>
            <div>
              <label class="block text-xs font-medium text-secondary mb-1">Role</label>
              <input type="text" class="w-full px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none" value="${member.role || ''}" oninput="updateTeamMember(${index}, 'role', this.value)" placeholder="e.g. CTO" />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-xs font-medium text-secondary mb-1">Image URL</label>
              <div class="flex gap-2">
                <input id="team_img_${index}" type="text" class="flex-1 px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none" value="${member.image_url || ''}" oninput="updateTeamMember(${index}, 'image_url', this.value)" placeholder="https://..." />
                <button type="button" class="px-3 py-1.5 bg-white hover:bg-gray-100 text-secondary text-xs font-medium rounded-md border border-gray-300 transition-colors" onclick="this.nextElementSibling.click()">Upload</button>
                <input type="file" class="hidden" accept="image/*" onchange="handleImageUpload(this, 'team_img_${index}')" />
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-2 shrink-0">
            ${member.image_url ? '<img src="' + member.image_url + '" class="w-12 h-12 object-cover rounded-full border border-gray-200" />' : '<div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center text-gray-400 text-xs">No Img</div>'}
            <button type="button" onclick="removeTeamMember(${index})" class="text-xs text-red-500 hover:text-red-700 font-medium">Remove</button>
          </div>
        </div>
      `).join('');
    }

    function addTeamMember() {
      teamMembers.push({ name: '', role: '', image_url: '' });
      renderTeamMembers();
      const input = document.getElementById('team_members_json');
      if (input) input.value = JSON.stringify(teamMembers);
    }

    function updateTeamMember(index, field, value) {
      if (teamMembers[index]) {
        teamMembers[index][field] = value;
      }
      if (field === 'image_url') {
        renderTeamMembers(); // re-render to show image
      }
      const input = document.getElementById('team_members_json');
      if (input) input.value = JSON.stringify(teamMembers);
    }

    function removeTeamMember(index) {
      if(confirm('Remove this team member?')) {
        teamMembers.splice(index, 1);
        renderTeamMembers();
        const input = document.getElementById('team_members_json');
        if (input) input.value = JSON.stringify(teamMembers);
      }
    }

    function prepareTeamData(e) {
      // Updates the hidden input before form submit
      document.getElementById('team_members_json').value = JSON.stringify(teamMembers);
    }

    let faqs = [];
    
    function initFaqData() {
      try {
        const storedFaqs = document.getElementById('faqs_json')?.value;
        if (storedFaqs) {
          faqs = JSON.parse(storedFaqs);
        } else {
          faqs = [];
        }
      } catch(e) { faqs = []; }
    }
    
    function initAll() {
      initTeamData();
      initFaqData();
      renderTeamMembers();
      renderFaqs();
    }

    document.addEventListener('DOMContentLoaded', initAll);
    document.addEventListener('astro:page-load', initAll);
    
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initAll();
    }

    function renderFaqs() {
      const container = document.getElementById('faqs-container');
      if (!container) return;
      
      if (faqs.length === 0) {
        container.innerHTML = '<p class="text-sm text-secondary/50 text-center py-4 border border-dashed border-gray-200 rounded-lg">No FAQs added yet.</p>';
        return;
      }
      
      container.innerHTML = faqs.map((faq, index) => `
        <div class="faq-item bg-gray-50 p-4 rounded-xl border border-gray-200 flex flex-col gap-3 relative">
          <div>
            <label class="block text-xs font-medium text-secondary mb-1">Question</label>
            <input type="text" class="w-full px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none" value="${faq.question || ''}" onchange="updateFaq(${index}, 'question', this.value)" placeholder="e.g. What is your return policy?" />
          </div>
          <div>
            <label class="block text-xs font-medium text-secondary mb-1">Answer</label>
            <textarea rows="3" class="w-full px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none" onchange="updateFaq(${index}, 'answer', this.value)" placeholder="e.g. We offer a 30-day return policy...">${faq.answer || ''}</textarea>
          </div>
          <button type="button" onclick="removeFaq(${index})" class="absolute top-4 right-4 text-xs text-red-500 hover:text-red-700 font-medium bg-red-50 px-2 py-1 rounded">Remove</button>
        </div>
      `).join('');
    }

    function addFaq() {
      faqs.push({ question: '', answer: '' });
      renderFaqs();
      const input = document.getElementById('faqs_json');
      if (input) input.value = JSON.stringify(faqs);
      if (frame && frame.contentWindow) frame.contentWindow.postMessage({ type: 'faq_update', faqs: faqs }, '*');
      if (mobileFrame && mobileFrame.contentWindow) mobileFrame.contentWindow.postMessage({ type: 'faq_update', faqs: faqs }, '*');
    }

    function updateFaq(index, field, value) {
      if (faqs[index]) {
        faqs[index][field] = value;
        const input = document.getElementById('faqs_json');
        if (input) input.value = JSON.stringify(faqs);
        if (frame && frame.contentWindow) frame.contentWindow.postMessage({ type: 'faq_update', faqs: faqs }, '*');
        if (mobileFrame && mobileFrame.contentWindow) mobileFrame.contentWindow.postMessage({ type: 'faq_update', faqs: faqs }, '*');
      }
    }

    function removeFaq(index) {
      if (index >= 0 && index < faqs.length) {
        faqs.splice(index, 1);
        renderFaqs();
        const input = document.getElementById('faqs_json');
        if (input) input.value = JSON.stringify(faqs);
        if (frame && frame.contentWindow) frame.contentWindow.postMessage({ type: 'faq_update', faqs: faqs }, '*');
        if (mobileFrame && mobileFrame.contentWindow) mobileFrame.contentWindow.postMessage({ type: 'faq_update', faqs: faqs }, '*');
      }
    }

    function prepareFaqData(e) {
      const input = document.getElementById('faqs_json');
      if (input) input.value = JSON.stringify(faqs);
    }

    document.addEventListener('DOMContentLoaded', () => {
      renderFaqs();
    });

    // Also call directly for Astro client-side navigation
    renderFaqs();

  </script>

  <!-- Tab Switching Logic -->
  <script is:inline data-astro-rerun>
    // Tab preview URL mapping
    var tabPreviewUrls = {
      branding: "/",
      company: "/",
      homepage: "/",
      about: "/about",
      pages: "/contact",
      policies: "/privacy-policy",
      faq: "/faq",
      checkout: "/"
    };

    function switchTab(tabId) {
      // Hide all panels
      var panels = document.querySelectorAll('.tab-panel');
      for (var i = 0; i < panels.length; i++) {
        panels[i].classList.add('hidden');
      }
      
      // Show target panel
      var target = document.querySelector('[data-tab-content="' + tabId + '"]');
      if (target) {
        target.classList.remove('hidden');
      } else {
        console.warn('switchTab: panel not found for tab:', tabId);
        return;
      }

      // Update active tab button styling
      var btns = document.querySelectorAll('.store-tab');
      for (var j = 0; j < btns.length; j++) {
        btns[j].classList.remove('bg-primary', 'text-white', 'shadow-sm');
        btns[j].classList.add('bg-white', 'text-secondary', 'hover:bg-gray-100');
      }
      var activeBtn = document.querySelector('.store-tab[data-tab="' + tabId + '"]');
      if (activeBtn) {
        activeBtn.classList.remove('bg-white', 'text-secondary', 'hover:bg-gray-100');
        activeBtn.classList.add('bg-primary', 'text-white', 'shadow-sm');
      }

      // Update live preview
      var url = tabPreviewUrls[tabId] || '/';
      var frame = document.getElementById('live-preview-frame');
      var badge = document.getElementById('preview-url-badge');
      var mobileFrame = document.getElementById('mobile-preview-frame');
      var mobileBadge = document.getElementById('mobile-preview-badge');
      if (frame) frame.src = url;
      if (badge) badge.textContent = url;
      if (mobileFrame) mobileFrame.src = url;
      if (mobileBadge) mobileBadge.textContent = url;

      // Scroll left pane to top
      try {
        var leftPane = document.querySelector('.overflow-y-auto');
        if (leftPane) leftPane.scrollTop = 0;
      } catch (e) {
        // ignore scroll errors
      }
    }
  </script>

