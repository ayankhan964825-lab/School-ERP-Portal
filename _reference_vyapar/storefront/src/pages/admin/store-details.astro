  <script is:inline>
    // ── Form Submission ────────────────────────────────────────────────
    function attachFormListeners() {
      var forms = document.querySelectorAll('.settings-section-form');
      forms.forEach(function(form) {
        form.removeEventListener('submit', form.submitHandler);
        form.submitHandler = async function(e) {
          e.preventDefault();
          await handleSaveSettings(form);
        };
        form.addEventListener('submit', form.submitHandler);
      });
    }
    
    document.addEventListener('DOMContentLoaded', attachFormListeners);
    document.addEventListener('astro:page-load', attachFormListeners);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      attachFormListeners();
    }
    async function handleSaveSettings(form) {
      if (!form) return;
      var saveBtn = form.querySelector('button[type="submit"]');
      var saveBtnText = form.querySelector('.save-btn-text');
      var saveBtnSpinner = form.querySelector('.save-btn-spinner');

      // Show loading state
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.classList.add('opacity-70', 'cursor-not-allowed');
      }
      var originalText = saveBtnText ? saveBtnText.textContent : 'Saving...';
      if (saveBtnText) saveBtnText.textContent = 'Saving...';
      if (saveBtnSpinner) saveBtnSpinner.classList.remove('hidden');

      // Sync dynamic arrays into hidden inputs before collecting form data
      // This prevents auto-save (e.g. radio change) from sending stale values
      var teamInput = form.querySelector('#team_members_json');
      if (teamInput && typeof teamMembers !== 'undefined' && Array.isArray(teamMembers)) {
        teamInput.value = JSON.stringify(teamMembers);
      }
      var faqInput = form.querySelector('#faqs_json');
      if (faqInput && typeof faqs !== 'undefined' && Array.isArray(faqs)) {
        faqInput.value = JSON.stringify(faqs);
      }

      // Collect all form data from this specific form
      var data = {};
      var inputs = form.querySelectorAll('input, textarea, select');
      for (var i = 0; i < inputs.length; i++) {
        var input = inputs[i];
        var name = input.name;
        if (!name) continue;

        if (input.type === 'radio') {
          if (input.checked) data[name] = input.value;
        } else if (input.type === 'checkbox') {
          data[name] = input.checked ? 'true' : 'false';
        } else {
          data[name] = input.value;
        }
      }

      try {
        var res = await fetch('/api/admin/update-settings?_tenant_id=' + encodeURIComponent(window.__targetStoreId), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          credentials: 'include'
        });

        var result = await res.json();

        if (res.ok && result.success) {
          showSettingsToast(originalText.replace('Save ', '') + ' saved successfully!', 'success');
          // Reload the page after a brief delay to update the admin sidebar and header logos
          setTimeout(() => window.location.reload(), 1200);
        } else {
          showSettingsToast('Error: ' + (result.error || 'Failed to save'), 'error');
        }
      } catch (err) {
        showSettingsToast('Network error: ' + (err.message || 'Could not reach server'), 'error');
      } finally {
        // Reset button
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.classList.remove('opacity-70', 'cursor-not-allowed');
        }
        if (saveBtnText) saveBtnText.textContent = originalText;
        if (saveBtnSpinner) saveBtnSpinner.classList.add('hidden');
      }
    }

    // ── Auto-save Checkboxes ─────────────────────────────────────────
    function attachCheckboxListeners() {
      var autoSaveCheckboxes = document.querySelectorAll('.settings-section-form input[type="radio"]');
      autoSaveCheckboxes.forEach(function(chk) {
        chk.removeEventListener('change', chk.changeHandler);
        chk.changeHandler = function(e) {
          if (confirm('Are you sure you want to update this setting?')) {
            var form = this.closest('.settings-section-form');
            if (form && typeof handleSaveSettings === 'function') {
              handleSaveSettings(form);
            }
          } else {
            // It's a radio, reverting is tricky without keeping old state, but UI will reflect change briefly.
          }
        };
        chk.addEventListener('change', chk.changeHandler);
      });
    }

    document.addEventListener('DOMContentLoaded', attachCheckboxListeners);
    document.addEventListener('astro:page-load', attachCheckboxListeners);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      attachCheckboxListeners();
    }
    // ── Toast Helper ────────────────────────────────────────────────────
    function showSettingsToast(msg, type) {
      var toast = document.getElementById('settings-toast');
      var inner = document.getElementById('settings-toast-inner');
      var icon = document.getElementById('settings-toast-icon');
      var msgEl = document.getElementById('settings-toast-msg');
      if (!toast || !inner || !icon || !msgEl) return;

      msgEl.textContent = msg;
      icon.textContent = type === 'success' ? '✅' : '❌';
      inner.className = 'flex items-center gap-3 px-5 py-3 rounded-xl shadow-xl text-white text-sm font-medium ' +
        (type === 'success' ? 'bg-green-600' : 'bg-red-600');

      toast.classList.remove('hidden');
      setTimeout(function() {
        toast.classList.remove('translate-y-4', 'opacity-0');
      }, 10);

      setTimeout(function() {
        toast.classList.add('translate-y-4', 'opacity-0');
        setTimeout(function() { toast.classList.add('hidden'); }, 300);
      }, 3000);
      window.dispatchEvent(new CustomEvent('settings-saved', { detail: { type: type } }));
    }
  </script>

