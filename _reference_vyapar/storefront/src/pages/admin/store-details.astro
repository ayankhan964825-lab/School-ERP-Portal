      msgBox.textContent = msg;
      msgBox.className = `text-sm p-3 rounded-lg mt-2 ${type === 'error' ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-green-50 text-green-700 border border-green-200'}`;
