        const msgBox = document.getElementById('redirect-domain-msg');
        
        btn.querySelector('.save-btn-text').textContent = 'Adding...';
        btn.querySelector('.save-btn-spinner').classList.remove('hidden');
        btn.disabled = true;
        msgBox.classList.add('hidden');

        try {
          const res = await fetch('/api/admin/update-domain?_tenant_id=' + encodeURIComponent(window.__targetStoreId), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ custom_domain: customDomain, action: 'add_redirect' })
          });

          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to add redirect domain');

          msgBox.textContent = 'Redirect domain added successfully!';
          msgBox.className = 'text-sm p-3 rounded-lg mt-2 bg-green-50 text-green-700 border border-green-200';
          msgBox.classList.remove('hidden');
          setTimeout(() => window.location.reload(), 1500);
        } catch (err) {
          msgBox.textContent = err.message;
          msgBox.className = 'text-sm p-3 rounded-lg mt-2 bg-red-50 text-red-700 border border-red-200';
          msgBox.classList.remove('hidden');
        } finally {
          btn.querySelector('.save-btn-text').textContent = 'Add Redirect';
          btn.querySelector('.save-btn-spinner').classList.add('hidden');
          btn.disabled = false;
        }
      });
    }

    // --- Domain Status Checker ---
    async function checkDomainStatus(domain, type) {
      if (!domain) return;
      
      let badge, infoBox;
      if (type === 'primary') {
        badge = document.getElementById('primary-domain-status-badge');
        infoBox = document.getElementById('primary-domain-error-info');
      } else {
        badge = document.getElementById(`redirect-status-${domain.replace(/\./g, '-')}`);
      }

      if (!badge) return;

      badge.textContent = 'Checking...';
      badge.className = 'px-2 py-0.5 rounded text-xs bg-yellow-100 text-yellow-800 animate-pulse';
      if (infoBox) infoBox.classList.add('hidden');

      try {
        const res = await fetch(`/api/admin/check-domain?domain=${encodeURIComponent(domain)}&_tenant_id=${encodeURIComponent(window.__targetStoreId)}`);
        const data = await res.json();

        if (!res.ok) throw new Error(data.error || 'Check failed');

        if (data.verified) {
          badge.textContent = 'Active';
          badge.className = 'px-2 py-0.5 rounded text-xs font-bold bg-green-100 text-green-800';
        } else {
          badge.textContent = 'Pending Verification';
          badge.className = 'px-2 py-0.5 rounded text-xs font-bold bg-yellow-100 text-yellow-800';
          
          if (infoBox && data.verification && data.verification.length > 0) {
            const v = data.verification[0];
            infoBox.innerHTML = `<strong>Action Required:</strong> Missing ${v.type} record.<br/>Host: <code>${v.domain}</code><br/>Value: <code>${v.value}</code>`;
            infoBox.classList.remove('hidden');
          }
        }
      } catch (err) {
        badge.textContent = 'Error';
        badge.className = 'px-2 py-0.5 rounded text-xs font-bold bg-red-100 text-red-800';
      }
    }
    window.checkDomainStatus = checkDomainStatus;

    window.removeRedirectDomain = async function(domain) {
      if (!confirm(`Are you sure you want to remove ${domain}?`)) return;
      try {
        const res = await fetch('/api/admin/update-domain?_tenant_id=' + encodeURIComponent(window.__targetStoreId), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ custom_domain: domain, action: 'remove_redirect' })
        });
        if (!res.ok) throw new Error('Failed');
        window.location.reload();
      } catch (err) {
        alert('Failed to remove domain: ' + err.message);
      }
    };

    // Auto-check primary domain on load if it exists
    const primaryInput = document.getElementById('custom_domain');
    if (primaryInput && primaryInput.value && document.getElementById('primary-domain-status-badge')) {
      checkDomainStatus(primaryInput.value, 'primary');
    }

    // Auto-check all redirect domains on load
    const redirectDomainsArr = window.__redirectDomains || [];
    redirectDomainsArr.forEach(d => checkDomainStatus(d, 'redirect'));
  });
</script>
