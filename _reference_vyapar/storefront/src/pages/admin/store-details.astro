---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
const ctx = getPermissionContext(Astro.cookies);

if (Astro.request.method === "POST" && !canManageSection(ctx, "store_details")) {
  return new Response("Forbidden", { status: 403 });
}
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageAiPanel from '../../components/admin/PageAiPanel.astro';
import { getSettings, getStore } from '../../lib/database';

const isMasterAdmin = Astro.locals.storeId === 'SUPER_ADMIN_BYPASS';
const impersonateStoreId = Astro.cookies.get('admin_impersonate')?.value;
const targetStoreId = isMasterAdmin ? (Astro.url.searchParams.get('id') || impersonateStoreId) : Astro.locals.storeId;

const store = await getStore(targetStoreId);
const isFreeTier = store?.plan_id === '00000000-0000-0000-0000-000000000005';

// Inject targetStoreId into global window object for client-side API calls
const storeIdScript = `<script is:inline data-astro-rerun>window.__targetStoreId = ${JSON.stringify(targetStoreId)};</script>`;

const settings = await getSettings(targetStoreId);

const defaultProcessSteps = [
  { title: 'Step 1', desc: 'Description of your first process step goes here.', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>' },
  { title: 'Step 2', desc: 'Description of your second process step goes here.', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>' },
  { title: 'Step 3', desc: 'Description of your third process step goes here.', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z" /></svg>' },
  { title: 'Step 4', desc: 'Description of your fourth process step goes here.', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>' }
];

const processStepsJson = typeof settings.about_process_steps === 'string' 
  ? settings.about_process_steps 
  : JSON.stringify(settings.about_process_steps || defaultProcessSteps, null, 2);


// DEBUG: Log what settings actually contains for team data
console.log('[DEBUG store-details] team_members:', JSON.stringify(settings.team_members));
console.log('[DEBUG store-details] team_members type:', typeof settings.team_members);
console.log('[DEBUG store-details] team_members isArray:', Array.isArray(settings.team_members));
console.log('[DEBUG store-details] team_visibility:', settings.team_visibility);
console.log('[DEBUG store-details] pages_content keys:', settings.pages_content ? Object.keys(settings.pages_content) : 'NO pages_content');

const success = Astro.url.searchParams.get('success') === 'true';
const error = Astro.url.searchParams.get('error') === 'true';

const settingsForAI = JSON.stringify(settings);
---

<AdminLayout title="Store Details | Admin Panel" description="Manage store branding and pages.">
  <Fragment set:html={storeIdScript} />
  <div class="flex flex-col lg:flex-row gap-0 -m-4 sm:-m-6 lg:-m-8 h-[calc(100vh-3.5rem)] overflow-hidden" style="height: calc(100vh - 3.5rem); overflow: hidden;">
  <div class="w-full lg:w-[52%] shrink-0 overflow-y-auto h-full p-4 sm:p-6 lg:p-8 relative" style="height: 100%; overflow-y: auto;">
    <!-- Mobile Sticky Live Preview Button -->
    <div class="sticky z-30 block lg:hidden w-full bg-gray-50 border-b border-gray-200 shadow-sm mb-6 pb-3 pt-3" style="top: -1rem; margin-top: -1rem; margin-left: -1rem; margin-right: -1rem; width: calc(100% + 2rem); padding-left: 1rem; padding-right: 1rem;">
      <div class="flex justify-between items-center">
        <span class="text-xs font-bold text-secondary flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
          Store Editor
        </span>
        <button type="button" onclick="openMobilePreviewModal()" class="text-xs bg-primary text-white hover:bg-primary/90 px-3 py-1.5 rounded-lg shadow-sm font-medium transition-colors flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z" /><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" /></svg>
          View Live Preview
        </button>
      </div>
    </div>
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-serif font-bold text-secondary">Store Details</h1>
        <p class="text-sm text-secondary/60 mt-1">Manage branding, team members, and content for legal pages.</p>
      </div>
      <a href="/admin/bulk-upload/store-details" class="btn-primary !bg-white !text-primary border border-primary hover:!bg-primary/5 flex items-center justify-center gap-2 shrink-0 py-2 px-4 shadow-sm text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        BYO-AI Bulk Gen
      </a>
    </div>
    {success && (
      <div class="mb-6 bg-green-50 text-green-800 p-4 rounded-lg border border-green-200 text-sm font-medium">
        Settings saved successfully.
      </div>
    )}
    
    {error && (
      <div class="mb-6 bg-red-50 text-red-800 p-4 rounded-lg border border-red-200 text-sm font-medium">
        Failed to save settings. Please try again.
      </div>
    )}

    <div class="sticky top-0 z-20 bg-white/95 backdrop-blur-sm border border-gray-200 rounded-xl p-1.5 mb-6 shadow-sm">
      <div class="flex gap-1 overflow-x-auto scrollbar-hide">
        <button type="button" data-tab="domain" class="store-tab flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-primary text-white shadow-sm" onclick="switchTab('domain')">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
          Domain
        </button>
        <button type="button" data-tab="branding" class="store-tab flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white text-secondary hover:bg-gray-100" onclick="switchTab('branding')">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          Branding
        </button>
        <button type="button" data-tab="company" class="store-tab flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white text-secondary hover:bg-gray-100" onclick="switchTab('company')">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          Company
        </button>
        <button type="button" data-tab="homepage" class="store-tab flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white text-secondary hover:bg-gray-100" onclick="switchTab('homepage')">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Homepage
        </button>
        <button type="button" data-tab="about" class="store-tab flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white text-secondary hover:bg-gray-100" onclick="switchTab('about')">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          About Us
        </button>
        <button type="button" data-tab="pages" class="store-tab flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white text-secondary hover:bg-gray-100" onclick="switchTab('pages')">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Pages
        </button>
        <button type="button" data-tab="policies" class="store-tab flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white text-secondary hover:bg-gray-100" onclick="switchTab('policies')">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" /></svg>
          Policies
        </button>
        <button type="button" data-tab="faq" class="store-tab flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white text-secondary hover:bg-gray-100" onclick="switchTab('faq')">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          FAQ
        </button>
        <button type="button" data-tab="checkout" class="store-tab flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-all bg-white text-secondary hover:bg-gray-100" onclick="switchTab('checkout')">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          Checkout Rules
        </button>
      </div>
    </div>

    <!-- ═══ TAB CONTENT PANELS ═══ -->

    <div data-tab-content="domain" class="tab-panel space-y-6">
      <form autocomplete="off" id="custom-domain-form" class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
          <h2 class="font-bold text-secondary flex items-center gap-2">
            🌐 Custom Domain Setup
          </h2>
          <p class="text-xs text-secondary/60">Link your primary domain (e.g. mybrand.com) to your VyaparPe store.</p>
        </div>
        <div class="p-6 space-y-4">
          {isFreeTier ? (
            <div class="bg-primary/5 rounded-xl border border-primary/20 p-6 text-center">
              <h4 class="font-bold text-primary mb-2">Custom Domain Locked</h4>
              <p class="text-sm text-secondary/70 mb-4">Upgrade to the Growth Plan to use your own custom domain.</p>
              <a href="/admin/settings/billing" class="inline-flex px-4 py-2 bg-primary text-white text-sm font-medium rounded-lg">Upgrade Now</a>
            </div>
          ) : (
            <>
              <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 text-sm text-blue-800 mb-4">
                <h4 class="font-semibold mb-1">How to connect your domain:</h4>
                <ol class="list-decimal pl-4 space-y-1 text-xs">
                  <li>Enter your custom domain below (without https://) and click Connect.</li>
                  <li>Log into your Domain Registrar (GoDaddy, Hostinger, etc.).</li>
                  <li>Add a new <strong>CNAME</strong> record:
                    <ul class="list-disc pl-4 mt-1 font-mono text-xs bg-white/50 p-2 rounded border border-blue-100">
                      <li>Name/Host: <strong>@</strong> (or www)</li>
                      <li>Value/Target: <strong>cname.vercel-dns.com</strong></li>
                    </ul>
                  </li>
                  <li>Wait 15-30 minutes for DNS to propagate. SSL will be issued automatically.</li>
                </ol>
              </div>

              <div>
                <label for="custom_domain" class="block text-sm font-medium text-secondary mb-1">Primary Custom Domain</label>
                <div class="flex gap-3">
                  <input 
                    id="custom_domain" 
                    type="text" 
                    name="custom_domain" 
                    value={settings.custom_domain || ''} 
                    placeholder="e.g. mybrand.com" 
                    class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" 
                  />
                  {settings.custom_domain && (
                    <button type="button" id="remove-domain-btn" class="px-4 py-2 bg-red-50 text-red-600 rounded-lg text-sm font-semibold border border-red-100 hover:bg-red-100 transition-colors">
                      Remove
                    </button>
                  )}
                </div>
                {settings.custom_domain ? (
                  <div id="primary-domain-status-container" class="mt-3 p-3 rounded-lg border border-gray-200 bg-gray-50 flex flex-col gap-2">
                    <div class="flex justify-between items-center">
                      <div class="text-sm font-semibold text-secondary">Status: <span id="primary-domain-status-badge" class="px-2 py-0.5 rounded text-xs bg-yellow-100 text-yellow-800 animate-pulse">Checking...</span></div>
                      <button type="button" onclick="checkDomainStatus(document.getElementById('custom_domain').value, 'primary')" class="text-xs text-primary font-medium hover:underline">Check Again</button>
                    </div>
                    <div id="primary-domain-error-info" class="text-xs font-mono bg-white border border-red-100 text-red-700 p-2 rounded hidden">
                      <!-- Injected via JS -->
                    </div>
                  </div>
                ) : (
                  <p class="text-xs text-secondary/60 mt-2">Currently using: <a href={`https://${settings.subdomain}.vyaparpe.in`} target="_blank" class="text-primary hover:underline">{settings.subdomain}.vyaparpe.in</a></p>
                )}
              </div>
              <div id="domain-msg" class="hidden text-sm p-3 rounded-lg mt-2"></div>
            </>
          )}
        </div>
        
        {!isFreeTier && (
          <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">
            <button type="submit" id="domain-submit-btn" class="btn-primary flex items-center gap-2 px-6 py-2 text-sm">
              <span class="save-btn-text">Connect Domain</span>
              <svg class="save-btn-spinner hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
            </button>
          </div>
        )}
      </form>

      {settings.custom_domain && (
        <form autocomplete="off" id="redirect-domains-form" class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mt-6">
          <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
            <h2 class="font-bold text-secondary flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-repeat"><path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/></svg>
              Redirect Domains
            </h2>
            <p class="text-xs text-secondary/60">Add secondary domains (like Your Brand.in) that will automatically redirect visitors to your primary domain.</p>
          </div>
          <div class="p-6 space-y-4">
            <div class="flex gap-3">
              <input 
                id="new_redirect_domain" 
                type="text" 
                placeholder="e.g. Your Brand.in" 
                class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" 
              />
              <button type="submit" id="add-redirect-btn" class="px-4 py-2 bg-gray-100 text-gray-800 rounded-lg text-sm font-semibold border border-gray-200 hover:bg-gray-200 transition-colors flex items-center gap-2">
                <span class="save-btn-text">Add Redirect</span>
                <svg class="save-btn-spinner hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
              </button>
            </div>
            <div id="redirect-domain-msg" class="hidden text-sm p-3 rounded-lg mt-2"></div>
            
            <!-- List of existing redirect domains -->
            <div class="mt-4 space-y-3">
              {settings.redirect_domains && Array.isArray(settings.redirect_domains) && settings.redirect_domains.map((rd: string) => (
                <div class="flex justify-between items-center p-3 border border-gray-100 rounded-lg bg-gray-50/50">
                  <div>
                    <div class="font-semibold text-sm text-secondary">{rd} <span class="text-xs font-normal text-secondary/60 ml-1">&rarr; {settings.custom_domain}</span></div>
                    <div id={`redirect-status-${rd.replace(/\./g, '-')}`} class="text-[10px] uppercase font-bold text-yellow-600 tracking-wider mt-1">Checking Status...</div>
                  </div>
                  <button type="button" onclick={`removeRedirectDomain('${rd}')`} class="text-red-500 hover:text-red-700 text-xs font-medium px-2 py-1 bg-red-50 rounded">Remove</button>
                </div>
              ))}
              {(!settings.redirect_domains || settings.redirect_domains.length === 0) && (
                <div class="text-sm text-secondary/60 text-center py-4 bg-gray-50 rounded-lg border border-dashed border-gray-200">No redirect domains added yet.</div>
              )}
            </div>
          </div>
        </form>
        <script define:vars={{ redirectDomains: settings.redirect_domains || [] }} data-astro-rerun>
          window.__redirectDomains = redirectDomains;
        </script>
      )}
    </div>

    <div data-tab-content="branding" class="tab-panel space-y-6 hidden">
      <!-- Branding & Assets -->
      <form autocomplete="off" class="settings-section-form bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
          <h2 class="font-bold text-secondary flex items-center gap-2">
