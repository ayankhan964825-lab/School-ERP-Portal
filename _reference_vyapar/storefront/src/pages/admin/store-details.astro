<script is:inline data-astro-rerun>
  (function() {
    const frame = document.getElementById("live-preview-frame");
    const badge = document.getElementById("preview-url-badge");
    const mobileFrame = document.getElementById("mobile-preview-frame");
    const mobileBadge = document.getElementById("mobile-preview-badge");

    const pageMap = {
      "About Us": "/about",
      "Bulk Order": "/bulk-order",
      "Contact Us": "/contact",
      "Privacy Policy": "/privacy-policy",
      "Terms": "/terms",
      "Refund Policy": "/refund-policy",
      "Shipping Policy": "/shipping-policy",
      "Sustainability": "/sustainability",
      "Warranty": "/warranty",
      "Delivery": "/delivery",
      "FAQ": "/faq"
    };

    function updateAllPreviews(page) {
      const url = pageMap[page];
      if (!url) return;
      
      if (frame) {
        frame.src = url;
      }
      if (badge) {
        badge.textContent = url;
      }
      if (mobileFrame) {
        mobileFrame.src = url;
      }
      if (mobileBadge) {
        mobileBadge.textContent = url;
      }
    }

    function syncAllSettingsToFrame(targetFrame) {
      if (!targetFrame || !targetFrame.contentWindow) return;
      document.querySelectorAll('.settings-section-form input[name], .settings-section-form textarea[name]').forEach(function(el) {
        if (!el.name) return;
        var val = el.value;
        if (el.type === 'checkbox' || el.type === 'radio') {
          if (!el.checked) return;
          val = el.value;
        }
        const msg = {
          type: 'settings_update',
          key: el.name,
          value: val
        };
        targetFrame.contentWindow.postMessage(msg, '*');
      });
    }

    if (frame) {
      frame.addEventListener('load', function() {
        syncAllSettingsToFrame(frame);
      });
    }
    if (mobileFrame) {
      mobileFrame.addEventListener('load', function() {
        syncAllSettingsToFrame(mobileFrame);
      });
    }

    // Toggle logic for the exclusive accordion
    document.querySelectorAll("details[data-page]").forEach(function(d) {
      d.addEventListener("toggle", function() {
        if (this.open) {
          document.querySelectorAll("details[data-page]").forEach(function(other) {
            if (other !== d) other.removeAttribute("open");
          });
          const page = this.getAttribute("data-page");
          updateAllPreviews(page);
        }
      });
    });

    // Hook into the toast to auto-reload after save
    window.addEventListener('settings-saved', function(e) {
      if (e.detail && e.detail.type === "success") {
        setTimeout(function() { 
          if (frame) frame.src = frame.src; 
          if (mobileFrame) mobileFrame.src = mobileFrame.src;
        }, 600);
      }
    });

  // Dynamic scaling removed in favor of native modal

    // Realtime Live Preview dispatcher
    document.addEventListener('input', function(e) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
        const msg = {
          type: 'settings_update',
          key: e.target.name,
          value: e.target.value
        };
        if (frame && frame.contentWindow) {
          frame.contentWindow.postMessage(msg, '*');
        }
        if (mobileFrame && mobileFrame.contentWindow) {
          mobileFrame.contentWindow.postMessage(msg, '*');
        }
      }
    });
  })();
</script>

