---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
const ctx = getPermissionContext(Astro.cookies);

if (Astro.request.method === "POST" && !canManageSection(ctx, "feedback")) {
  return new Response("Forbidden", { status: 403 });
}
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageAiPanel from '../../components/admin/PageAiPanel.astro';
import { getFeedback, getBulkInquiries } from '../../lib/database';

const feedbacks = await getFeedback();
const bulkOrders = await getBulkInquiries();

const openComplaints = feedbacks.filter((f: any) => f.type === 'complaint' && f.status === 'open').length;
const newBulkInquiries = bulkOrders.filter((b: any) => b.status === 'new').length;

const feedbackForAI = JSON.stringify({
  feedbacks: feedbacks.slice(0, 30),
  bulkOrders: bulkOrders.slice(0, 30)
});
---

<AdminLayout title="Feedback & Inquiries | Admin Panel">
  <div class="flex justify-between items-center mb-4">
    <div>
      <h1 class="text-2xl font-serif font-bold text-secondary">Feedback & B2B Inquiries</h1>
      <p class="text-sm text-secondary/60 mt-1">Manage customer complaints, feedback, and bulk order inquiries from one place.</p>
    </div>
    <div class="flex gap-3">
      <a href="/admin/bulk-upload/feedback" class="btn-primary !py-2.5 flex items-center gap-2 shrink-0 whitespace-nowrap">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Bulk Upload
      </a>
    </div>
  </div>

  <!-- AI Assistant Panel -->
  <PageAiPanel
    page="feedback"
    title="Feedback Assistant"
    pageDataJson={feedbackForAI}
    guideTitleEn="Feedback & B2B Guide"
    guideTitleHi="Feedback & B2B Guide"
    guideHtml={`<ul class="space-y-2">
      <li><strong>Feedback:</strong> Read and resolve customer complaints and feedback. Click "Mark Resolved" when done.</li>
      <li><strong>B2B / Bulk:</strong> Review wholesale/B2B inquiries. Use the WhatsApp/Email buttons to contact leads, then "Mark Contacted".</li>
      <li><strong>Alerts:</strong> The red alert box shows unhandled complaints or new bulk orders requiring your attention.</li>
    </ul>`}
    guideHtmlHi={`<ul class="space-y-2">
      <li><strong>Feedback:</strong> Customer ki shikayatein (complaints) aur feedback padhein. Resolve hone par "Mark Resolved" dabayein.</li>
      <li><strong>B2B / Bulk:</strong> Wholesale enquiries dekhein. Lead ko WhatsApp/Email karne ke baad "Mark Contacted" par click karein.</li>
      <li><strong>Alerts:</strong> Upar laal alert box un complaints aur naye orders ko dikhata hai jin par dhyan dena zaroori hai.</li>
    </ul>`}
    quickActions={[
      { label: '🔴 Open Complaints', query: 'open complaints dikhao' },
      { label: '🆕 New B2B', query: 'naye b2b orders dikhao' },
      { label: '✅ Resolve All', query: 'sab complaints ko resolve mark karo' }
    ]}
  />

  <!-- Alert for open items -->
  {(openComplaints > 0 || newBulkInquiries > 0) && (
    <div class="mb-6 bg-red-50 border border-red-200 rounded-2xl p-4 flex items-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      <p class="text-sm font-medium text-red-800">
        {openComplaints > 0 && `${openComplaints} open complaint${openComplaints > 1 ? 's' : ''}`}
        {openComplaints > 0 && newBulkInquiries > 0 && ' · '}
        {newBulkInquiries > 0 && `${newBulkInquiries} new bulk inquiry${newBulkInquiries > 1 ? 'ies' : 'y'}`}
        {' '} require your attention.
      </p>
    </div>
  )}

  <!-- Tabs -->
  <div class="flex gap-1 bg-gray-100 rounded-xl p-1 mb-8 w-fit">
    <button id="tab-feedback" class="tab-btn px-5 py-2 rounded-lg text-sm font-semibold bg-white text-secondary shadow-sm transition-all">
      Customer Feedback
      {openComplaints > 0 && <span class="ml-2 bg-red-500 text-white text-xs rounded-full px-1.5 py-0.5">{openComplaints}</span>}
    </button>
    <button id="tab-bulk" class="tab-btn px-5 py-2 rounded-lg text-sm font-semibold text-secondary/60 hover:text-secondary transition-all">
      B2B / Bulk Orders
      {newBulkInquiries > 0 && <span class="ml-2 bg-amber-500 text-white text-xs rounded-full px-1.5 py-0.5">{newBulkInquiries}</span>}
    </button>
  </div>

  <!-- ── FEEDBACK PANEL ─────────────────────────── -->
  <div id="panel-feedback" class="space-y-4">
    {feedbacks.length === 0 ? (
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-16 text-center">
        <p class="text-secondary/60 text-lg font-medium">No feedback yet</p>
        <p class="text-secondary/40 text-sm mt-1">Customer feedback and complaints will appear here.</p>
      </div>
    ) : (
      feedbacks.map((item: any) => {
        const isComplaint = item.type === 'complaint';
        return (
          <div class={`feedback-card bg-white rounded-2xl border p-5 shadow-sm ${item.status === 'open' && isComplaint ? 'border-red-200' : 'border-gray-100'}`} data-id={item.id}>
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-2 flex-wrap mb-2">
                  <span class={`text-xs font-bold px-2.5 py-0.5 rounded-full ${isComplaint ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700'}`}>
                    {isComplaint ? 'Complaint' : 'Feedback'}
                  </span>
                  <span class={`feedback-status text-xs font-semibold px-2 py-0.5 rounded-full ${item.status === 'open' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-500'}`}>
                    {item.status === 'open' ? 'Open' : 'Resolved'}
                  </span>
                  {item.orderId && <span class="text-xs text-secondary/40">Order #{item.orderId}</span>}
                </div>
                <h3 class="font-bold text-secondary text-sm mb-1">{item.subject}</h3>
                <p class="text-sm text-secondary/70 leading-relaxed">{item.message}</p>
                <div class="mt-3 flex items-center gap-3 text-xs text-secondary/50">
                  <span class="font-medium text-secondary/70">{item.customer}</span>
                  <span>·</span>
                  <a href={`tel:${item.phone}`} class="text-primary hover:underline">{item.phone}</a>
                  <span>·</span>
                  <span>{item.created_at ? new Date(item.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : '—'}</span>
                </div>
              </div>
              {item.status === 'open' && (
                <div class="flex gap-2 shrink-0">
                  <button
                    class="resolve-btn px-4 py-2 text-xs font-semibold bg-green-100 text-green-700 rounded-xl hover:bg-green-600 hover:text-white transition-colors"
                    data-id={item.id}
                  >
                    ✓ Mark Resolved
                  </button>
                  <a
                    href={`https://wa.me/91${item.phone}?text=Hello%20${encodeURIComponent(item.customer || '')}%2C%20regarding%20your%20${item.type}%20on%20order%20%23${item.orderId || ''}`}
                    target="_blank"
                    class="px-4 py-2 text-xs font-semibold bg-emerald-100 text-emerald-700 rounded-xl hover:bg-emerald-600 hover:text-white transition-colors flex items-center gap-1.5"
                  >
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    WhatsApp
                  </a>
                </div>
              )}
            </div>
          </div>
        );
      })
    )}
  </div>

  <!-- ── BULK ORDERS PANEL ──────────────────────── -->
  <div id="panel-bulk" class="space-y-4 hidden">
    {bulkOrders.length === 0 ? (
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-16 text-center">
        <p class="text-secondary/60 text-lg font-medium">No bulk inquiries yet</p>
        <p class="text-secondary/40 text-sm mt-1">B2B and bulk order inquiries will appear here.</p>
      </div>
    ) : (
      bulkOrders.map((inq: any) => (
        <div class={`bulk-card bg-white rounded-2xl border p-5 shadow-sm ${inq.status === 'new' ? 'border-amber-200' : 'border-gray-100'}`} data-id={inq.id}>
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center gap-2 flex-wrap mb-2">
                <span class={`bulk-status text-xs font-bold px-2.5 py-0.5 rounded-full ${inq.status === 'new' ? 'bg-amber-100 text-amber-700' : 'bg-green-100 text-green-700'}`}>
                  {inq.status === 'new' ? 'New' : 'Contacted'}
                </span>
                <span class="text-xs text-secondary/40">{inq.created_at ? new Date(inq.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'}</span>
              </div>
              <h3 class="font-bold text-secondary">{inq.name}</h3>
              <p class="text-xs text-secondary/60 mb-2">{inq.company}</p>
              <p class="text-sm text-secondary/70 leading-relaxed bg-gray-50 rounded-xl p-3 mt-2">{inq.requirements}</p>
              <div class="mt-3 flex items-center gap-3 text-xs text-secondary/50">
                <a href={`tel:${inq.phone}`} class="text-primary hover:underline font-medium">{inq.phone}</a>
                <span>·</span>
                <a href={`mailto:${inq.email}`} class="text-primary hover:underline">{inq.email}</a>
              </div>
            </div>
            <div class="flex flex-col gap-2 shrink-0">
              {inq.status === 'new' && (
                <button
                  class="bulk-contacted-btn px-4 py-2 text-xs font-semibold bg-green-100 text-green-700 rounded-xl hover:bg-green-600 hover:text-white transition-colors"
                  data-id={inq.id}
                >
                  ✓ Mark Contacted
                </button>
              )}
              <a
                href={`https://wa.me/91${inq.phone}?text=Hello%20${encodeURIComponent(inq.name || '')}%2C%20we%20received%20your%20bulk%20order%20inquiry%20from%20The%20Your Brand.%20Could%20you%20please%20share%20more%20details%3F`}
                target="_blank"
                class="px-4 py-2 text-xs font-semibold bg-emerald-100 text-emerald-700 rounded-xl hover:bg-emerald-600 hover:text-white transition-colors flex items-center gap-1.5"
              >
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                WhatsApp
              </a>
              <a href={`mailto:${inq.email}`}
                class="px-4 py-2 text-xs font-semibold bg-blue-50 text-blue-600 rounded-xl hover:bg-blue-600 hover:text-white transition-colors text-center"
              >
                ✉️ Email
              </a>
            </div>
          </div>
        </div>
      ))
    )}
  </div>


<script data-astro-rerun>
  // Tab switching
  const tabs = ['feedback', 'bulk'];
  tabs.forEach(t => {
    document.getElementById(`tab-${t}`)?.addEventListener('click', () => {
      tabs.forEach(x => {
        const btn = document.getElementById(`tab-${x}`);
        const panel = document.getElementById(`panel-${x}`);
        if (x === t) {
          btn?.classList.add('bg-white', 'text-secondary', 'shadow-sm');
          btn?.classList.remove('text-secondary/60');
          panel?.classList.remove('hidden');
        } else {
          btn?.classList.remove('bg-white', 'text-secondary', 'shadow-sm');
          btn?.classList.add('text-secondary/60');
          panel?.classList.add('hidden');
        }
      });
    });
  });

  // Resolve feedback — real API call
  document.querySelectorAll('.resolve-btn').forEach(btn => {
    btn.addEventListener('click', async function(this) {
      const id = this.dataset.id;
      if (!id) return;

      this.textContent = '✅ Resolved';
      (this).disabled = true;
      const card = this.closest('.feedback-card');
      if (card) {
        card.style.borderColor = '#d1fae5';
        const badge = card.querySelector('.feedback-status');
        if (badge) { badge.textContent = 'Resolved'; badge.className = 'feedback-status text-xs font-semibold px-2 py-0.5 rounded-full bg-gray-100 text-gray-500'; }
      }

      try {
        await fetch('/api/admin/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'resolve_feedback', id }),
        });
      } catch (err) {
        console.error('Failed to resolve feedback:', err);
      }
    });
  });

  // Mark bulk contacted — real API call
  document.querySelectorAll('.bulk-contacted-btn').forEach(btn => {
    btn.addEventListener('click', async function(this) {
      const id = this.dataset.id;
      if (!id) return;

      const card = this.closest('.bulk-card');
      if (card) {
        card.style.borderColor = '#d1fae5';
        const badge = card.querySelector('.bulk-status');
        if (badge) { badge.textContent = 'Contacted'; badge.className = 'bulk-status text-xs font-bold px-2.5 py-0.5 rounded-full bg-green-100 text-green-700'; }
      }
      this.remove();

      try {
        await fetch('/api/admin/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'mark_contacted', id }),
        });
      } catch (err) {
        console.error('Failed to update inquiry:', err);
      }
    });
  });

  // ── AI Action Handler (from PageAiPanel) ──────────────────────────────
  document.addEventListener('ai-action', function(e) {
    var action = e.detail.action;
    var params = e.detail.params || {};

    if (action === 'switch_tab') {
      var tab = params.tab || 'feedback'; // 'feedback' or 'bulk'
      var btn = document.getElementById('tab-' + tab);
      if (btn) btn.click();
    }
    else if (action === 'resolve_all_feedback') {
      document.getElementById('tab-feedback')?.click();
      var btns = document.querySelectorAll('.resolve-btn');
      btns.forEach(function(btn) { 
        btn.classList.add('ring-2', 'ring-violet-500', 'ring-offset-2');
        const origText = btn.innerHTML;
        btn.innerHTML = '✨ Click to Resolve';
        setTimeout(() => {
          btn.classList.remove('ring-2', 'ring-violet-500', 'ring-offset-2');
          btn.innerHTML = origText;
        }, 4000);
      });
    }
    else if (action === 'mark_all_bulk_contacted') {
      document.getElementById('tab-bulk')?.click();
      var btns = document.querySelectorAll('.bulk-contacted-btn');
      btns.forEach(function(btn) { 
        btn.classList.add('ring-2', 'ring-violet-500', 'ring-offset-2');
        const origText = btn.innerHTML;
        btn.innerHTML = '✨ Click to Mark Contacted';
        setTimeout(() => {
          btn.classList.remove('ring-2', 'ring-violet-500', 'ring-offset-2');
          btn.innerHTML = origText;
        }, 4000);
      });
    }
    else if (action === 'navigate') {
      if (params.url) window.location.href = params.url;
    }
  });
</script>

</AdminLayout>
