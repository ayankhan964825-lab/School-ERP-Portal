---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
const ctx = getPermissionContext(Astro.cookies);

if (Astro.request.method === "POST" && !canManageSection(ctx, "orders_all")) {
  return new Response("Forbidden", { status: 403 });
}
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageAiPanel from '../../components/admin/PageAiPanel.astro';
import { getOrders, supabaseAdmin } from '../../lib/database';

const allOrders = await getOrders(Astro.locals?.storeId);
let orders = allOrders.filter((o: any) => !(o.is_b2b || (o.customer && o.customer.is_b2b)));
orders.sort((a: any, b: any) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

// Fetch Riders
let activeRiders: any[] = [];
if (supabaseAdmin && Astro.locals?.storeId) {
  const { data } = await supabaseAdmin
    .from('riders')
    .select('id, name, is_online, vehicle_type')
    .eq('store_id', Astro.locals.storeId)
    .eq('status', 'active');
  if (data) activeRiders = data;
}

const statusColors: { [key: string]: string } = {
  pending:   'bg-yellow-100 text-yellow-800',
  placed:    'bg-yellow-100 text-yellow-800',
  confirmed: 'bg-blue-100 text-blue-800',
  processing:'bg-blue-100 text-blue-800',
  shipped:   'bg-purple-100 text-purple-800',
  dispatched:'bg-purple-100 text-purple-800',
  delivered: 'bg-green-100 text-green-800',
  cancelled: 'bg-red-100 text-red-800',
  returned:  'bg-red-100 text-red-800',
  quotation: 'bg-blue-100 text-blue-900 border border-blue-200',
};

// Serialize for AI (last 100 orders, lightweight)
const totalOrdersCount = orders.length;
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const limit = 50;
const totalPages = Math.max(1, Math.ceil(totalOrdersCount / limit));
const paginatedOrders = orders.slice((page - 1) * limit, page * limit);

const ordersForAI = JSON.stringify(paginatedOrders.slice(0, 100).map((o: any) => ({
  id: o.id,
  status: o.status,
  date: o.createdAt,
  customer: o.customerName || o.customer_name || '',
  phone: o.phone || '',
  total: o.total,
  paymentMethod: o.paymentMethod || o.payment_method || '',
  items: (o.items || []).map((i: any) => i.name || i.productName).join(', '),
})));
---

<AdminLayout title="Orders | Admin Panel" description="Manage orders.">
  <!-- Page Header -->
  <div class="flex justify-between items-center mb-4">
    <div>
      <h1 class="text-2xl font-serif font-bold text-secondary">Order Management</h1>
      <p class="text-sm text-secondary/60 mt-1">Update status, print invoices, and add AWB tracking numbers.</p>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-sm text-secondary/60 font-medium">{totalOrdersCount} total orders</span>
    </div>
  </div>

  <!-- AI Assistant Panel -->
  <PageAiPanel
    page="orders"
    title="Orders Assistant"
    pageDataJson={ordersForAI}
    guideTitleEn="Order Management Guide"
    guideTitleHi="Order Management Guide"
    guideHtml={`<ul class="space-y-2">
      <li><strong>Status Update:</strong> Order row ke ✏️ icon se status change karein.</li>
      <li><strong>AWB Number:</strong> Shipped orders mein tracking number add karein.</li>
      <li><strong>Invoice Print:</strong> Order row mein 🖨️ button se individual invoice print karein.</li>
      <li><strong>Filter:</strong> Upar ke buttons se status-wise filter karein.</li>
      <li><strong>Bulk Print:</strong> Batch Print section mein multiple invoices ek saath print karein.</li>
    </ul>`}
    guideHtmlHi={`<ul class="space-y-2">
      <li><strong>Status Update:</strong> Har order row mein ✏️ icon se status badlein — pending → confirmed → shipped → delivered.</li>
      <li><strong>AWB Number:</strong> Jab order ship ho jaye, tracking number daalein taaki customer track kar sake.</li>
      <li><strong>Invoice Print:</strong> Order row mein printer icon se invoice nikaalein.</li>
      <li><strong>Filter:</strong> Upar ke colorful buttons se status ke hisaab se orders filter karein.</li>
      <li><strong>Bulk Print:</strong> Batch Print section mein jaayein multiple invoices ek saath print karne ke liye.</li>
    </ul>`}
    quickActions={[
      { label: '📦 Pending dikhao', query: 'pending orders dikhao' },
      { label: '🚚 Shipped dikhao', query: 'shipped orders dikhao' },
      { label: '✅ Delivered dikhao', query: 'delivered orders dikhao' },
      { label: '📊 Kitne orders hain?', query: 'total orders kitne hain aur status breakdown batao' },
      { label: '💰 Aaj ke orders', query: 'aaj ke orders kitne hain' },
    ]}
  />

  <!-- Filters -->
  <div class="flex flex-wrap gap-2 mb-6">
    {['all','pending','confirmed','shipped','delivered','cancelled'].map(status => (
      <button
        class="filter-btn px-4 py-1.5 rounded-full text-xs font-semibold border transition-colors"
        data-status={status}
      >
        {status.charAt(0).toUpperCase() + status.slice(1)}
      </button>
    ))}
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-6">
    {paginatedOrders.length === 0 ? (
      <div class="p-16 text-center text-secondary/60">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
        <p>No orders found.</p>
      </div>
    ) : (
      <div class="overflow-x-auto w-full">
        <table class="min-w-full text-sm text-left">
          <thead class="text-xs text-secondary/60 uppercase bg-gray-50/80 border-b border-gray-100">
            <tr>
              <th class="px-5 py-3.5 font-semibold">Order</th>
              <th class="px-5 py-3.5 font-semibold">Customer</th>
              <th class="px-5 py-3.5 font-semibold">Items & Amount</th>
              <th class="px-5 py-3.5 font-semibold">Status</th>
              <th class="px-5 py-3.5 font-semibold">AWB / Tracking</th>
              <th class="px-5 py-3.5 font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            {paginatedOrders.map((order: any) => (
              <tr class="order-row hover:bg-gray-50/40 transition-colors" data-status={order.status}>
                <!-- Order ID + Date -->
                <td class="px-5 py-4">
                  <div class="font-bold text-secondary text-xs flex items-center gap-1 flex-wrap">
                    {order.orderId}
                    {order.items?.some((i: any) => i.is_q_commerce_only) && (
                      <span class="bg-purple-100 text-purple-700 text-[9px] font-bold px-1.5 py-0.5 rounded-sm flex items-center gap-0.5" title="Q-Commerce / Hyperlocal Order">
                        ⚡ QC
                      </span>
                    )}
                    
                  </div>
                  <div class="text-xs text-secondary/50 mt-0.5">
                    {new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </div>
                  <div class="mt-1">
                    <span class="text-[10px] uppercase font-bold tracking-wide bg-gray-100 text-secondary/60 px-2 py-0.5 rounded">
                      {order.paymentMethod || 'COD'}
                    </span>
                  </div>
                </td>

                <!-- Customer -->
                <td class="px-5 py-4">
                  <div class="font-semibold text-secondary text-sm">{order.customer?.name || 'Guest'}</div>
                  <div class="text-xs text-secondary/50">{order.customer?.phone}</div>
                  <div class="text-xs text-secondary/40 mt-0.5 line-clamp-1 max-w-[160px]">
                    {order.customer?.addressLine || order.customer?.street_address || order.customer?.address}, {order.customer?.city}
                  </div>
                </td>

                <!-- Items + Amount -->
                <td class="px-5 py-4">
                  <div class="font-bold text-secondary">₹{(order.amount || 0).toLocaleString('en-IN')}</div>
                  <div class="mt-1 space-y-0.5">
                    {(order.items || []).slice(0,2).map((item) => (
                      <div class="text-xs text-secondary/60">
                        <span class="font-medium">{item.quantity}×</span> {item.name} {item.weight ? `(${item.weight})` : (item.variant ? `(${item.variant})` : '')}
                      </div>
                    ))}
                    {(order.items || []).length > 2 && (
                      <div class="text-xs text-secondary/40">+{(order.items || []).length - 2} more</div>
                    )}
                  </div>
                </td>

                <!-- Status -->
                <td class="px-5 py-4">
                  <select
                    aria-label="Order status"
                    class="order-status-select w-full text-xs border border-gray-200 rounded-lg px-2 py-1.5 focus:border-primary focus:ring-1 focus:ring-primary outline-none font-semibold transition-colors"
                    data-order-id={order.orderId}
                    style={`background-color: transparent`}
                  >
                    <option value="pending"   selected={['pending','placed'].includes(order.status)}>Pending</option>
                    <option value="confirmed" selected={['confirmed','processing'].includes(order.status)}>Confirmed</option>
                    <option value="shipped"   selected={['shipped','dispatched'].includes(order.status)}>Shipped</option>
                    <option value="delivered" selected={order.status === 'delivered'}>Delivered</option>
                    <option value="cancelled" selected={['cancelled','returned'].includes(order.status)}>Cancelled</option>
                  </select>
                  <span class={`inline-block mt-1.5 text-[10px] font-bold px-2 py-0.5 rounded-full ${statusColors[order.status] || 'bg-gray-100 text-gray-600'}`}>
                    {order.status}
                  </span>
                </td>

                <!-- AWB / Dispatch Details -->
                <td class="px-3 py-3" style="min-width:220px">
                  <!-- AWB Number -->
                  <input
                    aria-label="AWB / Docket Number"
                    type="text"
                    class="awb-input w-full text-xs border border-gray-200 rounded-lg px-2 py-1.5 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors mb-1.5"
                    placeholder="AWB / Docket No."
                    value={order.awb || ''}
                    data-order-id={order.orderId}
                  />
                  <!-- Courier Name -->
                  <select
                    aria-label="Courier Partner"
                    class="courier-select w-full text-xs border border-gray-200 rounded-lg px-2 py-1.5 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors mb-1.5 bg-white"
                    data-order-id={order.orderId}
                  >
                    <option value="" disabled selected={!order.courierPartner}>Select Courier</option>
                    {['Delhivery','Bluedart','Ekart','DTDC','India Post','Xpressbees','Shadowfax','iCarry Partner','Local Courier','Other'].map(c => (
                      <option value={c} selected={order.courierPartner === c}>{c}</option>
                    ))}
                  </select>
                  <!-- Routing Code -->
                  <input
                    aria-label="Routing Code"
                    type="text"
                    class="routing-input w-full text-xs border border-gray-200 rounded-lg px-2 py-1.5 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors mb-1.5"
                    placeholder="Routing Code (e.g. LKO/DEL)"
                    value={order.routingCode || ''}
                    data-order-id={order.orderId}
                  />
                  <!-- Weight & Dimensions in one row -->
                  <div class="flex gap-1.5 mb-1.5">
                    <input
                      aria-label="Package Weight"
                      type="text"
                      class="weight-input w-1/2 text-xs border border-gray-200 rounded-lg px-2 py-1.5 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors"
                      placeholder="Weight (KG)"
                      value={order.packageWeight || '0.50 KG'}
                      data-order-id={order.orderId}
                    />
                    <input
                      aria-label="Package Dimensions"
                      type="text"
                      class="dimensions-input w-1/2 text-xs border border-gray-200 rounded-lg px-2 py-1.5 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors"
                      placeholder="Dimensions (CM)"
                      value={order.packageDimensions || '13*13*13 CM'}
                      data-order-id={order.orderId}
                    />
                  </div>

                  <!-- Rider Assignment (Q-Commerce) -->
                  <div class="flex gap-1.5 mb-1.5">
                    <select
                      aria-label="Assign Rider"
                      class="rider-select w-full text-xs border border-purple-200 bg-purple-50 rounded-lg px-2 py-1.5 focus:border-purple-500 focus:ring-1 focus:ring-purple-500 outline-none transition-colors"
                      data-order-id={order.orderId}
                    >
                      <option value="" selected={!order.rider_id}>No Rider Assigned</option>
                      {activeRiders.map(r => (
                        <option value={r.id} selected={order.rider_id === r.id}>
                          {r.is_online ? '🟢' : '⚪'} {r.name} ({r.vehicle_type})
                        </option>
                      ))}
                    </select>
                  </div>

                  <!-- Action Buttons -->
                  <div class="flex items-center gap-2">
                    <button
                      class="save-awb-btn flex-1 text-[10px] font-semibold text-white bg-primary rounded-lg px-2 py-1.5 hover:bg-primary/80 transition-colors"
                      data-order-id={order.orderId}
                    >
                      💾 Save & Ship
                    </button>
                    <button
                      class="generate-awb-btn text-[10px] font-semibold text-blue-600 hover:text-blue-800 flex items-center gap-0.5 shrink-0"
                      data-order-id={order.orderId}
                      title="Auto-generate via iCarry API (requires API key in Settings)"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                      Auto
                    </button>
                  </div>
                </td>

                <!-- Actions -->
                <td class="px-5 py-4">
                  <div class="flex flex-col gap-2">
                    <!-- View Order Details -->
                    <button
                      class="view-order-btn w-full flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-secondary/10 text-secondary rounded-lg hover:bg-secondary hover:text-white transition-colors"
                      data-order={encodeURIComponent(JSON.stringify(order))}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                      View Details
                    </button>
                    <!-- Invoice -->
                    <a
                      href={`/admin/invoice/${order.orderId}`}
                      target="_blank"
                      class="w-full flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-primary/10 text-primary rounded-lg hover:bg-primary hover:text-white transition-colors"
                    >
                      <svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2' style='display:inline;vertical-align:middle'><path stroke-linecap='round' stroke-linejoin='round' d='M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z' /></svg> Print Invoice
                    </a>
                    {['manual_whatsapp', 'b2b_pos', 'quotation'].includes(order.customer?.source) && (
                      <a
                        href={`/admin/bulk-bill?edit=${order.orderId}`}
                        class="w-full flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-amber-100 text-amber-700 rounded-lg hover:bg-amber-200 transition-colors"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg> Edit
                      </a>
                      <button
                        class="delete-order-btn w-full flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition-colors"
                        data-order-id={order.orderId}
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg> Delete
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  {totalPages > 1 && (
    <div class="flex items-center justify-between border-t border-gray-100 bg-white px-4 py-3 sm:px-6 rounded-2xl shadow-sm mb-6">
      <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
        <div>
          <p class="text-sm text-gray-700">
            Showing <span class="font-medium">{Math.min(1 + (page - 1) * limit, totalOrdersCount)}</span> to <span class="font-medium">{Math.min(page * limit, totalOrdersCount)}</span> of <span class="font-medium">{totalOrdersCount}</span> orders
          </p>
        </div>
        <div>
          <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
            <a href={`?page=${Math.max(1, page - 1)}`} class={`relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 ${1 >= page ? 'pointer-events-none opacity-50' : ''}`}>
              <span class="sr-only">Previous</span>
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
            </a>
            {Array.from({ length: totalPages }, (_, i) => i + 1).map((num) => {
              if (num === 1 || num === totalPages || (num >= page - 2 && page + 2 >= num)) {
                return (
                  <a href={`?page=${num}`} class={`relative inline-flex items-center px-4 py-2 text-sm font-semibold ${num === page ? 'z-10 bg-indigo-600 text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600' : 'text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0'}`}>
                    {num}
                  </a>
                );
              } else if (num === page - 3 || num === page + 3) {
                return <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 focus:outline-offset-0">...</span>;
              }
              return null;
            })}
            <a href={`?page=${Math.min(totalPages, page + 1)}`} class={`relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 ${page >= totalPages ? 'pointer-events-none opacity-50' : ''}`}>
              <span class="sr-only">Next</span>
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
            </a>
          </nav>
        </div>
      </div>
    </div>
  )}


<!-- == ORDER DETAIL MODAL == -->
<div id="order-detail-modal" class="fixed inset-0 bg-secondary/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-xl max-h-[90vh] flex flex-col">
    <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 shrink-0">
      <h2 class="text-lg font-bold text-secondary" id="modal-order-title">Order Details</h2>
      <button id="close-order-modal" class="text-secondary/50 hover:text-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div id="modal-order-body" class="p-6 overflow-y-auto flex-1 space-y-5 text-sm">
      <!-- Filled by JS -->
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
  // == Status Update ==
  document.querySelectorAll('.order-status-select').forEach(select => {
    select.addEventListener('change', async (e) => {
      const target = e.target;
      const orderId = target.dataset.orderId;
      const newStatus = target.value;
      target.style.background = '#fef08a';
      try {
        const res = await fetch('/api/admin/update-order-status', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderId, status: newStatus })
        });
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || 'Unknown API error');
        }
        target.style.background = '#bbf7d0';
        // Update the status badge in same row
        const row = target.closest('tr');
        const badge = row?.querySelector('[class*="rounded-full"]');
        if (badge) badge.textContent = newStatus;
        setTimeout(() => { target.style.background = ''; }, 1000);
      } catch (err) {
        target.style.background = '#fecdd3';
        setTimeout(() => { target.style.background = ''; }, 1000);
        alert('Error: ' + err.message);
      }
    });
  });

  // == Save AWB (with all dispatch fields) ==
  document.querySelectorAll('.save-awb-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
      const row = this.closest('tr');
      const orderId   = this.dataset.orderId;
      const awb       = row?.querySelector('.awb-input')?.value.trim();
      const courier   = row?.querySelector('.courier-select')?.value.trim();
      const routing   = row?.querySelector('.routing-input')?.value.trim();
      const weight    = row?.querySelector('.weight-input')?.value.trim();
      const dims      = row?.querySelector('.dimensions-input')?.value.trim();
      const riderId   = row?.querySelector('.rider-select')?.value.trim();

      if (!awb && !riderId) { alert('Please enter an AWB number or Assign a Rider.'); return; }
      if (!courier && !riderId){ alert('Please select a Courier Partner or Assign a Rider.'); return; }

      const originalHTML = this.innerHTML;
      this.textContent = 'Saving...';
      this.disabled = true;

      try {
        const res = await fetch('/api/admin/update-order-awb', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            orderId,
            awb:                awb || null,
            courier_partner:    courier || null,
