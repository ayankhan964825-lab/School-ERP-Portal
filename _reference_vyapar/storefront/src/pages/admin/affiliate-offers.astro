---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
const ctx = getPermissionContext(Astro.cookies);

if (!canManageSection(ctx, "affiliate_offers")) {
  return new Response("Forbidden", { status: 403 });
}

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAffiliateOffers } from '../../lib/database';

const offers = await getAffiliateOffers();
---

<AdminLayout title="Affiliate Offers | Admin Panel" description="Manage affiliate campaigns.">
  <div class="max-w-5xl">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-serif font-bold text-secondary">Affiliate Offers</h1>
        <p class="text-sm text-secondary/60 mt-1">Create campaigns that influencers can join.</p>
      </div>
      <button id="toggle-form-btn" class="btn-primary text-sm">+ New Offer</button>
    </div>

    <!-- Create Offer Form -->
    <div id="offer-form" class="hidden mb-6">
      <form id="affiliate-offer-form" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <h3 id="form-title" class="font-bold text-secondary mb-4">Create New Offer</h3>
        <input type="hidden" name="id" id="offer_id_input" />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div>
            <label class="block text-xs font-medium text-secondary mb-1">Offer Title</label>
            <input type="text" name="title" required placeholder="e.g. Diwali Dhamaka" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-medium text-secondary mb-1">Description</label>
            <input type="text" name="description" placeholder="Short details for influencers" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-medium text-secondary mb-1">Affiliate Commission (%)</label>
            <input type="number" name="commission_percentage" required min="1" max="100" placeholder="e.g. 10" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-medium text-secondary mb-1">Customer Discount (%)</label>
            <input type="number" name="customer_discount_percentage" required min="1" max="100" placeholder="e.g. 15" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" />
          </div>
          <div class="flex items-center pt-6">
            <label class="flex items-center gap-2 text-sm text-secondary cursor-pointer">
              <input type="checkbox" name="is_active" id="is_active_input" checked class="rounded border-gray-300 text-primary focus:ring-primary transition-colors" />
              Active
            </label>
          </div>
        </div>
        <div class="flex gap-3">
          <button type="submit" class="btn-primary text-sm" id="submit-btn">Save Offer</button>
          <button type="button" id="cancel-form-btn" class="text-sm text-secondary/70 hover:text-secondary">Cancel</button>
        </div>
      </form>
    </div>

    <!-- Offers Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      {offers.length === 0 ? (
        <div class="p-12 text-center text-secondary/60">
          <p class="mb-2">No offers created yet.</p>
          <p class="text-xs">Click "+ New Offer" to create your first affiliate campaign.</p>
        </div>
      ) : (
        <div class="overflow-x-auto w-full">
          <table class="min-w-full text-sm text-left">
            <thead class="text-xs text-secondary/70 uppercase bg-gray-50 border-b border-gray-100">
              <tr>
                <th class="px-5 py-3">Title</th>
                <th class="px-5 py-3">Commission (Affiliate)</th>
                <th class="px-5 py-3">Discount (Customer)</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              {offers.map((o: any) => (
                <tr class="border-b border-gray-50 hover:bg-gray-50/50 transition-colors">
                  <td class="px-5 py-4 font-medium text-secondary">{o.title}</td>
                  <td class="px-5 py-4 text-green-700 font-bold">{o.commission_percentage}%</td>
                  <td class="px-5 py-4 text-blue-700 font-bold">{o.customer_discount_percentage}%</td>
                  <td class="px-5 py-4">
                    <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${o.is_active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
                      {o.is_active ? 'Active' : 'Inactive'}
                    </span>
                  </td>
                  <td class="px-5 py-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <button type="button" class="edit-offer-btn text-xs font-medium px-3 py-1 rounded bg-violet-100 text-violet-700 hover:bg-violet-200 transition-colors" data-offer={JSON.stringify(o)}>Edit</button>
                      <button type="button" class="delete-offer-btn text-red-600 hover:bg-red-50 p-1.5 rounded transition-colors" data-id={o.id}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

<script data-astro-rerun>
  const formWrapper = document.getElementById('offer-form');
  const form = document.getElementById('affiliate-offer-form');
  const formTitle = document.getElementById('form-title');
  const idInput = document.getElementById('offer_id_input');

  document.getElementById('toggle-form-btn').addEventListener('click', () => {
    formWrapper.classList.toggle('hidden');
    if (!formWrapper.classList.contains('hidden')) {
      form.reset();
      idInput.value = '';
      formTitle.textContent = 'Create New Offer';
      document.getElementById('is_active_input').checked = true;
    }
  });

  document.getElementById('cancel-form-btn').addEventListener('click', () => {
    formWrapper.classList.add('hidden');
    form.reset();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submit-btn');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    data.is_active = (document.getElementById('is_active_input')).checked;

    const method = data.id ? 'PUT' : 'POST';

    try {
      const res = await fetch('/api/admin/affiliate-offers', {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (res.ok) {
        window.location.reload();
      } else {
        alert('Failed to save offer');
        btn.disabled = false;
        btn.textContent = 'Save Offer';
      }
    } catch (err) {
      alert('Network error');
      btn.disabled = false;
      btn.textContent = 'Save Offer';
    }
  });

  document.querySelectorAll('.edit-offer-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const offerStr = (e.currentTarget).dataset.offer;
      if (!offerStr) return;
      const o = JSON.parse(offerStr);
      
      formWrapper.classList.remove('hidden');
      formTitle.textContent = 'Edit Offer';
      idInput.value = o.id;
      
      (form.elements.namedItem('title')).value = o.title || '';
      (form.elements.namedItem('description')).value = o.description || '';
      (form.elements.namedItem('commission_percentage')).value = o.commission_percentage || '';
      (form.elements.namedItem('customer_discount_percentage')).value = o.customer_discount_percentage || '';
      (document.getElementById('is_active_input')).checked = !!o.is_active;
      
      formWrapper.scrollIntoView({ behavior: 'smooth' });
    });
  });

  document.querySelectorAll('.delete-offer-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const id = (e.currentTarget).dataset.id;
      if (!confirm('Are you sure you want to delete this offer?')) return;
      
      try {
        const res = await fetch('/api/admin/affiliate-offers', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id })
        });
        if (res.ok) window.location.reload();
        else alert('Failed to delete offer.');
      } catch (err) { alert('Network error'); }
    });
  });
</script>
</AdminLayout>
