---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
import { getProducts, getSettings, getCoupons, getActiveMilestone, supabaseAdmin, isSupabase } from '../../lib/database';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageAiPanel from '../../components/admin/PageAiPanel.astro';
import ManagePricesModal from '../../components/admin/ManagePricesModal.astro';

const ctx = getPermissionContext(Astro.cookies);
if (!canManageSection(ctx, "orders_pos")) {
  return new Response("Forbidden", { status: 403 });
}

const products = await getProducts(Astro.locals?.storeId);
const settings = await getSettings(Astro.locals?.storeId);
const coupons = await getCoupons();
const milestoneOffer = await getActiveMilestone();

// Filter only active/inStock products
const activeProducts = products.filter((p: any) => p.inStock !== false && !p.outOfStock);

const productsJson = JSON.stringify(activeProducts.map((p: any) => ({
  id: p.id,
  name: p.name,
  price: p.price,
  originalPrice: p.originalPrice,
  hsn_code: p.hsn_code || settings.default_hsn_code || '0813',
  gst_rate: p.gst_rate || settings.default_gst_rate || 12,
  image: p.images?.[0] || '',
  hasVariants: p.hasVariants || (p.variants && p.variants.length > 0),
  variants: p.variants || [],
  specifications: p.specifications || {}
})));

const settingsJson = JSON.stringify({
  free_shipping_threshold: settings.free_shipping_threshold || 499,
  flat_shipping_rate: settings.flat_shipping_rate || 60,
  prepaid_discount_enabled: settings.prepaid_discount_enabled,
  prepaid_discount_value: settings.prepaid_discount_value,
  prepaid_discount_type: settings.prepaid_discount_type,
  prepaid_discount_min_order: settings.prepaid_discount_min_order,
  allow_coupon_stacking: settings.allow_coupon_stacking,
  pos_upi_id: settings.pos_upi_id || ''
});

const couponsJson = JSON.stringify(coupons || []);
const milestoneJson = JSON.stringify(milestoneOffer || {});

let locations: any[] = [];
if (isSupabase && supabaseAdmin && Astro.locals?.storeId) {
  const { data } = await supabaseAdmin
    .from('locations')
    .select('id, name, is_default')
    .eq('store_id', Astro.locals.storeId)
    .eq('is_active', true)
    .order('created_at', { ascending: false });
  if (data) locations = data;
}
const locationsJson = JSON.stringify(locations);
---

<AdminLayout title={`Manual Bill Generator | ${settings?.brand_name || 'Store'} Admin`}>
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <div class="h-10 w-10 bg-primary/10 rounded-xl flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <h1 class="text-2xl font-serif font-bold text-secondary">Store POS Billing</h1>
      </div>
      <p class="text-sm text-secondary/55 ml-[52px]">Quickly generate bills for walk-in store customers</p>
    </div>
    <div class="flex items-center gap-3">
      <button type="button" id="btn-manage-prices" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-secondary text-sm font-semibold rounded-xl transition-colors border border-gray-200 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Manage Prices
      </button>
    </div>
  </div>

  <PageAiPanel 
    page="manual-bill"
    title="Manual Billing Assistant"
    pageDataJson={JSON.stringify({})}
    guideTitleEn="Manual Billing Guide"
    guideTitleHi="Manual Billing Guide"
    guideHtml={`<ul class="space-y-2">
      <li><strong>Customer:</strong> Enter phone number to send digital receipts or SMS updates.</li>
      <li><strong>Products:</strong> Search and add products by scanning or typing.</li>
      <li><strong>Discount:</strong> Apply store-level coupons or manual discounts.</li>
      <li><strong>Print:</strong> Thermal receipts are generated instantly for physical stores.</li>
    </ul>`}
    guideHtmlHi={`<ul class="space-y-2">
      <li><strong>Customer:</strong> Customer ka phone number dalein (optional).</li>
      <li><strong>Products:</strong> Search karke jaldi products add karein.</li>
      <li><strong>Discount:</strong> Store offers ya manual discount dein.</li>
      <li><strong>Print:</strong> Turant thermal print receipt nikal jayegi.</li>
    </ul>`}
    quickActions={[]}
  />

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-32">
    <!-- Left Column: Customer & Products -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- Customer Details Form -->
