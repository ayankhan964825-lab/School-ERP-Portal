        </div>
      </div>

      <!-- Product Selection -->
      <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-secondary flex items-center gap-2">
