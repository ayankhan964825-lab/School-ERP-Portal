          <div class="grid grid-cols-3 gap-2" id="payment-methods-container">
            <label class="border border-gray-200 rounded-xl p-3 flex items-center justify-center gap-2 cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-colors">
              <input type="radio" name="payment" value="Cash" checked class="hidden payment-radio" />
              <span class="font-bold text-secondary text-sm">Cash</span>
            </label>
            <label class="border border-gray-200 rounded-xl p-3 flex items-center justify-center gap-2 cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-colors">
              <input type="radio" name="payment" value="UPI" class="hidden payment-radio" />
              <span class="font-bold text-secondary text-sm">UPI</span>
            </label>
            <label class="border border-gray-200 rounded-xl p-3 flex items-center justify-center gap-2 cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-colors">
              <input type="radio" name="payment" value="Card" class="hidden payment-radio" />
              <span class="font-bold text-secondary text-sm">Card</span>
            </label>
          </div>
        </div>

        <!-- Payment Status -->
        <div class="mb-6">
          <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">Initial Payment Status</label>
          <select id="payment-status" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary outline-none bg-gray-50/50">
            <option value="paid" selected>Paid (Received)</option>
            <option value="pending">Pending (Unpaid)</option>
          </select>
        </div>

        <!-- QR Mode (Only visible in POS Mode) -->
        <div class="mb-4 hidden" id="qr-mode-container">
          <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">UPI Collection Mode</label>
          <div class="grid grid-cols-2 gap-2">
            <label class="border border-gray-200 rounded-xl p-3 flex items-center justify-center gap-2 cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-colors">
              <input type="radio" name="qr_mode" value="static" checked class="hidden" />
              <div class="text-center">
                <span class="block font-bold text-secondary text-sm">Static QR</span>
                <span class="block text-[10px] text-secondary/60">0% Fee • Manual Verify</span>
              </div>
            </label>
            <label class="border border-gray-200 rounded-xl p-3 flex items-center justify-center gap-2 cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-colors">
              <input type="radio" name="qr_mode" value="dynamic" class="hidden" />
              <div class="text-center">
                <span class="block font-bold text-secondary text-sm">Dynamic API</span>
                <span class="block text-[10px] text-secondary/60">Gateway Fee • Auto-Verify</span>
              </div>
            </label>
          </div>
        </div>

        <button id="btn-submit-order" class="w-full py-3.5 bg-primary hover:bg-primary/90 text-white font-bold rounded-xl shadow-[0_4px_14px_0_rgba(139,90,43,0.39)] hover:shadow-[0_6px_20px_rgba(139,90,43,0.23)] hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
          <span>Generate Bill</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
        </button>

      </div>
    </div>
  </div>

  <!-- POS Success Modal -->
  <div id="pos-success-modal" class="hidden fixed inset-0 z-[100] bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-sm overflow-hidden animate-in fade-in zoom-in duration-300">
      <div class="bg-primary/10 p-6 text-center border-b border-primary/10">
        <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center mx-auto mb-3 shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-secondary">Bill Generated</h2>
        <p class="text-secondary/60 text-sm mt-1 font-mono" id="modal-order-id">#...</p>
      </div>
      
      <div class="p-6 text-center">
        <p class="text-sm font-semibold text-secondary/60 uppercase tracking-wider mb-1">Total Amount</p>
        <div class="text-4xl font-black text-secondary mb-6" id="modal-amount">₹0</div>

        <div id="qr-container" class="mb-6 hidden">
          <p class="text-xs font-semibold text-secondary/60 uppercase tracking-wider mb-2">Scan to Pay via UPI</p>
          <img id="upi-qr-image" src="" alt="UPI QR Code" class="w-48 h-48 mx-auto border-2 border-gray-100 rounded-xl p-2 bg-white" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <button id="btn-modal-print" class="py-3 px-2 bg-primary text-white font-bold rounded-xl shadow-lg shadow-primary/30 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-1.5 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
            Print Thermal
          </button>
          <button id="btn-modal-print-a4" class="py-3 px-2 bg-secondary text-white font-bold rounded-xl shadow-lg shadow-secondary/30 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-1.5 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            Print A4
          </button>
          <button id="btn-modal-new" class="col-span-2 py-3 px-4 bg-gray-100 text-secondary font-bold rounded-xl hover:bg-gray-200 transition-colors">
            Start New Bill
          </button>
        </div>
      </div>
    </div>
  </div>

</AdminLayout>

<ManagePricesModal />

<div id="page-data" 
  data-products={productsJson} 
  data-settings={settingsJson}
  data-coupons={couponsJson}
  data-milestone={milestoneJson}
  data-locations={locationsJson}
  class="hidden"></div>

<script data-astro-rerun>
  // Setup data
  const products = JSON.parse(document.getElementById('page-data').dataset.products);
  const settings = JSON.parse(document.getElementById('page-data').dataset.settings);
  const couponsList = JSON.parse(document.getElementById('page-data').dataset.coupons);
  const milestoneOffer = JSON.parse(document.getElementById('page-data').dataset.milestone);
  const locationsList = JSON.parse(document.getElementById('page-data').dataset.locations || '[]');
  
  let cart = []; // Array of items: { pid, vIndex, name, variantName, price, qty, hsn_code, gst_rate }
  let appliedCoupons = [];
  let computedTotalDiscount = 0;

  // DOM Elements
  const pSearch = document.getElementById('product-search');
  const pDropdown = document.getElementById('product-dropdown');
  const btnAdd = document.getElementById('btn-add-product');
  const tbody = document.getElementById('cart-tbody');
  const emptyRow = document.getElementById('empty-cart-row');
  
  const sumSubtotal = document.getElementById('summary-subtotal');
  const sumShipping = document.getElementById('summary-shipping');
  const shipLabel = document.getElementById('shipping-label');
  const inputDiscount = document.getElementById('input-discount');
  const sumTotal = document.getElementById('summary-total');
  
  const inputCoupon = document.getElementById('input-coupon');
  const btnApplyCoupon = document.getElementById('btn-apply-coupon');
  const couponMessage = document.getElementById('coupon-message');
  const couponHint = document.getElementById('coupon-hint');
  const custPhone = document.getElementById('cust-phone');
  
  const rowCoupon = document.getElementById('row-coupon');
  const sumCoupon = document.getElementById('summary-coupon');
  
  const rowMilestone = document.getElementById('row-milestone');
  const sumMilestone = document.getElementById('summary-milestone');
  
  const paymentRadios = document.querySelectorAll('input[name="payment"]');
  const paymentMethodsContainer = document.getElementById('payment-methods-container');

  // Custom Dropdown Logic
  function renderDropdown(filterText = '') {
    pDropdown.innerHTML = '';
    const term = filterText.toLowerCase().trim();
    
    let displayItems = [];
    products.forEach(p => {
       const pNameMatches = p.name.toLowerCase().includes(term);
       
       if (p.hasVariants && p.variants && p.variants.length > 0) {
          p.variants.forEach((v, vIdx) => {
             const variantName = v.weight || v.name || 'Default';
             const fullName = `${p.name} - ${variantName}`;
             if (pNameMatches || fullName.toLowerCase().includes(term)) {
                displayItems.push({
                   type: 'variant',
                   product: p,
                   vIndex: vIdx,
                   displayName: fullName,
                   price: v.price || p.price
                });
             }
          });
       } else {
          if (pNameMatches) {
             displayItems.push({
                type: 'product',
                product: p,
                vIndex: 0,
                displayName: p.name,
                price: p.price
             });
          }
       }
    });
    
    if (displayItems.length === 0) {
      pDropdown.innerHTML = '<div class="px-4 py-3 text-sm text-gray-500 text-center">No products found</div>';
      pDropdown.classList.remove('hidden');
      return;
    }

    // Limit to top 50 to prevent freezing
    const displayMatches = displayItems.slice(0, 50);

    displayMatches.forEach(item => {
      const div = document.createElement('div');
      div.className = 'px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm text-secondary border-b border-gray-100 last:border-0 flex justify-between items-center';
      div.innerHTML = `
        <span class="font-medium">${item.displayName}</span>
        <span class="text-primary font-semibold text-xs">₹${item.price}</span>
      `;
      div.addEventListener('click', () => {
        pSearch.value = '';
        pDropdown.classList.add('hidden');
        addToCart(item.product, item.vIndex);
      });
      pDropdown.appendChild(div);
    });
    pDropdown.classList.remove('hidden');
  }

  pSearch.addEventListener('focus', () => renderDropdown(pSearch.value));
  pSearch.addEventListener('input', (e) => renderDropdown(e.target.value));

  // Hide dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (!pSearch.contains(e.target) && !pDropdown.contains(e.target)) {
      pDropdown.classList.add('hidden');
    }
  });
  
  function attachPaymentRadioListeners() {
    document.querySelectorAll('.payment-radio').forEach(radio => {
      radio.addEventListener('change', (e) => {
        const val = e.target.value;
        const statusDropdown = document.getElementById('payment-status');
        if (statusDropdown) {
          if (val === 'Cash' || val === 'UPI' || val === 'Card' || val === 'Prepaid') {
            statusDropdown.value = 'paid';
          } else {
            statusDropdown.value = 'pending';
          }
        }
        updateTotals();
      });
    });
  }
  attachPaymentRadioListeners();

  // LocalStorage Preferences Restoring
  const savedQrMode = localStorage.getItem('pos_qr_mode');
  if (savedQrMode) {
    const el = document.querySelector(`input[name="qr_mode"][value="${savedQrMode}"]`);
    if (el) el.checked = true;
  }
  document.querySelectorAll('input[name="qr_mode"]').forEach(r => {
    r.addEventListener('change', (e) => localStorage.setItem('pos_qr_mode', e.target.value));
  });

  // Coupon enable/disable based on Phone Number
  custPhone.addEventListener('input', () => {
