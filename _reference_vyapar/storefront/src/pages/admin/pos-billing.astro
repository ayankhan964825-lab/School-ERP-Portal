      inputCoupon.disabled = false;
      btnApplyCoupon.disabled = false;
      couponHint.classList.add('hidden');
    } else {
      inputCoupon.disabled = true;
      btnApplyCoupon.disabled = true;
      couponHint.classList.remove('hidden');
      
      // If phone is removed, also remove the applied coupon
      if (appliedCoupons.length > 0) {
        appliedCoupons = [];
        couponMessage.textContent = '';
        couponMessage.className = 'hidden';
        inputCoupon.value = '';
        updateTotals();
      }
    }
  });

  // Default setup
  document.getElementById('qr-mode-container').classList.remove('hidden');
  attachPaymentRadioListeners();
  updateTotals();

  // Apply Coupon button
  btnApplyCoupon.addEventListener('click', () => {
    const code = inputCoupon.value.trim().toUpperCase();
    if (!code) {
      appliedCoupons = [];
      couponMessage.textContent = 'Coupon removed.';
      couponMessage.className = 'text-[10px] mt-0 text-red-500 block';
      inputCoupon.value = '';
      updateTotals();
      return;
    }
    
    // Find coupon in DB
    const found = couponsList.find(c => c.code.toUpperCase() === code && c.is_active !== false);
    if (!found) {
      couponMessage.textContent = 'Invalid or expired coupon code.';
      couponMessage.className = 'text-[10px] mt-0 text-red-500 block';
      return;
    }
    
    // Check minimum order amount requirement (lazy check now, exact check in updateTotals)
    appliedCoupons = [found]; // Admin can override and type only one at a time via input
    couponMessage.textContent = 'Coupon applied successfully!';
    couponMessage.className = 'text-[10px] mt-0 text-emerald-600 block';
    updateTotals();
  });

  // Calculate Totals
  function updateTotals() {
    let subtotal = 0;
    cart.forEach(item => {
      subtotal += item.price * item.qty;
    });

    const manualDiscount = parseInt(inputDiscount.value || '0', 10) || 0;
    
    const toggleDeals = document.getElementById('toggle-deals');
    const applyDeals = toggleDeals ? toggleDeals.checked : true;
    
    // Milestone Discount
    let milestoneAmount = 0;
    let activeTierDiscount = 0;
    if (applyDeals && milestoneOffer && milestoneOffer.tiers && milestoneOffer.tiers.length > 0) {
      // Ensure tiers are sorted ascending by target
      const sortedTiers = [...milestoneOffer.tiers].sort((a, b) => a.target - b.target);
      for (let i = sortedTiers.length - 1; i >= 0; i--) {
        if (subtotal >= sortedTiers[i].target) {
          activeTierDiscount = sortedTiers[i].discount;
          break;
        }
      }
    }
    if (activeTierDiscount > 0) {
      milestoneAmount = Math.floor(subtotal * (activeTierDiscount / 100));
    }
    
    // Coupon Discount
    let couponAmount = 0;
    let validCoupons = [];
    appliedCoupons.forEach(coupon => {
      if (subtotal >= (coupon.min_order_amount || 0)) {
        validCoupons.push(coupon);
        if (coupon.discount_type === 'percentage') {
          let d = Math.floor(subtotal * (coupon.discount_value / 100));
          if (coupon.max_discount_amount) d = Math.min(d, coupon.max_discount_amount);
          couponAmount += d;
        } else {
          couponAmount += coupon.discount_value;
        }
      } else {
        couponMessage.textContent = `Requires min order of ₹${coupon.min_order_amount}`;
        couponMessage.className = 'text-[10px] mt-0 text-red-500 block';
      }
    });
    appliedCoupons = validCoupons;
    
    const allowStacking = settings.allow_coupon_stacking === true || settings.allow_coupon_stacking === 'true';
    let systemDiscount = 0;
    
    if (allowStacking) {
      systemDiscount = couponAmount + milestoneAmount;
    } else {
      systemDiscount = Math.max(couponAmount, milestoneAmount);
      
      // Update UI to show which discount was applied if not stacking
      if (couponAmount > milestoneAmount) {
        rowMilestone.classList.add('hidden');
        if (rowCoupon) rowCoupon.classList.remove('hidden');
      } else if (milestoneAmount > couponAmount) {
        rowCoupon.classList.add('hidden');
        if (rowMilestone) rowMilestone.classList.remove('hidden');
      }
    }
    
    let totalDiscount = systemDiscount + manualDiscount;
    computedTotalDiscount = totalDiscount;

    let grandTotal = subtotal + 0 - totalDiscount;
    if (grandTotal < 0) grandTotal = 0;

    let shipping = 0;
    shipLabel.textContent = 'POS FREE';
    shipLabel.classList.remove('hidden');

    sumSubtotal.textContent = subtotal.toLocaleString('en-IN');
    sumShipping.textContent = shipping > 0 ? `₹${shipping}` : '₹0';
    
    if (couponAmount > 0 && (allowStacking || couponAmount >= milestoneAmount)) {
      sumCoupon.textContent = `-₹${couponAmount.toLocaleString('en-IN')}`;
      rowCoupon.classList.remove('hidden');
    } else {
      rowCoupon.classList.add('hidden');
    }
    
    if (milestoneAmount > 0 && (!allowStacking ? milestoneAmount >= couponAmount : true)) {
      sumMilestone.textContent = `-₹${milestoneAmount.toLocaleString('en-IN')}`;
      rowMilestone.classList.remove('hidden');
    } else {
      rowMilestone.classList.add('hidden');
    }

    sumTotal.textContent = grandTotal > 0 ? grandTotal.toLocaleString('en-IN') : '0';
  }

  // Render Cart Table
  function renderCart() {
    if (cart.length === 0) {
      emptyRow.style.display = 'table-row';
      Array.from(tbody.children).forEach(c => { if(c !== emptyRow) c.remove(); });
      updateTotals();
      return;
    }
    emptyRow.style.display = 'none';
    
    // Clear old rows
    Array.from(tbody.children).forEach(c => { if(c !== emptyRow) c.remove(); });

    cart.forEach((item, index) => {
      const tr = document.createElement('tr');
      tr.className = 'group hover:bg-gray-50 transition-colors';
      
      // Select variants dropdown if applicable
      const p = products.find(prod => prod.id === item.pid);
      let variantHtml = `<span class="text-secondary/50 text-xs">N/A</span>`;
      if (p && p.hasVariants && p.variants.length > 0) {
        variantHtml = `<select class="variant-select text-xs border border-gray-200 rounded px-2 py-1 outline-none focus:border-primary" data-index="${index}">`;
        p.variants.forEach((v, vIdx) => {
          variantHtml += `<option value="${vIdx}" ${item.vIndex === vIdx ? 'selected' : ''}>${v.weight || v.name} - ₹${v.price}</option>`;
        });
        variantHtml += `</select>`;
      }

      tr.innerHTML = `
        <td class="px-4 py-3 font-semibold text-secondary">${item.name}</td>
        <td class="px-4 py-3">${variantHtml}</td>
        <td class="px-4 py-3 text-secondary/70">₹${item.price.toLocaleString('en-IN')}</td>
        <td class="px-4 py-3">
          <input type="number" min="0.01" step="0.01" value="${item.qty}" class="qty-input w-20 px-2 py-1 text-sm border border-gray-200 rounded outline-none focus:border-primary text-center" data-index="${index}" />
        </td>
        <td class="px-4 py-3 text-right font-bold text-secondary">₹${(item.price * item.qty).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
        <td class="px-4 py-3 text-right">
          <button type="button" class="btn-remove text-red-500 hover:text-red-700 opacity-0 group-hover:opacity-100 transition-opacity" data-index="${index}">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    // Attach events
    document.querySelectorAll('.qty-input').forEach(el => {
      el.addEventListener('change', (e) => {
        const idx = parseInt(e.target.dataset.index);
        const val = parseFloat(e.target.value);
        if (val > 0) cart[idx].qty = val;
        renderCart();
      });
    });

    document.querySelectorAll('.variant-select').forEach(el => {
      el.addEventListener('change', (e) => {
        const idx = parseInt(e.target.dataset.index);
        const vIdx = parseInt(e.target.value);
        const item = cart[idx];
        const p = products.find(prod => prod.id === item.pid);
        if (p && p.variants[vIdx]) {
          item.vIndex = vIdx;
          item.variantName = p.variants[vIdx].weight || p.variants[vIdx].name;
          
          let finalPrice = p.variants[vIdx].price;
          const toggleDeals = document.getElementById('toggle-deals');
          const applyDeals = toggleDeals ? toggleDeals.checked : true;
          if (!applyDeals && p.variants[vIdx].pos_price) {
             finalPrice = parseFloat(p.variants[vIdx].pos_price);
          }
          item.price = finalPrice;
          
          renderCart();
        }
      });
    });

    document.querySelectorAll('.btn-remove').forEach(el => {
      el.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.dataset.index);
        cart.splice(idx, 1);
        renderCart();
      });
    });

    updateTotals();
  }

  function addToCart(p, vIndex = 0) {
    // Check if already in cart with exactly this variant index
    const existing = cart.find(item => item.pid === p.id && item.vIndex === vIndex);
    const toggleDeals = document.getElementById('toggle-deals');
    const applyDeals = toggleDeals ? toggleDeals.checked : true;
    const validVariants = p.variants && p.variants.length > 0;
    const isVariantProd = p.hasVariants && validVariants;

    let finalPrice = isVariantProd && p.variants[vIndex] ? (p.variants[vIndex].price || p.price) : p.price;
    if (!applyDeals) {
       if (isVariantProd && p.variants[vIndex] && p.variants[vIndex].pos_price) {
           finalPrice = parseFloat(p.variants[vIndex].pos_price);
       } else if (p.specifications && p.specifications._pos_price) {
           finalPrice = parseFloat(p.specifications._pos_price);
       }
    }

    if (existing) {
      existing.qty += 1;
    } else {
      cart.push({
        pid: p.id,
        vIndex: vIndex,
        name: p.name,
        variantName: isVariantProd && p.variants[vIndex] ? (p.variants[vIndex].weight || p.variants[vIndex].name || 'Default') : 'N/A',
        price: finalPrice,
        qty: 1,
        hsn_code: p.hsn_code,
        gst_rate: p.gst_rate
      });
    }
    
    pSearch.value = '';
    renderCart();
  }

  const toggleDeals = document.getElementById('toggle-deals');
  if (toggleDeals) {
    toggleDeals.addEventListener('change', () => {
       cart.forEach(item => {
          const p = products.find(prod => prod.id === item.pid);
          if (!p) return;
          const validVariants = p.variants && p.variants.length > 0;
          const isVariantProd = p.hasVariants && validVariants;
          
          let finalPrice = isVariantProd && p.variants[item.vIndex] ? (p.variants[item.vIndex].price || p.price) : p.price;
          
          if (!toggleDeals.checked) {
             if (isVariantProd && p.variants[item.vIndex] && p.variants[item.vIndex].pos_price) {
                 finalPrice = parseFloat(p.variants[item.vIndex].pos_price);
             } else if (p.specifications && p.specifications._pos_price) {
                 finalPrice = parseFloat(p.specifications._pos_price);
             }
          }
          item.price = finalPrice;
       });
       renderCart();
    });
  }

  // Add Product button
  btnAdd.addEventListener('click', () => {
    const searchVal = pSearch.value.trim();
    if (!searchVal) return;
    
    const searchValLower = searchVal.toLowerCase();
    
    let matchedItem = null;
    products.forEach(p => {
       if (p.hasVariants && p.variants && p.variants.length > 0) {
          p.variants.forEach((v, vIdx) => {
             const variantName = v.weight || v.name || 'Default';
             const fullName = `${p.name} - ${variantName}`.toLowerCase();
             if ((p.name.toLowerCase() === searchValLower || fullName.includes(searchValLower)) && !matchedItem) {
                matchedItem = { product: p, vIndex: vIdx };
             }
          });
       } else {
          if (p.name.toLowerCase().includes(searchValLower) && !matchedItem) {
             matchedItem = { product: p, vIndex: 0 };
          }
       }
    });

    if (!matchedItem) {
      alert("Product not found. Please select from the dropdown or check the spelling.");
      return;
    }

    addToCart(matchedItem.product, matchedItem.vIndex);
  });

  pSearch.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      btnAdd.click();
    }
  });

  inputDiscount.addEventListener('input', updateTotals);

  // Submit Order
  const btnSubmit = document.getElementById('btn-submit-order');
  btnSubmit.addEventListener('click', async () => {
    // Validate
    let requiredFields = ['cust-address', 'cust-city', 'cust-state', 'cust-pincode'];
    const qrModeEl = document.querySelector('input[name="qr_mode"]:checked');
    const qrMode = qrModeEl ? qrModeEl.value : 'static';

    requiredFields = []; // All optional in POS, including address
    if (qrMode === 'dynamic' && settings.razorpay_smart_collect_enabled !== true && settings.razorpay_smart_collect_enabled !== 'true') {
      requiredFields.push('cust-phone');
    }
    const allFields = ['cust-name', 'cust-phone', 'cust-address', 'cust-city', 'cust-state', 'cust-pincode', 'cust-email'];
    let valid = true;
    const custData = {};
    allFields.forEach(id => {
      const el = document.getElementById(id);
      if (!el) return; // Skip if field is not in DOM
      
      if (!el.value.trim() && requiredFields.includes(id)) {
        el.classList.add('ring-2', 'ring-red-400', 'border-red-400');
        valid = false;
      } else {
        el.classList.remove('ring-2', 'ring-red-400', 'border-red-400');
        custData[id.replace('cust-', '')] = el.value.trim();
      }
    });

    if (!valid) {
      if (qrMode === 'dynamic' && !custData['phone'] && settings.razorpay_smart_collect_enabled !== true && settings.razorpay_smart_collect_enabled !== 'true') {
        alert("Customer Phone Number is mandatory for Dynamic QR (Payment Links).\n\nTo skip this requirement in the future, please complete Razorpay KYC for 'Smart Collect / QR Codes API' and turn it ON in Admin Settings.");
      } else {
        alert("Please fill all required customer details.");
      }
      return;
    }

    if (cart.length === 0) {
      alert("Please add at least one product.");
      return;
    }

    btnSubmit.disabled = true;
    btnSubmit.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Generating...`;

    // Construct Payload
    const paymentMode = document.querySelector('input[name="payment"]:checked').value;
    const paymentStatus = document.getElementById('payment-status').value;

    const subtotal = parseFloat(sumSubtotal.textContent.replace(/,/g, '')) || 0;
    const shipping = parseFloat(sumShipping.textContent.replace(/[₹,]/g, '')) || 0;
    const grandTotal = parseFloat(sumTotal.textContent.replace(/,/g, '')) || 0;
    const discount = computedTotalDiscount || 0;

    const payload = {
      customer: custData,
      items: cart.map(c => ({
        product_id: c.pid,
        name: c.name,
        price: c.price,
        quantity: c.qty,
        variant_name: c.variantName || '',
        variant: c.variantName || '',
        hsn_code: c.hsn_code,
        gst_rate: c.gst_rate,
        location_id: (locationsList.length > 0) ? document.getElementById('pos-location').value : null
      })),
      subtotal,
      shipping,
      discount,
      grandTotal,
      couponCode: appliedCoupons.map(c => c.code).join(',') || null,
      paymentMethod: paymentMode,
      paymentStatus: paymentStatus,
      is_pos: true,
      notes: "Generated via Offline Store POS"
    };

    try {
      const res = await fetch('/api/admin/create-manual-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      
      if (res.ok) {
          // Show POS Modal
          cart = [];
          renderCart();
          document.getElementById('cust-name').value = '';
          document.getElementById('cust-phone').value = '';
          const modalAmountEl = document.getElementById('modal-amount');
          const qrContainer = document.getElementById('qr-container');
          const qrImage = document.getElementById('upi-qr-image');
          
          document.getElementById('pos-success-modal').classList.remove('hidden');
          document.getElementById('modal-order-id').textContent = '#' + data.orderId;
          modalAmountEl.textContent = '₹' + grandTotal;

          // Check QR Mode
          const qrModeEl = document.querySelector('input[name="qr_mode"]:checked');
          const qrMode = qrModeEl ? qrModeEl.value : 'static';

          if (qrMode === 'dynamic') {
            modalAmountEl.innerHTML = `₹${grandTotal} <br/><span class="text-xs text-amber-500 animate-pulse">Waiting for Payment...</span>`;
            
            // Fetch Dynamic Payment Link
            try {
              const payRes = await fetch('/api/admin/generate-pos-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId: data.orderId, amount: grandTotal, customerPhone: document.getElementById('cust-phone').value.trim() })
              });
              const payData = await payRes.json();
              
              if (payRes.ok && payData.paymentUrl) {
                if (payData.isImageUrl) {
                  qrImage.src = payData.paymentUrl;
                } else {
                  qrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(payData.paymentUrl)}`;
                }
                qrContainer.classList.remove('hidden');

                // Start Polling
                let maxPolls = 100; // 5 minutes max (3s interval)
                let pollInterval = setInterval(async () => {
                  if (document.hidden) return; // Smart polling: save Vercel Edge requests
                  
                  maxPolls--;
                  if (maxPolls <= 0) {
                    clearInterval(pollInterval);
                    modalAmountEl.innerHTML = `₹${grandTotal} <br/><span class="text-xs text-red-600 bg-red-100 px-2 py-1 rounded-full uppercase tracking-wider">QR Expired / Timeout</span>`;
                    return;
                  }

                  try {
                    const statusRes = await fetch(`/api/admin/check-pos-payment-status?order_id=${data.orderId}`);
                    const statusData = await statusRes.json();
                    
                    if (statusData.isPaid) {
                      clearInterval(pollInterval);
                      modalAmountEl.innerHTML = `₹${grandTotal} <br/><span class="text-xs text-green-600 bg-green-100 px-2 py-1 rounded-full uppercase tracking-wider">✔ Paid Successfully</span>`;
                      qrContainer.classList.add('hidden');
                      // Auto-trigger saved print preference
                      const savedPrintPref = localStorage.getItem('pos_print_pref') || 'thermal';
                      if (savedPrintPref === 'a4') {
                        document.getElementById('btn-modal-print-a4').click();
                      } else {
                        document.getElementById('btn-modal-print').click();
                      }
                    }
                  } catch (e) {
                    console.error("Polling error", e);
                  }
                }, 3000);
              } else {
                alert("Could not generate dynamic QR: " + (payData.error || 'Unknown error'));
              }
            } catch (e) {
              console.error("Dynamic QR error", e);
            }

          } else if (settings.pos_upi_id) {
            // Static QR
            const storeName = encodeURIComponent(settings.brand_name || settings.store_name || window.location.hostname || 'Store');
            const upiString = `upi://pay?pa=${settings.pos_upi_id}&pn=${storeName}&am=${grandTotal.toFixed(2)}&cu=INR`;
            qrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(upiString)}`;
            qrContainer.classList.remove('hidden');
          }

          // Attach Modal Listeners
          const orderDataForPrint = { orderId: data.orderId, subtotal, discount, shipping, grandTotal, items: cart };
          
          document.getElementById('btn-modal-print').onclick = () => {
            localStorage.setItem('pos_print_pref', 'thermal');
            printPosReceipt(orderDataForPrint);
          };
          document.getElementById('btn-modal-print-a4').onclick = () => {
            localStorage.setItem('pos_print_pref', 'a4');
            window.location.href = `/admin/invoice/${data.orderId}`;
          };
          document.getElementById('btn-modal-new').onclick = () => window.location.reload();
      } else {
        throw new Error(data.error || 'Failed to create order');
      }
    } catch (err) {
      alert("Error: " + err.message);
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = `<span>Generate Bill</span>...`;
    }
  });

  function printPosReceipt(orderData) {
    const iframe = document.createElement('iframe');
    iframe.style.display = 'none';
    document.body.appendChild(iframe);
    
    let itemsHtml = orderData.items.map(item => `
      <tr>
        <td style="padding: 4px 0; word-break: break-all;">${item.name}<br/><small style="color: #444;">${item.variantName !== 'N/A' ? item.variantName : ''}</small></td>
        <td style="padding: 4px 0; text-align: center;">${item.qty}</td>
        <td style="padding: 4px 0; text-align: right;">${item.price * item.qty}</td>
      </tr>
    `).join('');

    const html = `
      <html>
      <head>
        <title>Receipt</title>
        <style>
          @media print {
            @page { margin: 0; size: 80mm auto; }
            body { margin: 0; padding: 15px; width: 80mm; font-family: monospace; font-size: 13px; }
          }
          body { margin: 0 auto; padding: 15px; width: 80mm; font-family: monospace; font-size: 13px; }
          table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
          th { border-bottom: 1px dashed #000; padding-bottom: 4px; }
          .text-center { text-align: center; }
          .font-bold { font-weight: bold; }
          .border-bottom { border-bottom: 1px dashed #000; }
          .border-top { border-top: 1px dashed #000; }
        </style>
      </head>
      <body>
        <div class="text-center font-bold" style="font-size: 18px; margin-bottom: 5px;">TAX INVOICE</div>
        <div style="margin-bottom: 10px; border-bottom: 1px dashed #000; padding-bottom: 10px;">
          <div><strong>Order:</strong> #${orderData.orderId}</div>
          <div><strong>Date:</strong> ${new Date().toLocaleString()}</div>
        </div>
        <table>
          <thead>
            <tr>
              <th style="text-align: left;">Item</th>
              <th>Qty</th>
              <th style="text-align: right;">Amt</th>
            </tr>
          </thead>
          <tbody>${itemsHtml}</tbody>
        </table>
        <div class="border-top" style="padding-top: 8px;">
          <div style="display: flex; justify-content: space-between;">
            <span>Subtotal:</span><span>₹${orderData.subtotal}</span>
          </div>
          ${orderData.discount > 0 ? `<div style="display: flex; justify-content: space-between;"><span>Discount:</span><span>-₹${orderData.discount}</span></div>` : ''}
          ${orderData.shipping > 0 ? `<div style="display: flex; justify-content: space-between;"><span>Shipping:</span><span>+₹${orderData.shipping}</span></div>` : ''}
          <div class="font-bold border-top" style="display: flex; justify-content: space-between; margin-top: 5px; padding-top: 5px; font-size: 16px;">
            <span>TOTAL:</span><span>₹${orderData.grandTotal}</span>
          </div>
        </div>
        <div class="text-center border-top" style="margin-top: 15px; padding-top: 10px;">
          Thank you for shopping!
        </div>
      </body>
      </html>
    `;
    
    iframe.contentDocument.write(html);
    iframe.contentDocument.close();
    setTimeout(() => {
      iframe.contentWindow.focus();
      iframe.contentWindow.print();
      setTimeout(() => document.body.removeChild(iframe), 2000);
    }, 500);
  }

  document.addEventListener('prices-updated', (e) => {
     const updates = e.detail;
     updates.forEach(u => {
        const p = products.find(prod => prod.id === u.id);
        if (p) {
           if (u.specifications) p.specifications = { ...p.specifications, ...u.specifications };
           if (u.variants && u.variants.length > 0) {
              u.variants.forEach(vUpdate => {
                 if (p.variants[vUpdate.vIndex]) {
                    if (vUpdate.pos_price !== undefined) p.variants[vUpdate.vIndex].pos_price = vUpdate.pos_price;
                    if (vUpdate.b2b_price !== undefined) p.variants[vUpdate.vIndex].b2b_price = vUpdate.b2b_price;
                 }
              });
           }
        }
     });
     
     // Update prices in cart
     const toggleDeals = document.getElementById('toggle-deals');
     const applyDeals = toggleDeals ? toggleDeals.checked : true;
     
     cart.forEach(item => {
        const p = products.find(prod => prod.id === item.pid);
        if (!p) return;
        
        const isVariantProd = p.hasVariants && p.variants && p.variants.length > 0;
        let finalPrice = p.price;
        
        if (isVariantProd && p.variants[item.vIndex]) {
           finalPrice = p.variants[item.vIndex].price || p.price;
           if (!applyDeals) {
              if (p.variants[item.vIndex].pos_price) finalPrice = parseFloat(p.variants[item.vIndex].pos_price);
           }
        } else {
           if (!applyDeals) {
              if (p.specifications && p.specifications._pos_price) finalPrice = parseFloat(p.specifications._pos_price);
           }
        }
        item.price = finalPrice;
     });
     
     renderCart();
  });

  // Init
  updateTotals();
</script>