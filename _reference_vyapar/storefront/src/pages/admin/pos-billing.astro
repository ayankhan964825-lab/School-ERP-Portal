        </div>

        <!-- Selected Items Table -->
        <div class="overflow-x-auto border border-gray-100 rounded-xl mt-4">
          <table class="w-full text-sm text-left">
            <thead class="bg-gray-50/80 text-xs text-secondary/50 uppercase tracking-wider border-b border-gray-100">
