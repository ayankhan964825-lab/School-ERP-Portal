---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
const ctx = getPermissionContext(Astro.cookies);

if (Astro.request.method === "POST" && !canManageSection(ctx, "milestones")) {
  return new Response("Forbidden", { status: 403 });
}
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageAiPanel from '../../components/admin/PageAiPanel.astro';
import { supabaseAdmin, getProducts } from '../../lib/database';

// Fetch all milestones and products
let milestones: any[] = [];
let availableProducts: any[] = [];
let errorMsg = '';

try {
  if (supabaseAdmin) {
    const { data, error } = await supabaseAdmin.from('milestone_offers').select('*').eq('store_id', Astro.locals?.storeId).order('created_at', { ascending: false });
    if (error) throw error;
    milestones = data || [];
  }
  
  availableProducts = await getProducts(Astro.locals?.storeId);
} catch (error: any) {
  errorMsg = error.message;
}

// Map products to a flat list of variants for the dropdown
const productVariantsForDropdown = availableProducts.flatMap(p => {
  if (!p.variants || p.variants.length === 0) {
    return [{ id: p.id, variantName: '', name: p.name, image: p.image || p.media?.[0] || '', price: p.price || 0 }];
  }
  return p.variants.map((opt: any) => ({
    id: p.id,
    variantName: opt.name || opt.weight || 'Default',
    name: p.name,
    image: opt.image || p.image || p.media?.[0] || '',
    price: opt.price || p.price || 0
  }));
});

// Handle Form Submission (Create / Update / Delete / Toggle)
import { storeContext } from '../../lib/storeContext';

if (Astro.request.method === 'POST') {
  try {
    const redirectResponse = await storeContext.run({ storeId: (Astro.locals as any).storeId }, async () => {
      const storeId = (Astro.locals as any).storeId;
      const formData = await Astro.request.formData();
      const action = formData.get('action')?.toString();

      if (action === 'create' || action === 'update') {
        const id = formData.get('id')?.toString();
        const name = formData.get('name')?.toString() || '';
        const tiersJson = formData.get('tiers')?.toString() || '[]';
        const is_active = formData.get('is_active') === 'on';

        const payload = { name, tiers: JSON.parse(tiersJson), is_active, store_id: storeId };

        if (action === 'create') {
          if (is_active && supabaseAdmin) {
            const { error } = await supabaseAdmin.from('milestone_offers').update({ is_active: false }).eq('store_id', storeId).neq('id', '00000000-0000-0000-0000-000000000000');
            if (error) throw error;
          }
          const { error } = await supabaseAdmin?.from('milestone_offers').insert([payload]);
          if (error) throw error;
        } else if (action === 'update' && id) {
          if (is_active && supabaseAdmin) {
            const { error } = await supabaseAdmin.from('milestone_offers').update({ is_active: false }).eq('store_id', storeId).neq('id', id);
            if (error) throw error;
          }
          const { error } = await supabaseAdmin?.from('milestone_offers').update(payload).eq('id', id).eq('store_id', storeId);
          if (error) throw error;
        }
      } else if (action === 'delete') {
        const id = formData.get('id')?.toString();
        if (id) {
          const { error } = await supabaseAdmin?.from('milestone_offers').delete().eq('id', id).eq('store_id', storeId);
          if (error) throw error;
        }
      } else if (action === 'toggle_active') {
        const id = formData.get('id')?.toString();
        const currentStatus = formData.get('current_status') === 'true';
        if (id && supabaseAdmin) {
          if (!currentStatus) {
            // Deactivate all others first
            const { error: err1 } = await supabaseAdmin.from('milestone_offers').update({ is_active: false }).eq('store_id', storeId).neq('id', id);
            if (err1) throw err1;
          }
          const { error: err2 } = await supabaseAdmin.from('milestone_offers').update({ is_active: !currentStatus }).eq('id', id).eq('store_id', storeId);
          if (err2) throw err2;
        }
      }

      return Astro.redirect('/admin/milestones');
    });
    if (redirectResponse) return redirectResponse;
  } catch (err: any) {
    errorMsg = err.message;
  }
}

const milestonesForAI = JSON.stringify(milestones.map((m: any) => ({
  id: m.id,
  name: m.name,
  isActive: m.is_active,
  tiers: m.tiers
})));
---

<AdminLayout title="Milestone Offers | Admin">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-secondary">Milestone Offers</h1>
        <p class="text-secondary/60 text-sm">Manage cart progress bars and gamification tiers.</p>
      </div>
      <button onclick="document.getElementById('modal-add').showModal()" class="bg-primary text-white px-4 py-2 rounded-xl text-sm font-medium hover:bg-primary/90 transition-colors flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        Create Milestone
      </button>
    </div>

    <!-- AI Assistant Panel -->
    <PageAiPanel
      page="milestones"
      title="Milestones Assistant"
      pageDataJson={milestonesForAI}
      guideTitleEn="Milestones Guide"
      guideTitleHi="Milestones Guide"
      guideHtml={`<ul class="space-y-2">
        <li><strong>Create:</strong> Click "Create Milestone" to add gamified cart tiers (e.g., ₹500 for 5% off).</li>
        <li><strong>Active Status:</strong> Only one milestone offer can be active at a time to prevent cart conflicts.</li>
      </ul>`}
      guideHtmlHi={`<ul class="space-y-2">
        <li><strong>Create:</strong> Cart me discount tiers set karne ke liye "Create Milestone" pe click karein.</li>
        <li><strong>Active Status:</strong> Ek waqt me sirf ek hi milestone offer active reh sakta hai.</li>
      </ul>`}
      quickActions={[
        { label: '➕ New Milestone', query: 'naya milestone banana hai' },
        { label: '📊 Active Offer', query: 'kaun sa milestone abhi active hai' }
      ]}
    />

    {errorMsg && (
      <div class="bg-red-50 text-red-600 p-4 rounded-xl text-sm font-medium border border-red-100">
        {errorMsg}
      </div>
    )}

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      {milestones.length === 0 ? (
        <div class="p-8 text-center text-secondary/50">
          <p>No milestone offers found.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-gray-50/50 text-secondary/50 font-medium border-b border-gray-100">
              <tr>
                <th class="px-6 py-4">Name</th>
                <th class="px-6 py-4">Tiers</th>
                <th class="px-6 py-4">Status</th>
                <th class="px-6 py-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {milestones.map((m: any) => (
                <tr class="hover:bg-gray-50/50 transition-colors">
                  <td class="px-6 py-4 font-medium text-secondary">{m.name}</td>
                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-1">
                      {m.tiers?.map((t: any) => {
                        const gifts = t.free_gifts && t.free_gifts.length > 0 ? t.free_gifts : (t.free_gift_name ? [{ name: t.free_gift_name, worth: t.free_gift_worth }] : []);
                        return (
                          <span class="bg-primary/10 text-primary text-[10px] px-2 py-0.5 rounded-full font-bold whitespace-nowrap">
                            ₹{t.target} {t.discount ? `→ ${t.discount}%` : ''}
                            {t.discount && gifts.length > 0 ? ` + ` : (gifts.length > 0 ? '→ ' : '')}
                            {gifts.length > 0 && `🎁 ${gifts.map((g: any) => `${g.name || g.free_gift_name}${g.worth ? ` (₹${g.worth})` : ''}`).join(' + ')}`}
                          </span>
                        );
                      })}
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <form method="POST">
                      <input type="hidden" name="action" value="toggle_active" />
                      <input type="hidden" name="id" value={m.id} />
                      <input type="hidden" name="current_status" value={m.is_active.toString()} />
                      <button type="submit" class={`relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 ${m.is_active ? 'bg-primary' : 'bg-gray-200'}`}>
                        <span class="sr-only">Toggle</span>
                        <span class={`pointer-events-none absolute left-0.5 inline-block h-4 w-4 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out ${m.is_active ? 'translate-x-4' : 'translate-x-0'}`}></span>
                      </button>
                    </form>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex justify-end gap-2">
                      <button 
                        type="button"
                        class="text-blue-500 hover:text-blue-600 bg-blue-50 p-1.5 rounded-lg transition-colors edit-milestone-btn"
                        data-milestone={JSON.stringify(m)}
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                      </button>
                      <form action="" onsubmit="event.preventDefault(); if(confirm('Are you sure you want to delete this milestone?')){ const btn = this.querySelector('button'); btn.disabled=true; fetch('', { method: 'POST', body: new FormData(this) }).then(res => { if(res.ok) window.location.reload(); else alert('Failed to delete'); btn.disabled=false; }); }" class="inline">
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={m.id} />
                        <button type="submit" class="text-red-500 hover:text-red-600 bg-red-50 p-1.5 rounded-lg transition-colors">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- Add/Edit Modal -->
    <dialog id="modal-add" class="bg-transparent p-0 w-full max-w-3xl backdrop:bg-black/40 backdrop:backdrop-blur-sm open:animate-in open:fade-in open:zoom-in-95">
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 max-h-[90vh] flex flex-col">
        <form method="dialog" class="px-6 py-4 border-b border-gray-100 flex items-center justify-between shrink-0 bg-gray-50/50">
          <h3 class="text-lg font-bold text-secondary" id="modal-title">Create Milestone</h3>
          <button type="submit" onclick="closeModal()" class="text-secondary/50 hover:text-secondary p-1 rounded-lg hover:bg-gray-100 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </form>
        
        <form method="POST" id="milestone-form" class="p-6 overflow-y-auto flex-1" onsubmit="return handleFormSubmit(event)">
          <input type="hidden" name="action" id="form-action" value="create" />
          <input type="hidden" name="id" id="form-id" value="" />
          <input type="hidden" name="tiers" id="form-tiers" value="[]" />
          
          <div class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-secondary mb-1">Internal Name</label>
                <input type="text" name="name" id="form-name" required class="w-full px-3 py-2.5 border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary outline-none text-sm transition-colors" placeholder="e.g. Summer Launch Offer" />
              </div>
              <div class="flex items-center">
                <div class="mt-6 border border-primary/20 bg-primary/5 px-4 py-2.5 rounded-xl flex items-center gap-2 cursor-pointer w-full">
                  <input type="checkbox" name="is_active" id="form-is-active" class="w-4 h-4 text-primary rounded border-gray-300 focus:ring-primary cursor-pointer" checked />
                  <label for="form-is-active" class="text-sm font-medium text-primary cursor-pointer">Set as Active Offer</label>
                </div>
              </div>
            </div>

            <hr class="border-gray-100" />

            <div>
              <div class="flex items-center justify-between mb-3">
                <div>
                  <label class="block text-base font-bold text-secondary">Tiers Configuration</label>
                  <p class="text-xs text-secondary/60">Tiers are automatically sorted by Target Amount.</p>
                </div>
                <button type="button" onclick="addTier()" class="text-sm text-white bg-secondary hover:bg-secondary/90 px-3 py-1.5 rounded-lg font-medium flex items-center gap-1 transition-colors shadow-sm">+ Add Tier</button>
              </div>
              
              <div id="tiers-container" class="space-y-4">
                <!-- Tiers will be rendered here via JS -->
              </div>
            </div>
          </div>
          
          <div class="mt-8 pt-4 border-t border-gray-100 flex justify-end gap-3">
            <button type="button" onclick="window.closeModal()" class="px-5 py-2.5 text-sm font-medium text-secondary/70 bg-gray-50 hover:bg-gray-100 rounded-xl transition-colors">Cancel</button>
            <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-primary hover:bg-primary/90 rounded-xl shadow-sm transition-colors">Save Milestone</button>
          </div>
        </form>
      </div>
    </dialog>

  <script id="milestone-data" type="application/json" is:inline set:html={JSON.stringify(productVariantsForDropdown)}></script>

  <script is:inline data-astro-rerun>
    // Bulletproof initialization that survives view transitions
    var productsDataRaw = document.getElementById('milestone-data')?.textContent || '[]';
    var productVariantsForDropdown = JSON.parse(productsDataRaw);
    window.currentTiers = [];

    // Safely escape a string for HTML attributes
    window.escapeAttr = function(str) {
      if (str == null) return '';
      return String(str).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    };

    // Direct DOM updater for Custom Image (Smooth Upload)
    window.handleCustomImageUpload = async function(index, giftIndex, fileInput) {
      const file = fileInput.files[0];
      if (!file) return;

      const fd = new FormData();
      fd.append('file', file);

      const btn = document.getElementById(`upload-btn-${index}-${giftIndex}`);
      if(btn) {
        btn.innerHTML = '<span class="animate-spin mr-1">↻</span> Uploading...';
        btn.disabled = true;
      }

      try {
        const res = await fetch('/api/admin/upload', { method: 'POST', body: fd });
        if (!res.ok) throw new Error('Upload failed');
        const data = await res.json();
        if (data.url) {
          window.currentTiers[index].free_gifts[giftIndex].image = data.url;
          const imgInput = document.getElementById(`tier-${index}-gift-${giftIndex}-image-input`);
          if (imgInput) {
            imgInput.value = data.url;
            window.updateImagePreview(index, giftIndex, data.url);
          }
        }
      } catch (err) {
        alert('Failed to upload image. Please check API settings.');
        console.error(err);
      } finally {
        if(btn) {
          btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg> Upload';
          btn.disabled = false;
        }
        fileInput.value = ''; // Reset file input
      }
    };

    window.renderTiers = function() {
      const container = document.getElementById('tiers-container');
      if (!container) return;
      container.innerHTML = '';
      
      if (!window.currentTiers || window.currentTiers.length === 0) {
        container.innerHTML = '<div class="text-sm text-center p-8 bg-gray-50 border border-dashed border-gray-200 rounded-xl text-secondary/50 font-medium">No tiers added. Click "+ Add Tier" to start.</div>';
        return;
      }

      window.currentTiers.forEach((tier, index) => {
        const div = document.createElement('div');
        div.className = 'bg-gray-50/50 p-4 rounded-xl border border-gray-200 shadow-sm relative';
        
        // Render Gifts
        let giftsHtml = '';
        if (tier.free_gifts && tier.free_gifts.length > 0) {
          tier.free_gifts.forEach((gift, giftIndex) => {
            let selectOptions = '<option value="">-- Remove Gift --</option>';
            selectOptions += '<option value="__custom__"' + (gift.isCustom ? ' selected' : '') + '>✏️ Custom Gift...</option>';
            if (productVariantsForDropdown) {
              productVariantsForDropdown.forEach(p => {
                const isSelected = !gift.isCustom && gift.id === p.id && (gift.variantName || '') === p.variantName;
                selectOptions += '<option value="' + window.escapeAttr(JSON.stringify({id: p.id, variantName: p.variantName, name: p.name, image: p.image, price: p.price})) + '"' + (isSelected ? ' selected' : '') + '>' + window.escapeAttr(p.name) + (p.variantName ? ' - ' + window.escapeAttr(p.variantName) : '') + (p.price ? ' (₹' + p.price + ')' : '') + '</option>';
              });
            }

            const showCustom = !!gift.isCustom;
            giftsHtml += `
              <div class="mt-4 p-4 bg-white rounded-xl border border-primary/20 space-y-3 shadow-sm relative">
                <button type="button" onclick="window.removeGift(${index}, ${giftIndex})" class="absolute top-2 right-2 p-1 text-red-500 hover:bg-red-50 rounded transition-colors" title="Remove Gift">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
                <div class="pr-8">
                  <label class="text-xs font-medium text-secondary/80 mb-1 block">Select Gift #${giftIndex + 1}</label>
                  <select onchange="window.handleGiftSelection(${index}, ${giftIndex}, this.value)" class="w-full px-3 py-2 border border-gray-200 rounded-lg outline-none text-sm focus:border-primary bg-white">
                    ${selectOptions}
                  </select>
                </div>
                
                <div class="${showCustom ? 'block' : 'hidden'} mt-3 space-y-3" id="tier-${index}-gift-${giftIndex}-custom-section">
                  <p class="text-xs font-bold text-primary uppercase tracking-wider flex items-center gap-2 border-t border-gray-100 pt-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
                    Custom Gift Details
                  </p>
                  
                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label class="text-xs text-secondary/70 font-medium mb-1 block">Gift Name *</label>
                      <input type="text" value="${window.escapeAttr(gift.name || '')}" oninput="window.updateGiftField(${index}, ${giftIndex}, 'name', this.value)" placeholder="e.g. Premium Shaker" class="w-full px-3 py-2 border border-gray-200 rounded-lg outline-none text-sm focus:border-primary bg-white" />
                    </div>
                    <div>
                      <label class="text-xs text-secondary/70 font-medium mb-1 block">Worth ₹ (Display Value)</label>
                      <input type="number" value="${gift.worth || ''}" oninput="window.updateGiftField(${index}, ${giftIndex}, 'worth', this.value)" placeholder="₹" class="w-full px-3 py-2 border border-gray-200 rounded-lg outline-none text-sm focus:border-primary bg-white" />
                    </div>
                  </div>

                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label class="text-xs text-secondary/70 font-medium mb-1 block">Image</label>
                      <div class="flex gap-2">
                        <input type="text" id="tier-${index}-gift-${giftIndex}-image-input" value="${window.escapeAttr(gift.image || '')}" oninput="window.updateGiftField(${index}, ${giftIndex}, 'image', this.value); window.updateImagePreview(${index}, ${giftIndex}, this.value)" placeholder="URL or Upload ->" class="flex-1 px-3 py-2 border border-gray-200 rounded-lg outline-none text-sm focus:border-primary bg-white" />
                        
                        <div class="relative overflow-hidden shrink-0">
                          <button type="button" id="upload-btn-${index}-${giftIndex}" class="px-3 py-2 bg-gray-100 hover:bg-gray-200 border border-gray-200 rounded-lg text-sm font-medium text-secondary transition-colors cursor-pointer flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                            Upload
                          </button>
                          <input type="file" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" onchange="window.handleCustomImageUpload(${index}, ${giftIndex}, this)" />
                        </div>
                      </div>
                    </div>
                    <div>
                      <label class="text-xs text-secondary/70 font-medium mb-1 block">Variant Name</label>
                      <input type="text" value="${window.escapeAttr(gift.variantName || '')}" oninput="window.updateGiftField(${index}, ${giftIndex}, 'variantName', this.value)" placeholder="e.g. 500ml Black" class="w-full px-3 py-2 border border-gray-200 rounded-lg outline-none text-sm focus:border-primary bg-white" />
                    </div>
                  </div>
                  
                  <div id="tier-${index}-gift-${giftIndex}-preview-container" class="flex items-center gap-3 mt-1" style="display: ${gift.image ? 'flex' : 'none'}">
                    <img id="tier-${index}-gift-${giftIndex}-preview-img" src="${window.escapeAttr(gift.image || '')}" class="w-12 h-12 rounded-lg object-cover border border-gray-200 bg-gray-50 shadow-sm" onerror="this.style.display='none'" onload="this.style.display='block'" />
                    <span class="text-xs font-medium text-secondary/50">Live Preview</span>
                  </div>
                </div>
              </div>
            `;
          });
        } else {
          giftsHtml = '<p class="text-xs text-secondary/50 italic py-2">No free gifts added to this tier yet.</p>';
        }

        div.innerHTML = `
          <button type="button" onclick="window.removeTier(${index})" class="absolute top-4 right-4 p-1.5 text-red-500 hover:bg-red-100 bg-white rounded-lg border border-red-100 transition-colors shadow-sm" title="Remove Tier">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          </button>
          
          <div class="text-xs font-black text-secondary/30 uppercase tracking-wider mb-3">Tier #${index + 1}</div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Left: Condition -->
            <div class="space-y-4 bg-white p-4 rounded-xl border border-gray-100 shadow-sm">
              <h4 class="text-xs font-bold text-secondary uppercase tracking-widest border-b border-gray-100 pb-2">1. Condition</h4>
              <div>
                <label class="text-xs font-medium text-secondary/80 mb-1 block">Target Amount *</label>
                <div class="relative">
                  <span class="absolute left-3 top-2.5 text-sm text-secondary/50 font-medium">₹</span>
                  <input type="number" value="${tier.target || ''}" oninput="window.updateTierField(${index}, 'target', this.value)" placeholder="e.g. 1500" required class="w-full pl-7 pr-3 py-2 border border-gray-200 rounded-lg outline-none text-sm focus:border-primary bg-white" />
                </div>
              </div>
              <div>
                <label class="text-xs font-medium text-secondary/80 mb-1 block">Success Message *</label>
                <input type="text" id="tier-${index}-message-input" value="${window.escapeAttr(tier.message || '')}" oninput="window.updateTierField(${index}, 'message', this.value)" placeholder="e.g. Awesome! You unlocked a Free Shaker" required class="w-full px-3 py-2 border border-gray-200 rounded-lg outline-none text-sm focus:border-primary bg-white" />
              </div>
            </div>

            <!-- Right: Rewards -->
            <div class="space-y-4 bg-white p-4 rounded-xl border border-gray-100 shadow-sm">
              <div class="flex items-center justify-between border-b border-primary/10 pb-2">
                <h4 class="text-xs font-bold text-primary uppercase tracking-widest">2. Rewards</h4>
                <button type="button" onclick="window.addGift(${index})" class="text-[10px] bg-primary/10 text-primary hover:bg-primary/20 px-2 py-1 rounded font-bold transition-colors">+ ADD GIFT</button>
              </div>
              <div>
                <label class="text-xs font-medium text-secondary/80 mb-1 block">Discount %</label>
                <div class="relative">
                  <input type="number" value="${tier.discount !== undefined ? tier.discount : ''}" oninput="window.updateTierField(${index}, 'discount', this.value)" placeholder="Leave empty for no discount" class="w-full pl-3 pr-8 py-2 border border-gray-200 rounded-lg outline-none text-sm focus:border-primary bg-white" />
                  <span class="absolute right-3 top-2.5 text-sm text-secondary/50 font-medium">%</span>
                </div>
              </div>
              <div>
                ${giftsHtml}
              </div>
            </div>
          </div>
        `;
        container.appendChild(div);
      });
    };

    window.getAutoMessage = function(t) {
      const hasDiscount = t.discount > 0;
      const gifts = t.free_gifts || [];
      const hasGift = gifts.length > 0;
      const giftNames = gifts.map(g => `${g.name || 'Gift'}${g.worth ? ` (Worth ₹${g.worth})` : ''}`).join(' + ');

      if (hasDiscount && hasGift) return `Awesome! You unlocked ${t.discount}% OFF + Free ${giftNames}`;
      if (hasDiscount) return `Awesome! You unlocked ${t.discount}% OFF`;
      if (hasGift) return `Awesome! You unlocked a Free ${giftNames}`;
      return '';
    };

    window.autoUpdateMessage = function(index) {
      const t = window.currentTiers[index];
      if (t._message_edited) return;
      t.message = window.getAutoMessage(t);
    };

    window.addTier = function() {
      window.currentTiers.push({ target: '', discount: '', message: '', free_gifts: [], _message_edited: false });
      window.renderTiers();
    };

    window.removeTier = function(index) {
      window.currentTiers.splice(index, 1);
      setTimeout(() => window.renderTiers(), 0);
    };

    window.addGift = function(index) {
      window.currentTiers[index].free_gifts = window.currentTiers[index].free_gifts || [];
      window.currentTiers[index].free_gifts.push({ isCustom: false });
      setTimeout(() => window.renderTiers(), 0);
    };

    window.removeGift = function(index, giftIndex) {
      window.currentTiers[index].free_gifts.splice(giftIndex, 1);
      window.autoUpdateMessage(index);
      setTimeout(() => window.renderTiers(), 0);
    };

    window.updateTierField = function(index, field, value) {
      if (field === 'message') {
        window.currentTiers[index].message = value;
        window.currentTiers[index]._message_edited = (value.trim() !== '');
        if (value.trim() === '') {
          window.autoUpdateMessage(index);
          const msgInput = document.getElementById(`tier-${index}-message-input`);
          if (msgInput) msgInput.value = window.currentTiers[index].message;
        }
      } else {
        window.currentTiers[index][field] = value === '' ? '' : Number(value);
      }
      
      if (field === 'discount') {
        window.autoUpdateMessage(index);
        const msgInput = document.getElementById(`tier-${index}-message-input`);
        if (msgInput) msgInput.value = window.currentTiers[index].message;
      }
    };

    window.updateGiftField = function(index, giftIndex, field, value) {
      window.currentTiers[index].free_gifts[giftIndex][field] = value;
      if (['name', 'worth'].includes(field)) {
        window.autoUpdateMessage(index);
        const msgInput = document.getElementById(`tier-${index}-message-input`);
        if (msgInput) msgInput.value = window.currentTiers[index].message;
      }
    };

    window.updateImagePreview = function(index, giftIndex, url) {
      const imgEl = document.getElementById(`tier-${index}-gift-${giftIndex}-preview-img`);
      const container = document.getElementById(`tier-${index}-gift-${giftIndex}-preview-container`);
      if (imgEl && container) {
        if (!url || url.trim() === '') {
          container.style.display = 'none';
        } else {
          imgEl.src = url;
          container.style.display = 'flex';
        }
      }
    };

    window.handleGiftSelection = function(index, giftIndex, valueStr) {
      const gift = window.currentTiers[index].free_gifts[giftIndex];
      if (!valueStr) {
        // Remove Gift handled by removeGift button, but if they pick empty:
        window.removeGift(index, giftIndex);
        return;
      } else if (valueStr === '__custom__') {
        // Custom gift mode
        gift.isCustom = true;
        gift.id = 'custom_gift_' + Date.now();
        gift.name = gift.name || '';
        gift.image = gift.image || '';
        gift.variantName = gift.variantName || '';
        gift.worth = gift.worth || 0;
      } else {
        // Product-based gift
        try {
          const val = JSON.parse(valueStr);
          gift.id = val.id;
          gift.variantName = val.variantName;
          gift.name = val.name;
          gift.image = val.image;
          gift.worth = val.price || 0;
          gift.isCustom = false;
        } catch(e) {
          console.error('Failed to parse gift selection', e);
        }
      }
      
      window.autoUpdateMessage(index);
      setTimeout(() => window.renderTiers(), 0);
    };

    window.editMilestone = function(id, name, tiers, isActive) {
      document.getElementById('modal-title').textContent = 'Edit Milestone';
      document.getElementById('form-action').value = 'update';
      document.getElementById('form-id').value = id;
      document.getElementById('form-name').value = name;
      document.getElementById('form-is-active').checked = isActive;
      
      window.currentTiers = Array.isArray(tiers) ? JSON.parse(JSON.stringify(tiers)).map(t => {
        // Migrate old structure to new structure
        if (!t.free_gifts) t.free_gifts = [];
        if (t.free_gift_id || t.free_gift_custom || t.free_gift_name) {
          t.free_gifts.push({
            id: t.free_gift_id,
            name: t.free_gift_name,
            image: t.free_gift_image,
            variantName: t.free_gift_variant,
            worth: t.free_gift_worth,
            isCustom: !!t.free_gift_custom
          });
          delete t.free_gift_id; delete t.free_gift_name; delete t.free_gift_image; delete t.free_gift_custom; delete t.free_gift_variant; delete t.free_gift_worth;
        }

        t._message_edited = (t.message !== window.getAutoMessage(t));
        return t;
      }) : [];
      window.renderTiers();
      document.getElementById('modal-add').showModal();
    };

    window.closeModal = function() {
      try {
        const modal = document.getElementById('modal-add');
        if (modal && typeof modal.close === 'function') {
          modal.close();
        }
      } catch(e) { console.error('Error closing modal:', e); }
      
      const title = document.getElementById('modal-title');
      if(title) title.textContent = 'Create Milestone';
      const action = document.getElementById('form-action');
      if(action) action.value = 'create';
      const id = document.getElementById('form-id');
      if(id) id.value = '';
      const name = document.getElementById('form-name');
      if(name) name.value = '';
      const isActive = document.getElementById('form-is-active');
      if(isActive) isActive.checked = true;
      
      window.currentTiers = [];
      window.renderTiers();
    };

    window.handleFormSubmit = function(e) {
      if (!window.currentTiers || window.currentTiers.length === 0) {
        alert('Please add at least one tier configuration.');
        e.preventDefault();
        return false;
      }

      for (let i = 0; i < window.currentTiers.length; i++) {
        const t = window.currentTiers[i];
        if (!t.target || t.target <= 0) {
          alert('Tier #' + (i+1) + ': Target amount is required and must be > 0.');
          e.preventDefault();
          return false;
        }
        
        const hasDiscount = (t.discount !== '' && t.discount !== undefined && t.discount > 0);
        const hasFreeGift = t.free_gifts && t.free_gifts.length > 0;
        
        if (!hasDiscount && !hasFreeGift) {
          alert('Tier #' + (i+1) + ': Please provide either a Discount % or select a Free Gift (or both).');
          e.preventDefault();
          return false;
        }
        if (!t.message || t.message.trim() === '') {
          alert('Tier #' + (i+1) + ': Success Message is required.');
          e.preventDefault();
          return false;
        }
        
        if (hasFreeGift) {
          for (let j = 0; j < t.free_gifts.length; j++) {
            const g = t.free_gifts[j];
            if (g.isCustom && (!g.name || g.name.trim() === '')) {
              alert('Tier #' + (i+1) + ' Gift #' + (j+1) + ': Custom gift name is required.');
              e.preventDefault();
              return false;
            }
          }
        }
      }
      
      window.currentTiers.sort((a, b) => a.target - b.target);
      document.getElementById('form-tiers').value = JSON.stringify(window.currentTiers);
      
      const form = e.target;
      const btn = form.querySelector('button[type="submit"]');
      const origText = btn.textContent;
      btn.textContent = 'Saving...';
      btn.disabled = true;

      fetch(window.location.href, {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form)
      }).then(async res => {
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to save milestone');
          btn.textContent = origText;
          btn.disabled = false;
        }
      }).catch(err => {
        alert('An error occurred');
        btn.textContent = origText;
        btn.disabled = false;
      });

      e.preventDefault();
      return false;
    };

    window.renderTiers();

    document.querySelectorAll('.edit-milestone-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        try {
          const m = JSON.parse(e.currentTarget.dataset.milestone);
          window.editMilestone(m.id, m.name, m.tiers, m.is_active);
        } catch (err) {
          console.error("Failed to parse milestone data", err);
        }
      });
    });

    document.addEventListener('ai-action', function(e) {
      var action = e.detail.action;
      var params = e.detail.params || {};

      if (action === 'open_add_form') {
        document.getElementById('modal-add').showModal();
      }
      else if (action === 'fill_milestone_form') {
        document.getElementById('modal-add').showModal();
        setTimeout(() => {
          if (params.name) document.getElementById('form-name').value = params.name;
          if (params.is_active !== undefined) document.getElementById('form-is-active').checked = params.is_active;
          
          if (params.tiers && Array.isArray(params.tiers)) {
            window.currentTiers = params.tiers.map(t => {
              const newT = {
                target: t.target || '',
                discount: t.discount || '',
                message: t.message || '',
                free_gifts: t.free_gifts || []
              };
              newT._message_edited = (newT.message !== window.getAutoMessage(newT));
              return newT;
            });
            window.renderTiers();
          }
        }, 100);
      }
      else if (action === 'navigate') {
        if (params.url) window.location.href = params.url;
      }
    });
</script>
</AdminLayout>
