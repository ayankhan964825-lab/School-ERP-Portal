---
import { getPermissionContext, canManageSection } from '../../../lib/permissions';
const ctx = getPermissionContext(Astro.cookies);

if (Astro.request.method === "POST" && !canManageSection(ctx, "orders_tracking")) {
  return new Response("Forbidden", { status: 403 });
}
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageAiPanel from '../../../components/admin/PageAiPanel.astro';
import { getOrders } from '../../../lib/database';

const allOrders = await getOrders(Astro.locals?.storeId);
let orders = allOrders.filter((o: any) => !(o.is_b2b || (o.customer && o.customer.is_b2b)));
// Only show active shipments
orders = orders.filter((o: any) => ['shipped', 'ndr', 'rto'].includes(o.status));
orders.sort((a: any, b: any) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

const statusColors: { [key: string]: string } = {
  shipped:   'bg-purple-100 text-purple-800',
  ndr:       'bg-orange-100 text-orange-800',
  rto:       'bg-red-100 text-red-800',
};

// Serialize for AI (last 100 orders, lightweight)
const ordersForAI = JSON.stringify(orders.slice(0, 100).map((o: any) => ({
  id: o.id,
  status: o.status,
  date: o.createdAt,
  awb: o.awb || '',
  courier: o.courierPartner || '',
  customer: o.customerName || o.customer_name || '',
})));
---

<AdminLayout title="Order Tracking Hub | Admin Panel" description="Track all active shipments and monitor delivery timelines.">
  <!-- Page Header -->
  <div class="flex justify-between items-center mb-4">
    <div>
      <h1 class="text-2xl font-serif font-bold text-secondary">Order Tracking Hub</h1>
      <p class="text-sm text-secondary/60 mt-1">Monitor all active shipments, AWB numbers, and transit statuses.</p>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-sm text-secondary/60 font-medium">{orders.length} active shipments</span>
    </div>
  </div>

  <!-- AI Assistant Panel -->
  <PageAiPanel
    page="orders"
    title="Tracking Assistant"
    pageDataJson={ordersForAI}
    guideTitleEn="Tracking Hub Guide"
    guideTitleHi="Tracking Hub Guide"
    guideHtml={`<ul class="space-y-2">
      <li><strong>Active Shipments:</strong> Monitor orders that have left the warehouse but aren't delivered yet.</li>
      <li><strong>Timeline Tracking:</strong> Click 'Track Timeline' to see dispatch, transit, and out-for-delivery milestones.</li>
    </ul>`}
    guideHtmlHi={`<ul class="space-y-2">
      <li><strong>Active Shipments:</strong> Jo orders dispatch ho gaye hain par abhi deliver nahi hue, unko yahan track karein.</li>
      <li><strong>Timeline Tracking:</strong> 'Track Timeline' pe click karke order ka safar dekhein.</li>
    </ul>`}
    quickActions={[
      { label: '📦 Shipped dikhao', query: 'show shipped orders' },
      { label: '⚠️ NDR dikhao', query: 'show ndr shipments' },
    ]}
  />

  <div class="bg-blue-50 text-blue-800 text-sm px-4 py-3 rounded-xl mb-6 font-medium border border-blue-100 flex items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    Tracking timelines are currently generated internally based on status updates. Integration with live courier APIs can be configured in Shipping Settings.
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    {orders.length === 0 ? (
      <div class="p-16 text-center text-secondary/60">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
        No active shipments currently in transit.
      </div>
    ) : (
      <div class="overflow-x-auto w-full">
        <table class="min-w-full text-sm text-left">
          <thead class="text-xs text-secondary/60 uppercase bg-gray-50/80 border-b border-gray-100">
            <tr>
              <th class="px-5 py-3.5 font-semibold">Order</th>
              <th class="px-5 py-3.5 font-semibold">Customer</th>
              <th class="px-5 py-3.5 font-semibold">Current Status</th>
              <th class="px-5 py-3.5 font-semibold">Logistics Partner & AWB</th>
              <th class="px-5 py-3.5 font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            {orders.map((order: any) => (
              <tr class="order-row hover:bg-gray-50/40 transition-colors" data-status={order.status}>
                <td class="px-5 py-4">
                  <div class="font-bold text-secondary text-xs">
                    {order.orderId}
                    
                  </div>
                  <div class="text-xs text-secondary/50 mt-0.5">
                    {new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </div>
                  <div class="mt-1">
                    <span class="text-[10px] uppercase font-bold tracking-wide bg-gray-100 text-secondary/60 px-2 py-0.5 rounded">
                      ₹{(order.amount || 0).toLocaleString('en-IN')}
                    </span>
                  </div>
                </td>

                <td class="px-5 py-4">
                  <div class="font-semibold text-secondary text-sm">{order.customer?.name || 'Guest'}</div>
                  <div class="text-xs text-secondary/50">{order.customer?.phone}</div>
                  <div class="text-xs text-secondary/40 mt-0.5 line-clamp-1 max-w-[160px]">
                    {order.customer?.city}, {order.customer?.state}
                  </div>
                </td>

                <td class="px-5 py-4">
                  <span class={`inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full ${statusColors[order.status] || 'bg-gray-100 text-gray-800'}`}>
                    <span class={`w-1.5 h-1.5 rounded-full mr-1.5 ${order.status === 'ndr' || order.status === 'rto' ? 'bg-current animate-pulse' : 'bg-current'}`}></span>
                    {order.status.toUpperCase()}
                  </span>
                  {order.status === 'ndr' && (
                    <p class="text-[10px] text-orange-600 mt-1 font-semibold">Action Required</p>
                  )}
                  {order.status === 'rto' && (
                    <p class="text-[10px] text-red-600 mt-1 font-semibold">Returning to Origin</p>
                  )}
                </td>

                <td class="px-5 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-500 shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    </div>
                    <div>
                      <p class="font-bold text-secondary text-xs">{order.courierPartner || 'N/A'}</p>
                      <p class="text-xs text-secondary/60 font-mono mt-0.5 tracking-wider">{order.awb || 'No AWB Assigned'}</p>
                    </div>
                  </div>
                </td>

                <td class="px-5 py-4">
                  <button
                    class="track-order-btn w-full flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors justify-center shadow-sm"
                    data-order={encodeURIComponent(JSON.stringify(order))}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
                    Track Timeline
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

<!-- == TRACKING TIMELINE MODAL == -->
<div id="tracking-modal" class="fixed inset-0 bg-secondary/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-md max-h-[90vh] flex flex-col overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 shrink-0">
      <div>
        <h2 class="text-base font-bold text-secondary" id="tracking-modal-title">Tracking Timeline</h2>
        <p class="text-xs text-secondary/50 mt-0.5" id="tracking-modal-awb">AWB: </p>
      </div>
      <button id="close-tracking-modal" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-gray-100 transition-colors text-secondary/40 hover:text-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div class="p-6 overflow-y-auto flex-1 bg-gray-50/30">
      <!-- Simulated Timeline -->
      <div class="relative pl-6 space-y-6 before:absolute before:inset-0 before:ml-[1.4rem] before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-slate-200 before:to-transparent" id="tracking-timeline-body">
         <!-- Filled via JS -->
      </div>
    </div>
    <div class="p-4 bg-white border-t border-gray-100">
      <button id="external-track-btn" class="w-full py-2.5 bg-secondary text-white text-sm font-semibold rounded-xl hover:bg-secondary/90 transition-colors flex justify-center items-center gap-2">
        View on Courier Website
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </button>
    </div>
  </div>
</div>

<script data-astro-rerun>
  const trackingModal = document.getElementById('tracking-modal');
  const trackingBody = document.getElementById('tracking-timeline-body');
  const trackingTitle = document.getElementById('tracking-modal-title');
  const trackingAwb = document.getElementById('tracking-modal-awb');
  const externalTrackBtn = document.getElementById('external-track-btn');

  document.querySelectorAll('.track-order-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const btnEl = this;
      const order = JSON.parse(btnEl.dataset.order || '{}');
      
      if (trackingTitle) trackingTitle.textContent = `Order #${order.orderId}`;
      if (trackingAwb) trackingAwb.textContent = `AWB: ${order.awb || 'N/A'} via ${order.courierPartner || 'N/A'}`;

      const timelineSteps = [];
      const dispatchDateStr = order.dispatchDate || order.createdAt;
      const dispatchDate = new Date(dispatchDateStr);
      
      // Step 1: Placed
      timelineSteps.push({
        title: 'Order Placed',
        desc: 'Order received and confirmed',
        date: new Date(order.createdAt).toLocaleString('en-IN', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }),
        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />',
        color: 'bg-green-500',
        active: true
      });

      // Step 2: Dispatched
      timelineSteps.push({
        title: 'Dispatched',
        desc: `Handed over to ${order.courierPartner || 'courier'}`,
        date: new Date(dispatchDate.getTime() + 86400000).toLocaleString('en-IN', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }),
        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />',
        color: 'bg-blue-500',
        active: true
      });

      // Step 3: In Transit / NDR / RTO
      if (order.status === 'shipped') {
        timelineSteps.push({
          title: 'In Transit',
          desc: 'Package is on its way to the destination hub',
          date: 'Live Tracking...',
          icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />',
          color: 'bg-indigo-500 animate-pulse',
          active: true
        });
      } else if (order.status === 'ndr') {
        timelineSteps.push({
          title: 'Delivery Attempt Failed',
          desc: 'Customer not contactable. Awaiting seller action.',
          date: 'Action Required',
          icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />',
          color: 'bg-orange-500',
          active: true
        });
      } else if (order.status === 'rto') {
        timelineSteps.push({
          title: 'Returning to Origin',
          desc: 'RTO initiated by courier partner',
          date: 'In Transit (Reverse)',
          icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />',
          color: 'bg-red-500',
          active: true
        });
      }

      if (trackingBody) {
        trackingBody.innerHTML = timelineSteps.map((step, idx) => `
          <div class="relative flex items-start gap-4 z-10 group">
            <div class="w-8 h-8 rounded-full ${step.color} border-4 border-white shadow-sm flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                ${step.icon}
              </svg>
            </div>
            <div class="pt-1 flex-1 bg-white p-4 rounded-xl border border-gray-100 shadow-sm ${idx === timelineSteps.length - 1 ? 'ring-1 ring-primary/20 bg-primary/5' : ''}">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <h4 class="font-bold text-secondary text-sm ${idx === timelineSteps.length - 1 ? 'text-primary' : ''}">${step.title}</h4>
                  <p class="text-xs text-secondary/60 mt-1">${step.desc}</p>
                </div>
                <div class="text-[10px] font-semibold text-secondary/40 whitespace-nowrap bg-gray-50 px-2 py-1 rounded">
                  ${step.date}
                </div>
              </div>
            </div>
          </div>
        `).join('');
      }

      if (externalTrackBtn) {
        externalTrackBtn.onclick = () => {
          if (!order.awb) {
            alert('No AWB assigned to this order yet.');
            return;
          }
          // Basic tracking URL inference based on courier string matching
          let url = `https://www.google.com/search?q=track+${order.courierPartner}+${order.awb}`;
          if(order.courierPartner?.toLowerCase().includes('delhivery')) url = `https://www.delhivery.com/track/package/${order.awb}`;
          if(order.courierPartner?.toLowerCase().includes('bluedart')) url = `https://www.bluedart.com/tracking`;
          window.open(url, '_blank');
        };
      }

      trackingModal?.classList.remove('hidden');
      trackingModal?.classList.add('flex');
    });
  });

  document.getElementById('close-tracking-modal')?.addEventListener('click', () => {
    trackingModal?.classList.add('hidden');
    trackingModal?.classList.remove('flex');
  });
  trackingModal?.addEventListener('click', (e) => { if (e.target === trackingModal) { trackingModal.classList.add('hidden'); trackingModal.classList.remove('flex'); } });
</script>

</AdminLayout>







