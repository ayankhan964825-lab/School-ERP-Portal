---
import { getPermissionContext, canManageSection } from '../../../lib/permissions';
const ctx = getPermissionContext(Astro.cookies);

if (Astro.request.method === "POST" && !canManageSection(ctx, "orders_returns")) {
  return new Response("Forbidden", { status: 403 });
}
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageAiPanel from '../../../components/admin/PageAiPanel.astro';
import { getOrders, getSettings } from '../../../lib/database';

const settings = await getSettings(Astro.locals?.storeId);
const policyType = settings.return_policy_type || 'video_proof';

const allOrders = await getOrders(Astro.locals?.storeId);
let orders = allOrders.filter((o: any) => !(o.is_b2b || (o.customer && o.customer.is_b2b)));
// Assuming returns have status 'return_requested' or 'returned'
orders = orders.filter((o: any) => ['return_requested', 'returned'].includes(o.status));
orders.sort((a: any, b: any) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

const statusColors: { [key: string]: string } = {
  pending:   'bg-yellow-100 text-yellow-800',
  confirmed: 'bg-blue-100 text-blue-800',
  shipped:   'bg-purple-100 text-purple-800',
  delivered: 'bg-green-100 text-green-800',
  cancelled: 'bg-red-100 text-red-800',
  return_requested: 'bg-orange-100 text-orange-800',
  returned: 'bg-gray-200 text-gray-800',
};

// Serialize for AI (last 100 orders, lightweight)
const ordersForAI = JSON.stringify(orders.slice(0, 100).map((o: any) => ({
  id: o.id,
  status: o.status,
  date: o.createdAt,
  customer: o.customerName || o.customer_name || '',
  phone: o.phone || '',
  total: o.total,
  paymentMethod: o.paymentMethod || o.payment_method || '',
  items: (o.items || []).map((i: any) => i.name || i.productName).join(', '),
})));
---

<AdminLayout title="Return Requests | Admin Panel" description="Manage return and exchange requests.">
  <!-- Page Header -->
  <div class="flex justify-between items-center mb-4">
    <div>
      <h1 class="text-2xl font-serif font-bold text-secondary">Return Requests</h1>
      <p class="text-sm text-secondary/60 mt-1">Review and process customer returns.</p>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-sm text-secondary/60 font-medium">{orders.length} return requests</span>
    </div>
  </div>

  <!-- AI Assistant Panel -->
  <PageAiPanel
    page="orders"
    title="Returns Assistant"
    pageDataJson={ordersForAI}
    guideTitleEn="Returns Guide"
    guideTitleHi="Returns Guide"
    guideHtml={`<ul class="space-y-2">
      <li><strong>Approve/Reject:</strong> Review the reason for return and approve or reject it.</li>
      ${policyType === 'video_proof' 
        ? '<li><strong>Video Proof:</strong> Verify the unboxing video sent by the customer on WhatsApp/Email.</li><li><strong>Resolution:</strong> Issue a refund or dispatch a replacement order instead of reverse pickup.</li>'
        : '<li><strong>Reverse Pickup:</strong> If approved, initiate a reverse pickup via your courier.</li><li><strong>Refund:</strong> Once the item is received in the warehouse, process the refund.</li>'}
    </ul>`}
    guideHtmlHi={`<ul class="space-y-2">
      <li><strong>Approve/Reject:</strong> Customer ka return reason dekhein aur approve ya reject karein.</li>
      ${policyType === 'video_proof'
        ? '<li><strong>Video Proof:</strong> WhatsApp ya email pe aayi hui video check karein.</li><li><strong>Resolution:</strong> Reverse pickup ki jagah refund ya replacement bhejen.</li>'
        : '<li><strong>Reverse Pickup:</strong> Approve karne ke baad reverse pickup schedule karein.</li><li><strong>Refund:</strong> Jab item wapas aa jaye, tabhi refund process karein.</li>'}
    </ul>`}
    quickActions={[
      { label: '📦 New Returns', query: 'show new return requests' },
      { label: '📊 Return Stats', query: 'total returns kitne hain' },
    ]}
  />

  {policyType === 'video_proof' ? (
    <div class="bg-orange-50 text-orange-800 text-sm px-4 py-3 rounded-xl mb-6 font-medium border border-orange-100 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
      Review requests and check video proof from customers. Arrange for a replacement or issue a refund.
    </div>
  ) : policyType === 'no_returns' ? (
    <div class="bg-red-50 text-red-800 text-sm px-4 py-3 rounded-xl mb-6 font-medium border border-red-100 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
      Returns and refunds are currently disabled in store settings.
    </div>
  ) : (
    <div class="bg-orange-50 text-orange-800 text-sm px-4 py-3 rounded-xl mb-6 font-medium border border-orange-100 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" /></svg>
      These orders have return requests. Review their reasons and arrange reverse pickup or issue refunds.
    </div>
  )}

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    {orders.length === 0 ? (
      <div class="p-16 text-center text-secondary/60">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
        No return requests pending.
      </div>
    ) : (
      <div class="overflow-x-auto w-full">
        <table class="min-w-full text-sm text-left">
          <thead class="text-xs text-secondary/60 uppercase bg-gray-50/80 border-b border-gray-100">
            <tr>
              <th class="px-5 py-3.5 font-semibold">Order</th>
              <th class="px-5 py-3.5 font-semibold">Customer</th>
              <th class="px-5 py-3.5 font-semibold">Items & Amount</th>
              <th class="px-5 py-3.5 font-semibold">Status</th>
              <th class="px-5 py-3.5 font-semibold">Return Details</th>
              <th class="px-5 py-3.5 font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            {orders.map((order: any) => (
              <tr class="order-row hover:bg-gray-50/40 transition-colors" data-status={order.status}>
                <td class="px-5 py-4">
                  <div class="font-bold text-secondary text-xs">
                    {order.orderId}
                    
                  </div>
                  <div class="text-xs text-secondary/50 mt-0.5">
                    {new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </div>
                  <div class="mt-1">
                    <span class="text-[10px] uppercase font-bold tracking-wide bg-gray-100 text-secondary/60 px-2 py-0.5 rounded">
                      {order.paymentMethod || 'COD'}
                    </span>
                  </div>
                </td>
                <td class="px-5 py-4">
                  <div class="font-semibold text-secondary text-sm">{order.customer?.name || 'Guest'}</div>
                  <div class="text-xs text-secondary/50">{order.customer?.phone}</div>
                  <div class="text-xs text-secondary/40 mt-0.5 line-clamp-1 max-w-[160px]">
                    {order.customer?.address}, {order.customer?.city}
                  </div>
                </td>
                <td class="px-5 py-4">
                  <div class="font-bold text-secondary">₹{(order.amount || 0).toLocaleString('en-IN')}</div>
                  <div class="mt-1 space-y-0.5">
                    {(order.items || []).slice(0,2).map((item) => (
                      <div class="text-xs text-secondary/60">
                        <span class="font-medium">{item.quantity}×</span> {item.name}
                      </div>
                    ))}
                  </div>
                </td>
                <td class="px-5 py-4">
                  <select
                    aria-label="Order status"
                    class="order-status-select w-full text-xs border border-gray-200 rounded-lg px-2 py-1.5 focus:border-primary focus:ring-1 focus:ring-primary outline-none font-semibold transition-colors"
                    data-order-id={order.orderId}
                  >
                    <option value="return_requested" selected={order.status === 'return_requested'}>Requested</option>
                    <option value="returned" selected={order.status === 'returned'}>{policyType === 'video_proof' ? 'Replaced/Refunded' : 'Returned/Refunded'}</option>
                    <option value="cancelled" selected={order.status === 'cancelled'}>Rejected</option>
                  </select>
                  <span class={`inline-block mt-1.5 text-[10px] font-bold px-2 py-0.5 rounded-full ${statusColors[order.status] || 'bg-gray-100 text-gray-600'}`}>
                    {order.status.replace('_', ' ')}
                  </span>
                </td>
                <td class="px-5 py-4" style="min-width:200px">
                  <div class="bg-gray-50 border border-gray-200 p-2 rounded-lg mb-2">
                    <p class="text-[10px] font-bold text-gray-500 uppercase tracking-wide">Reason for Return</p>
                    <p class="text-xs text-secondary font-medium">Defective product received</p>
                  </div>
                  <div class="flex gap-2">
                    <button class="text-[10px] font-semibold text-white bg-green-600 rounded-lg px-3 py-1.5 hover:bg-green-700 transition-colors" onclick="alert('Approve Return')">Approve</button>
                    <button class="text-[10px] font-semibold text-white bg-red-600 rounded-lg px-3 py-1.5 hover:bg-red-700 transition-colors" onclick="alert('Reject Return')">Reject</button>
                  </div>
                </td>
                <td class="px-5 py-4">
                  <button class="view-order-btn w-full flex items-center justify-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-secondary/10 text-secondary rounded-lg hover:bg-secondary hover:text-white transition-colors" data-order={encodeURIComponent(JSON.stringify(order))}>
                    View Details
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>

<script data-astro-rerun>
  document.querySelectorAll('.order-status-select').forEach(select => {
    select.addEventListener('change', async (e) => {
      const target = e.target;
      const orderId = target.dataset.orderId;
      const newStatus = target.value;
      try {
        const res = await fetch('/api/admin/update-order-status', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderId, status: newStatus })
        });
        if (!res.ok) { const errData = await res.json().catch(() => ({})); throw new Error(errData.error || "Unknown API error"); }
        const row = target.closest('tr');
        const badge = row?.querySelector('[class*="rounded-full"]');
        if (badge) badge.textContent = newStatus.replace('_', ' ');
      } catch {
        alert('Failed to update status');
      }
    });
  });
</script>







