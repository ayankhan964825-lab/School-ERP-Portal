            <div>
              <div class="text-sm font-semibold text-secondary">Deactivate</div>
              <div class="text-xs text-secondary/40">Block admin access</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Danger zone -->
      <div id="edit-danger-container" class="border border-red-100 bg-red-50/50 rounded-xl p-4">
        <p class="text-xs font-semibold text-red-600 mb-1 flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          Danger Zone
        </p>
        <p class="text-xs text-red-500/80 mb-3">Deactivating this account will immediately revoke all admin access for this user.</p>
        <div class="flex justify-end pt-2 border-t border-red-100">
          <button type="button" onclick="handleDeleteStaff()" class="text-xs font-semibold text-red-600 hover:text-red-800 transition-colors underline flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            Delete this staff member completely
          </button>
        </div>
      </div>

      <div class="pt-1 flex gap-3">
        <button type="button" onclick="closeEditModal()" class="flex-1 px-4 py-2.5 text-sm font-medium text-secondary/60 bg-gray-100 hover:bg-gray-200 rounded-xl transition-colors">
          Cancel
        </button>
        <button type="submit" class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-semibold bg-primary text-white rounded-xl hover:bg-primary/90 active:scale-95 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          Save Changes
        </button>
      </div>
    </form>
  </div>
</div>


<!-- ======================== -->
<!-- Reset Password Modal     -->
<!-- ======================== -->
<div id="reset-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeResetModal()"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6 space-y-4">
    <h3 class="text-base font-semibold text-secondary" id="reset-modal-name">Reset Staff Password</h3>
    <p class="text-xs text-secondary/60">Set a new password for this staff member. This will clear their reset request.</p>
    <input type="hidden" id="reset-staff-id" />
    <div>
      <label class="block text-xs font-semibold text-secondary/70 mb-1.5 uppercase tracking-wider">New Password</label>
      <input type="text" id="reset-new-password" placeholder="Enter new password (min 6 chars)"
        class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition font-mono" />
    </div>
    <div class="flex gap-3 mt-4">
      <button type="button" onclick="closeResetModal()" class="flex-1 px-4 py-2.5 text-sm font-medium text-secondary/60 bg-gray-100 hover:bg-gray-200 rounded-xl transition-colors">Cancel</button>
      <button type="button" onclick="submitResetPassword()" class="flex-1 px-4 py-2.5 text-sm font-semibold bg-primary text-white rounded-xl hover:bg-primary/90 active:scale-95 transition-all">Reset Password</button>
    </div>
  </div>
</div>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-6 right-6 z-[60] hidden">
  <div class="flex items-center gap-3 bg-secondary text-white text-sm font-medium px-5 py-3.5 rounded-2xl shadow-2xl">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
    </svg>
    <span id="toast-message">Action completed</span>
  </div>
</div>

<style>
  @keyframes modal-in {
    from { opacity: 0; transform: translateY(16px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .animate-modal {
    animation: modal-in 0.22s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
</style>

<script data-astro-rerun>
  // ── Toast ──────────────────────────────────────────────
  function showToast(msg) {
    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toast-message');
    toastMsg.textContent = msg;
    toast.classList.remove('hidden');
    toast.classList.add('flex');
    setTimeout(() => {
      toast.classList.add('hidden');
      toast.classList.remove('flex');
    }, 3500);
  }

  // -- Invite Modal
  const PERM_SECTIONS = ['reports', 'orders_all', 'orders_b2b', 'orders_pos', 'orders_manual', 'orders_bulk', 'batch_invoice', 'orders_returns', 'orders_tracking', 'products', 'inventory', 'categories', 'flash_sales', 'bulk_upload', 'media', 'customers', 'reviews', 'feedback', 'coupons', 'milestones', 'affiliates', 'affiliate_offers', 'blog', 'hero', 'seo', 'marketing', 'notifications', 'shipping_rates', 'shipping_riders', 'finance_wallet', 'finance_health', 'finance_calculator', 'finance_remittance', 'finance_expenses', 'finance_pnl', 'staff', 'activity', 'settings', 'store_details', 'settings_domains', 'settings_mobile', 'settings_locations', 'whatsapp', 'website_config', 'website_themes', 'website_designs', 'website_videos', 'website_navigation', 'website_announcement', 'custom_1', 'custom_2', 'custom_3'];

  const inviteModal    = document.getElementById('invite-modal');
  const inviteBackdrop = document.getElementById('invite-backdrop');
  const openInviteBtn  = document.getElementById('open-invite-modal');
  const closeInviteBtn = document.getElementById('close-invite-modal');

  function openInviteModal() {
    inviteModal.classList.remove('hidden');
    inviteModal.classList.add('flex');
  }
  window.openInviteModal = openInviteModal;

  function closeInviteModal() {
    inviteModal.classList.add('hidden');
    inviteModal.classList.remove('flex');
    document.getElementById('invite-form').reset();
    document.getElementById('invite-custom-role').value = '';
    PERM_SECTIONS.forEach(s => {
      const el = document.querySelector('input[name="invite-perm-' + s + '"][value="none"]');
      if (el) el.checked = true;
    });
  }

  openInviteBtn.addEventListener('click', openInviteModal);
  closeInviteBtn.addEventListener('click', closeInviteModal);
  inviteBackdrop.addEventListener('click', closeInviteModal);

  function getInvitePermissions() {
    const perms = {};
    PERM_SECTIONS.forEach(s => {
      const checked = document.querySelector('input[name="invite-perm-' + s + '"]:checked');
      perms[s] = checked ? checked.value : 'none';
    });
    return perms;
  }

  window.handleRoleSelect = function(role) {}; // Kept for compatibility

  window.handleInvite = function handleInvite(e) {
    e.preventDefault();
    const name            = document.getElementById('invite-name').value;
    const email           = document.getElementById('invite-email').value;
    const password        = document.getElementById('invite-password').value;
    const hierarchy_level = parseInt(document.getElementById('invite-hierarchy').value, 10);
    const recoveryEl = document.getElementById('invite-recovery');
    const recovery_method = recoveryEl ? recoveryEl.value : 'contact_admin';
    const customRole      = document.getElementById('invite-custom-role').value.trim();
    const role            = customRole || 'staff';
    const permissions     = getInvitePermissions();

    fetch('/api/admin/staff', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'create', name, email, password, role, permissions, hierarchy_level, recovery_method }),
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        closeInviteModal();
        showToast('Staff member ' + name + ' added successfully!');
        setTimeout(() => window.location.reload(), 1500);
      } else {
        alert('Error: ' + (data.error || 'Failed to add staff') + (data.details ? '\nDetails: ' + data.details : ''));
      }
    })
    .catch(() => alert('Network error'));
  }

  // ── Edit Modal ─────────────────────────────────────────
  const editModal    = document.getElementById('edit-modal');
  const editBackdrop = document.getElementById('edit-backdrop');
  const closeEditBtn = document.getElementById('close-edit-modal');

  window.openEditModal = function openEditModal(btn) {
    const name   = btn.dataset.staffName   || '';
    const email  = btn.dataset.staffEmail  || '';
    const status = btn.dataset.staffStatus || 'active';
    const id     = btn.dataset.staffId     || '';
    let perms = {};
    try { perms = JSON.parse(btn.dataset.staffPermissions || '{}'); } catch(e) {}

    document.getElementById('edit-modal-title').textContent = 'Edit - ' + name;
    document.getElementById('edit-modal-subtitle').textContent = 'Modify permissions or account status for ' + name;
    document.getElementById('edit-staff-id').value = id;
    document.getElementById('edit-email').value = email;
    document.getElementById('edit-password').value = '';
    
    const recoverySelect = document.getElementById('edit-recovery');
    if (recoverySelect) {
      recoverySelect.value = btn.dataset.staffRecovery || 'contact_super';
    }

    // Set permissions radio buttons
    PERM_SECTIONS.forEach(s => {
      const val = perms[s] || 'none';
      const el = document.querySelector('input[name="edit-perm-' + s + '"][value="' + val + '"]');
      if (el) el.checked = true;
    });

    if (status === 'active') {
      document.getElementById('edit-status-active').checked = true;
    } else {
      document.getElementById('edit-status-inactive').checked = true;
    }

    if (id === 'staff-owner') {
      document.getElementById('edit-permissions-container').classList.add('hidden');
      document.getElementById('edit-status-container').classList.add('hidden');
      document.getElementById('edit-danger-container').classList.add('hidden');
    } else {
      document.getElementById('edit-permissions-container').classList.remove('hidden');
      document.getElementById('edit-status-container').classList.remove('hidden');
      document.getElementById('edit-danger-container').classList.remove('hidden');
    }

    editModal.classList.remove('hidden');
    editModal.classList.add('flex');
  }

  function closeEditModal() {
    editModal.classList.add('hidden');
    editModal.classList.remove('flex');
  }
  window.closeEditModal = closeEditModal;

  closeEditBtn.addEventListener('click', closeEditModal);
  editBackdrop.addEventListener('click', closeEditModal);

  function getEditPermissions() {
    const perms = {};
    PERM_SECTIONS.forEach(s => {
      const checked = document.querySelector('input[name="edit-perm-' + s + '"]:checked');
      perms[s] = checked ? checked.value : 'none';
    });
    return perms;
  }

  window.handleEdit = function handleEdit(e) {
    e.preventDefault();
    const id       = document.getElementById('edit-staff-id').value;
    const email    = document.getElementById('edit-email').value;
    const password = document.getElementById('edit-password').value;
    const status   = document.querySelector('input[name="edit-status"]:checked')?.value || 'active';
    const title    = document.getElementById('edit-modal-title').textContent || '';
    const name     = title.replace('Edit - ', '');
    const permissions = getEditPermissions();
    const recovery_method = document.getElementById('edit-recovery') ? document.getElementById('edit-recovery').value : 'contact_super';

    const payload = { action: 'update', id, email, is_active: status === 'active', status, permissions, recovery_method };
    if (password.trim() !== '') {
      payload.password = password.trim();
    }

    fetch('/api/admin/staff', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        closeEditModal();
        showToast(name + "'s permissions updated - " + status + '.');
        setTimeout(() => window.location.reload(), 1500);
      } else {
        alert('Error: ' + (data.error || 'Failed to update'));
      }
    })
    .catch(() => alert('Network error'));
  }

  window.handleDeleteStaff = function handleDeleteStaff() {
    const id = document.getElementById('edit-staff-id').value;
    const title = document.getElementById('edit-modal-title').textContent || '';
    const name = title.replace('Edit - ', '');
    
    if (id === 'staff-owner') {
      alert('You cannot delete the primary admin account.');
      return;
    }
    
    if (confirm(`Are you SURE you want to completely delete ${name}? This action cannot be undone.`)) {
      fetch('/api/admin/staff', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete', id }),
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          closeEditModal();
          showToast(name + ' deleted successfully.');
          setTimeout(() => window.location.reload(), 1500);
        } else {
          alert('Error: ' + data.error);
        }
      });
    }
  }

  function toggleStatus(btn) {
    const current = btn.dataset.status || 'active';
    const next    = current === 'active' ? 'inactive' : 'active';
    btn.dataset.status = next;

    const dot  = btn.querySelector('span');
    if (next === 'active') {
      btn.classList.replace('bg-gray-200', 'bg-green-400');
      dot.classList.replace('translate-x-1', 'translate-x-6');
    } else {
      btn.classList.replace('bg-green-400', 'bg-gray-200');
      dot.classList.replace('translate-x-6', 'translate-x-1');
    }

    // Update status text sibling
    const statusText = btn.previousElementSibling;
    if (statusText) {
      statusText.textContent = next === 'active' ? 'Active' : 'Inactive';
      statusText.className = `text-xs font-medium ${next === 'active' ? 'text-green-600' : 'text-gray-400'}`;
    }

    // Update green dot on avatar
    const card = btn.closest('.bg-white');
    const avatarDot = card?.querySelector('.absolute.-bottom-1.-right-1');
    if (avatarDot) {
      if (next === 'active') {
        avatarDot.classList.replace('bg-gray-300', 'bg-green-400');
      } else {
        avatarDot.classList.replace('bg-green-400', 'bg-gray-300');
      }
    }

    // API call to persist toggle
    const staffId = btn.dataset.staffId || '';
    fetch('/api/admin/staff', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'toggle_status', id: staffId, is_active: next === 'active' }),
    }).catch(err => console.error('Failed to toggle status:', err));

    showToast(`Account ${next === 'active' ? 'activated' : 'deactivated'} successfully.`);
  }

    // ── Keyboard ESC ───────────────────────────────────────
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!inviteModal.classList.contains('hidden')) closeInviteModal();
        if (!editModal.classList.contains('hidden'))   closeEditModal();
      }
    });

    // ── AI Action Handler (from PageAiPanel) ──────────────────────────────
    document.addEventListener('ai-action', function(e) {
      var action = e.detail.action;
      var params = e.detail.params || {};

      if (action === 'open_invite_form') {
        var btn = document.getElementById('open-invite-modal');
        if (btn) btn.click();
        
        if (params.name) document.getElementById('invite-name').value = params.name;
        if (params.email) document.getElementById('invite-email').value = params.email;
        if (params.role) {
          document.getElementById('invite-role').value = params.role;
          document.getElementById('invite-role').dispatchEvent(new Event('change'));
        }
        
        if (params.name || params.email || params.role) {
           const submitBtn = document.querySelector('#invite-form button[type="submit"]');
           if (submitBtn) {
             const orig = submitBtn.innerHTML;
             submitBtn.innerHTML = '✨ Review & Send Invite';
             submitBtn.classList.add('ring-2', 'ring-violet-500', 'ring-offset-2');
             setTimeout(() => {
               submitBtn.innerHTML = orig;
               submitBtn.classList.remove('ring-2', 'ring-violet-500', 'ring-offset-2');
             }, 4000);
           }
        }
      }
      else if (action === 'navigate') {
        if (params.url) window.location.href = params.url;
      }
    });

    // ── Password Recovery Requests JS ──
    const callerHierarchy = parseInt(document.querySelector('meta[name="admin-hierarchy"]')?.getAttribute('content') || '5', 10);
    if (callerHierarchy <= 3) {
      loadRecoveryRequests();
    }

    async function loadRecoveryRequests() {
      try {
        const res = await fetch('/api/admin/password-recovery');
        const data = await res.json();
        const listEl = document.getElementById('recovery-requests-list');
        const countBadge = document.getElementById('recovery-count-badge');
        
        if (!data.success) {
          if (listEl) listEl.innerHTML = `<div class="p-4 text-red-500 text-sm">Failed to load requests: ${data.error}</div>`;
          return;
        }

        const pending = data.requests.filter((r) => r.status === 'pending');
        if (countBadge) countBadge.textContent = `${pending.length} pending`;

        if (pending.length === 0) {
          if (listEl) listEl.innerHTML = `
            <div class="bg-white rounded-2xl border border-gray-100 p-6 text-center text-sm text-secondary/40">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto mb-2 text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              No pending recovery requests
            </div>
          `;
          return;
        }

        if (listEl) {
          listEl.innerHTML = pending.map((req) => `
            <div class="bg-white rounded-2xl border border-orange-100 shadow-sm p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-sm font-semibold text-secondary">${req.requester_name}</span>
                  <span class="text-[10px] bg-gray-100 px-2 py-0.5 rounded-full font-medium">Level ${req.requester_level}</span>
                </div>
                <p class="text-xs text-secondary/60 mb-2">${req.requester_email}</p>
                ${req.message ? `<div class="text-xs bg-orange-50 text-orange-800 p-2 rounded-lg italic">"${req.message}"</div>` : ''}
                <div class="text-[10px] text-secondary/40 mt-2">Requested via ${req.recovery_method.replace('_', ' ')} on ${new Date(req.created_at).toLocaleString()}</div>
              </div>
              <div class="flex items-center gap-2 w-full sm:w-auto">
                <button onclick="openApproveModal('${req.id}', '${req.requester_id}', ${req.requester_level}, '${req.requester_name}')" class="flex-1 sm:flex-none px-3 py-1.5 text-xs font-semibold bg-orange-500 hover:bg-orange-600 text-white rounded-lg transition-colors">
                  Change Password
                </button>
                <button onclick="rejectRequest('${req.id}', '${req.requester_id}')" class="flex-1 sm:flex-none px-3 py-1.5 text-xs font-medium text-red-500 hover:bg-red-50 rounded-lg transition-colors">
                  Dismiss Request
                </button>
              </div>
            </div>
          `).join('');
        }
      } catch (err) {
        console.error(err);
      }
    }

    window.openApproveModal = function(requestId, staffId, staffLevel, staffName) {
      document.getElementById('approve-modal').classList.remove('hidden');
      document.getElementById('approve-modal').classList.add('flex');
      document.getElementById('approve-request-id').value = requestId;
      document.getElementById('approve-staff-id').value = staffId;
      document.getElementById('approve-staff-level').value = staffLevel;
      document.getElementById('approve-modal-desc').textContent = `Set a new password for ${staffName}.`;
      document.getElementById('approve-new-password').value = '';
    }

    function closeApproveModal() {
      document.getElementById('approve-modal').classList.add('hidden');
      document.getElementById('approve-modal').classList.remove('flex');
    }
    window.closeApproveModal = closeApproveModal;

    window.submitApprove = async function() {
      const requestId = document.getElementById('approve-request-id').value;
      const staffId = document.getElementById('approve-staff-id').value;
      const staffLevel = parseInt(document.getElementById('approve-staff-level').value, 10);
      const newPassword = document.getElementById('approve-new-password').value;

      if (!newPassword || newPassword.length < 6) {
        alert('Password must be at least 6 characters.');
        return;
      }

      try {
        const res = await fetch('/api/admin/password-recovery', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'approve', request_id: requestId, staff_id: staffId, staff_level: staffLevel, new_password: newPassword })
        });
        const data = await res.json();
        if (data.success) {
          alert('Password reset successfully!');
          closeApproveModal();
          loadRecoveryRequests();
        } else {
          alert('Error: ' + data.error);
        }
      } catch (e) {
        alert('Network error');
      }
    }

    window.rejectRequest = async function(requestId, staffId) {
      if (!confirm('Are you sure you want to reject this request?')) return;
      try {
        const res = await fetch('/api/admin/password-recovery', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'reject', request_id: requestId, staff_id: staffId, reason: 'Rejected by admin' })
        });
        const data = await res.json();
        if (data.success) {
          loadRecoveryRequests();
        } else {
          alert('Error: ' + data.error);
        }
      } catch (e) {
        alert('Network error');
      }
    }

  
    function openResetModal(btn) {
      document.getElementById('reset-staff-id').value = btn.dataset.staffId;
      document.getElementById('reset-modal-name').textContent = 'Reset Password for ' + btn.dataset.staffName;
      document.getElementById('reset-new-password').value = '';
      document.getElementById('reset-modal').classList.remove('hidden');
      document.getElementById('reset-modal').classList.add('flex');
    }
    function closeResetModal() {
      document.getElementById('reset-modal').classList.add('hidden');
      document.getElementById('reset-modal').classList.remove('flex');
    }
    async function submitResetPassword() {
      var id = document.getElementById('reset-staff-id').value;
      var newPass = document.getElementById('reset-new-password').value;
      if (newPass.length < 6) return alert("Password must be at least 6 characters.");
      
      try {
        const res = await fetch('/api/admin/staff', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'admin_reset_password', id: id, new_password: newPass })
        });
        const result = await res.json();
        if (result.success) {
          window.location.reload();
        } else {
          alert(result.error || "Failed to reset password");
        }
      } catch(e) {
        alert("Error resetting password");
      }
    }

</script>

</AdminLayout>
