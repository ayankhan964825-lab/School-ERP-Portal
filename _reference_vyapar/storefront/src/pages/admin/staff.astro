---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageAiPanel from '../../components/admin/PageAiPanel.astro';
import { getStaff, getSettings } from '../../lib/database';
import { getPermissionContext } from '../../lib/permissions';

const dbStaff = await getStaff();
const currentSettings = await getSettings(Astro.locals?.storeId);
let pc = currentSettings.pages_content;
if (typeof pc === 'string') { try { pc = JSON.parse(pc); } catch {} }
const customEmail = (pc && typeof pc === 'object' && pc.super_admin_custom_email) ? pc.super_admin_custom_email : null;
const customName = (pc && typeof pc === 'object' && pc.super_admin_custom_name) ? pc.super_admin_custom_name : 'Super Admin';
const adminEmail = (customEmail || import.meta.env.ADMIN_EMAIL || process.env.ADMIN_EMAIL || '').toLowerCase();

// Use centralized permission context
const ctx = getPermissionContext(Astro.cookies);
const callerHierarchy = ctx.hierarchyLevel;
const isOriginalSuperAdmin = ctx.isOriginalSuperAdmin;
const callerName = ctx.adminName;
const callerRole = ctx.adminRole;
const callerEmail = ctx.adminId ? '' : adminEmail;

const callerPerms: Record<string, string> = isOriginalSuperAdmin ? {} : (ctx.permissions || {});
function getCallerPerm(key: string): 'manage' | 'view' | 'none' {
  if (isOriginalSuperAdmin) return 'manage';
  const p = callerPerms[key];
  return (p === 'manage' || p === 'view') ? p : 'none';
}

// Hierarchy levels display
const HIERARCHY_LABELS: Record<number, string> = {
  0: 'Original Super Admin',
  1: 'Super Admin',
  2: 'Admin',
  3: 'Manager',
  4: 'Moderator',
  5: 'Staff',
};

// Build staff list — always include owner as first member
const owner = {
  id: 'staff-owner',
  name: customName,
  email: adminEmail,
  role: 'super_admin',
  hierarchy_level: 0,
  lastLogin: 'Today',
  status: 'active',
  initials: customName.split(' ').map((w: string) => w[0]).join('').toUpperCase().slice(0, 2),
  is_primary: true,
};
const otherStaff = dbStaff.filter((s: any) => s.id !== 'staff-owner').map((s: any) => ({
  ...s,
  initials: s.initials || (s.name || '').split(' ').map((w: string) => w[0]).join('').toUpperCase().slice(0, 2),
  lastLogin: s.lastLogin || (s.created_at ? new Date(s.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : 'Never'),
  status: s.is_active === false ? 'inactive' : (s.status || 'active'),
  hierarchy_level: s.hierarchy_level ?? 5,
}));

// Only show staff below caller's level (Original SA sees all)
const allStaff = [owner, ...otherStaff];
const staffMembers = isOriginalSuperAdmin 
  ? allStaff 
  : allStaff.filter((s: any) => (s.hierarchy_level ?? 5) > callerHierarchy);

const staffForAI = JSON.stringify(staffMembers.map((s: any) => ({
  id: s.id,
  name: s.name,
  email: s.email,
  role: s.role,
  status: s.status,
  lastLogin: s.lastLogin
})));

interface Permission {
  label: string;
  super_admin: boolean;
  admin: boolean;
  manager: boolean;
  custom: string;
}

const permissions: Permission[] = [
  { label: 'Reports',            super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Orders',             super_admin: true, admin: true,  manager: true,  custom: 'Variable' },
  { label: 'Batch Print',        super_admin: true, admin: true,  manager: true,  custom: 'Variable' },
  { label: 'Products',           super_admin: true, admin: true,  manager: true,  custom: 'Variable' },
  { label: 'Categories',         super_admin: true, admin: true,  manager: true,  custom: 'Variable' },
  { label: 'Flash Sales',        super_admin: true, admin: true,  manager: true,  custom: 'Variable' },
  { label: 'Bulk Upload',        super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Media',              super_admin: true, admin: true,  manager: true,  custom: 'Variable' },
  { label: 'Customers',          super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Reviews',            super_admin: true, admin: true,  manager: true,  custom: 'Variable' },
  { label: 'Feedback & B2B',     super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Coupons',            super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Milestones',         super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Blog',               super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Hero Banner',        super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'SEO Settings',       super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Marketing',          super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Notifications',      super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Shipping Rates',     super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Finance',            super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Staff Accounts',     super_admin: true, admin: false, manager: false, custom: 'Variable' },
  { label: 'Activity Logs',      super_admin: true, admin: false, manager: false, custom: 'Variable' },
  { label: 'API Settings',       super_admin: true, admin: false, manager: false, custom: 'Variable' },
  { label: 'Store Details',      super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'WhatsApp Auto',      super_admin: true, admin: true,  manager: false, custom: 'Variable' },
  { label: 'Website Config',     super_admin: true, admin: true,  manager: false, custom: 'Variable' },
];

const activityLogs: any[] = [
  {
    id: 'log-1',
    user: 'Demo Staff',
    role: 'super_admin',
    action: 'Updated settings',
    target: 'Razorpay API keys updated',
    time: 'Today, 6:12 AM',
    icon: 'settings',
  },
  {
    id: 'log-2',
    user: 'Riya Sharma',
    role: 'admin',
    action: 'Added product',
    target: 'Mango Powder 500g listed',
    time: 'Yesterday, 3:45 PM',
    icon: 'product',
  },
  {
    id: 'log-3',
    user: 'Demo Staff',
    role: 'super_admin',
    action: 'Invited staff',
    target: 'riya@yourstore.com invited as Admin',
    time: 'May 18, 11:00 AM',
    icon: 'invite',
  },
  {
    id: 'log-4',
    user: 'Mohd. Asif',
    role: 'manager',
    action: 'Edited order',
    target: 'Order #ND-20451 marked as shipped',
    time: 'May 17, 2:30 PM',
    icon: 'order',
  },
  {
    id: 'log-5',
    user: 'Riya Sharma',
    role: 'admin',
    action: 'Published blog',
    target: '"5 Benefits of Dried Mango" published',
    time: 'May 15, 10:15 AM',
    icon: 'blog',
  },
];

const iconPaths: Record<string, string> = {
  settings: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  product:  'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  invite:   'M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z',
  order:    'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
  blog:     'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z',
};

const iconBgColors: Record<string, string> = {
  settings: 'bg-gray-100 text-gray-500',
  product:  'bg-orange-100 text-orange-600',
  invite:   'bg-purple-100 text-purple-600',
  order:    'bg-blue-100 text-blue-600',
  blog:     'bg-green-100 text-green-600',
};
---

<AdminLayout title="Staff Accounts | Admin Panel" description="Manage admin users and their permissions.">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
    <div>
      <h1 class="text-2xl font-serif font-bold text-secondary">Staff Accounts</h1>
      <p class="text-sm text-secondary/60 mt-1">Manage admin users and their permissions</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/admin/bulk-upload/staff" class="btn-primary !bg-white !text-primary border border-primary hover:!bg-primary/5 flex items-center justify-center gap-2 shrink-0 py-2.5 px-4 shadow-sm text-sm rounded-xl font-semibold">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        BYO-AI Bulk Gen
      </a>
      <button
        id="open-invite-modal"
        class="flex items-center gap-2 bg-primary text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-primary/90 active:scale-95 transition-all shadow-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Invite Staff
      </button>
    </div>
  </div>

  <!-- AI Assistant Panel -->
  <PageAiPanel
    page="staff"
    title="Staff Assistant"
    pageDataJson={staffForAI}
    guideTitleEn="Staff Guide"
    guideTitleHi="Staff Guide"
    guideHtml={`<ul class="space-y-2">
      <li><strong>Invite:</strong> Click "Invite Staff" to add new team members with specific roles.</li>
      <li><strong>Roles:</strong> Super Admin has full access. Admin cannot manage settings/staff. Manager has restricted view access.</li>
      <li><strong>Status:</strong> Toggle active/inactive status to temporarily suspend access.</li>
    </ul>`}
    guideHtmlHi={`<ul class="space-y-2">
      <li><strong>Invite:</strong> Naye staff ko jodney ke liye "Invite Staff" par click karein.</li>
      <li><strong>Roles:</strong> Super Admin ke paas full access hai. Admin settings/staff edit nahi kar sakte. Manager ke paas limited access hai.</li>
      <li><strong>Status:</strong> Kisi ka access rokne ke liye "Active" se "Inactive" karden.</li>
    </ul>`}
    quickActions={[
      { label: '➕ Invite Staff', query: 'naye staff ko invite karna hai' },
      { label: '👥 Team', query: 'kaun kaun staff hain abhi' },
      { label: '⚙️ Add Manager', query: 'john.doe@email.com ko as a manager invite form me fill karo' }
    ]}
  />

  <!-- Logged-in user banner -->
  <div class="mb-6 flex items-center gap-4 bg-gradient-to-r from-purple-50 to-violet-50 border border-purple-200 rounded-2xl px-6 py-4">
    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-500 to-violet-600 text-white flex items-center justify-center font-bold text-base flex-shrink-0 shadow-md">
      {callerName.slice(0,2).toUpperCase()}
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <p class="text-sm font-semibold text-secondary">{callerName}</p>
        <span class="inline-flex items-center gap-1 bg-purple-100 text-purple-700 text-xs font-bold px-2.5 py-0.5 rounded-full border border-purple-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 1l2.928 5.927L19 7.927l-4.5 4.386L15.854 19 10 16.027 4.146 19l1.354-6.687L1 7.927l6.072-.9L10 1z" clip-rule="evenodd"/>
          </svg>
          {HIERARCHY_LABELS[callerHierarchy] || callerRole}
        </span>
        {isOriginalSuperAdmin && <span class="text-[10px] bg-amber-100 text-amber-700 border border-amber-200 px-2 py-0.5 rounded-full font-semibold">Root Authority</span>}
      </div>
      <p class="text-xs text-secondary/50 mt-0.5">You are logged in · Hierarchy Level {callerHierarchy}</p>
    </div>
    <div class="hidden sm:flex flex-col items-end text-right flex-shrink-0">
      <span class="text-xs text-secondary/40">Your level</span>
      <span class="text-xs font-bold text-primary">Level {callerHierarchy}</span>
    </div>
  </div>

  <!-- Staff List -->
  <div class="mb-8">
    <h2 class="text-base font-semibold text-secondary mb-4 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      Team Members
      <span class="ml-auto text-xs text-secondary/40 font-normal">{staffMembers.length} members</span>
    </h2>

    <div class="grid grid-cols-1 gap-4">
      {staffMembers.map((member) => {
        const roleColors = {
          super_admin: { bg: 'bg-purple-100', text: 'text-purple-700', border: 'border-purple-200', avatar: 'from-purple-500 to-violet-600', dot: 'bg-purple-500', label: 'Super Admin' },
          admin:       { bg: 'bg-blue-100',   text: 'text-blue-700',   border: 'border-blue-200',   avatar: 'from-blue-500 to-indigo-600',  dot: 'bg-blue-500',   label: 'Admin'       },
          manager:     { bg: 'bg-green-100',  text: 'text-green-700',  border: 'border-green-200',  avatar: 'from-green-500 to-emerald-600', dot: 'bg-green-500',  label: 'Manager'     },
          custom:      { bg: 'bg-gray-100',   text: 'text-gray-700',   border: 'border-gray-200',   avatar: 'from-gray-500 to-slate-600',   dot: 'bg-gray-500',   label: 'Staff'       },
          viewer:      { bg: 'bg-gray-100',   text: 'text-gray-700',   border: 'border-gray-200',   avatar: 'from-gray-500 to-slate-600',   dot: 'bg-gray-500',   label: 'Staff'       },
        };
        const rc = roleColors[member.role] || roleColors.custom;
        return (
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow p-5 flex flex-col sm:flex-row items-start sm:items-center gap-5">
            <!-- Avatar -->
            <div class={`relative w-14 h-14 rounded-2xl bg-gradient-to-br ${rc.avatar} text-white flex items-center justify-center font-bold text-base flex-shrink-0 shadow-md`}>
              {member.initials}
              <span class={`absolute -bottom-1 -right-1 w-4 h-4 rounded-full border-2 border-white ${member.status === 'active' ? 'bg-green-400' : 'bg-gray-300'}`}></span>
            </div>

            <!-- Info -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap mb-0.5">
                <h3 class="text-sm font-semibold text-secondary">{member.name}</h3>
                <span class={`inline-flex items-center gap-1 ${rc.bg} ${rc.text} text-xs font-bold px-2.5 py-0.5 rounded-full border ${rc.border}`}>
                  {member.role === 'secondary_super_admin' ? 'Super Admin' : (roleColors[member.role] ? rc.label : (member.role.charAt(0).toUpperCase() + member.role.slice(1)))}
                </span>
                <span class="text-[10px] text-secondary/40 bg-gray-100 px-2 py-0.5 rounded-full font-medium">L{member.hierarchy_level ?? 5}</span>
                {member.reset_requested && (
                  <span class="inline-flex items-center gap-1 bg-red-100 text-red-700 text-[10px] font-bold px-2 py-0.5 rounded-full border border-red-200 animate-pulse">
                    Reset Requested
                  </span>
                )}
              </div>
              <p class="text-xs text-secondary/50 mb-2">{member.email}</p>
              <div class="flex items-center gap-4 flex-wrap text-xs text-secondary/40">
                <span class="flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  Last login: {member.lastLogin}
                </span>
              </div>
            </div>

            <!-- Status Toggle & Edit -->
            <div class="flex items-center gap-3 flex-shrink-0 self-end sm:self-center">
              {member.reset_requested && (
                <button
                  class="flex items-center gap-1.5 text-xs font-semibold text-white bg-red-500 hover:bg-red-600 px-3 py-2 rounded-lg transition-colors shadow-sm"
                  data-staff-id={member.id}
                  data-staff-name={member.name}
                  onclick="openResetModal(this)"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4v-3.252l1.465-1.465A6 6 0 0117 9z" />
                  </svg>
                  Set New Password
                </button>
              )}
              <!-- Status toggle -->
              {!(member.id === 'staff-owner') && (
                <div class="flex items-center gap-2">
                  <span class={`text-xs font-medium ${member.status === 'active' ? 'text-green-600' : 'text-gray-400'}`}>
                    {member.status === 'active' ? 'Active' : 'Inactive'}
                  </span>
                  <button
                    class={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none ${member.status === 'active' ? 'bg-green-400' : 'bg-gray-200'}`}
                    data-staff-id={member.id}
                    data-status={member.status}
                    aria-label="Toggle status"
                    onclick="toggleStatus(this)"
                  >
                    <span class={`inline-block h-4 w-4 rounded-full bg-white shadow-sm transform transition-transform ${member.status === 'active' ? 'translate-x-6' : 'translate-x-1'}`}></span>
                  </button>
                </div>
              )}

              <!-- Edit button -->
              {!(member.id === 'staff-owner') && (
                <button
                  class="flex items-center gap-1.5 text-xs font-semibold text-secondary/60 bg-gray-100 hover:bg-gray-200 px-3 py-2 rounded-lg transition-colors"
                  data-staff-id={member.id}
                  data-staff-name={member.name}
                  data-staff-email={member.email}
                  data-staff-status={member.status}
                  data-staff-permissions={JSON.stringify(member.permissions || {})}
                  data-staff-recovery={member.recovery_method}
                  onclick="openEditModal(this)"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                  Edit
                </button>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Roles & Permissions Matrix -->
  <div class="mb-8">
    <h2 class="text-base font-semibold text-secondary mb-4 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      Roles & Permissions Matrix
    </h2>

    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto w-full">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-gray-100 bg-gray-50/80">
              <th class="px-6 py-4 text-left text-xs font-semibold text-secondary/60 uppercase tracking-wider w-2/5">Permission</th>
              <th class="px-3 py-4 text-center">
                <div class="flex flex-col items-center gap-1">
                  <span class="inline-flex items-center gap-1 bg-purple-100 text-purple-700 text-xs font-bold px-2 py-1 rounded-full border border-purple-200">
                    Super Admin
                  </span>
                </div>
              </th>
              <th class="px-3 py-4 text-center">
                <div class="flex flex-col items-center gap-1">
                  <span class="inline-flex items-center gap-1 bg-blue-100 text-blue-700 text-xs font-bold px-2 py-1 rounded-full border border-blue-200">
                    Admin
                  </span>
                </div>
              </th>
              <th class="px-3 py-4 text-center">
                <div class="flex flex-col items-center gap-1">
                  <span class="inline-flex items-center gap-1 bg-green-100 text-green-700 text-xs font-bold px-2 py-1 rounded-full border border-green-200">
                    Manager
                  </span>
                </div>
              </th>
              <th class="px-3 py-4 text-center">
                <div class="flex flex-col items-center gap-1">
                  <span class="inline-flex items-center gap-1 bg-gray-100 text-gray-700 text-xs font-bold px-2 py-1 rounded-full border border-gray-200">
                    Staff
                  </span>
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            {permissions.map((perm, i) => (
              <tr class={`border-b border-gray-50 hover:bg-gray-50/50 transition-colors ${i % 2 === 0 ? '' : 'bg-gray-50/30'}`}>
                <td class="px-6 py-3.5 font-medium text-secondary text-sm">{perm.label}</td>
                <td class="px-3 py-3.5 text-center">
                  {perm.super_admin ? (
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-purple-100 text-purple-600">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
