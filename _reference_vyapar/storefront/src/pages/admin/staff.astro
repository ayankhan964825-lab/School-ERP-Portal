                    <span class="text-gray-300 text-lg font-light">—</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Activity Log removed as there is no real logging system yet -->

  <!-- ── Password Recovery Requests (visible to managers and above) ── -->
  {callerHierarchy <= 3 && (
    <div class="mb-8" id="recovery-requests-section">
      <h2 class="text-base font-semibold text-secondary mb-4 flex items-center gap-2">
