      if (hasVariants) {
        baseSection.classList.add('opacity-50', 'pointer-events-none', 'grayscale');
        baseSection.querySelector('h2 span').textContent = "Pricing & Inventory (Disabled)";
      } else {
        baseSection.classList.remove('opacity-50', 'pointer-events-none', 'grayscale');
        baseSection.querySelector('h2 span').textContent = "Pricing & Inventory";
      }
    }
  }

  // Monitor variants container for changes to trigger toggle
  const variantsObserver = new MutationObserver(() => updateBasePricingVisibility());
  if (variantsContainer) variantsObserver.observe(variantsContainer, { childList: true });
  updateBasePricingVisibility();

  // ── AUTO SLUG ────────────────────────────────────────────────────────
  let slugEdited = false;
  document.getElementById('slug')?.addEventListener('input', () => { slugEdited = true; });
  document.getElementById('name')?.addEventListener('input', (e) => {
    if (slugEdited) return;
    document.getElementById('slug').value = e.target.value.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  });

  // ── TAB SWITCHING & TOGGLES ─────────────────────────────────────────────────────
  const trackInventory = document.getElementById('track_inventory');
  const trackInventoryLabel = document.getElementById('track_inventory_label');
  const toggleBg = trackInventory?.parentElement.querySelector('.toggle-bg');
  const toggleDot = trackInventory?.parentElement.querySelector('.toggle-dot');
  
  function updateToggleUI() {
    if (trackInventory?.checked) {
      toggleBg?.classList.replace('bg-gray-200', 'bg-primary');
      toggleBg?.classList.replace('border-gray-200', 'border-primary');
      toggleDot?.classList.add('translate-x-5');
      if (trackInventoryLabel) trackInventoryLabel.textContent = 'Enabled';
    } else {
      toggleBg?.classList.replace('bg-primary', 'bg-gray-200');
      toggleBg?.classList.replace('border-primary', 'border-gray-200');
      toggleDot?.classList.remove('translate-x-5');
      if (trackInventoryLabel) trackInventoryLabel.textContent = 'Disabled';
    }
  }
  
  trackInventory?.addEventListener('change', updateToggleUI);
  updateToggleUI(); // Initialize

  const tabUpload  = document.getElementById('tab-upload');
  const tabGallery = document.getElementById('tab-gallery');
  const panelUpload  = document.getElementById('panel-upload');
  const panelGallery = document.getElementById('panel-gallery');
  const galleryGrid  = document.getElementById('gallery-grid');
  const galleryEmpty = document.getElementById('gallery-empty');

  tabUpload?.addEventListener('click', () => {
    tabUpload.className  = 'flex-1 py-2.5 text-sm font-medium bg-primary text-white transition-colors';
    tabGallery.className = 'flex-1 py-2.5 text-sm font-medium bg-white text-secondary hover:bg-gray-50 transition-colors';
    panelUpload.classList.remove('hidden');
    panelGallery.classList.add('hidden');
  });
  tabGallery?.addEventListener('click', () => {
    tabGallery.className = 'flex-1 py-2.5 text-sm font-medium bg-primary text-white transition-colors';
    tabUpload.className  = 'flex-1 py-2.5 text-sm font-medium bg-white text-secondary hover:bg-gray-50 transition-colors';
    panelGallery.classList.remove('hidden');
    panelUpload.classList.add('hidden');
  });

  // ── THUMBNAIL HELPERS ─────────────────────────────────────────────────
  const imageUrlInput    = document.getElementById('image_url');
  const currentThumbBox  = document.getElementById('current-thumb-box');
  const currentThumbImg  = document.getElementById('current-thumb-img');
  const currentThumbLabel= document.getElementById('current-thumb-label');

  function setThumbnail(dataUrl, label) {
    imageUrlInput.value = dataUrl;
    currentThumbImg.src = dataUrl;
    // Show friendly label — never show raw base64 in the UI
    const friendlyLabel = dataUrl.startsWith('data:')
      ? `✅ ${label || 'Uploaded image (WebP)'}`
      : (label || dataUrl);
    currentThumbLabel.textContent = friendlyLabel;
    currentThumbLabel.title = dataUrl.startsWith('data:') ? 'Compressed WebP image (stored as base64)' : dataUrl;
    currentThumbBox.classList.remove('hidden');
  }

  // Remove thumbnail
  document.getElementById('remove-thumb-btn')?.addEventListener('click', () => {
    imageUrlInput.value = '';
    currentThumbBox.classList.add('hidden');
  });

  // ── THUMBNAIL UPLOAD ─────────────────────────────────────────────────
  const thumbUpload      = document.getElementById('thumbnail-upload');
  const thumbText        = document.getElementById('thumbnail-upload-text');
  const thumbPreviewBox  = document.getElementById('thumbnail-preview-box');
  const thumbPreviewImg  = document.getElementById('thumbnail-preview-img');
  const thumbPreviewName = document.getElementById('thumbnail-preview-name');
  const thumbPreviewSize = document.getElementById('thumbnail-preview-size');
  const thumbDownloadBtn = document.getElementById('thumbnail-download-btn');

  if (thumbUpload) {
    thumbUpload.addEventListener('change', async (e) => {
      if (!canManage) {
        alert("Currently editing is disabled by developer because of certain bug. Please try again later.");
        e.target.value = '';
        return;
      }
      const file = e.target.files?.[0];
      if (!file) return;
      thumbText.textContent = '⏳ Compressing...';
      try {
        const { blob, name, origSize, newSize } = await compressToWebP(file, 800, 0.75);
        const saving = Math.round((1 - newSize / origSize) * 100);
        thumbText.textContent = '⏳ Uploading to storage...';
        
        const url = await uploadToBucket(blob, name);
        
        thumbText.textContent = `✅ ${name}`;
        thumbPreviewImg.src = url;
        thumbPreviewName.textContent = name;
        thumbPreviewSize.innerHTML = `${formatBytes(origSize)} → <strong class="text-green-700">${formatBytes(newSize)}</strong>${saving > 0 ? ` <span class="text-green-700 font-bold">(${saving}% smaller!)</span>` : ''}`;
        thumbDownloadBtn.href = url;
        thumbDownloadBtn.download = name;
        thumbPreviewBox.classList.remove('hidden');
        setThumbnail(url, name);
      } catch (err) {
        console.error(err);
        thumbText.textContent = `❌ Upload failed for ${file.name}`;
      }
    });
  }

  // ── ADD IMAGE TO GALLERY WHEN VARIANT UPLOADS ─────────────────────────
  function addToGallery(dataUrl, label) {
    galleryEmpty?.classList.add('hidden');
    galleryGrid?.classList.remove('hidden');
    const id = 'gimg_' + Math.random().toString(36).substr(2, 7);
    galleryGrid?.insertAdjacentHTML('beforeend', `
      <div class="relative group cursor-pointer" id="${id}" title="Click to set as thumbnail">
        <img src="${dataUrl}" class="w-full aspect-square object-cover rounded-xl border-2 border-transparent group-hover:border-primary transition-all" />
        <div class="absolute inset-0 bg-primary/20 opacity-0 group-hover:opacity-100 rounded-xl flex items-center justify-center transition-all">
          <span class="bg-white text-primary text-[10px] font-bold px-2 py-1 rounded-full shadow">✓ Set</span>
        </div>
      </div>
    `);
    document.getElementById(id)?.addEventListener('click', () => {
      // Remove active border from others
      galleryGrid?.querySelectorAll('img').forEach(img => img.classList.remove('border-primary', 'border-4'));
      document.getElementById(id)?.querySelector('img')?.classList.add('border-primary', 'border-4');
      setThumbnail(dataUrl, label || 'Variant image');
    });
  }

  // ── VARIANT IMAGE UPLOADS ────────────────────────────────────────────
  document.addEventListener('change', async (e) => {
    if (!e.target?.classList.contains('variant-img-upload')) return;
    if (!canManage) {
      alert("Currently editing is disabled by developer because of certain bug. Please try again later.");
      e.target.value = '';
      return;
    }
    const files = e.target.files;
    const rowId = e.target.getAttribute('data-row-id');
    const previewEl = document.getElementById(`preview_${rowId}`);
    if (!files || !previewEl) return;

    for (const file of files) {
      const isVideo = file.type.startsWith('video/');
      if (isVideo) {
        const videoUrl = URL.createObjectURL(file);
        previewEl.insertAdjacentHTML('beforeend', `
          <div class="relative flex-shrink-0">
            <video src="${videoUrl}" class="w-14 h-14 object-cover rounded-md border-2 border-blue-300" muted playsinline onmouseenter="this.play()" onmouseleave="this.pause()"></video>
            <span class="absolute top-0 left-0 text-[9px] bg-blue-600 text-white px-1 rounded font-bold">VID</span>
          </div>
        `);
      } else {
        try {
          const tempId = 'up_' + Date.now() + Math.random().toString(36).substr(2,5);
          previewEl.insertAdjacentHTML('beforeend', `<div id="${tempId}" class="w-14 h-14 bg-gray-100 animate-pulse rounded-md border-2 border-gray-200 flex items-center justify-center flex-shrink-0 text-[10px] text-gray-400">⏳</div>`);
          
          const { blob, name, origSize, newSize } = await compressToWebP(file, 800, 0.75);
          const url = await uploadToBucket(blob, name);
          
          document.getElementById(tempId)?.remove();
          
          const saving = Math.round((1 - newSize / origSize) * 100);
          previewEl.insertAdjacentHTML('beforeend', `
            <div class="relative flex-shrink-0 group">
              <img src="${url}" class="w-14 h-14 object-cover rounded-md border-2 border-green-300" />
              <button type="button" class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full p-0.5 opacity-0 group-hover:opacity-100 transition-opacity z-10 shadow" onclick="this.parentElement.remove()" title="Remove image">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
              ${saving > 0 ? `<span class="absolute top-0 right-0 text-[8px] bg-green-600 text-white px-1 rounded z-0">${saving}%</span>` : ''}
            </div>
          `);
          // Auto-add to thumbnail gallery
          addToGallery(url, name);
          // ✅ Default: first variant's first image = thumbnail (if none set yet)
          const currentThumb = document.getElementById('image_url')?.value;
          const isFirstVariantRow = document.querySelectorAll('.variant-row')[0]?.id === rowId;
          const isFirstFileInRow = previewEl.children.length === 1; // just added
          if (!currentThumb && isFirstVariantRow && isFirstFileInRow) {
            setThumbnail(url, `Default: ${name}`);
          }
        } catch (err) {
          console.error('Variant image upload error:', err);
          alert('Failed to upload image ' + file.name);
          document.getElementById(tempId)?.remove();
        }
      }
    }
  });

  // ── AI ASSISTANT ─────────────────────────────────────────────────────
  document.getElementById('btn-generate-ai')?.addEventListener('click', async () => {
    if (!canManage) {
      alert("Currently editing is disabled by developer because of certain bug. Please try again later.");
      return;
    }
    const prompt = document.getElementById('ai-prompt').value.trim();
    if (!prompt) { alert('Please enter a prompt first.'); return; }
    const btn = document.getElementById('btn-generate-ai');
    const status = document.getElementById('ai-status');
    btn.disabled = true; btn.classList.add('opacity-50'); status.classList.remove('hidden');
    try {
      // Pass existing data if any so AI can 'edit' rather than 'create' from scratch
      const currentData = typeof collectFormData === 'function' ? collectFormData() : {};
      const res = await fetch('/api/admin/generate-listing', { 
        method: 'POST', 
        headers: { 'Content-Type': 'application/json' }, 
        body: JSON.stringify({ prompt, currentData }) 
      });
      if (!res.ok) throw new Error('API failed');
      const data = await res.json();
      document.getElementById('name').value = data.name || '';
      if (!slugEdited && data.name) {
        document.getElementById('slug').value = data.name.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      }
      if (data.category) {
        const genCat = String(data.category).toLowerCase().trim();
        const catSelect = document.getElementById('category');
        if (catSelect) {
          const option = Array.from(catSelect.options).find(o => 
            String(o.value).toLowerCase().trim() === genCat || 
            String(o.text).toLowerCase().trim() === genCat ||
            String(o.value).replace(/-/g, ' ') === genCat.replace(/-/g, ' ')
          );
          if (option) {
            catSelect.value = option.value;
          } else {
            catSelect.insertAdjacentHTML('beforeend', `<option value="${data.category}" selected>${data.category} (AI)</option>`);
            catSelect.value = data.category;
          }
        }
      }
      document.getElementById('description').value = data.description || '';
      document.getElementById('long_description').value = data.long_description || '';
      if (typeof quill !== 'undefined' && quill) {
        quill.root.innerHTML = data.long_description || '';
      }
      if (data.hsn_code) document.getElementById('hsn_code').value = data.hsn_code;
      if (data.gst_rate !== undefined) document.getElementById('gst_rate').value = data.gst_rate;
      
      specsContainer.innerHTML = '';
      if (customSectionsContainer) customSectionsContainer.innerHTML = '';
      if (data.specifications) {
        Object.entries(data.specifications).forEach(([k, v]) => {
          if (k.startsWith('_section_')) {
            createCustomSectionRow(k.replace('_section_', ''), v);
          } else if (!k.startsWith('_')) {
            createSpecRow(k, v);
          }
        });
      }

      bulletsContainer.innerHTML = ''; if (data.bullet_points) data.bullet_points.forEach(b => createBulletRow(b));
      
      if (data.badges && data.badges.length > 0) {
        badgesContainer.innerHTML = '';
        data.badges.forEach(b => createBadgeRow(b));
      }
      
      // Apply SEO, Vendor, Tags from AI
      if (data.seo_title) document.getElementById('seo_title').value = data.seo_title;
      if (data.seo_description) document.getElementById('seo_description').value = data.seo_description;
      if (data.seo_keywords) document.getElementById('seo_keywords').value = data.seo_keywords;
      if (data.vendor) document.getElementById('vendor').value = data.vendor;
      if (data.tags) document.getElementById('tags').value = Array.isArray(data.tags) ? data.tags.join(', ') : data.tags;
      
      
      if (data.variants && data.variants.length > 0) {
        // If variants container has only empty variants, clear it before adding AI generated ones
        const existingRows = variantsContainer.querySelectorAll('.variant-row');
        let hasData = false;
        existingRows.forEach(row => {
          if (row.querySelector('.variant-weight')?.value || row.querySelector('.variant-price')?.value || row.querySelector('.variant-img-upload')?.files?.length) hasData = true;
        });
        if (!hasData) variantsContainer.innerHTML = '';
        
        data.variants.forEach(v => createVariantRow(v.weight, v.price, v.mrp));
      }
    } catch (err) { alert('Failed to generate. Check console.'); console.error(err); }
    finally { btn.disabled = false; btn.classList.remove('opacity-50'); status.classList.add('hidden'); }
  });

  // ── COLLECT & SUBMIT ─────────────────────────────────────────────────
  function collectFormData() {
    // Sync Quill content to textarea before collecting
    if (typeof quill !== 'undefined' && quill) {
      const html = quill.root.innerHTML;
      document.getElementById('long_description').value = html === '<p><br></p>' ? '' : html;
    }
    
    const variants = [];
    document.querySelectorAll('.variant-row').forEach((row, i) => {
      const weight = row.querySelector('.variant-weight')?.value?.trim();
      const price = parseFloat(row.querySelector('.variant-price')?.value) || 0;
      const mrp = parseFloat(row.querySelector('.variant-mrp')?.value) || 0;
      const stock = 0; // Stock is managed entirely from the Inventory tab
      const sku = row.querySelector('.variant-sku')?.value?.trim() || '';
      // Gather all images in this variant's preview box
      const images = Array.from(row.querySelectorAll('.scrollbar-hide img')).map(img => img.src).filter(src => !!src);
      
      if (!weight && price === 0 && mrp === 0) return;
      
      variants.push({ id: row.dataset.variantId || `v${i+1}`, weight: weight || `Variant ${i+1}`, price, mrp, stock, sku, images });
    });
    // Specs
    const specifications = {};
    document.querySelectorAll('.spec-row').forEach(row => {
      const k = row.querySelector('.spec-key')?.value?.trim();
      const v = row.querySelector('.spec-val')?.value?.trim();
      if (k) specifications[k] = v || '';
    });

    document.querySelectorAll('.custom-section-row').forEach(row => {
      const heading = row.querySelector('.sec-heading').value.trim();
      if (!heading) return;
      const q = row.__quill;
      if (q) {
        const html = q.root.innerHTML;
        if (html !== '<p><br></p>' && html.trim()) {
          specifications['_section_' + heading] = html;
        }
      }
    });

    // Badges
    const badges = [];
    document.querySelectorAll('.badge-val').forEach(el => { if (el.value.trim()) badges.push(el.value.trim()); });
    // Bullets
    const bullet_points = [];
    document.querySelectorAll('.bullet-val').forEach(el => { if (el.value.trim()) bullet_points.push(el.value.trim()); });

    
    const variant_options = typeof getVGroups === 'function' ? getVGroups() : [];
    // Only collect enabled variants
    const activeVariants = variants.filter((_, i) => {
      const rows = document.querySelectorAll('.variant-row');
      const row = rows[i];
      if (!row) return true;
      const cb = row.querySelector('.variant-active');
      return !cb || cb.checked;
    });
    let minPrice = 0, maxMrp = 0;
    
    // Read base pricing
    const bPrice = parseFloat(document.getElementById('base_price')?.value) || 0;
    const bMrp = parseFloat(document.getElementById('base_mrp')?.value) || 0;
    const bSku = document.getElementById('base_sku')?.value?.trim() || '';
    const bBarcode = document.getElementById('base_barcode')?.value?.trim() || '';
    const bWeight = document.getElementById('base_weight_kg')?.value?.trim() || '';
    const bLength = document.getElementById('base_length')?.value?.trim() || '';
    const bWidth = document.getElementById('base_width')?.value?.trim() || '';
    const bHeight = document.getElementById('base_height')?.value?.trim() || '';

    if (bSku) specifications._base_sku = bSku;
    if (bBarcode) specifications._base_barcode = bBarcode;
    if (bWeight) specifications._base_weight_kg = bWeight;
    if (bLength) specifications._base_length = bLength;
    if (bWidth) specifications._base_width = bWidth;
    if (bHeight) specifications._base_height = bHeight;

    // SEO, Vendor, Tags → stored in specifications with _ prefix
    const seoTitle = document.getElementById('seo_title')?.value?.trim() || '';
    const seoDesc = document.getElementById('seo_description')?.value?.trim() || '';
    const seoKeywords = document.getElementById('seo_keywords')?.value?.trim() || '';
    const vendorVal = document.getElementById('vendor')?.value?.trim() || '';
    const tagsVal = document.getElementById('tags')?.value?.trim() || '';
    if (seoTitle) specifications._seo_title = seoTitle;
    if (seoDesc) specifications._seo_description = seoDesc;
    if (seoKeywords) specifications._seo_keywords = seoKeywords;
    if (vendorVal) specifications._vendor = vendorVal;
    if (tagsVal) specifications._tags = tagsVal;

    if (activeVariants.length > 0) {
      const validPrices = activeVariants.map(v => v.price).filter(p => !isNaN(p) && p > 0);
      const validMrps = activeVariants.map(v => v.mrp).filter(m => !isNaN(m) && m > 0);
      minPrice = validPrices.length > 0 ? Math.min(...validPrices) : 0;
      maxMrp = validMrps.length > 0 ? Math.max(...validMrps) : 0;
      
      // Clear base properties from spec when using variants to prevent data inconsistency
      delete specifications._base_sku;
      delete specifications._base_barcode;
      delete specifications._base_weight_kg;
      delete specifications._base_length;
      delete specifications._base_width;
      delete specifications._base_height;
    } else {
      minPrice = bPrice;
      maxMrp = bMrp;
    }


    const isDigital = document.getElementById('is_digital')?.checked || false;
    const deliveryType = document.getElementById('delivery_type')?.value || 'both';
    const isQCommerceOnly = deliveryType === 'q_commerce_only';
    const isStandardOnly = deliveryType === 'standard_only';

    return {
      name: document.getElementById('name').value.trim(),
      slug: document.getElementById('slug').value.trim(),
      category: document.getElementById('category').value,
      description: document.getElementById('description').value.trim(),
      long_description: document.getElementById('long_description').value.trim(),
      rating_value: parseFloat(document.getElementById('rating_value').value) || 0,
      rating_count: parseInt(document.getElementById('rating_count').value) || 0,
      is_in_stock: document.getElementById('is_in_stock').value === 'true',
      is_active: document.getElementById('is_active').value === 'true',
      track_inventory: document.getElementById('track_inventory').checked,
      image: document.getElementById('image_url').value || `/products/${document.getElementById('slug').value}.webp`,
      price: minPrice,
      original_price: maxMrp,
      hsn_code: document.getElementById('hsn_code')?.value.trim() || null,
      gst_rate: document.getElementById('gst_rate')?.value ? parseFloat(document.getElementById('gst_rate').value) : null,
      variant_options,
      variants: activeVariants,
      specifications,
      badges,
      bullet_points,
      is_digital: isDigital,
      is_q_commerce_only: isQCommerceOnly,
      is_standard_only: isStandardOnly,
      digital_delivery_url: document.getElementById('digital_delivery_url')?.value?.trim() || null,
      custom_inputs: Array.from(document.querySelectorAll('.custom-field-row')).map(row => {
        const id = row.querySelector('.cf-id')?.value?.trim() || '';
        const label = row.querySelector('.cf-label')?.value?.trim() || '';
        const type = row.querySelector('.cf-type')?.value || 'text';
        const required = row.querySelector('.cf-req')?.checked || false;
        const optionsStr = row.querySelector('.cf-options')?.value?.trim() || '';
        const options = type === 'select' ? optionsStr.split(',').map(o => o.trim()).filter(o => o) : [];
        return id ? { id, label, type, required, options } : null;
      }).filter(Boolean),
    };
  }

  function showStatus(msg, isError = false) {
    const el = document.getElementById('save-status');
    el.className = `mb-6 p-4 rounded-xl text-sm font-medium flex items-center gap-2 ${isError ? 'bg-red-50 text-red-800 border border-red-200' : 'bg-green-50 text-green-800 border border-green-200'}`;
    el.innerHTML = `<span>${isError ? '❌' : '✅'}</span> ${msg}`;
    el.classList.remove('hidden');
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.getElementById('product-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!canManage) {
      alert("Currently editing is disabled by developer because of certain bug. Please try again later.");
      return;
    }
    const saveBtn = document.getElementById('save-btn-top');
    saveBtn.innerHTML = `<svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Saving...`;
    saveBtn.disabled = true;

    const data = collectFormData();
    let body = {};

    if (productId && initialProduct) {
      // Parse arrays that might be stored as strings in initialProduct
      const parseJsonSafe = (val) => {
        if (typeof val === 'string' && val.trim().startsWith('[')) { try { return JSON.parse(val); } catch (e) { return val; } }
        if (typeof val === 'string' && val.trim().startsWith('{')) { try { return JSON.parse(val); } catch (e) { return val; } }
        return val;
      };

      const oldData = {
        name: initialProduct.name || '',
        slug: initialProduct.slug || '',
        category: initialProduct.category || '',
        description: initialProduct.description || '',
        long_description: initialProduct.long_description || '',
        rating_value: parseFloat(initialProduct.rating?.value || initialProduct.rating) || 0,
        rating_count: parseInt(initialProduct.rating?.count || initialProduct.reviews_count) || 0,
        is_in_stock: initialProduct.is_in_stock !== false,
        is_active: initialProduct.is_active !== false,
        track_inventory: initialProduct.track_inventory === true,
        image: initialProduct.image || `/products/${initialProduct.slug || ''}.webp`,
        price: initialProduct.price || 0,
        original_price: initialProduct.original_price || 0,
        hsn_code: initialProduct.hsn_code || null,
        gst_rate: initialProduct.gst_rate !== undefined && initialProduct.gst_rate !== null ? parseFloat(initialProduct.gst_rate) : null,
        variant_options: parseJsonSafe(initialProduct.variant_options) || [],
        variants: parseJsonSafe(initialProduct.variants) || [],
        specifications: parseJsonSafe(initialProduct.specifications || initialProduct.specs) || {},
        badges: parseJsonSafe(initialProduct.badges) || [],
        bullet_points: parseJsonSafe(initialProduct.bullet_points) || [],
        is_digital: initialProduct.is_digital === true,
        digital_delivery_url: initialProduct.digital_delivery_url || null,
        custom_inputs: parseJsonSafe(initialProduct.custom_inputs) || [],
      };

      // Find changed fields
      for (const key in data) {
        const newVal = data[key];
        const oldVal = oldData[key];
        if (typeof newVal === 'object' && newVal !== null) {
          if (JSON.stringify(newVal) !== JSON.stringify(oldVal)) body[key] = newVal;
        } else if (newVal !== oldVal) {
          body[key] = newVal;
        }
      }

      if (Object.keys(body).length === 0) {
        showStatus('No changes detected to save.', false);
        saveBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg> Save Product`;
        saveBtn.disabled = false;
        return;
      }
      body.action = 'update';
      body.id = productId;
    } else {
      body = { action: 'create', ...data };
    }
    
    // Check total payload size to prevent Supabase 1MB limit error
    const jsonString = JSON.stringify(body);
    const payloadSizeInBytes = new Blob([jsonString]).size;
    const maxPayloadSize = 850 * 1024; // 850 KB limit
    
    if (payloadSizeInBytes > maxPayloadSize) {
      showStatus(`Error: Form data is too large (${(payloadSizeInBytes / 1024).toFixed(0)} KB).`, true);
      saveBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg> Save Product`;
      saveBtn.disabled = false;
      return;
    }

    try {
      const res = await fetch('/api/admin/products', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: jsonString });
      const result = await res.json();
      if (result.success) {
        showStatus(productId ? 'Product successfully updated in database!' : 'Product successfully created!');
        setTimeout(() => window.location.href = '/admin/products', 1500);
      } else {
        showStatus(result.error || 'Failed to save product.', true);
        if (result.error && result.error.includes('Currently editing is disabled')) {
           alert(result.error.replace('Permission denied: ', ''));
        }
      }
    } catch (err) {
      showStatus('Network error occurred.', true);
      console.error(err);
    } finally {
      saveBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg> Save Product`;
      saveBtn.disabled = false;
    }
  });

  // ── DELETE ───────────────────────────────────────────────────────────
  document.getElementById('delete-btn')?.addEventListener('click', async () => {
    if (!canManage) {
      alert("Currently editing is disabled by developer because of certain bug. Please try again later.");
      return;
    }
    if (!confirm('Are you sure you want to delete this product? This action cannot be undone.')) return;
    try {
      const res = await fetch('/api/admin/products', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id: productId }) });
      const result = await res.json();
      if (result.success) window.location.href = '/admin/products?deleted=true';
      else showStatus('Delete failed: ' + result.error, true);
    } catch { showStatus('Network error during delete.', true); }
  });

  // ── AI Action Handler (from PageAiPanel) ──────────────────────────────
  document.addEventListener('ai-action', function(e) {
    var action = e.detail.action;
    var params = e.detail.params || {};

    if (action === 'navigate') {
      if (params.url) window.location.href = params.url;
    } else if (action === 'generate_listing') {
      if (params.prompt) {
        document.getElementById('ai-prompt').value = params.prompt;
        document.getElementById('btn-generate-ai')?.click();
      }
    }
  });
});


</script>

