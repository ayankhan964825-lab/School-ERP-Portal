---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageAiPanel from '../../../components/admin/PageAiPanel.astro';
import { getProducts, getCategories, supabaseAdmin, getStore } from '../../../lib/database';

const url = new URL(Astro.request.url);
const productId = url.searchParams.get('id');
const isEditing = !!productId;

// Permission Check
let userPermissions: Record<string, string> = {};
try { userPermissions = JSON.parse(decodeURIComponent(Astro.cookies.get('admin_permissions')?.value || '%7B%7D')); } catch {}
const adminRole = Astro.cookies.get('admin_role')?.value || 'super_admin';
const isSuperAdmin = adminRole === 'super_admin';
const canManage = isSuperAdmin || userPermissions['products'] === 'manage';

// Fetch from DB (merged with catalog data via getProducts)
let product: any = null;
if (isEditing) {
  const all = await getProducts(Astro.locals?.storeId);
  product = all.find((p: any) => p.id === productId) || null;
  if (!product) return Astro.redirect('/admin/products');
}

// Get categories from DB for dropdown
const categories = await getCategories(Astro.locals?.storeId);

const storeId = Astro.locals?.storeId;
const store = await getStore(storeId);
const isFreeTier = store?.plan_id === '00000000-0000-0000-0000-000000000005';

// Check if Q-commerce is enabled for this store
let hasQCommerce = false;
if (supabaseAdmin && Astro.locals?.storeId) {
  const { data: locs } = await supabaseAdmin
    .from('locations')
    .select('q_commerce_enabled')
    .eq('store_id', Astro.locals.storeId)
    .eq('is_active', true);
  hasQCommerce = locs?.some((l: any) => l.q_commerce_enabled) || false;
}

const productForAI = JSON.stringify({
  name: product?.name || '',
  category: product?.category || '',
  description: product?.description || '',
  variants: product?.variants || [],
  specifications: product?.specifications || {},
  badges: product?.badges || []
});
---

<AdminLayout title={isEditing ? `Edit Product | Admin Panel` : `New Product | Admin Panel`} description="Manage product details and variants.">
  <div class="max-w-7xl mx-auto px-4 pb-24">
    <!-- Header -->
    <div class="sticky top-0 z-40 bg-gray-50/90 backdrop-blur-md pb-4 pt-4 mb-6 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <a href="/admin/products" class="p-2 rounded-lg border border-gray-200 text-secondary hover:bg-white transition-colors bg-white/50 shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        </a>
        <div>
          <h1 class="text-2xl font-serif font-bold text-secondary">{isEditing ? 'Edit Product' : 'Add New Product'}</h1>
          <p class="text-sm text-secondary/60 mt-1 hidden sm:block">{isEditing ? `Editing: ${product?.name}` : 'Create a new product listing.'}</p>
        </div>
      </div>
      <div>
         <button type="submit" form="product-form" id="save-btn-top" class="btn-primary !px-6 !py-2.5 !rounded-xl font-bold flex items-center justify-center gap-2 shadow-sm w-full sm:w-auto">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
            Save Product
         </button>
      </div>
    </div>

    <!-- Status Banner -->
    <div id="save-status" class="hidden mb-6 p-4 rounded-xl text-sm font-medium flex items-center gap-2"></div>

    <form id="product-form" class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left Column: Main Content -->
      <div class="lg:col-span-8 space-y-6">

      <!-- AI Assistant Panel -->
      <PageAiPanel
    page="product_edit"
    title="Product_Edit Assistant"
        pageDataJson={productForAI}
        guideTitleEn="Product Listing Guide"
        guideTitleHi="Product Listing Guide"
        guideHtml={`<ul class="space-y-2">
          <li><strong>AI Assistant:</strong> Use the "Generate Listing" button to automatically write SEO-friendly titles, descriptions, and bullets based on a short prompt.</li>
          <li><strong>Variants:</strong> Add different sizes (e.g., 100g, 200g) with their respective prices.</li>
          <li><strong>Images:</strong> Auto-converts to WebP. You can pick variant images to be the main thumbnail.</li>
        </ul>`}
        guideHtmlHi={`<ul class="space-y-2">
          <li><strong>AI Assistant:</strong> Product details auto-generate karne ke liye prompt daalein aur Generate click karein.</li>
          <li><strong>Variants:</strong> Alag weights (jaise 100g, 500g) aur unki prices daalein.</li>
          <li><strong>Images:</strong> Sabhi images auto-compress hoti hain.</li>
        </ul>`}
        quickActions={[
          { label: '✨ Write Description', query: 'ek acha SEO description likho is product ke liye' },
          { label: '📝 Suggest Bullets', query: 'key benefits ke 5 bullet points suggest karo' }
        ]}
      />

      <!-- AI Listing Assistant -->
      <div class="bg-gradient-to-br from-primary/10 to-primary/5 p-6 rounded-2xl shadow-sm border border-primary/20">
        <div class="flex items-start gap-4">
          <div class="p-3 bg-white rounded-xl shadow-sm border border-primary/10 hidden sm:block">
            <span class="text-2xl">✨</span>
          </div>
          <div class="flex-1">
            <h2 class="text-lg font-bold text-primary mb-1">AI Listing Assistant</h2>
            <p class="text-sm text-secondary/70 mb-4">Product ka naam aur variants enter karo — AI automatically SEO description, bullets aur specifications generate karega.</p>
            <div class="space-y-3">
              <textarea id="ai-prompt" rows="3" class="w-full px-4 py-3 border border-primary/20 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary outline-none resize-none bg-white shadow-inner" placeholder="e.g. Make a listing for Mango Powder. Variants: 100g (₹200), 200g (₹380)."></textarea>
              <div class="flex justify-end items-center gap-3">
                <span id="ai-status" class="text-sm text-primary font-medium hidden flex items-center gap-2">
                  <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                  Generating...
                </span>
                <button type="button" id="btn-generate-ai" class="btn-primary !py-2 !px-6 !rounded-lg flex items-center gap-2">
                  Generate Listing ✨
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ── BASIC INFO ── -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <h2 class="text-lg font-bold text-secondary mb-4">Basic Information</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-sm font-medium text-secondary">Product Name <span class="text-red-500">*</span></label>
            <input type="text" id="name" required value={product?.name || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none" placeholder="e.g. Beetroot Powder" />
          </div>

          <div class="space-y-2">
            <label class="text-sm font-medium text-secondary">URL Slug</label>
            <input type="text" id="slug" value={product?.slug || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none font-mono text-sm" placeholder="beetroot-powder" />
            <p class="text-xs text-secondary/40">Auto-generated from name. Edit only if needed.</p>
          </div>
        </div>


        <div class="space-y-2 mt-6">
          <label class="text-sm font-medium text-secondary">Short Description <span class="text-red-500">*</span></label>
          <textarea id="description" required rows="2" class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none resize-none" placeholder="Product card pe dikhne wala short description...">{product?.description || ''}</textarea>
        </div>

        <div class="space-y-2 mt-6">
          <label class="text-sm font-medium text-secondary">Long Description (Product Page)</label>
          <textarea id="long_description" rows="5" class="hidden">{product?.long_description || ''}</textarea>
          <div id="long_description_editor" class="bg-white border border-gray-200 rounded-lg" style="min-height: 200px;"></div>
        </div>
                <!-- Dynamic Content Sections -->
        <div class="mt-8 border-t border-gray-100 pt-6">
          <div class="flex justify-between items-center mb-4">
            <div>
              <h3 class="text-sm font-bold text-secondary">Custom Sections (Accordions)</h3>
              <p class="text-xs text-secondary/60">Dynamic sections (e.g. Health Benefits, Size Guide) that appear as accordions on product page.</p>
            </div>
            <button type="button" id="add-custom-section-btn" class="text-primary text-sm font-medium hover:underline">+ Add Section</button>
          </div>
          <div id="custom-sections-container" class="space-y-4"></div>
        </div>

      </div>

      <!-- ── DIGITAL & CUSTOM PRODUCTS ── -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 mb-6">
        <h2 class="text-lg font-bold text-secondary mb-4">Product Type & Customization</h2>
        
        <div class="space-y-6">
          <!-- Digital Product Toggle -->
          <div class="col-span-1 md:col-span-2">
            {isFreeTier ? (
              <div class="flex items-start gap-3 p-4 bg-gray-50 border border-gray-200 rounded-xl opacity-75">
                <div class="flex-1">
                  <div class="flex items-center justify-between mb-1">
                    <label class="text-sm font-medium text-gray-500">Digital Product (No Shipping) 🔒</label>
                    <a href="/admin/settings/billing" class="text-[10px] uppercase font-bold tracking-wider bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full hover:bg-amber-200">Upgrade to unlock</a>
                  </div>
                  <p class="text-xs text-gray-400">Sell ebooks, courses, software, or direct download links. (Growth Plan required)</p>
                </div>
              </div>
            ) : (
            <div class="flex items-start gap-3 p-4 bg-white border border-gray-200 rounded-xl hover:border-primary/30 hover:shadow-[0_2px_10px_-3px_rgba(0,0,0,0.05)] transition-all">
              <div class="flex items-center h-5 mt-0.5">
                <input type="checkbox" id="is_digital" class="w-5 h-5 text-primary border-gray-300 rounded focus:ring-primary" checked={product?.is_digital} />
              </div>
              <div class="flex-1">
                <label for="is_digital" class="text-sm font-medium text-secondary cursor-pointer">Digital Product (No Shipping)</label>
                <p class="text-xs text-secondary/60 mt-1">If checked, physical shipping methods and COD will be disabled. Delivery type is instantly marked delivered.</p>
              </div>
            </div>
            )}
          </div>
            
            <div class="mt-4 pt-4 border-t border-gray-200" id="delivery_type_container" data-has-qc={hasQCommerce ? 'true' : 'false'}>
              <label for="delivery_type" class="text-sm font-medium text-secondary block mb-2">Delivery Type Configuration</label>
              <select id="delivery_type" class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none disabled:bg-gray-100 disabled:text-gray-500" disabled={!hasQCommerce}>
                <option value="both" selected={!product?.is_q_commerce_only && !product?.is_standard_only}>Both (Quick Commerce & Standard Delivery)</option>
                <option value="qc_only" selected={product?.is_q_commerce_only}>Only Quick Commerce (Hyperlocal Fast Delivery)</option>
                <option value="std_only" selected={product?.is_standard_only}>Only Standard Delivery (Courier / 3-4 Days)</option>
              </select>
              {!hasQCommerce ? (
                 <p class="text-xs text-amber-600 mt-2 font-medium">⚠️ Enable Quick Commerce in Location & Fulfillment to use this setting.</p>
              ) : (
                 <p class="text-xs text-secondary/60 mt-1">Select how this product can be delivered to the customer.</p>
              )}
            </div>
            
            <div id="digital_warning" class={`mt-3 p-3 bg-amber-50 border border-amber-200 rounded-lg text-amber-800 text-xs ${product?.is_digital ? '' : 'hidden'}`}>
                <strong>⚠️ Note:</strong> Cash on Delivery (COD) will be automatically disabled for this product at checkout. <br/>
                If your store only has COD enabled (no online payment gateways like Razorpay/PhonePe), customers will not be able to purchase this product.
            </div>

            <div id="digital_url_container" class={`mt-4 ${product?.is_digital ? '' : 'hidden'}`}>
              <label class="text-sm font-medium text-secondary block mb-1">Digital Delivery URL</label>
              <input type="text" id="digital_delivery_url" value={product?.digital_delivery_url || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none" placeholder="e.g. https://wa.me/919999999999?text=Send%20File or Google Drive Link" />
              <p class="text-xs text-secondary/40 mt-1">Customers will see this link on the Order Success page after paying.</p>
            </div>
          </div>

          <!-- Custom Fields Builder -->
          <div>
            <div class="flex justify-between items-center mb-3">
              <div>
                <h3 class="text-sm font-bold text-secondary">Custom Input Fields</h3>
                <p class="text-xs text-secondary/60">Allow customers to provide text or upload files (e.g. Custom Cakes, T-Shirts)</p>
              </div>
              <button type="button" id="add-custom-field-btn" class="text-xs font-bold bg-primary/10 text-primary px-3 py-1.5 rounded-lg hover:bg-primary/20 transition-colors">
                + Add Field
              </button>
            </div>
            
            <div id="custom-fields-container" class="space-y-3">
              <!-- JS rendered custom fields -->
            </div>
          </div>
        </div>

      <!-- ── SEO ENGINE ── -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 mb-6">
        <h2 class="text-lg font-bold text-secondary mb-1">Search Engine Optimization</h2>
        <p class="text-sm text-secondary/60 mb-4">Customize how this product appears on Google search results.</p>
        
        <div class="space-y-4">
          <div class="space-y-2">
            <label class="text-sm font-medium text-secondary">SEO Page Title</label>
            <input type="text" id="seo_title" value={product?.specifications?._seo_title || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none" placeholder="Leave empty to use product name" />
          </div>
          <div class="space-y-2">
            <label class="text-sm font-medium text-secondary">SEO Meta Description</label>
            <textarea id="seo_description" rows="2" class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none resize-none" placeholder="Leave empty to use short description...">{product?.specifications?._seo_description || ''}</textarea>
          </div>
          
          <div class="space-y-2">
            <label class="text-sm font-medium text-secondary">SEO Tags (Keywords)</label>
            <input type="text" id="seo_keywords" value={product?.specifications?._seo_keywords || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none" placeholder="e.g. natural, organic, powder (comma separated)" />
          </div>
        </div>
      </div>
      
      <!-- ── MULTI-DIMENSIONAL VARIANTS ── -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100" id="md-variant-builder">
        <div class="flex justify-between items-start mb-4">
          <div>
            <h2 class="text-lg font-bold text-secondary">Variant Options (Multi-Dimensional)</h2>
            <p class="text-sm text-secondary/60">E.g. Group: "Size" → Values: "S, M, L". Use "@Color" or "@Image" to enable swatches.</p>
          </div>
          <button type="button" id="add-vgroup-btn" class="text-sm font-medium text-primary hover:text-primary/80 flex items-center gap-1">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            Add Option Group
          </button>
        </div>
        <div id="vgroups-container" class="space-y-3 mb-6"></div>
        <div class="flex justify-between items-center mb-4 border-t border-gray-100 pt-6">
          <div>
            <h2 class="text-lg font-bold text-secondary">Combinations & Pricing</h2>
            <p class="text-sm text-secondary/60">Set prices, stock, upload images. <strong class="text-red-500">Uncheck to disable invalid combinations.</strong></p>
          </div>
          <div class="flex items-center gap-2">
            <input type="number" id="bulk-price-input" placeholder="Price (₹)" class="w-24 px-3 py-1.5 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:border-primary outline-none" />
            <button type="button" id="apply-bulk-btn" class="text-xs font-bold bg-primary text-white px-3 py-1.5 rounded-lg hover:bg-primary/90 transition-colors">Apply to All</button>
          </div>
        </div>

        <div class="overflow-auto rounded-xl border border-gray-200 shadow-sm mb-4 max-h-[60vh]">
          <table class="w-full text-left border-collapse min-w-[600px] mobile-card-table">
            <thead class="sticky top-0 z-10 bg-gray-50 outline outline-1 outline-gray-200">
              <tr class="text-xs uppercase tracking-wider text-secondary/70">
                <th class="p-3 w-10 text-center"><input type="checkbox" id="toggle-all-variants" class="w-4 h-4 rounded border-gray-300 text-primary focus:ring-primary" checked></th>
                <th class="p-3 font-semibold" id="variant-col-header">Variant (Options)</th>
                <th class="p-3 font-semibold w-28">Price (₹)</th>
                <th class="p-3 font-semibold w-28">MRP (₹)</th>
                <th class="p-3 font-semibold w-28">SKU</th>
                <th class="p-3 font-semibold w-28 text-center">Images</th>
                <th class="p-3 w-10"></th>
              </tr>
            </thead>
            <tbody id="variants-container" class="divide-y divide-gray-100 text-sm">
              <!-- Grid rows go here -->
            </tbody>
          </table>
        </div>
        
        <div class="flex justify-between items-center">
          <button type="button" id="generate-combinations-btn" class="text-sm font-bold bg-primary/10 text-primary px-4 py-2 rounded-lg hover:bg-primary/20 transition-colors flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
            Auto-Generate Table
          </button>
          <button type="button" id="add-custom-variant-btn" class="text-sm font-medium text-primary hover:text-primary/80 flex items-center gap-1">
            + Add Custom Row
          </button>
        </div>
      </div>

      <!-- ── PRODUCT THUMBNAIL ── -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <div class="flex justify-between items-start mb-4">
          <div>
            <h2 class="text-lg font-bold text-secondary">Product Thumbnail</h2>
            <p class="text-sm text-secondary/60">Naya image upload karo <strong>ya</strong> variant images mein se koi choose karo as thumbnail.</p>
          </div>
          <span class="text-xs bg-primary/10 text-primary font-semibold px-2 py-1 rounded-full">Auto WebP ✨</span>
        </div>

        <!-- Current thumbnail preview -->
        <div id="current-thumb-box" class={`mb-4 overflow-hidden flex items-center gap-3 bg-gray-50 border border-gray-200 rounded-xl p-3 ${!product?.image ? 'hidden' : ''}`}>
          <img id="current-thumb-img"
            src={product?.image?.startsWith('data:') ? product.image : (product?.image || '')}
            alt="Current thumbnail"
            class="w-16 h-16 object-cover rounded-lg border border-gray-200 flex-shrink-0"
            onerror="this.src='/placeholder-product.webp'"
          />
          <div class="flex-1 min-w-0 overflow-hidden">
            <p class="text-sm font-medium text-secondary">Current Thumbnail</p>
            <p
              class="text-xs text-secondary/40 font-mono truncate max-w-full block"
              id="current-thumb-label"
              title={product?.image?.startsWith('data:') ? 'Compressed WebP (stored as base64)' : (product?.image || '')}
            >
              {product?.image?.startsWith('data:') ? '✅ Uploaded image (WebP, compressed)' : (product?.image || '')}
            </p>
          </div>
          <button type="button" id="remove-thumb-btn" class="flex-shrink-0 text-xs text-red-500 hover:text-red-700 font-medium px-2 py-1 border border-red-200 rounded-lg whitespace-nowrap">Remove</button>
        </div>

        <input type="hidden" id="image_url" value={product?.image || ''} />

        <!-- Tabs: Upload New / Choose from Variants -->
        <div class="flex border border-gray-200 rounded-xl overflow-hidden mb-4">
          <button type="button" id="tab-upload" class="flex-1 py-2.5 text-sm font-medium bg-primary text-white transition-colors">
            📤 Upload New Image
          </button>
          <button type="button" id="tab-gallery" class="flex-1 py-2.5 text-sm font-medium bg-white text-secondary hover:bg-gray-50 transition-colors">
            🖼️ Choose from Variant Images
          </button>
        </div>

        <!-- Upload Panel -->
        <div id="panel-upload">
          <div class="border-2 border-dashed border-gray-200 rounded-xl p-6 text-center hover:bg-gray-50 transition-colors relative" id="thumbnail-dropzone">
            <input type="file" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" id="thumbnail-upload" />
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <div class="text-sm font-medium text-secondary" id="thumbnail-upload-text">Drop image here or click to browse</div>
            <p class="text-xs text-secondary/40 mt-1">JPG, PNG, HEIC, WEBP → auto-compressed to WebP</p>
          </div>
          <div id="thumbnail-preview-box" class="hidden mt-3 flex items-center gap-3 bg-green-50 border border-green-200 rounded-xl p-3 overflow-hidden">
            <img id="thumbnail-preview-img" class="w-16 h-16 object-cover rounded-lg border border-green-300 flex-shrink-0" />
            <div class="flex-1 min-w-0 overflow-hidden">
              <p class="text-sm font-semibold text-green-800 truncate" id="thumbnail-preview-name"></p>
              <p class="text-xs text-green-700 truncate" id="thumbnail-preview-size"></p>
            </div>
            <a id="thumbnail-download-btn" download class="text-xs font-semibold text-primary underline flex-shrink-0 whitespace-nowrap">⬇ Download WebP</a>
          </div>
        </div>

        <!-- Variant Image Gallery Panel -->
        <div id="panel-gallery" class="hidden">
          <div id="gallery-empty" class="text-center py-8 text-secondary/40 text-sm border-2 border-dashed border-gray-200 rounded-xl">
            <p class="font-medium">Abhi koi variant images nahi hain</p>
            <p class="text-xs mt-1">Pehle Variants section mein images upload karo, phir yahan se select kar sakte ho</p>
          </div>
          <div id="gallery-grid" class="hidden grid grid-cols-4 sm:grid-cols-6 gap-3">
            <!-- Populated by JS when variant images are uploaded -->
          </div>
          <p class="text-xs text-secondary/40 mt-2 text-center">Kisi bhi image pe click karo use thumbnail set karne ke liye ✅</p>
        </div>
      </div>


      <!-- ── BADGES ── -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <div class="flex justify-between items-center mb-4">
          <div>
            <h2 class="text-lg font-bold text-secondary">Product Badges</h2>
            <p class="text-sm text-secondary/60">Labels jaise '100% Natural', 'New', 'Trending', 'Best Seller'</p>
          </div>
          <button type="button" id="add-badge-btn" class="text-sm font-medium text-primary hover:text-primary/80 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            Add Badge
          </button>
        </div>
        <div id="badges-container" class="flex flex-wrap gap-3"></div>
      </div>

      <!-- ── BULLET POINTS ── -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <div class="flex justify-between items-center mb-4">
          <div>
            <h2 class="text-lg font-bold text-secondary">Feature Bullet Points</h2>
            <p class="text-sm text-secondary/60">Product page pe key benefits highlight karo.</p>
          </div>
          <button type="button" id="add-bullet-btn" class="text-sm font-medium text-primary hover:text-primary/80 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            Add Point
          </button>
        </div>
        <div id="bullets-container" class="space-y-3"></div>
      </div>


      <!-- ── SPECIFICATIONS ── -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <div class="flex justify-between items-center mb-4">
          <div>
            <h2 class="text-lg font-bold text-secondary">Specifications</h2>
            <p class="text-sm text-secondary/60">Technical details — key aur value pairs.</p>
          </div>
          <button type="button" id="add-spec-btn" class="text-sm font-medium text-primary hover:text-primary/80 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            Add Spec
          </button>
        </div>
        <div id="specs-container" class="space-y-3"></div>
      </div>

      </div>
      <!-- END LEFT COLUMN -->

      <!-- RIGHT COLUMN: SETTINGS -->
      <div class="lg:col-span-4 space-y-6">
        <!-- Product Status -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
          <h2 class="text-lg font-bold text-secondary mb-4">Status</h2>
          <div class="space-y-2">
            <label class="text-sm font-medium text-secondary">Product Status</label>
            <select id="is_active" class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50">
              <option value="true" selected={product?.is_active !== false}>Active</option>
              <option value="false" selected={product?.is_active === false}>Draft</option>
            </select>
            <p class="text-xs text-secondary/60">Draft products are hidden from the storefront.</p>
          </div>
        </div>

        <!-- Organization (Brand & Tags) -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
          <h2 class="text-lg font-bold text-secondary mb-4">Organization</h2>
          <div class="space-y-4">
            <div class="space-y-2">
              <label class="text-sm font-medium text-secondary">Brand / Vendor</label>
              <input type="text" id="vendor" value={product?.specifications?._vendor || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50" placeholder="e.g. Nike, Samsung" />
            </div>
            <div class="space-y-2">
              <label class="text-sm font-medium text-secondary">Product Tags</label>
              <input type="text" id="tags" value={product?.specifications?._tags || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50" placeholder="e.g. summer-sale, new-arrival (comma separated)" />
            </div>
            <div class="space-y-2">
              <label class="text-sm font-medium text-secondary">Category <span class="text-red-500">*</span></label>
              <select id="category" required class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50">
                <option value="">Select Category</option>
                {categories.map((cat: any) => (
                  <option value={cat.slug} selected={product?.category === cat.slug || product?.category === cat.name || product?.category === cat.id}>{cat.name}</option>
                ))}
                {product?.category && !categories.some((c: any) => c.slug === product.category || c.name === product.category || c.id === product.category) && (
                  <option value={product.category} selected>{product.category} (Current)</option>
                )}
              </select>
            </div>
          </div>
        </div>

        
        

        <!-- Base Pricing & Shipping -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 transition-all" id="base-pricing-section">
          <h2 class="text-lg font-bold text-secondary mb-4 flex items-center justify-between">
            <span>Pricing & Inventory</span>
          </h2>
          <p class="text-xs text-secondary/60 mb-4" id="base-pricing-helper">Used when the product has no variants.</p>
          <div class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="text-sm font-medium text-secondary">Price (₹)</label>
                <input type="number" step="0.01" id="base_price" value={product?.price || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50" placeholder="0.00" />
              </div>
              <div class="space-y-2">
                <label class="text-sm font-medium text-secondary">Compare at Price (₹)</label>
                <input type="number" step="0.01" id="base_mrp" value={product?.original_price || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50" placeholder="0.00" />
              </div>
            </div>
            
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="text-sm font-medium text-secondary">SKU (Stock Keeping Unit)</label>
                <input type="text" id="base_sku" value={product?.specifications?._base_sku || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50" placeholder="e.g. TSHIRT-RED-M" />
              </div>
              <div class="space-y-2">
                <label class="text-sm font-medium text-secondary">Barcode (ISBN, UPC, GTIN)</label>
                <input type="text" id="base_barcode" value={product?.specifications?._base_barcode || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50" placeholder="e.g. 123456789012" />
              </div>
            </div>

            <div class="pt-4 border-t border-gray-100">
              <h3 class="text-sm font-medium text-secondary mb-3">Shipping Dimensions</h3>
              <div class="grid grid-cols-2 gap-4">
                <div class="space-y-2">
                  <label class="text-xs font-medium text-secondary/80">Weight (kg)</label>
                  <input type="number" step="0.01" id="base_weight_kg" value={product?.specifications?._base_weight_kg || ''} class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50 text-sm" placeholder="0.0" />
                </div>
                <div class="space-y-2">
                  <label class="text-xs font-medium text-secondary/80">Dimensions (cm)</label>
                  <div class="flex items-center gap-2">
                    <input type="number" step="0.1" id="base_length" value={product?.specifications?._base_length || ''} class="w-full px-2 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50 text-sm" placeholder="L" />
                    <span class="text-gray-400 text-xs">x</span>
                    <input type="number" step="0.1" id="base_width" value={product?.specifications?._base_width || ''} class="w-full px-2 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50 text-sm" placeholder="W" />
                    <span class="text-gray-400 text-xs">x</span>
                    <input type="number" step="0.1" id="base_height" value={product?.specifications?._base_height || ''} class="w-full px-2 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50 text-sm" placeholder="H" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Inventory -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
          <h2 class="text-lg font-bold text-secondary mb-4">Inventory</h2>
          <div class="space-y-5">
            <div class="space-y-2">
              <label class="text-sm font-medium text-secondary">Stock Status</label>
              <select id="is_in_stock" class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50">
                <option value="true" selected={product?.is_in_stock !== false}>In Stock</option>
                <option value="false" selected={product?.is_in_stock === false}>Out of Stock</option>
              </select>
            </div>
            
            <div class="flex items-center justify-between border-t border-gray-100 pt-4 cursor-pointer" onclick="document.getElementById('track_inventory').click()">
              <div>
                <span class="text-sm font-medium text-secondary block">Track Inventory</span>
                <span class="text-xs text-secondary/60">Prevent overselling</span>
              </div>
              <label class="relative cursor-pointer" onclick="event.stopPropagation()">
                <input type="checkbox" id="track_inventory" class="sr-only" checked={product?.track_inventory === true} />
                <div class="toggle-bg w-11 h-6 bg-gray-200 rounded-full border border-gray-200 transition-colors"></div>
                <div class="toggle-dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform shadow-sm"></div>
              </label>
            </div>
          </div>
        </div>

        <!-- Taxes -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
          <h2 class="text-lg font-bold text-secondary mb-4">Taxes (GST)</h2>
          <div class="space-y-4">
            <div class="space-y-2">
              <label class="text-sm font-medium text-secondary">HSN Code</label>
              <input type="text" id="hsn_code" value={product?.hsn_code || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50" placeholder="e.g. 0813 (Leave blank for default)" />
            </div>

            <div class="space-y-2">
              <label class="text-sm font-medium text-secondary">GST Rate (%)</label>
              <input type="number" step="0.1" id="gst_rate" value={product?.gst_rate || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50" placeholder="e.g. 5" />
            </div>
          </div>
        </div>

        <!-- Rating Overrides -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
          <h2 class="text-lg font-bold text-secondary mb-4">Ratings Data</h2>
          <div class="space-y-4">
            <div class="space-y-2">
              <label class="text-sm font-medium text-secondary">Rating Value (0-5)</label>
              <input type="number" step="0.1" min="0" max="5" id="rating_value" value={product?.rating?.value || product?.rating || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50" placeholder="4.5" />
            </div>
            <div class="space-y-2">
              <label class="text-sm font-medium text-secondary">Review Count</label>
              <input type="number" step="1" min="0" id="rating_count" value={product?.rating?.count || product?.reviews_count || ''} class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:border-primary focus:ring-1 focus:ring-primary outline-none bg-gray-50/50" placeholder="120" />
            </div>
          </div>
        </div>
        
        <!-- ── MARKETPLACE ── -->
        {isEditing && (
        <div class="bg-indigo-50/50 p-6 rounded-2xl shadow-sm border border-indigo-100 flex flex-col gap-3">
          <div>
            <h2 class="text-lg font-bold text-indigo-900 flex items-center gap-2">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              VyaparPe Marketplace
            </h2>
            <p class="text-sm text-indigo-700/80 mt-1">Submit this product to be featured on the main vyaparpe.com marketplace.</p>
          </div>
          <button type="button" id="btn-request-marketplace" class="w-full px-5 py-2.5 bg-indigo-600/50 cursor-not-allowed text-white text-sm font-medium rounded-lg shadow-sm focus:outline-none" title="Coming Soon" disabled>
            Submit (Coming Soon)
          </button>
        </div>
        )}

      </div> <!-- END RIGHT COLUMN -->
      
      <!-- Mobile Delete Action (Desktop has it via Sticky header? Actually we moved Save up, let's put delete at the very bottom) -->
      <div class="lg:col-span-12 pt-6 pb-6 flex items-center justify-center sm:justify-start">
        {isEditing && (
          <button type="button" id="delete-btn" class="text-sm text-red-500 hover:text-red-700 font-bold px-4 py-2 hover:bg-red-50 rounded-lg transition-colors flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            Delete this product
          </button>
        )}
      </div>

    </form>
  </div>

  <!-- ── VARIANT IMAGE MANAGER MODAL ── -->
  <div id="variant-image-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden bg-black/50 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl overflow-hidden border border-gray-100 flex flex-col max-h-[85vh]">
      <div class="p-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
        <div>
          <h3 class="text-lg font-bold text-secondary" id="vim-title">Manage Variant Images</h3>
          <p class="text-xs text-secondary/60 mt-1" id="vim-subtitle">Upload images specific to this variant.</p>
        </div>
        <button type="button" id="close-vim-btn" class="text-gray-400 hover:text-red-500 transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="p-5 overflow-y-auto flex-1">
        <div class="flex items-center justify-between mb-3">
          <label class="text-xs font-semibold text-secondary/80 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            Upload Images / Video
          </label>
          <span class="text-[10px] bg-primary/10 text-primary font-bold px-2 py-0.5 rounded-full tracking-wide">Auto WebP ✨</span>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <div class="w-20 h-20 rounded-xl border-2 border-dashed border-gray-300 flex flex-col items-center justify-center bg-gray-50 hover:bg-primary/5 hover:border-primary/40 cursor-pointer transition-all relative flex-shrink-0 group">
            <svg class="w-6 h-6 text-gray-400 group-hover:text-primary transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            <span class="text-[10px] font-medium text-gray-500 mt-1">Add File</span>
            <input type="file" multiple accept="image/*,video/mp4,video/webm" class="absolute inset-0 opacity-0 cursor-pointer" id="vim-upload" />
          </div>
          <div class="flex-1 flex gap-3 overflow-x-auto pb-2 scrollbar-hide pt-2" id="vim-preview-container">
            <!-- Images go here -->
          </div>
        </div>
      </div>
      <div class="p-5 border-t border-gray-100 bg-gray-50/50 flex justify-end gap-3">
        <button type="button" id="done-vim-btn" class="px-8 py-2.5 text-sm font-bold text-white bg-primary rounded-lg hover:bg-primary/90 transition-colors">Done</button>
      </div>
    </div>
  </div>


<div id="product-edit-data" class="hidden" data-product={JSON.stringify(product || {})} data-id={productId || ''} data-manage={canManage ? 'true' : 'false'}></div>
<script is:inline>
document.addEventListener('astro:page-load', () => {
  const dataEl = document.getElementById('product-edit-data');
  if (!dataEl) return; // Not on the edit page
  const initialProduct = JSON.parse(dataEl.dataset.product || '{}');
  const productId = dataEl.dataset.id;
  const canManage = dataEl.dataset.manage === 'true';

  // Move modal to body to prevent fixed positioning bugs inside scrolling containers with transforms
  const vimModal = document.getElementById('variant-image-modal');
  if (vimModal && vimModal.parentElement !== document.body) {
    document.body.appendChild(vimModal);
  }


  // ── DIGITAL & CUSTOM PRODUCTS JS ────────────────────────────────────
  
  // Robust fallback for category selection if server-side matching failed
  if (initialProduct && initialProduct.category) {
    const catSelect = document.getElementById('category');
    if (catSelect && !catSelect.value) {
       const catVal = String(initialProduct.category).toLowerCase().trim();
       const option = Array.from(catSelect.options).find(o => 
         String(o.value).toLowerCase().trim() === catVal || 
         String(o.text).toLowerCase().trim() === catVal ||
         String(o.value).replace(/-/g, ' ') === catVal.replace(/-/g, ' ')
       );
       if (option) catSelect.value = option.value;
    }
  }
  
  const isDigitalToggle = document.getElementById('is_digital');
  const deliveryTypeSelect = document.getElementById('delivery_type');
  const digitalUrlContainer = document.getElementById('digital_url_container');
  const digitalWarning = document.getElementById('digital_warning');

  // Initial state logic
  if (isDigitalToggle && isDigitalToggle.checked && deliveryTypeSelect) {
      deliveryTypeSelect.value = 'std_only';
      deliveryTypeSelect.disabled = true;
      deliveryTypeSelect.title = "Digital products cannot be delivered via Q-Commerce";
  }

  if (isDigitalToggle) {
    isDigitalToggle.addEventListener('change', (e) => {
      const isChecked = e.target.checked;
      
      if (digitalUrlContainer) {
        if (isChecked) {
          digitalUrlContainer.classList.remove('hidden');
        } else {
          digitalUrlContainer.classList.add('hidden');
        }
      }
      if (digitalWarning) {
        if (isChecked) {
          digitalWarning.classList.remove('hidden');
        } else {
          digitalWarning.classList.add('hidden');
        }
      }

      if (deliveryTypeSelect) {
        const container = document.getElementById('delivery_type_container');
        const storeHasQc = container?.getAttribute('data-has-qc') === 'true';

        if (isChecked) {
          deliveryTypeSelect.value = 'std_only';
          deliveryTypeSelect.disabled = true;
          deliveryTypeSelect.title = "Digital products cannot be delivered via Q-Commerce";
        } else {
          if (storeHasQc) {
            deliveryTypeSelect.disabled = false;
            deliveryTypeSelect.title = "";
          }
        }
      }
    });
  }

  const customFieldsContainer = document.getElementById('custom-fields-container');
  const addCustomFieldBtn = document.getElementById('add-custom-field-btn');
  
  function createCustomFieldRow(field = { id: '', label: '', type: 'text', required: false, options: '' }) {
    const div = document.createElement('div');
    div.className = 'custom-field-row flex gap-2 items-start bg-gray-50 border border-gray-200 p-3 rounded-lg relative group mb-3';
    div.innerHTML = `
      <div class="flex-1 space-y-2">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
          <input type="text" placeholder="Field ID (e.g. name_on_cake)" value="${field.id}" class="cf-id w-full px-2 py-1 text-xs border rounded" required />
          <input type="text" placeholder="Label (e.g. Name on Cake)" value="${field.label}" class="cf-label w-full px-2 py-1 text-xs border rounded" required />
          <select class="cf-type w-full px-2 py-1 text-xs border rounded bg-white">
            <option value="text" ${field.type === 'text' ? 'selected' : ''}>Text Input</option>
            <option value="textarea" ${field.type === 'textarea' ? 'selected' : ''}>Long Text</option>
            <option value="select" ${field.type === 'select' ? 'selected' : ''}>Dropdown</option>
            <option value="file" ${field.type === 'file' ? 'selected' : ''}>File Upload</option>
          </select>
          <label class="flex items-center gap-1 text-xs text-secondary/70 bg-white border px-2 rounded cursor-pointer"><input type="checkbox" class="cf-req" ${field.required ? 'checked' : ''} /> Required</label>
        </div>
        <div class="cf-options-container ${field.type === 'select' ? '' : 'hidden'}">
          <input type="text" placeholder="Options (comma separated, e.g. Chocolate, Vanilla)" value="${field.options}" class="cf-options w-full px-2 py-1 text-xs border rounded" />
        </div>
      </div>
      <button type="button" class="text-red-500 hover:text-red-700 bg-red-50 p-1.5 rounded" onclick="this.parentElement.remove()">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
      </button>
    `;
    const typeSelect = div.querySelector('.cf-type');
    const optionsContainer = div.querySelector('.cf-options-container');
    typeSelect.addEventListener('change', (e) => {
      if (e.target.value === 'select') optionsContainer.classList.remove('hidden');
      else optionsContainer.classList.add('hidden');
