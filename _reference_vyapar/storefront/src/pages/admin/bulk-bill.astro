---
import { getPermissionContext, canManageSection } from '../../lib/permissions';
import { getProducts, getSettings, getCoupons, getActiveMilestone } from '../../lib/database';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageAiPanel from '../../components/admin/PageAiPanel.astro';
import ManagePricesModal from '../../components/admin/ManagePricesModal.astro';

const ctx = getPermissionContext(Astro.cookies);
if (!canManageSection(ctx, "orders_bulk")) {
  return new Response("Forbidden", { status: 403 });
}

const products = await getProducts(Astro.locals?.storeId);
const settings = await getSettings(Astro.locals?.storeId);
const coupons = await getCoupons();
const milestoneOffer = await getActiveMilestone();

// Filter only active/inStock products
const activeProducts = products.filter((p: any) => p.inStock !== false && !p.outOfStock);

const productsJson = JSON.stringify(activeProducts.map((p: any) => ({
  id: p.id,
  name: p.name,
  price: p.price,
  originalPrice: p.originalPrice,
  hsn_code: p.hsn_code || settings.default_hsn_code || '0813',
  gst_rate: p.gst_rate || settings.default_gst_rate || 12,
  image: p.images?.[0] || '',
  hasVariants: p.hasVariants || (p.variants && p.variants.length > 0),
  variants: p.variants || [],
  b2b_variants: p.b2b_variants || [],
  specifications: p.specifications || {}
})));

const settingsJson = JSON.stringify({
  free_shipping_threshold: settings.free_shipping_threshold || 499,
  flat_shipping_rate: settings.flat_shipping_rate || 60,
  prepaid_discount_enabled: settings.prepaid_discount_enabled,
  prepaid_discount_value: settings.prepaid_discount_value,
  prepaid_discount_type: settings.prepaid_discount_type,
  prepaid_discount_min_order: settings.prepaid_discount_min_order,
  allow_coupon_stacking: settings.allow_coupon_stacking
});

const couponsJson = JSON.stringify(coupons || []);
const milestoneJson = JSON.stringify(milestoneOffer || {});

const orders = await import('../../lib/database').then(m => m.getOrders(Astro.locals?.storeId));
const editOrderId = Astro.url.searchParams.get('edit');
let editOrder = null;
if (editOrderId) {
  editOrder = orders.find((o: any) => o.orderId === editOrderId);
}
const editOrderJson = editOrder ? JSON.stringify(editOrder) : 'null';
---

<AdminLayout title="B2B Bulk Order Generator | Your Brand Admin">
  
  <!-- Modal to render invoice -->
  <div id="invoice-modal" class="fixed inset-0 z-50 hidden bg-gray-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg overflow-hidden flex flex-col max-h-[90vh]">
    </div>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <div class="h-10 w-10 bg-primary/10 rounded-xl flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <h1 class="text-2xl font-serif font-bold text-secondary">Bulk Order Generator</h1>
      </div>
      <p class="text-sm text-secondary/55 ml-[52px]">Quickly generate bulk B2B invoices</p>
    </div>
    <div class="flex items-center gap-3">
      <button type="button" id="btn-manage-prices" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-secondary text-sm font-semibold rounded-xl transition-colors border border-gray-200 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Manage Prices
      </button>
    </div>
  </div>

  <PageAiPanel 
    page="bulk-bill"
    title="B2B Billing Assistant"
    pageDataJson={JSON.stringify({})}
    guideTitleEn="Manual Billing Guide"
    guideTitleHi="Manual Billing Guide"
    guideHtml={`<ul class="space-y-2">
      <li><strong>Customer:</strong> Enter guest checkout details.</li>
      <li><strong>Products:</strong> Search and add products, select variants if applicable.</li>
      <li><strong>Coupons:</strong> Enter a valid public or private coupon code to apply system discounts.</li>
      <li><strong>Discount:</strong> Add arbitrary flat discounts to negotiate via WhatsApp.</li>
      <li><strong>Print:</strong> Click Generate Bill to instantly get the printable PDF.</li>
    </ul>`}
    guideHtmlHi={`<ul class="space-y-2">
      <li><strong>Customer:</strong> Customer ki details dalein.</li>
      <li><strong>Products:</strong> Products search karke add karein.</li>
      <li><strong>Coupons:</strong> Coupon code (public ya private) apply kar sakte hain.</li>
      <li><strong>Discount:</strong> WhatsApp par bargaining handle karne ke liye manual discount de sakte hain.</li>
      <li><strong>Print:</strong> Generate dabaate hi invoice PDF taiyaar ho jayegi.</li>
    </ul>`}
    quickActions={[]}
  />

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-32">
    <!-- Left Column: Customer & Products -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- Customer Details Form -->
      <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6">
        <h2 class="text-lg font-bold text-secondary mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Customer Details
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="md:col-span-2">
            <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">Full Name *</label>
            <input type="text" id="cust-name" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none" placeholder="e.g. Rahul Kumar" required />
          </div>
          <div>
            <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">Phone Number *</label>
            <input type="tel" id="cust-phone" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none" placeholder="e.g. 9876543210" required />
          </div>
          <div>
            <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">GSTIN (Optional)</label>
            <input type="text" id="cust-gstin" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none uppercase" placeholder="e.g. 29AAZFT1344H1ZL" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">Email Address (Optional)</label>
            <input type="email" id="cust-email" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none" placeholder="e.g. rahul@example.com" />
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">Address *</label>
            <textarea id="cust-address" rows="2" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none" placeholder="House No, Street, Area" required></textarea>
          </div>
          <div>
            <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">City *</label>
            <input type="text" id="cust-city" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none" placeholder="City" required />
          </div>
          <div>
            <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">State *</label>
            <input type="text" id="cust-state" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none" placeholder="State" required />
          </div>
          <div>
            <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">Pincode *</label>
            <input type="text" id="cust-pincode" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none" placeholder="Pincode" required />
          </div>
        </div>
      </div>

      <!-- Product Selection -->
      <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-secondary flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            Order Items
          </h2>
          <div class="flex items-center gap-5">
            <!-- Global Decimal Qty Feature -->
            <div class="flex items-center gap-2 border border-primary/20 bg-primary/5 rounded-lg px-3 py-1.5" title="Set decimal quantity before selecting a variant to automatically calculate price">
              <span class="text-xs font-bold text-primary uppercase tracking-wide">Add Qty</span>
              <input type="number" id="global-add-qty" min="0.01" step="0.01" value="1" class="w-16 bg-white border border-primary/10 rounded px-2 py-0.5 text-sm font-bold text-secondary outline-none focus:ring-1 focus:ring-primary text-center shadow-inner">
            </div>

            <!-- Website Pricing Toggle -->
            <label class="flex items-center gap-2 cursor-pointer" title="Apply website deals/offers or use custom B2B/POS prices">
              <span class="text-xs font-semibold text-secondary/70">Website Deals & Milestones</span>
              <div class="relative">
                <input type="checkbox" id="toggle-deals" class="sr-only peer">
                <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
              </div>
            </label>
          </div>
        </div>

        <!-- Product Search/Select -->
        <div class="relative mb-4 space-y-4">
          <div>
            <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">Select Catalog Product</label>
            <div class="flex gap-2">
              <div class="relative flex-1">
                <input type="text" id="product-search" autocomplete="off" placeholder="Type to search product..." class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary/20 outline-none bg-gray-50/50">
                <div id="product-dropdown" class="absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-xl shadow-lg hidden max-h-60 overflow-y-auto">
                  <!-- Populated by JS -->
                </div>
              </div>
              <button type="button" id="btn-add-product" class="px-4 py-2 bg-secondary text-white text-sm font-semibold rounded-xl hover:bg-secondary/90 transition-colors">
                Add Selected
              </button>
            </div>
          </div>
          
          <div class="bg-primary/5 p-4 rounded-xl border border-primary/20">
            <label class="block text-xs font-semibold text-primary mb-1.5 uppercase">Create Custom B2B Variant</label>
            <div class="flex flex-col sm:flex-row gap-2">
              <div class="relative flex-1">
                <input type="text" id="custom-variant-base-search" autocomplete="off" placeholder="Search Base Product..." class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary outline-none" />
                <input type="hidden" id="custom-variant-base-val" />
                <div id="custom-variant-base-dropdown" class="absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-xl shadow-lg hidden max-h-48 overflow-y-auto"></div>
              </div>
              <input type="text" id="custom-variant-name" placeholder="e.g. 1kg Box" class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary outline-none" />
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-secondary/50">₹</span>
                <input type="number" id="custom-variant-price" placeholder="Rate" class="w-24 px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary outline-none" />
              </div>
              <button type="button" id="btn-add-custom-variant" class="px-4 py-2 bg-primary text-white text-sm font-semibold rounded-xl hover:bg-primary/90 transition-colors whitespace-nowrap">
                Add Custom Variant
              </button>
            </div>
            <div class="flex items-center gap-2 mt-3">
              <input type="checkbox" id="custom-variant-save" class="rounded border-gray-300 text-primary focus:ring-primary h-4 w-4" checked />
              <label for="custom-variant-save" class="text-xs font-medium text-secondary/70">Save permanently to Product Catalog</label>
            </div>
          </div>
        </div>

        <!-- Selected Items Table -->
        <div class="overflow-x-auto border border-gray-100 rounded-xl mt-4">
          <table class="w-full text-sm text-left">
            <thead class="bg-gray-50/80 text-xs text-secondary/50 uppercase tracking-wider border-b border-gray-100">
              <tr>
                <th class="px-4 py-3">Item</th>
                <th class="px-4 py-3 w-32">Variant</th>
                <th class="px-4 py-3 w-24">Price</th>
                <th class="px-4 py-3 w-24">Qty</th>
                <th class="px-4 py-3 w-24 text-right">Total</th>
                <th class="px-4 py-3 w-10"></th>
              </tr>
            </thead>
            <tbody id="cart-tbody" class="divide-y divide-gray-50">
              <tr id="empty-cart-row">
                <td colspan="6" class="px-4 py-8 text-center text-secondary/40 font-medium">No items added yet.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- Right Column: Order Summary & Actions -->
    <div class="space-y-6">
      
      <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 sticky top-24">
        <h2 class="text-lg font-bold text-secondary mb-4">Order Summary</h2>
        
        <div class="space-y-3 text-sm mb-6 pb-6 border-b border-gray-100">
          <div class="flex justify-between text-secondary/70">
            <span>Original Taxable</span>
            <span class="font-semibold text-secondary">₹<span id="summary-subtotal">0</span></span>
          </div>
          <div class="flex justify-between text-secondary/70">
            <span>Total GST</span>
            <span class="font-semibold text-secondary">₹<span id="summary-gst">0</span></span>
          </div>

          

          <div class="flex justify-between items-center text-secondary/70">
            <span>Percentage Discount</span>
            <div class="relative w-24">
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-secondary/50">%</span>
              <input type="number" id="input-discount-percent" value="0" min="0" max="100" class="w-full pl-2 pr-7 py-1 text-right border border-gray-200 rounded-lg focus:border-primary outline-none font-semibold text-secondary" />
            </div>
          </div>

          <div class="flex justify-between items-center text-secondary/70">
            <span>Extra Flat Discount</span>
            <div class="relative w-24">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-secondary/50">₹</span>
              <input type="number" id="input-discount" value="0" min="0" class="w-full pl-7 pr-2 py-1 text-right border border-gray-200 rounded-lg focus:border-primary outline-none font-semibold text-secondary" />
            </div>
          </div>
          
          <div class="flex justify-between items-center text-secondary/70">
            <span>Shipping & Handling</span>
            <div class="relative w-24">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-secondary/50">₹</span>
              <input type="number" id="input-shipping" value="0" min="0" class="w-full pl-7 pr-2 py-1 text-right border border-gray-200 rounded-lg focus:border-primary outline-none font-semibold text-secondary" />
            </div>
          </div>
        </div>

        <div class="flex justify-between items-end mb-6">
          <span class="font-bold text-secondary">Grand Total</span>
          <span class="text-2xl font-black text-primary">₹<span id="summary-total">0</span></span>
        </div>

        <!-- Payment Mode -->
        <div class="mb-4">
          <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">Payment Method</label>
          <div class="grid grid-cols-1 gap-2">
            <label class="border border-gray-200 rounded-xl p-3 flex items-center justify-center gap-2 cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-colors">
              <input type="radio" name="payment" value="COD" checked class="hidden" />
              <span class="font-bold text-secondary text-sm">COD / Standard</span>
            </label>
          </div>
        </div>

        <!-- Amount Received -->
        <div class="mb-4">
          <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">Amount Received (Advance)</label>
          <div class="relative w-full">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-secondary/50">₹</span>
            <input type="number" id="input-amount-received" value="0" min="0" class="w-full pl-7 pr-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary outline-none bg-gray-50/50" />
          </div>
        </div>

        <!-- Payment Status -->
        <div class="mb-6">
          <label class="block text-xs font-semibold text-secondary/50 mb-1.5 uppercase">Initial Payment Status</label>
          <select id="payment-status" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-primary outline-none bg-gray-50/50">
            <option value="pending">Pending (Unpaid)</option>
            <option value="paid">Paid (Received)</option>
          </select>
          <p class="text-[10px] text-secondary/40 mt-1">If COD but already paid via UPI, mark as Paid.</p>
        </div>

        <!-- Quotation Toggle -->
        <div class="mb-6 flex items-center justify-between p-3 bg-blue-50 border border-blue-100 rounded-xl">
          <div>
            <p class="text-sm font-bold text-blue-900">Generate as Quotation</p>
            <p class="text-[10px] text-blue-700/70">Does not add to revenue dashboard</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="toggle-quotation" class="sr-only peer">
            <div class="w-11 h-6 bg-blue-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
          </label>
        </div>

        <button id="btn-submit-order" class="w-full py-3.5 bg-primary hover:bg-primary/90 text-white font-bold rounded-xl shadow-[0_4px_14px_0_rgba(139,90,43,0.39)] hover:shadow-[0_6px_20px_rgba(139,90,43,0.23)] hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
          <span id="submit-btn-text">Generate Bill</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
        </button>

      </div>
    </div>
  </div>

</AdminLayout>

<ManagePricesModal />

<script type="application/json" id="products-data" set:html={productsJson.replace(/</g, '\u003c')}></script>
<script type="application/json" id="settings-data" set:html={settingsJson.replace(/</g, '\u003c')}></script>
<script type="application/json" id="coupons-data" set:html={couponsJson.replace(/</g, '\u003c')}></script>
<script type="application/json" id="milestone-data" set:html={milestoneJson.replace(/</g, '\u003c')}></script>
<script type="application/json" id="edit-order-data" set:html={editOrderJson.replace(/</g, '\u003c')}></script>

<script data-astro-rerun>
  // Setup data
  const products = JSON.parse(document.getElementById('products-data')?.textContent || '[]');
  const settings = JSON.parse(document.getElementById('settings-data')?.textContent || '{}');
  const couponsList = JSON.parse(document.getElementById('coupons-data')?.textContent || '[]');
  const milestoneOffer = JSON.parse(document.getElementById('milestone-data')?.textContent || '{}');
  const editOrder = JSON.parse(document.getElementById('edit-order-data')?.textContent || 'null');
  
  let cart = []; // Array of items: { pid, vIndex, name, variantName, price, qty, hsn_code, gst_rate }
  let appliedCoupons = [];
  let computedTotalDiscount = 0;
  let currentOrderId = editOrder ? editOrder.orderId : null;

  // DOM Elements
  const pSearch = document.getElementById('product-search');
  const pDropdown = document.getElementById('product-dropdown');
  const btnAdd = document.getElementById('btn-add-product');
  const tbody = document.getElementById('cart-tbody');
  const emptyRow = document.getElementById('empty-cart-row');
  
  const sumSubtotal = document.getElementById('summary-subtotal');
  const sumGst = document.getElementById('summary-gst');
  const inputDiscountPercent = document.getElementById('input-discount-percent');
  const inputDiscount = document.getElementById('input-discount');
  const inputShipping = document.getElementById('input-shipping');
  const sumTotal = document.getElementById('summary-total');
  
  const paymentRadios = document.querySelectorAll('input[name="payment"]');

  let currentDisplayMatches = [];
  function renderDropdown(filterText = '') {
    pDropdown.innerHTML = '';
    const term = filterText.toLowerCase().trim();
    
    let displayItems = [];
    products.forEach(p => {
       const pName = p.name || '';
       const pNameMatches = pName.toLowerCase().includes(term);
       
       if (p.hasVariants && p.variants && p.variants.length > 0) {
          p.variants.forEach((v, vIdx) => {
             const variantName = v.weight || v.name || 'Default';
             const fullName = `${pName} - ${variantName}`;
             if (pNameMatches || fullName.toLowerCase().includes(term)) {
                displayItems.push({
                   type: 'variant',
                   product: p,
                   vIndex: vIdx,
                   displayName: fullName,
                   price: v.price || p.price,
                   isB2bVariant: false
                });
             }
          });
       } else {
          if (pNameMatches) {
             displayItems.push({
                type: 'product',
                product: p,
                vIndex: 0,
                displayName: pName,
                price: p.price,
                isB2bVariant: false
             });
          }
       }

       if (p.b2b_variants && p.b2b_variants.length > 0) {
          p.b2b_variants.forEach((v, vIdx) => {
             const variantName = v.weight || v.name || 'B2B';
             const fullName = `${pName} - ${variantName} (B2B)`;
             if (pNameMatches || fullName.toLowerCase().includes(term)) {
                displayItems.push({
                   type: 'b2b_variant',
                   product: p,
                   vIndex: vIdx + 1000,
                   displayName: fullName,
                   price: v.price || p.price,
                   isB2bVariant: true
                });
             }
          });
       }
    });
    
    if (displayItems.length === 0) {
      currentDisplayMatches = [];
      pDropdown.innerHTML = '<div class="px-4 py-3 text-sm text-gray-500 text-center">No products found</div>';
      pDropdown.classList.remove('hidden');
      return;
    }

    // Limit to top 50 to prevent freezing
    currentDisplayMatches = displayItems.slice(0, 50);

    currentDisplayMatches.forEach(item => {
      const div = document.createElement('div');
      div.className = 'px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm text-secondary border-b border-gray-100 last:border-0 flex justify-between items-center';
      div.innerHTML = `
        <span class="font-medium">${item.displayName}</span>
        <span class="text-primary font-semibold text-xs">₹${item.price}</span>
      `;
      div.addEventListener('click', () => {
        pSearch.value = '';
        pDropdown.classList.add('hidden');
        addToCart(item.product, item.vIndex, item.isB2bVariant);
      });
      pDropdown.appendChild(div);
    });
    pDropdown.classList.remove('hidden');
  }

  pSearch.addEventListener('focus', () => renderDropdown(pSearch.value));
  pSearch.addEventListener('input', (e) => renderDropdown(e.target.value));
  pSearch.addEventListener('keydown', (e) => {
     if (e.key === 'Enter') {
        e.preventDefault();
        if (currentDisplayMatches.length > 0) {
           const item = currentDisplayMatches[0];
           pSearch.value = '';
           pDropdown.classList.add('hidden');
           addToCart(item.product, item.vIndex, item.isB2bVariant);
        }
     }
  });

  if (btnAdd) {
     btnAdd.addEventListener('click', () => {
        if (currentDisplayMatches.length > 0) {
           const item = currentDisplayMatches[0];
           pSearch.value = '';
           pDropdown.classList.add('hidden');
           addToCart(item.product, item.vIndex, item.isB2bVariant);
        }
     });
  }

  const cvSearch = document.getElementById('custom-variant-base-search');
  const cvVal = document.getElementById('custom-variant-base-val');
  const cvDropdown = document.getElementById('custom-variant-base-dropdown');

  function renderCvDropdown(filterText = '') {
    cvDropdown.innerHTML = '';
    const term = filterText.toLowerCase().trim();
    
    let matches = products.filter(p => (p.name || '').toLowerCase().includes(term));
    if (matches.length === 0) {
      cvDropdown.innerHTML = '<div class="px-4 py-3 text-sm text-gray-500 text-center">No products found</div>';
      cvDropdown.classList.remove('hidden');
      return;
    }

    matches.slice(0, 30).forEach(p => {
      const div = document.createElement('div');
      div.className = 'px-4 py-2 hover:bg-gray-50 cursor-pointer text-sm text-secondary border-b border-gray-100 last:border-0';
      div.textContent = p.name;
      div.addEventListener('click', () => {
        cvSearch.value = p.name;
        cvVal.value = p.id;
        cvDropdown.classList.add('hidden');
      });
      cvDropdown.appendChild(div);
    });
    cvDropdown.classList.remove('hidden');
  }

  cvSearch.addEventListener('focus', () => renderCvDropdown(cvSearch.value));
  cvSearch.addEventListener('input', (e) => {
    cvVal.value = '';
    renderCvDropdown(e.target.value);
  });

  document.addEventListener('click', (e) => {
    if (!pSearch.contains(e.target) && !pDropdown.contains(e.target)) {
      pDropdown.classList.add('hidden');
    }
    if (!cvSearch.contains(e.target) && !cvDropdown.contains(e.target)) {
      cvDropdown.classList.add('hidden');
    }
  });
  
  // Payment Radio change listener
  paymentRadios.forEach(radio => radio.addEventListener('change', updateTotals));

  

  
  // Calculate Totals
  function updateTotals() {
    let subtotal = 0;
    let totalGst = 0;
    cart.forEach(item => {
      let lineTaxable = item.price * item.qty;
      subtotal += lineTaxable;
      let gstRate = parseFloat(item.gst_rate) || 5;
      totalGst += lineTaxable * (gstRate / 100);
    });

    const originalGoodsTotal = subtotal + totalGst;
    
    const discountPercent = parseFloat(inputDiscountPercent.value || '0') || 0;
    const percentDiscountAmount = originalGoodsTotal * (discountPercent / 100);
    const flatDiscount = parseFloat(inputDiscount.value || '0') || 0;
    
    computedTotalDiscount = percentDiscountAmount + flatDiscount;
    computedTotalDiscount = computedTotalDiscount > originalGoodsTotal ? originalGoodsTotal : computedTotalDiscount;
    
    const targetGoodsFinal = Math.max(0, originalGoodsTotal - computedTotalDiscount);
    const shipping = parseFloat(inputShipping.value || '0') || 0;
    const total = targetGoodsFinal + shipping;

    sumSubtotal.textContent = subtotal.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
    if (sumGst) sumGst.textContent = totalGst.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
    sumTotal.textContent = total.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
  }

  // Render Cart Table
  function renderCart() {
    if (cart.length === 0) {
      emptyRow.style.display = 'table-row';
      Array.from(tbody.children).forEach(c => { if(c !== emptyRow) c.remove(); });
      updateTotals();
      return;
    }
    emptyRow.style.display = 'none';
    
    // Clear old rows
    Array.from(tbody.children).forEach(c => { if(c !== emptyRow) c.remove(); });

    cart.forEach((item, index) => {
      const tr = document.createElement('tr');
      tr.className = 'group hover:bg-gray-50 transition-colors';
      
      // Select variants dropdown if applicable
      const p = products.find(prod => prod.id === item.pid);
      let variantHtml = `<span class="text-secondary/50 text-xs">N/A</span>`;
      if (p && ((p.hasVariants && p.variants.length > 0) || (p.b2b_variants && p.b2b_variants.length > 0))) {
        variantHtml = `<select class="variant-select text-xs border border-gray-200 rounded px-2 py-1 outline-none focus:border-primary" data-index="${index}">`;
        p.variants.forEach((v, vIdx) => {
          variantHtml += `<option value="${vIdx}" ${item.vIndex === vIdx && !item.isB2bVariant ? 'selected' : ''}>${v.weight || v.name} - ₹${v.price}</option>`;
        });
        if (p.b2b_variants) {
          p.b2b_variants.forEach((v, vIdx) => {
            const b2bIdx = vIdx + 1000; // offset for b2b variants
            variantHtml += `<option value="${b2bIdx}" ${item.vIndex === b2bIdx ? 'selected' : ''}>${v.weight || v.name} (B2B) - ₹${v.price}</option>`;
          });
        }
        if (item.isCustomB2b) {
          variantHtml += `<option value="-1" selected>${item.variantName}</option>`;
        }
        variantHtml += `</select>`;
      } else if (item.isCustomB2b) {
        variantHtml = `<span class="text-xs font-semibold text-primary">${item.variantName}</span>`;
      }

      tr.innerHTML = `
        <td class="px-4 py-3 font-semibold text-secondary">${item.name}</td>
        <td class="px-4 py-3">${variantHtml}</td>
        <td class="px-4 py-3 text-secondary/70">
          <div class="flex items-center gap-1">
            <span class="text-xs">₹</span>
            <input type="number" step="0.01" min="0" value="${item.price}" class="price-input w-20 px-2 py-1 text-sm border border-gray-200 rounded outline-none focus:border-primary text-right" data-index="${index}" />
          </div>
        </td>
        <td class="px-4 py-3">
          <input type="number" min="0.01" step="0.01" value="${item.qty}" class="qty-input w-20 px-2 py-1 text-sm border border-gray-200 rounded outline-none focus:border-primary text-center" data-index="${index}" />
        </td>
        <td class="px-4 py-3 text-right font-bold text-secondary">₹${(item.price * item.qty).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
        <td class="px-4 py-3 text-right">
          <button type="button" class="btn-remove text-red-400 hover:text-red-600 transition-colors" data-index="${index}">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    // Attach events
    document.querySelectorAll('.price-input').forEach(el => {
      el.addEventListener('change', (e) => {
        const idx = parseInt(e.target.dataset.index);
        const val = parseFloat(e.target.value);
        if (val >= 0) {
          cart[idx].price = val;
          cart[idx].isManuallyEdited = true;
        }
        renderCart();
      });
    });

    document.querySelectorAll('.qty-input').forEach(el => {
      el.addEventListener('change', (e) => {
        const idx = parseInt(e.target.dataset.index);
        const val = parseFloat(e.target.value);
        if (val > 0) cart[idx].qty = val;
        renderCart();
      });
    });

    document.querySelectorAll('.variant-select').forEach(el => {
      el.addEventListener('change', (e) => {
        const idx = parseInt(e.target.dataset.index);
        const vIdx = parseInt(e.target.value);
        if (vIdx === -1) return; // Custom, skip
        
        const item = cart[idx];
        const p = products.find(prod => prod.id === item.pid);
        if (p) {
          if (vIdx >= 1000) {
            const b2bIdx = vIdx - 1000;
            if (p.b2b_variants && p.b2b_variants[b2bIdx]) {
              item.vIndex = vIdx;
              item.variantName = (p.b2b_variants[b2bIdx].weight || p.b2b_variants[b2bIdx].name) + ' (B2B)';
              item.price = p.b2b_variants[b2bIdx].price;
              item.isB2bVariant = true;
              item.isCustomB2b = false;
              item.isManuallyEdited = false;
              renderCart();
            }
          } else {
            if (p.variants[vIdx]) {
              item.vIndex = vIdx;
              item.variantName = p.variants[vIdx].weight || p.variants[vIdx].name;
              
              let finalPrice = p.variants[vIdx].price;
              const toggleDeals = document.getElementById('toggle-deals');
              const applyDeals = toggleDeals ? toggleDeals.checked : false;
              if (!applyDeals) {
                 if (p.variants[vIdx].b2b_price) finalPrice = parseFloat(p.variants[vIdx].b2b_price);
                 else if (p.variants[vIdx].pos_price) finalPrice = parseFloat(p.variants[vIdx].pos_price);
              }
              item.price = finalPrice;
              item.isB2bVariant = false;
              item.isCustomB2b = false;
              item.isManuallyEdited = false;
              renderCart();
            }
          }
        }
      });
    });

    document.querySelectorAll('.btn-remove').forEach(el => {
      el.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.dataset.index);
        cart.splice(idx, 1);
        renderCart();
      });
    });

    updateTotals();
  }

  // Add Custom Variant logic
  document.getElementById('btn-add-custom-variant').addEventListener('click', () => {
    const val = cvVal.value;
    if (!val) {
      alert("Please select a base product first to add a custom variant to it.");
      return;
    }
    const p = products.find(prod => prod.id === val);

    const vName = document.getElementById('custom-variant-name').value.trim();
    const vPrice = parseFloat(document.getElementById('custom-variant-price').value);
    
    if (!vName || isNaN(vPrice) || vPrice < 0) {
      alert("Please enter a valid custom variant name and positive price.");
      return;
    }

    cart.push({
      pid: p.id,
      vIndex: -1, // Indicates custom B2B variant
      name: p.name,
      variantName: vName + ' (B2B)',
      price: vPrice,
      qty: 1,
      hsn_code: p.hsn_code,
      gst_rate: p.gst_rate,
      isCustomB2b: true
    });
    
    document.getElementById('custom-variant-name').value = '';
    document.getElementById('custom-variant-price').value = '';
    
    // Save permanently if checked
    if (document.getElementById('custom-variant-save').checked) {
       const btnObj = document.getElementById('btn-add-custom-variant');
       const originalText = btnObj.textContent;
       btnObj.textContent = 'Saving...';
       btnObj.disabled = true;
       fetch('/api/admin/products/add-b2b-variant', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ product_id: p.id, b2b_variant: { name: vName, price: vPrice } })
       }).then(res => res.json()).then(data => {
          if (data.success && data.variant) {
             if (!p.b2b_variants) p.b2b_variants = [];
             const newIndex = p.b2b_variants.length;
             p.b2b_variants.push(data.variant);
             
             // Update the cart item to point to this saved variant
             const cartItem = cart.find(c => c.pid === p.id && c.vIndex === -1 && c.isCustomB2b && c.variantName === (vName + ' (B2B)'));
             if (cartItem) {
                 cartItem.vIndex = newIndex + 1000;
                 cartItem.isCustomB2b = false;
                 cartItem.isB2bVariant = true;
                 renderCart();
             }
          }
       }).catch(console.error).finally(() => {
          btnObj.textContent = originalText;
          btnObj.disabled = false;
       });
    }

    cvSearch.value = '';
    cvVal.value = '';
    renderCart();
  });


  function addToCart(p, vIndex = 0, isB2bVariant = false) {
    const globalQtyInput = document.getElementById('global-add-qty');
    let qtyToAdd = globalQtyInput ? parseFloat(globalQtyInput.value) : 1;
    if (isNaN(qtyToAdd) || qtyToAdd <= 0) qtyToAdd = 1;

    const existing = cart.find(item => item.pid === p.id && item.vIndex === vIndex && item.isB2bVariant === isB2bVariant && !item.isCustomB2b);
    const validVariants = p.variants && p.variants.length > 0;
    const isVariantProd = p.hasVariants && validVariants;

    if (existing) {
      existing.qty += qtyToAdd;
    } else {
      let vName = 'N/A';
      let vPrice = p.price;
      
      if (isB2bVariant) {
        const bIdx = vIndex - 1000;
        if (p.b2b_variants && p.b2b_variants[bIdx]) {
          vName = (p.b2b_variants[bIdx].weight || p.b2b_variants[bIdx].name) + ' (B2B)';
          vPrice = p.b2b_variants[bIdx].price || p.price;
        }
      } else if (isVariantProd && p.variants[vIndex]) {
        vName = p.variants[vIndex].weight || p.variants[vIndex].name || 'Default';
        vPrice = p.variants[vIndex].price || p.price;
        const toggleDeals = document.getElementById('toggle-deals');
        const applyDeals = toggleDeals ? toggleDeals.checked : false;
        if (!applyDeals) {
           if (p.variants[vIndex].b2b_price) vPrice = parseFloat(p.variants[vIndex].b2b_price);
           else if (p.variants[vIndex].pos_price) vPrice = parseFloat(p.variants[vIndex].pos_price);
        }
      } else {
        const toggleDeals = document.getElementById('toggle-deals');
        const applyDeals = toggleDeals ? toggleDeals.checked : false;
        if (!applyDeals) {
           if (p.b2b_price) vPrice = parseFloat(p.b2b_price);
           else if (p.pos_price) vPrice = parseFloat(p.pos_price);
        }
      }

      cart.push({
        pid: p.id,
        name: p.name,
        vIndex: vIndex,
        variantName: vName,
        price: vPrice,
        qty: qtyToAdd,
        hsn_code: p.hsn_code,
        gst_rate: p.gst_rate,
        isB2bVariant: isB2bVariant,
        isCustomB2b: false,
        isManuallyEdited: false
      });
    }

    if (globalQtyInput) globalQtyInput.value = 1;

    pSearch.value = '';
    renderCart();
  }
  
  const toggleDeals = document.getElementById('toggle-deals');
  if (toggleDeals) {
    toggleDeals.addEventListener('change', () => {
       cart.forEach(item => {
          if (item.isCustomB2b || item.isManuallyEdited) return;
          
          const p = products.find(prod => prod.id === item.pid);
          if (!p) return;
          
          const isVariantProd = p.hasVariants && p.variants && p.variants.length > 0;
          let vPrice = p.price;
          
          if (item.isB2bVariant) {
             const bIdx = item.vIndex - 1000;
             if (p.b2b_variants && p.b2b_variants[bIdx]) {
                vPrice = p.b2b_variants[bIdx].price || p.price;
             }
          } else if (isVariantProd && p.variants[item.vIndex]) {
             vPrice = p.variants[item.vIndex].price || p.price;
             if (!toggleDeals.checked) {
                if (p.variants[item.vIndex].b2b_price) vPrice = parseFloat(p.variants[item.vIndex].b2b_price);
                else if (p.variants[item.vIndex].pos_price) vPrice = parseFloat(p.variants[item.vIndex].pos_price);
             }
          } else {
             if (!toggleDeals.checked) {
                if (p.specifications && p.specifications._b2b_price) vPrice = parseFloat(p.specifications._b2b_price);
                else if (p.specifications && p.specifications._pos_price) vPrice = parseFloat(p.specifications._pos_price);
             }
          }
          item.price = vPrice;
       });
       renderCart();
    });
  }

  function attachPaymentRadioListeners() {
    document.querySelectorAll('.payment-radio').forEach(radio => {
      radio.addEventListener('change', (e) => {
        const val = e.target.value;
        const statusDropdown = document.getElementById('payment-status');
        if (statusDropdown) {
          if (val === 'Prepaid') {
            statusDropdown.value = 'paid';
          } else {
            statusDropdown.value = 'pending';
          }
        }
        updateTotals();
      });
    });
  }
  attachPaymentRadioListeners();

  inputDiscountPercent.addEventListener('input', updateTotals);
  inputDiscount.addEventListener('input', updateTotals);
  inputShipping.addEventListener('input', updateTotals);

  // Toggle quotation text
  const toggleQuotation = document.getElementById('toggle-quotation');
  const submitBtnText = document.getElementById('submit-btn-text');
  if (toggleQuotation) {
    toggleQuotation.addEventListener('change', () => {
      submitBtnText.textContent = toggleQuotation.checked ? 'Save Quotation' : (currentOrderId ? 'Update Bill' : 'Generate Bill');
    });
  }

  // Pre-fill if editing
  if (editOrder) {
    document.getElementById('cust-name').value = editOrder.customer?.name || '';
    document.getElementById('cust-phone').value = editOrder.customer?.phone || '';
    document.getElementById('cust-gstin').value = editOrder.customer?.gstin || '';
    document.getElementById('cust-email').value = editOrder.customer?.email || '';
    document.getElementById('cust-address').value = editOrder.customer?.address || '';
    document.getElementById('cust-city').value = editOrder.customer?.city || '';
    document.getElementById('cust-state').value = editOrder.customer?.state || '';
    document.getElementById('cust-pincode').value = editOrder.customer?.pincode || '';

    inputDiscount.value = editOrder.discount || 0;
    inputShipping.value = editOrder.shipping || 0;
    document.getElementById('input-amount-received').value = editOrder.customer?.amount_received || 0;
    
    if (editOrder.paymentMethod) {
       const radio = document.querySelector(`input[name="payment"][value="${editOrder.paymentMethod}"]`);
       if (radio) radio.checked = true;
    }
    if (editOrder.paymentStatus) {
       document.getElementById('payment-status').value = editOrder.paymentStatus.toLowerCase() === 'paid' ? 'paid' : 'pending';
    }

    if ((editOrder.status === 'quotation' || editOrder.source === 'quotation') && toggleQuotation) {
      toggleQuotation.checked = true;
      submitBtnText.textContent = 'Update Quotation';
    } else if (currentOrderId) {
      submitBtnText.textContent = 'Update Bill';
    }

    if (editOrder.items && editOrder.items.length > 0) {
      editOrder.items.forEach(it => {
         const p = products.find(prod => prod.id === it.product_id || prod.name === it.name);
         if (p) {
            let vIndex = 0;
            let isB2bVariant = false;
            let isCustomB2b = false;
            let vName = it.variant || it.variant_name || '';

            if (p.hasVariants && p.variants) {
               const idx = p.variants.findIndex(v => v.weight === vName || v.name === vName);
               if (idx > -1) vIndex = idx;
            } else if (p.b2b_variants) {
               const idx = p.b2b_variants.findIndex(v => (v.weight || v.name) === vName || (v.weight || v.name) + ' (B2B)' === vName);
               if (idx > -1) {
                  vIndex = idx + 1000;
                  isB2bVariant = true;
               } else if (vName) {
                  vIndex = -1;
                  isCustomB2b = true;
               }
            }

            cart.push({
               pid: p.id,
               name: p.name,
               vIndex,
               variantName: vName + (isB2bVariant ? ' (B2B)' : (isCustomB2b ? ' (B2B)' : '')),
               price: it.price,
               qty: it.quantity,
               hsn_code: it.hsn_code || p.hsn_code,
               gst_rate: it.gst_rate || p.gst_rate,
               isB2bVariant,
               isCustomB2b,
               isManuallyEdited: true
            });
         }
      });
      renderCart();
    }
  }

  // Submit Order
  const btnSubmit = document.getElementById('btn-submit-order');
  btnSubmit.addEventListener('click', async () => {
    // Validate
    const requiredFields = ['cust-name', 'cust-phone', 'cust-address', 'cust-city', 'cust-state', 'cust-pincode'];
    const allFields = [...requiredFields, 'cust-email', 'cust-gstin'];
    let valid = true;
    const custData = {};
    allFields.forEach(id => {
      const el = document.getElementById(id);
      if (!el.value.trim() && requiredFields.includes(id)) {
        el.classList.add('ring-2', 'ring-red-400', 'border-red-400');
        valid = false;
      } else {
        el.classList.remove('ring-2', 'ring-red-400', 'border-red-400');
        custData[id.replace('cust-', '')] = el.value.trim();
      }
    });

    if (!valid) {
      alert("Please fill all required customer details.");
      return;
    }

    if (cart.length === 0) {
      alert("Please add at least one product.");
      return;
    }

    btnSubmit.disabled = true;
    btnSubmit.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Generating...`;

    // Construct Payload
    const paymentMode = document.querySelector('input[name="payment"]:checked').value;
    const paymentStatus = document.getElementById('payment-status').value;

    const subtotal = parseFloat(sumSubtotal.textContent.replace(/,/g, '')) || 0;
    const shipping = parseFloat(inputShipping.value || '0') || 0;
    const grandTotal = parseFloat(sumTotal.textContent.replace(/,/g, '')) || 0;
    const discount = computedTotalDiscount || 0;

    // Collect all B2B custom variants to save back to the product
    const customB2bItems = cart.filter(c => c.isCustomB2b);
    if (customB2bItems.length > 0) {
      // Group by productId
      const groups = {};
      customB2bItems.forEach(item => {
        if (!groups[item.pid]) groups[item.pid] = [];
        groups[item.pid].push({ name: item.variantName.replace(' (B2B)',''), price: item.price, weight: item.variantName.replace(' (B2B)','') });
      });
      
      // Fire and forget update calls for B2B variants
      for (const pid of Object.keys(groups)) {
        const p = products.find(prod => prod.id === pid);
        if (p) {
          const newB2bVariants = [...(p.b2b_variants || []), ...groups[pid]];
          fetch('/api/admin/b2b-update-variants', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId: pid, b2b_variants: newB2bVariants })
          }).catch(console.error);
        }
      }
    }

    const payload = {
      customer: custData,
      is_b2b: true,
      items: cart.map(c => {
        let cleanVariant = c.variantName || '';
        if (cleanVariant.endsWith(' (B2B)')) {
          cleanVariant = cleanVariant.substring(0, cleanVariant.length - 6);
        }
        return {
          product_id: c.pid,
          name: c.name,
          price: c.price,
          quantity: c.qty,
          variant_name: cleanVariant,
          variant: cleanVariant,
          hsn_code: c.hsn_code,
          gst_rate: c.gst_rate
        };
      }),
      subtotal,
      shipping,
      discount,
      grandTotal,
      paymentMethod: paymentMode,
      paymentStatus: paymentStatus,
      amountReceived: parseInt(document.getElementById("input-amount-received").value) || 0,
      notes: "Generated via B2B Bulk Orders",
      is_quotation: toggleQuotation ? toggleQuotation.checked : false,
      edit_order_id: currentOrderId
    };

    try {
      const res = await fetch('/api/admin/create-manual-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      
      if (res.ok) {
        // Redirect to invoice page immediately
        window.location.href = `/admin/invoice/${data.orderId}`;
      } else {
        throw new Error(data.error || 'Failed to create order');
      }
    } catch (err) {
      alert("Error: " + err.message);
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = `<span>Generate Bill</span>...`;
    }
  });

  document.addEventListener('prices-updated', (e) => {
     const updates = e.detail;
     updates.forEach(u => {
        const p = products.find(prod => prod.id === u.id);
        if (p) {
           if (u.specifications) p.specifications = { ...p.specifications, ...u.specifications };
           if (u.variants && u.variants.length > 0) {
              u.variants.forEach(vUpdate => {
                 if (p.variants[vUpdate.vIndex]) {
                    if (vUpdate.pos_price !== undefined) p.variants[vUpdate.vIndex].pos_price = vUpdate.pos_price;
                    if (vUpdate.b2b_price !== undefined) p.variants[vUpdate.vIndex].b2b_price = vUpdate.b2b_price;
                 }
              });
           }
        }
     });
     
     // Update prices in cart if not manually edited
     const toggleDeals = document.getElementById('toggle-deals');
     const applyDeals = toggleDeals ? toggleDeals.checked : false;
     
     cart.forEach(item => {
        if (item.isCustomB2b || item.isManuallyEdited) return;
        const p = products.find(prod => prod.id === item.pid);
        if (!p) return;
        
        const isVariantProd = p.hasVariants && p.variants && p.variants.length > 0;
        let vPrice = p.price;
        
        if (item.isB2bVariant) {
           const b2bIdx = item.vIndex >= 1000 ? item.vIndex - 1000 : item.vIndex;
           if (p.b2b_variants && p.b2b_variants[b2bIdx]) {
              vPrice = p.b2b_variants[b2bIdx].price;
           }
        } else if (isVariantProd && p.variants[item.vIndex]) {
           vPrice = p.variants[item.vIndex].price || p.price;
           if (!applyDeals) {
              if (p.variants[item.vIndex].b2b_price) vPrice = parseFloat(p.variants[item.vIndex].b2b_price);
              else if (p.variants[item.vIndex].pos_price) vPrice = parseFloat(p.variants[item.vIndex].pos_price);
           }
        } else {
           if (!applyDeals) {
              if (p.specifications && p.specifications._b2b_price) vPrice = parseFloat(p.specifications._b2b_price);
              else if (p.specifications && p.specifications._pos_price) vPrice = parseFloat(p.specifications._pos_price);
           }
        }
        item.price = vPrice;
     });
     
     renderCart();
  });

  // Init
  updateTotals();
</script>