---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSettings, getStore } from '../../../lib/database';

const store = await getStore(Astro.locals?.storeId);
const isFreeTier = store?.plan_id === '00000000-0000-0000-0000-000000000005';

const settings = await getSettings(Astro.locals?.storeId);
let pc = settings.pages_content || {};
if (typeof pc === 'string') {
  try { pc = JSON.parse(pc); } catch { pc = {}; }
}
const customDomain = pc.custom_domain || '';
const domainStatus = pc.custom_domain_status || 'none'; // 'none', 'pending', 'active'
---

<AdminLayout title="Custom Domains">
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-secondary">Custom Domains</h1>
        <p class="text-sm text-secondary/60 mt-1">Connect a custom domain to your store.</p>
      </div>
    </div>

    <!-- Domain Configuration Card -->
    {isFreeTier ? (
      <div class="bg-white rounded-2xl border border-gray-200 p-8 text-center shadow-sm">
        <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
        </div>
        <h2 class="text-xl font-bold text-secondary mb-2">Custom Domains are locked</h2>
        <p class="text-sm text-secondary/70 mb-6">Upgrade to our Growth Plan to connect your own .com or .in domain to your store.</p>
      </div>
    ) : (
    <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-secondary mb-4">Connect Existing Domain</h2>
      
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-secondary/70 mb-1.5">Enter your domain</label>
          <div class="flex gap-3">
            <input 
              type="text" 
              id="domain-input"
              value={customDomain}
              placeholder="e.g. www.mystore.com" 
              class="flex-1 px-4 py-2.5 border border-gray-200 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition"
            />
            <button 
              onclick="saveDomain()"
              class="px-6 py-2.5 bg-primary text-white font-medium rounded-xl hover:bg-primary/90 transition-colors whitespace-nowrap"
            >
              {customDomain ? 'Update Domain' : 'Connect Domain'}
            </button>
          </div>
        </div>

        {customDomain && (
          <div class="mt-6 border-t border-gray-100 pt-6">
            <div class="flex items-center gap-3 mb-4">
              <h3 class="text-sm font-semibold text-secondary">Status:</h3>
              {domainStatus === 'active' ? (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-green-50 text-green-700 border border-green-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                  Active / Connected
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                  Pending Configuration
                </span>
              )}
            </div>

            <div class="bg-blue-50/50 border border-blue-100 rounded-xl p-5">
              <h4 class="text-sm font-semibold text-blue-900 mb-2">DNS Configuration Required</h4>
              <p class="text-xs text-blue-800 mb-4">To complete the connection, log in to your domain provider (GoDaddy, Hostinger, etc.) and add the following DNS records:</p>
              
              <div class="space-y-3">
                <div class="flex items-center justify-between bg-white px-4 py-3 rounded-lg border border-blue-100/50">
                  <div class="flex gap-4">
                    <div>
                      <span class="text-[10px] font-bold uppercase tracking-wider text-secondary/50 block">Type</span>
                      <span class="text-sm font-mono font-medium text-secondary">A Record</span>
                    </div>
                    <div>
                      <span class="text-[10px] font-bold uppercase tracking-wider text-secondary/50 block">Name</span>
                      <span class="text-sm font-mono font-medium text-secondary">@</span>
                    </div>
                    <div>
                      <span class="text-[10px] font-bold uppercase tracking-wider text-secondary/50 block">Value</span>
                      <span class="text-sm font-mono font-medium text-secondary">104.21.84.12</span>
                    </div>
                  </div>
                </div>

                <div class="flex items-center justify-between bg-white px-4 py-3 rounded-lg border border-blue-100/50">
                  <div class="flex gap-4">
                    <div>
                      <span class="text-[10px] font-bold uppercase tracking-wider text-secondary/50 block">Type</span>
                      <span class="text-sm font-mono font-medium text-secondary">CNAME</span>
                    </div>
                    <div>
                      <span class="text-[10px] font-bold uppercase tracking-wider text-secondary/50 block">Name</span>
                      <span class="text-sm font-mono font-medium text-secondary">www</span>
                    </div>
                    <div>
                      <span class="text-[10px] font-bold uppercase tracking-wider text-secondary/50 block">Value</span>
                      <span class="text-sm font-mono font-medium text-secondary">domains.vyaparpe.in</span>
                    </div>
                  </div>
                </div>
              </div>

              <p class="text-[11px] text-blue-700/70 mt-4 italic">Note: DNS propagation can take anywhere from a few minutes up to 48 hours depending on your provider.</p>
            </div>
            
            <div class="mt-4 flex justify-end">
               <button 
                  onclick="removeDomain()"
                  class="text-xs font-semibold text-red-500 hover:text-red-700 transition-colors underline"
                >
                  Remove Domain
                </button>
            </div>
          </div>
        )}
      </div>
    </div>
    )}
  </div>

  <script is:inline data-astro-rerun>
    async function saveDomain() {
      const input = document.getElementById('domain-input');
      const custom_domain = input.value.trim().toLowerCase();
      
      if (custom_domain && !custom_domain.includes('.')) {
        alert('Please enter a valid domain (e.g. www.mystore.com)');
        return;
      }

      const btn = event.currentTarget;
      const originalText = btn.innerText;
      btn.innerText = 'Connecting...';
      btn.disabled = true;

      try {
        const res = await fetch('/api/admin/domains', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ custom_domain })
        });
        
        if (!res.ok) throw new Error('Failed to save domain');
        window.location.reload();
      } catch (err) {
        alert(err.message);
        btn.innerText = originalText;
        btn.disabled = false;
      }
    }

    async function removeDomain() {
      if (!confirm('Are you sure you want to remove this custom domain? Your store will only be accessible via the default URL.')) return;
      
      try {
        const res = await fetch('/api/admin/domains', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ custom_domain: '' })
        });
        
        if (!res.ok) throw new Error('Failed to remove domain');
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    }
  </script>
</AdminLayout>
