---
import Layout from '../layouts/Layout.astro';
import { getOrders, getSettings } from '../lib/database';

import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const SUPABASE_SERVICE_ROLE_KEY = import.meta.env.SUPABASE_SERVICE_ROLE_KEY;

let order: any = null;
let fulfillment: any = null;
const queryId = Astro.url.searchParams.get('id');
const queryPhone = Astro.url.searchParams.get('phone');

if (queryId && queryPhone) {
  const orders = await getOrders();
  const cleanId = queryId.trim().replace(/^#/, '');
  const foundOrder = orders.find((o: any) => o.orderId === cleanId || (o.masterOrderId && o.masterOrderId === cleanId) || (o.order_number && o.order_number === cleanId) || o.orderId === queryId.trim());
  if (foundOrder && foundOrder.customer?.phone) {
    const orderPhoneClean = foundOrder.customer.phone.replace(/\D/g, '').slice(-10);
    const searchPhoneClean = queryPhone.trim().replace(/\D/g, '').slice(-10);
    if (orderPhoneClean === searchPhoneClean) {
      order = foundOrder;
      
      // Get the active rider fulfillment
      // Since PGRST200 fallback drops fulfillments array in getOrders(), we fetch it manually here
      if (SUPABASE_URL && SUPABASE_ANON_KEY) {
        const client = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY || SUPABASE_ANON_KEY);
        const { data: fulfillments } = await client.from('fulfillments').select('*').eq('order_id', order.orderId);
        if (fulfillments && fulfillments.length > 0) {
           fulfillment = fulfillments.find((f: any) => f.rider_name && f.status !== 'cancelled');
        }
      }
      
      if (!fulfillment) {
        fulfillment = order.fulfillments?.find((f: any) => f.rider_name && f.status !== 'cancelled');
      }
    }
  }
}

const settings = await getSettings(Astro.locals?.storeId);
const googleMapsApiKey = settings?.google_maps_api_key || null;

let destStr = '';
let fallbackDestStr1 = '';
let fallbackDestStr2 = '';
if (order && order.customer) {
  destStr = `${order.customer.address || ''}, ${order.customer.city || ''}, ${order.customer.state || ''} ${order.customer.pincode || ''}`.replace(/^[\s,]+|[\s,]+$/g, '');
  fallbackDestStr1 = `${order.customer.city || ''}, ${order.customer.state || ''} ${order.customer.pincode || ''}`.replace(/^[\s,]+|[\s,]+$/g, '');
  fallbackDestStr2 = `${order.customer.pincode || ''}, India`.replace(/^[\s,]+|[\s,]+$/g, '');
}
---

<Layout bodyClass="bg-gray-100" title="Track Rider" description="Live track your delivery rider." hideHeader={true} hideFooter={true} hideWhatsApp={true}>
  {!order || !fulfillment ? (
    <div class="min-h-screen flex items-center justify-center p-6">
      <div class="bg-white p-8 rounded-3xl shadow-xl text-center max-w-md w-full">
        <div class="w-20 h-20 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
        </div>
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Order Not Found</h2>
        <p class="text-gray-500 mb-6">We couldn't find an active tracking session for this order. It may have already been delivered or the details provided are incorrect.</p>
        <a href="/account/orders" class="inline-flex items-center justify-center bg-primary hover:bg-primary/90 text-white font-bold py-3 px-6 rounded-xl transition-colors w-full">Back to Orders</a>
      </div>
    </div>
  ) : (
    <div class="fixed inset-0 w-full h-[100dvh] flex flex-col overflow-hidden z-[90] bg-gray-50 overscroll-none">
      {googleMapsApiKey ? (
        <div class="flex-1 w-full bg-gray-200 relative">
          <div id={`map_${fulfillment.id}`} class="w-full h-full rider-map absolute inset-0" data-fid={fulfillment.id} data-lat={fulfillment.last_known_location?.lat} data-lon={fulfillment.last_known_location?.lon}></div>
          
          <div class="absolute top-0 left-0 right-0 p-4 pt-6 z-[400] bg-gradient-to-b from-black/50 to-transparent pointer-events-none">
            <button onclick="history.back()" class="w-10 h-10 bg-white/90 backdrop-blur rounded-full flex items-center justify-center shadow-lg text-gray-800 hover:bg-white transition-colors cursor-pointer pointer-events-auto">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </button>
          </div>
        </div>
      ) : (
        <div class="flex-1 w-full bg-gray-50 flex flex-col items-center justify-center p-6 relative">
          <div class="absolute top-0 left-0 right-0 p-4 pt-6 z-[400]">
            <button onclick="history.back()" class="w-10 h-10 bg-white shadow-md rounded-full flex items-center justify-center text-gray-800 hover:bg-gray-50 transition-colors cursor-pointer">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </button>
          </div>
          
          <div class="relative w-48 h-48 mb-8">
            <div class="absolute inset-0 bg-primary/10 rounded-full animate-ping opacity-75"></div>
            <div class="absolute inset-4 bg-primary/20 rounded-full animate-pulse"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <svg class="w-24 h-24 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 19h18M7 17v-2a4 4 0 014-4h6a4 4 0 014 4v2M14 9a4 4 0 11-8 0 4 4 0 018 0zm-2 0l.01 0" />
              </svg>
            </div>
          </div>
          
          <h2 class="text-2xl font-black text-gray-900 text-center mb-2">Tracking Your Delivery</h2>
          <p class="text-gray-500 text-center max-w-sm">We are bringing your order to you! The rider's status will update below automatically.</p>
        </div>
      )}


      {/* Bottom Sheet - Rider Info */}
      <div class="bg-white rounded-t-3xl shadow-[0_-10px_40px_rgba(0,0,0,0.1)] relative z-10 px-6 py-8 pb-[100px]">
        <div class="w-12 h-1.5 bg-gray-200 rounded-full mx-auto absolute top-3 left-1/2 -translate-x-1/2"></div>
        
        <div class="flex items-center mb-6">
          <div>
            <h1 class="text-2xl font-black text-gray-900 flex items-baseline gap-1">
              {fulfillment.status === 'delivered' ? 'Delivered!' : (
                <>Arriving Soon<span class="tracking-[0.2em] opacity-60 animate-pulse">...</span></>
              )}
            </h1>
            <p class="text-sm text-gray-500 mt-1 font-medium">Order #{order.order_number || order.masterOrderId || order.orderId}</p>
          </div>
        </div>

        <div class="flex items-center gap-4 bg-gray-50 rounded-2xl p-4 border border-gray-100">
          <div class="w-14 h-14 rounded-full bg-primary/10 border-2 border-primary/20 flex items-center justify-center shrink-0 relative overflow-hidden">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-gray-900 truncate">{fulfillment.rider_name || 'Delivery Partner'}</p>
            <p id="rider_status_text" class="text-xs text-gray-500 flex items-center gap-1 mt-0.5">
              {fulfillment.status !== 'delivered' && <span class="w-2 h-2 rounded-full bg-green-500 inline-block animate-pulse"></span>} 
              {fulfillment.rider_status ? fulfillment.rider_status.replace('_', ' ').replace(/\b\w/g, (l:string) => l.toUpperCase()) : 'On the way'}
            </p>
          </div>

          {fulfillment.rider_phone && (
            <a href={`tel:${fulfillment.rider_phone}`} class="w-12 h-12 rounded-full bg-green-50 text-green-600 flex items-center justify-center shrink-0 shadow-sm active:scale-95 transition-transform hover:bg-green-100">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </a>
          )}
        </div>

      </div>
    </div>
  )}
</Layout>

{googleMapsApiKey && (
  <script is:inline src={`https://maps.googleapis.com/maps/api/js?key=${googleMapsApiKey}&libraries=geometry,marker,routes`}></script>
)}
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.8; }
    70% { transform: scale(2.5); opacity: 0; }
    100% { transform: scale(1); opacity: 0; }
  }
</style>

<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, googleMapsApiKey, destStr, fallbackDestStr1, fallbackDestStr2 }}>
  document.addEventListener('DOMContentLoaded', () => {
    const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    const mapElements = document.querySelectorAll('.rider-map');
    let fid = null;

    if (mapElements.length > 0) {
      fid = mapElements[0].getAttribute('data-fid');
    } else {
      // If no map element exists, extract fid from URL or another source if possible.
      // For now, we assume we can't track realtime location without the map element's data attributes,
      // but we can listen to the fulfillment status if we had the ID.
      // Wait, we need fid for the fallback UI text updates. Let's find it.
      // We didn't inject fid into the DOM for fallback. Let's just return if no fid.
      return; 
    }

    if (googleMapsApiKey && mapElements.length > 0 && window.google) {
      const el = mapElements[0];
      const startLatStr = el.getAttribute('data-lat');
      const startLonStr = el.getAttribute('data-lon');
      
      let startLat = parseFloat(startLatStr);
      let startLon = parseFloat(startLonStr);
      
      const initialLat = !isNaN(startLat) ? startLat : 20.5937;
      const initialLon = !isNaN(startLon) ? startLon : 78.9629;
      const initialZoom = !isNaN(startLat) ? 16 : 10;

      let map = new google.maps.Map(el, {
        zoom: initialZoom,
        center: { lat: initialLat, lng: initialLon },
        disableDefaultUI: true,
        styles: [
          {
            "featureType": "poi",
            "elementType": "labels",
            "stylers": [{ "visibility": "off" }]
          }
        ]
      });

      let riderMarker = null;
      let destMarker = null;
      let directionsService = new google.maps.DirectionsService();
      let directionsRenderer = new google.maps.DirectionsRenderer({
        map: map,
        suppressMarkers: true,
        polylineOptions: {
          strokeColor: '#3730a3',
          strokeOpacity: 1.0,
          strokeWeight: 5,
        }
      });
      
      let destLat = null;
      let destLon = null;
      let currentLat = initialLat;
      let currentLon = initialLon;
      let currentHeading = 0;
      let animationFrame = null;

      function updateRiderPosition(newLat, newLon) {
        if (!riderMarker) {
          currentLat = newLat;
          currentLon = newLon;
          
          // SVG Path for top-down arrow
          riderMarker = new google.maps.Marker({
            position: { lat: newLat, lng: newLon },
            map: map,
            icon: {
              path: 'M12 2L22 21L12 17L2 21L12 2Z',
              fillColor: '#4F46E5',
              fillOpacity: 1,
              strokeColor: '#ffffff',
              strokeWeight: 2,
              scale: 1.5,
              rotation: currentHeading,
              anchor: new google.maps.Point(12, 12),
            },
            zIndex: 1000
          });
          
          if (destLat && destLon) {
             drawRoute(newLat, newLon, destLat, destLon);
          } else {
             map.setCenter({ lat: newLat, lng: newLon });
          }
        } else {
          animateGoogleMarker(newLat, newLon, 4500);
        }
      }

      function animateGoogleMarker(targetLat, targetLon, duration = 3000) {
        if (!riderMarker) return;
        const startT = performance.now();
        const sLat = currentLat;
        const sLon = currentLon;
        
        const fromLatLng = new google.maps.LatLng(sLat, sLon);
        const toLatLng = new google.maps.LatLng(targetLat, targetLon);
        
        if (Math.abs(targetLat - sLat) > 0.0001 || Math.abs(targetLon - sLon) > 0.0001) {
          currentHeading = google.maps.geometry.spherical.computeHeading(fromLatLng, toLatLng);
        }

        function step(timestamp) {
          const progress = Math.min((timestamp - startT) / duration, 1);
          const ease = 1 - Math.pow(1 - progress, 3);
          
          currentLat = sLat + (targetLat - sLat) * ease;
          currentLon = sLon + (targetLon - sLon) * ease;
          
          riderMarker.setPosition({ lat: currentLat, lng: currentLon });
          
          const icon = riderMarker.getIcon();
          icon.rotation = currentHeading;
          riderMarker.setIcon(icon);

          if (progress < 1) {
            animationFrame = requestAnimationFrame(step);
          } else {
            if (destLat && destLon) {
               const bounds = new google.maps.LatLngBounds();
               bounds.extend(new google.maps.LatLng(currentLat, currentLon));
               bounds.extend(new google.maps.LatLng(destLat, destLon));
               map.fitBounds(bounds, { padding: 40 });
            } else {
               map.panTo({ lat: currentLat, lng: currentLon });
            }
          }
        }
        if (animationFrame) cancelAnimationFrame(animationFrame);
        animationFrame = requestAnimationFrame(step);
      }

      function drawRoute(rLat, rLon, dLat, dLon) {
        const request = {
          origin: new google.maps.LatLng(rLat, rLon),
          destination: new google.maps.LatLng(dLat, dLon),
          travelMode: 'DRIVING'
        };
        directionsService.route(request, (result, status) => {
          if (status === 'OK') {
            directionsRenderer.setDirections(result);
            
            // Adjust bounds to fit both points
            const bounds = new google.maps.LatLngBounds();
            bounds.extend(new google.maps.LatLng(rLat, rLon));
            bounds.extend(new google.maps.LatLng(dLat, dLon));
            map.fitBounds(bounds, { padding: 50 });
          }
        });
      }

      // Initialize Destination
      if (destStr) {
        const geocoder = new google.maps.Geocoder();
        const tryGeocode = async (queries) => {
          for (let q of queries) {
            if (!q) continue;
            try {
              const res = await geocoder.geocode({ address: q });
              if (res.results && res.results.length > 0) return res.results[0].geometry.location;
            } catch(e) { }
          }
          return null;
        };

        tryGeocode([destStr, fallbackDestStr1, fallbackDestStr2]).then(location => {
          if (location) {
            destLat = location.lat();
            destLon = location.lng();
            
            destMarker = new google.maps.Marker({
              position: location,
              map: map,
              icon: {
                path: google.maps.SymbolPath.CIRCLE,
                fillColor: '#10B981',
                fillOpacity: 1,
                strokeColor: '#ffffff',
                strokeWeight: 2,
                scale: 10
              }
            });

            if (riderMarker && !isNaN(startLat)) {
              drawRoute(startLat, startLon, destLat, destLon);
            } else {
              map.setCenter(location);
              map.setZoom(15);
            }
          }
        });
      }

      if (!isNaN(startLat)) {
        updateRiderPosition(startLat, startLon);
      }

      window.addEventListener('update_rider_loc', (e) => {
          if (e.detail && e.detail.latitude && e.detail.longitude) {
              updateRiderPosition(e.detail.latitude, e.detail.longitude);
          }
      });
    }

    // Subscribe to realtime location and status updates
    if (fid) {
      supabaseClient.channel(`fulfillment_${fid}`)
        .on('broadcast', { event: 'location_update' }, (payload) => {
          if (googleMapsApiKey && window.google && payload.payload && payload.payload.latitude && payload.payload.longitude) {
            // updateRiderPosition is enclosed in the if scope above, let's just trigger a custom event
            window.dispatchEvent(new CustomEvent('update_rider_loc', { detail: payload.payload }));
          }
        })
        .on('postgres_changes', { 
          event: 'UPDATE', 
          schema: 'public', 
          table: 'fulfillments', 
          filter: `id=eq.${fid}` 
        }, (payload) => {
          // Update Status Text
          const statusTextEl = document.getElementById('rider_status_text');
          if (statusTextEl && payload.new.rider_status) {
             const statusStr = payload.new.rider_status.replace('_', ' ').replace(/\b\w/g, (l) => l.toUpperCase());
             statusTextEl.innerHTML = (payload.new.status !== 'delivered' ? '<span class="w-2 h-2 rounded-full bg-green-500 inline-block animate-pulse"></span> ' : '') + statusStr;
          }

          if (googleMapsApiKey && window.google) {
            const newLat = payload.new.last_known_location?.lat;
            const newLon = payload.new.last_known_location?.lon;
            if (newLat && newLon) {
               window.dispatchEvent(new CustomEvent('update_rider_loc', { detail: { latitude: newLat, longitude: newLon } }));
            }
          }
        })
        .subscribe();
    }
  });
</script>

