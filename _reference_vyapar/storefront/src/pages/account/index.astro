---
import { verifyCustomerAuth } from '../../lib/auth';

if (!verifyCustomerAuth(Astro.cookies.get('customer_auth')?.value)) {
  return Astro.redirect('/account/login');
}
import Layout from '../../layouts/Layout.astro';
import QCommerceLayout from '../../layouts/QCommerceLayout.astro';
import AccountSidebar from '../../components/AccountSidebar.astro';
import { getCustomerById, getOrdersByCustomerId, getEnrichedAddresses, getSettings } from '../../lib/database';
import { storeContext } from '../../lib/storeContext';

let siteSettings = await getSettings(Astro.locals.storeId as string);
let qcThemeActive = false;
try {
  if (siteSettings?.website_configuration) {
    const parsed = typeof siteSettings.website_configuration === 'string'
      ? JSON.parse(siteSettings.website_configuration)
      : siteSettings.website_configuration;
    if (parsed.theme === 'qcommerce') qcThemeActive = true;
  }
} catch (e) {}

const ActiveLayout = qcThemeActive ? QCommerceLayout : Layout;

const customerId = verifyCustomerAuth(Astro.cookies.get('customer_auth')?.value) || '';

let customer: any = null;
let phone = '';
let email = '';
let myOrders: any[] = [];

await storeContext.run({ storeId: Astro.locals.storeId as string }, async () => {
  if (customerId) {
    customer = await getCustomerById(customerId);
    phone = customer?.phone || '';
    email = customer?.email || '';
    myOrders = await getOrdersByCustomerId(customerId);
  }
});

const loginMethod = Astro.cookies.get('login_method')?.value || '';
const isEmailAuth = loginMethod === 'email';
const emailFromCookie = email;

import { getEffectiveAuthMode } from '../../lib/auth';

const { authMode, otpLength } = await getEffectiveAuthMode(Astro.locals?.storeId);
const hasBothMode = authMode === 'both';
// Email is verified if customer has email set AND mode is 'both'
const emailVerified = hasBothMode && !!customer?.email;
const canCrossVerify = hasBothMode && !!customer?.phone && !!customer?.email;

let addresses: any[] = [];
if (phone) {
  await storeContext.run({ storeId: Astro.locals.storeId as string }, async () => {
    addresses = await getEnrichedAddresses(phone, Astro.locals.storeId as string);
  });
}

const displayId = customer?.name || (isEmailAuth ? emailFromCookie : phone);
---

<ActiveLayout bodyClass="bg-background-alt" title="My Account" description="Manage your account, orders, and addresses." settings={siteSettings}>
  {qcThemeActive ? (
    <div class="min-h-screen bg-[--qc-bg] pb-24">
      <!-- Premium Header Section -->
      <div class="relative bg-gradient-to-br from-primary to-primary-light px-5 pt-10 pb-16 overflow-hidden rounded-b-[2rem] shadow-md">
        <!-- Decorative subtle pattern -->
        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 20px 20px;"></div>
        
        <div class="relative z-10 flex items-center gap-5">
          <div class="w-16 h-16 rounded-full bg-surface shadow-xl flex items-center justify-center text-primary text-2xl font-black uppercase ring-4 ring-white/20">
            {displayId.charAt(0)}
          </div>
          <div class="flex flex-col">
            <h1 class="text-2xl font-black text-surface tracking-tight">{customer?.name || 'Guest User'}</h1>
            <p class="text-sm font-medium text-surface/80 flex items-center gap-1 mt-0.5">
              <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              {phone || emailFromCookie || 'No contact info'}
            </p>
          </div>
        </div>
      </div>
      
      <!-- Action Cards -->
      <div class="px-4 -mt-8 relative z-20">
        <div class="bg-surface rounded-2xl shadow-lg shadow-black/5 overflow-hidden border border-slate-100">
          <a href="/account/orders" class="flex items-center justify-between px-5 py-4 border-b border-slate-100 hover:bg-slate-50 active:bg-slate-100 transition-colors group">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
              </div>
              <div class="flex flex-col">
                <span class="font-bold text-slate-800 text-[15px]">My Orders</span>
                <span class="text-[11px] font-medium text-slate-500">Track, return, or buy again</span>
              </div>
            </div>
            <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
          
          <a href="/account/addresses" class="flex items-center justify-between px-5 py-4 hover:bg-slate-50 active:bg-slate-100 transition-colors group">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div class="flex flex-col">
                <span class="font-bold text-slate-800 text-[15px]">Saved Addresses</span>
                <span class="text-[11px] font-medium text-slate-500">Manage delivery locations</span>
              </div>
            </div>
            <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        </div>

        <div class="mt-6">
          <form method="POST" action="/api/account/logout" class="block w-full">
            <button type="submit" class="w-full flex items-center justify-center gap-2 px-5 py-3.5 bg-red-50 hover:bg-red-100 active:scale-[0.98] transition-all rounded-xl border border-red-100">
              <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
              <span class="font-bold text-red-600 text-[15px]">Logout</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  ) : (
  <div class="min-h-screen bg-background-alt pt-16 pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Page Header -->
      <div class="mb-8 pt-6">
        <h1 class="text-2xl font-serif font-bold text-secondary">My Account</h1>
        <p class="text-sm text-secondary/50 mt-1">Welcome back, <span class="text-primary font-medium">{customer?.name || displayId}</span></p>
      </div>

      <div class="flex flex-col lg:flex-row gap-6">

        <AccountSidebar activeTab="profile" customer={customer} phone={phone} emailFromCookie={emailFromCookie} isEmailAuth={isEmailAuth} addressesCount={addresses.length} ordersCount={myOrders.length} className="block w-full lg:w-64" />

        <!-- ──── MAIN CONTENT ──── -->
        <div id="account-main-content" class="flex-1 min-w-0 space-y-6 hidden lg:block">
          <!-- Mobile Back Button -->
          <a href="/account" class="lg:hidden flex items-center gap-2 text-secondary hover:text-primary transition-colors font-medium mb-2 px-2 py-1 bg-white rounded-lg shadow-sm border border-gray-100 w-fit">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Menu
          </a>

          <!-- ── PROFILE SECTION ── -->
          <section id="section-profile">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
              <div class="flex items-center gap-3 px-6 py-5 border-b border-gray-100 bg-gray-50/50">
                <div class="w-8 h-8 rounded-xl bg-primary/10 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
                <div>
                  <h2 class="text-base font-bold text-secondary">Profile Details</h2>
                  <p class="text-xs text-secondary/50">Update your personal information</p>
                </div>
              </div>

              <form action="/api/account/update-profile" method="POST" class="p-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                    <label class="block text-sm font-medium text-secondary mb-2">Full Name</label>
                    <input
                      type="text" name="name" value={customer?.name || ''} placeholder="Your full name"
                      class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm outline-none transition-all"
                    />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-secondary mb-2">Mobile Number</label>
                    <div class="relative">
                      {phone ? (
                        <>
                          <input type="text" value={phone} disabled
                            class="w-full px-4 py-3 border border-gray-100 rounded-xl bg-gray-50 text-sm text-secondary/50 cursor-not-allowed"
                          />
                          <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs bg-green-100 text-green-600 font-medium px-2 py-0.5 rounded-full">Verified ✓</span>
                        </>
                      ) : (
                        <p class="px-4 py-3 text-sm text-secondary/40 italic">No phone number set</p>
                      )}
                    </div>
                    {canCrossVerify && (
                      <button type="button" id="change-phone-btn" class="mt-1.5 text-xs text-primary hover:underline">Change phone number</button>
                    )}
                  </div>
                  <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-secondary mb-2">
                      Email Address
                      {emailVerified && <span class="ml-2 text-xs bg-green-100 text-green-600 font-medium px-2 py-0.5 rounded-full">Verified ✓</span>}
                      {hasBothMode && !emailVerified && customer?.email && <span class="ml-2 text-xs bg-amber-100 text-amber-600 font-medium px-2 py-0.5 rounded-full">Not verified</span>}
                    </label>
                    <div class="relative">
                      {emailVerified ? (
                        <>
                          <input type="text" value={customer?.email || ''} disabled
                            class="w-full px-4 py-3 border border-gray-100 rounded-xl bg-gray-50 text-sm text-secondary/50 cursor-not-allowed"
                          />
                          {canCrossVerify && (
                            <button type="button" id="change-email-btn"
                              class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-primary hover:underline">Change</button>
                          )}
                        </>
                      ) : (
                        <input
                          type="email" name="email" value={customer?.email || ''} placeholder="your@email.com"
                          class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-sm outline-none transition-all"
                        />
                      )}
                    </div>
                    {hasBothMode && !emailVerified && (
                      <button type="button" id="verify-email-btn"
                        class="mt-2 text-xs text-primary font-medium hover:underline flex items-center gap-1">
                        📧 Verify email address to enable email login
                      </button>
                    )}
                  </div>
                </div>
                <div class="mt-6 flex items-center gap-3">
                  <button type="submit" class="btn-primary text-sm px-6 py-2.5">
                    Save Changes
                  </button>
                  <p class="text-xs text-secondary/40">Changes apply immediately</p>
                </div>
              </form>

              {/* Cross-Verify Modal (Change Phone or Email) */}
              <div id="cross-verify-modal" class="hidden border-t border-gray-100">
                <div class="p-6 bg-amber-50">
                  <div class="flex items-start gap-3 mb-4">
                    <span class="text-2xl" id="modal-icon">🔐</span>
                    <div>
                      <p class="text-sm font-bold text-secondary" id="modal-title">Verify to continue</p>
                      <p class="text-xs text-secondary/60 mt-0.5" id="modal-desc">We'll send a verification code to confirm this change.</p>
                    </div>
                  </div>
                  <div id="modal-new-value-wrap" class="mb-4">
                    <label class="block text-xs font-medium text-secondary/70 mb-1.5" id="modal-input-label">New value</label>
                    <input id="modal-new-value" type="text"
                      class="w-full px-3 py-2.5 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none" />
                  </div>
                  <button id="modal-send-otp-btn" class="btn-primary text-sm px-5 py-2.5 mb-4">Send Verification Code</button>
                  <div id="modal-otp-wrap" class="hidden mb-4">
                    <label class="block text-xs font-medium text-secondary/70 mb-1.5" id="modal-otp-label">Enter OTP sent to <span id="modal-sent-to" class="font-bold"></span></label>
                    <input id="modal-otp-input" type="text" maxlength={otpLength} autocomplete="one-time-code" placeholder={Array(otpLength).fill('_').join('')}
                      class="w-full px-3 py-2.5 border border-gray-200 rounded-xl text-sm tracking-[0.5em] text-center font-bold focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none" />
                  </div>
                  <div class="flex gap-3">
                    <button id="modal-confirm-btn" class="hidden btn-primary text-sm px-5 py-2.5">Confirm Change</button>
                    <button id="modal-cancel-btn" class="text-sm px-5 py-2.5 border border-gray-200 rounded-xl text-secondary hover:bg-gray-50 transition-colors">Cancel</button>
                  </div>
                  <p id="modal-error" class="hidden text-xs text-red-600 mt-3"></p>
                </div>
              </div>
            </div>
          </section>

        </div>
      </div>
    </div>
  </div>
  )}

  {/* Existing Modals and Verification UI below (only really used in standard mode, but kept for compatibility) */}
<script define:vars={{ otpLength }}>
  // ── Cross-Verify Modal (Change Phone / Email) ─────────────────────────
  const cvModal = document.getElementById('cross-verify-modal');
  const cvTitle = document.getElementById('modal-title');
  const cvDesc = document.getElementById('modal-desc');
  const cvInputLabel = document.getElementById('modal-input-label');
  const cvInput = document.getElementById('modal-new-value');
  const cvSendBtn = document.getElementById('modal-send-otp-btn');
  
  const cvOtpWrap = document.getElementById('modal-otp-wrap');
  const cvSentTo = document.getElementById('modal-sent-to');
  const cvOtpInput = document.getElementById('modal-otp-input');
  const cvConfirmBtn = document.getElementById('modal-confirm-btn');
  const cvCancelBtn = document.getElementById('modal-cancel-btn');
  const cvError = document.getElementById('modal-error');
  
  let currentChangeType = '';

  function openCrossVerify(type) {
    currentChangeType = type;
    cvModal?.classList.remove('hidden');
    cvOtpWrap?.classList.add('hidden');
    cvConfirmBtn?.classList.add('hidden');
    cvSendBtn?.classList.remove('hidden');
    if (cvError) cvError.classList.add('hidden');
    
    cvInput.value = '';
    cvOtpInput.value = '';
    cvSendBtn.disabled = false;
    cvSendBtn.textContent = 'Send Verification Code';

    if (type === 'phone') {
      cvTitle.textContent = 'Change Phone Number';
      cvDesc.textContent = 'Enter your new 10-digit phone number. We will send an OTP to your registered email for security.';
      cvInputLabel.textContent = 'New Phone Number';
      cvInput.type = 'tel';
      cvInput.maxLength = 10;
      cvInput.placeholder = '10-digit number';
    } else {
      cvTitle.textContent = 'Change Email Address';
      cvDesc.textContent = 'Enter your new email address. We will send an OTP to your registered phone for security.';
      cvInputLabel.textContent = 'New Email Address';
      cvInput.type = 'email';
      cvInput.removeAttribute('maxLength');
      cvInput.placeholder = 'your@email.com';
    }
  }

  function closeCrossVerify() {
    cvModal?.classList.add('hidden');
  }

  document.getElementById('change-phone-btn')?.addEventListener('click', () => openCrossVerify('phone'));
  document.getElementById('change-email-btn')?.addEventListener('click', () => openCrossVerify('email'));
  document.getElementById('verify-email-btn')?.addEventListener('click', () => {
    // For unverified email, the flow is the same as changing email — we send OTP to phone to verify the new email input
    openCrossVerify('email');
    cvTitle.textContent = 'Verify Email Address';
    cvDesc.textContent = 'Enter the email you want to verify. We will send an OTP to your phone first.';
  });
  cvCancelBtn?.addEventListener('click', closeCrossVerify);

  cvSendBtn?.addEventListener('click', async () => {
    const newVal = cvInput.value.trim();
    if (currentChangeType === 'phone' && (!newVal || newVal.length !== 10 || !/^\d+$/.test(newVal))) {
      if (cvError) { cvError.textContent = 'Enter valid 10-digit phone'; cvError.classList.remove('hidden'); }
      return;
    }
    if (currentChangeType === 'email' && (!newVal.includes('@') || !newVal.includes('.'))) {
      if (cvError) { cvError.textContent = 'Enter valid email'; cvError.classList.remove('hidden'); }
      return;
    }

    if (cvError) cvError.classList.add('hidden');
    cvSendBtn.disabled = true;
    cvSendBtn.textContent = 'Sending...';

    try {
      const res = await fetch('/api/account/request-change-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ changeType: currentChangeType, newValue: newVal })
      });
      const data = await res.json();
      
      if (res.ok) {
        cvSendBtn.classList.add('hidden');
        cvOtpWrap?.classList.remove('hidden');
        cvConfirmBtn?.classList.remove('hidden');
        cvInput.disabled = true;
        if (cvSentTo) cvSentTo.textContent = data.maskedTarget || (data.sentTo === 'email' ? 'your email' : 'your phone');
        cvOtpInput.focus();
      } else {
        if (cvError) { cvError.textContent = data.error || 'Failed to send OTP'; cvError.classList.remove('hidden'); }
        cvSendBtn.disabled = false;
        cvSendBtn.textContent = 'Send Verification Code';
      }
    } catch (err) {
      if (cvError) { cvError.textContent = 'Network error'; cvError.classList.remove('hidden'); }
      cvSendBtn.disabled = false;
      cvSendBtn.textContent = 'Send Verification Code';
    }
  });

  cvConfirmBtn?.addEventListener('click', async () => {
    const otp = cvOtpInput.value.trim();
    if (!otp || otp.length !== otpLength || !/^\d+$/.test(otp)) {
      if (cvError) { cvError.textContent = `Please enter a valid ${otpLength}-digit OTP.`; cvError.classList.remove('hidden'); }
      return;
    }

    if (cvError) cvError.classList.add('hidden');
    cvConfirmBtn.disabled = true;
    cvConfirmBtn.textContent = 'Verifying...';

    try {
      const res = await fetch('/api/account/confirm-change', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ changeType: currentChangeType, newValue: cvInput.value.trim(), otp })
      });
      const data = await res.json();
      
      if (res.ok) {
        alert(data.message || 'Updated successfully!');
        window.location.reload();
      } else {
        if (cvError) { cvError.textContent = data.error || 'Invalid OTP'; cvError.classList.remove('hidden'); }
        cvConfirmBtn.disabled = false;
        cvConfirmBtn.textContent = 'Confirm Change';
      }
    } catch (err) {
      if (cvError) { cvError.textContent = 'Network error'; cvError.classList.remove('hidden'); }
      cvConfirmBtn.disabled = false;
      cvConfirmBtn.textContent = 'Confirm Change';
    }
  });
</script>
