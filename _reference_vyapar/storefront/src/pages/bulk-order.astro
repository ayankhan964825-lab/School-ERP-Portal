---
import Layout from '../layouts/Layout.astro';
import { getStorefrontProducts, getSettings } from '../lib/database';

const allProducts = await getStorefrontProducts(Astro.locals.storeId, Astro.cookies.get('delivery_pincode')?.value, Astro.cookies.get('qc_eligible')?.value);
const rawSettings = await getSettings();
const settings = rawSettings || {};
const s = (key: string, fallback?: string) => {
  const val = settings[key];
  return (val !== undefined && val !== null && val !== '') ? val : '';
};
const brandName = settings?.brand_name || '';
const whatsappNumber = (s('social_whatsapp') || s('contact_phone') || '91XXXXXXXXXX').replace(/\D/g, '');
---

<Layout bodyClass="bg-surface" title={`Bulk & Wholesale Orders | ${brandName}`} description={`Partner with ${brandName}`}>
  <div id="page-data" data-whatsapp={whatsappNumber} class="hidden"></div>
  <!-- Hero -->
  <div class="bg-gradient-to-br from-primary/10 via-surface to-surface border-b border-primary/10  pt-12 pb-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4 px-4 py-1.5 bg-primary/10 rounded-full" data-setting="bulk_hero_subtitle">{s('bulk_hero_subtitle')}</span>
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-secondary mb-5" data-setting="bulk_hero_title">
        {s('bulk_hero_title')}
      </h1>
      <p class="text-secondary/70 text-lg max-w-2xl mx-auto leading-relaxed">{s('bulk_hero_text') && (
  <div data-setting="bulk_hero_text" data-setting-html><Fragment set:html={s('bulk_hero_text')} /></div>
)}</p>
      <!-- Trust badges -->
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        {[
          { icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>', text: 'Direct from Unit' },
          { icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>', text: 'Low Min. Order' },
          { icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>', text: '48hr Dispatch' },
          { icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>', text: 'Custom Branding' },
        ].map(b => (
          <div class="flex items-center gap-2 bg-white border border-gray-200 shadow-sm rounded-full px-4 py-2 text-sm font-medium text-secondary">
            <span class="text-primary" set:html={b.icon}></span> {b.text}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="bg-surface py-10 md:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12">

        <!-- LEFT: Inquiry Form -->
        <div>
          <h2 class="text-2xl font-serif font-bold text-secondary mb-2">Send a Bulk Inquiry</h2>
          <p class="text-secondary/60 text-sm mb-8">Fill in the form and our B2B team will respond within 4 business hours.</p>

          <form
            id="bulk-form"
            class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 space-y-5"
          >
            <!-- Name & Business -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-secondary mb-1.5" for="b-name">Full Name *</label>
                <input id="b-name" name="name" type="text" required placeholder="Rajesh Kumar" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary outline-none text-sm transition-colors" />
              </div>
              <div>
                <label class="block text-sm font-medium text-secondary mb-1.5" for="b-biz">Business / Brand Name *</label>
                <input id="b-biz" name="business" type="text" required placeholder="Green Eats Pvt Ltd" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary outline-none text-sm transition-colors" />
              </div>
            </div>

            <!-- Phone & Email -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-secondary mb-1.5" for="b-phone">WhatsApp / Phone *</label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-secondary/50 text-sm font-medium">+91</span>
                  <input id="b-phone" name="phone" type="tel" required placeholder="9XXXXXXXXX" maxlength="10" class="w-full pl-12 pr-4 py-3 border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary outline-none text-sm transition-colors" />
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-secondary mb-1.5" for="b-email">Email Address</label>
                <input id="b-email" name="email" type="email" placeholder="rajesh@greeneats.in" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary outline-none text-sm transition-colors" />
              </div>
            </div>

            <!-- Business Type -->
            <div>
              <label class="block text-sm font-medium text-secondary mb-1.5" for="b-type">Business Type *</label>
              <select id="b-type" name="business_type" required class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary outline-none text-sm transition-colors bg-white appearance-none">
                <option value="">-- Select Type --</option>
                <option>Retail Store / Grocery</option>
                <option>Restaurant / Cloud Kitchen</option>
                <option>Health & Wellness Brand</option>
                <option>Hospital / Canteen</option>
                <option>Reseller / Distributor</option>
                <option>Other</option>
              </select>
            </div>

            <!-- Products Required -->
            <div>
              <label class="block text-sm font-medium text-secondary mb-2">Products Required *</label>
              <div id="product-checklist" class="grid grid-cols-2 gap-2 max-h-52 overflow-y-auto pr-1">
                {allProducts.slice(0, 20).map((p: any) => (
                  <label class="flex items-center gap-2.5 p-2.5 rounded-lg border border-gray-100 hover:border-primary/40 hover:bg-primary/3 cursor-pointer transition-colors text-sm">
                    <input type="checkbox" name="products" value={p.name} class="accent-primary rounded" />
                    <span class="text-secondary font-medium leading-snug">{p.name}</span>
                  </label>
                ))}
              </div>
              <p class="text-[11px] text-secondary/50 mt-1.5">Select all products you are interested in.</p>
            </div>

            <!-- Quantity & Frequency -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-secondary mb-1.5" for="b-qty">Est. Monthly Quantity *</label>
                <input id="b-qty" name="quantity" type="text" required placeholder="e.g. 50 boxes, 100 liters, 25 kg" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary outline-none text-sm transition-colors" />
              </div>
              <div>
                <label class="block text-sm font-medium text-secondary mb-1.5" for="b-freq">Order Frequency</label>
                <select id="b-freq" name="frequency" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary outline-none text-sm bg-white appearance-none transition-colors">
                  <option>One-time</option>
                  <option>Weekly</option>
                  <option>Monthly</option>
                  <option>Quarterly</option>
                </select>
              </div>
            </div>

            <!-- Custom Branding -->
            <div>
              <label class="flex items-center gap-3 p-3 bg-gray-50 rounded-xl border border-gray-200 cursor-pointer hover:bg-primary/5 hover:border-primary/30 transition-colors">
                <input type="checkbox" name="custom_branding" value="yes" class="accent-primary w-4 h-4" />
                <div>
                  <p class="text-sm font-semibold text-secondary">Interested in Private Label / Custom Branding</p>
                  <p class="text-xs text-secondary/50">We offer custom packaging with your brand logo.</p>
                </div>
              </label>
            </div>

            <!-- Notes -->
            <div>
              <label class="block text-sm font-medium text-secondary mb-1.5" for="b-notes">Additional Notes</label>
              <textarea id="b-notes" name="notes" rows="3" placeholder="Any specific requirements, special products, delivery location..." class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-primary focus:ring-1 focus:ring-primary outline-none text-sm resize-none transition-colors"></textarea>
            </div>

            <!-- Submit -->
            <button type="submit" id="bulk-submit-btn" class="w-full btn-primary !py-4 !text-base !rounded-xl shadow-lg shadow-primary/20 flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
              Send Inquiry
            </button>

            <!-- Success/Error -->
            <div id="form-feedback" class="hidden text-center text-sm font-medium py-3 px-4 rounded-xl"></div>
          </form>
        </div>

        <!-- RIGHT: Info / Why Partner -->
        <div class="flex flex-col gap-6">

          <!-- Why Partner Card -->
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8">
            <h3 class="text-xl font-bold font-serif text-secondary mb-5">Why Partner With Us?</h3>
            <ul class="space-y-4">
              {[
                { icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>', title: 'Competitive Wholesale Rates', desc: 'Tiered pricing based on volume. The more you buy, the more you save.' },
                { icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>', title: 'Premium Quality', desc: 'Highest quality standards guaranteed. Ethically sourced and carefully curated.' },
                { icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>', title: 'Private Label / White Label', desc: 'Get our products packaged under your own brand with custom labels.' },
                { icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" /></svg>', title: 'All India Delivery', desc: 'We ship to every corner of India via reliable courier partners.' },
                { icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>', title: 'Dedicated Account Manager', desc: 'A direct point of contact for all your order and logistics needs.' },
              ].map(item => (
                <li class="flex items-start gap-4">
                  <span class="flex-shrink-0 mt-0.5" set:html={item.icon}></span>
                  <div>
                    <p class="font-semibold text-secondary text-sm">{item.title}</p>
                    <p class="text-xs text-secondary/60 mt-0.5 leading-relaxed">{item.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Direct Contact Card -->
          <div class="bg-primary rounded-2xl text-white p-8">
            <h3 class="text-xl font-bold font-serif mb-2">Prefer to Talk Directly?</h3>
            <p class="text-white/70 text-sm mb-6">Reach our B2B sales team directly on WhatsApp or phone.</p>
            <div class="space-y-4">
              <a href={`https://wa.me/${whatsappNumber}?text=Hello%2C%20I%27m%20interested%20in%20bulk%20ordering%20from%20${encodeURIComponent(brandName)}.`} target="_blank" class="flex items-center gap-3 bg-white/10 hover:bg-white/20 p-4 rounded-xl transition-colors group">
                <div class="bg-accent text-primary p-3 rounded-lg group-hover:scale-110 transition-transform">
                  <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                </div>
                <div>
                  <h4 class="font-semibold text-white">WhatsApp Us</h4>
                  <p class="text-white/60 text-xs">{s('social_whatsapp') || s('contact_phone') || '+91 XXXXX XXXXX'}</p>
                </div>
              </a>
              <a href={`tel:${s('contact_phone') || '91XXXXXXXXXX'}`} class="flex items-center gap-3 bg-white/10 hover:bg-white/20 p-4 rounded-xl transition-colors group">
                <div class="bg-accent text-primary p-3 rounded-lg group-hover:scale-110 transition-transform">
                  <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <h4 class="font-semibold text-white">Call Us Directly</h4>
                  <p class="text-white/60 text-xs">{s('contact_phone') || '+91 XXXXX XXXXX'}</p>
                </div>
              </a>
              <a href={s('contact_email') ? `mailto:${s('contact_email')}` : '#'} class="flex items-center gap-3 bg-white/10 hover:bg-white/20 p-4 rounded-xl transition-colors group">
                <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                  <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div>
                  <p class="font-semibold text-sm">Email Us</p>
                  <p class="text-white/60 text-xs">{s('contact_email') || 'contact@yourstore.com'}</p>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/40 ml-auto group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('bulk-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('bulk-submit-btn') as HTMLButtonElement | null;
  const feedback = document.getElementById('form-feedback');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn || !feedback) return;

    const data = new FormData(form);

    // Validation
    const rawPhone = data.get('phone');
    const phone = typeof rawPhone === 'string' ? rawPhone.replace(/\D/g, '') : '';
    if (phone.length !== 10) {
      feedback.className = 'text-center text-sm font-medium py-3 px-4 rounded-xl bg-red-50 border border-red-200 text-red-700';
      feedback.textContent = 'Please enter a valid 10-digit phone number.';
      feedback.classList.remove('hidden');
      return;
    }

    const selectedProducts = data.getAll('products');
    if (selectedProducts.length === 0) {
      feedback.className = 'text-center text-sm font-medium py-3 px-4 rounded-xl bg-red-50 border border-red-200 text-red-700';
      feedback.textContent = 'Please select at least one product.';
      feedback.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = `<svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Sending...`;

    // Build WhatsApp message
    const name = data.get('name');
    const biz = data.get('business');
    const qty = data.get('quantity');
    const btype = data.get('business_type');
    const email = data.get('email') || '';
    const notes = data.get('notes') || '';
    const branding = data.get('custom_branding') === 'yes' ? 'Yes' : 'No';

    const waDataElem = document.getElementById('page-data');
    const waNum = waDataElem?.getAttribute('data-whatsapp') || '91XXXXXXXXXX';
    const brandNameStr = document.title.split('|').pop()?.trim() || 'Nutridry'; // Fallback to get brand name from title

    const waMsg = encodeURIComponent(
      `*Bulk Order Inquiry - ${brandNameStr}*\n\n` +
      `*Name:* ${name}\n*Business:* ${biz}\n*Type:* ${btype}\n*Phone:* +91${phone}\n` +
      `*Products:* ${selectedProducts.join(', ')}\n*Qty/Month:* ${qty}\n` +
      `*Custom Branding:* ${branding}\n*Notes:* ${notes || 'N/A'}`
    );

    // Call API
    try {
      const response = await fetch('/api/storefront/bulk-inquiry', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          name, business: biz, phone, email, business_type: btype, products: selectedProducts, quantity: qty, frequency: data.get('frequency'), custom_branding: data.get('custom_branding'), notes
        })
      });

      const resData = await response.json();

      if (!response.ok || !resData.success) {
        throw new Error(resData.error || 'Failed to submit inquiry');
      }

      feedback.className = 'text-center text-sm font-medium py-3 px-4 rounded-xl bg-green-50 border border-green-200 text-green-700';
      feedback.innerHTML = `✓ Inquiry submitted! Our team will contact you on <strong>+91${phone}</strong> within 4 hours. You can also click below to connect on WhatsApp.`;
      feedback.classList.remove('hidden');

      // Convert the submit button to a link button so it doesn't trigger the form
      submitBtn.type = 'button';
      submitBtn.onclick = () => window.open(`https://wa.me/${waNum}?text=${waMsg}`, '_blank');
      submitBtn.innerHTML = `✓ Also Send via WhatsApp`;
      submitBtn.className = 'w-full bg-green-500 hover:bg-green-600 text-white font-semibold py-4 text-base rounded-xl shadow-lg transition-colors flex items-center justify-center gap-2';
      submitBtn.disabled = false;

      form.reset();
    } catch (err: any) {
      feedback.className = 'text-center text-sm font-medium py-3 px-4 rounded-xl bg-red-50 border border-red-200 text-red-700';
      feedback.textContent = err.message || 'An error occurred. Please try again.';
      feedback.classList.remove('hidden');
      
      submitBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg> Send Inquiry`;
      submitBtn.disabled = false;
    }
  });
