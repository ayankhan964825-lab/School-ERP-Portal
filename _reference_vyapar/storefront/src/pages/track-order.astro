---
import Layout from '../layouts/Layout.astro';
import { getOrders, getSettings } from '../lib/database';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

let order: any = null;
let searchedId = '';
let searchedPhone = '';
const queryId = Astro.url.searchParams.get('id');
const queryPhone = Astro.url.searchParams.get('phone');

if (queryId && queryPhone) {
  searchedId = queryId.trim();
  searchedPhone = queryPhone.trim();
  const orders = await getOrders();
  // Find order by ID (internal or display ID) and verify phone number (last 10 digits to ignore country code if missing)
  const cleanSearchId = searchedId.replace(/^#/, '').trim();
  const foundOrder = orders.find((o: any) => 
    o.orderId === cleanSearchId || 
    (o.masterOrderId && o.masterOrderId === cleanSearchId) ||
    o.orderId === searchedId ||
    (o.order_number && o.order_number === cleanSearchId)
  );
  
  if (foundOrder && foundOrder.customer?.phone) {
    const orderPhoneClean = foundOrder.customer.phone.replace(/\D/g, '').slice(-10);
    const searchPhoneClean = searchedPhone.replace(/\D/g, '').slice(-10);
    if (orderPhoneClean === searchPhoneClean) {
      order = foundOrder;
    }
  }
}

const settings = await getSettings(Astro.locals?.storeId);
const googleMapsApiKey = settings?.google_maps_api_key || null;

let destStr = '';
if (order && order.address) {
  destStr = `${order.address.address || ''}, ${order.address.city || ''}, ${order.address.state || ''} ${order.address.pincode || ''}`.replace(/^[\s,]+|[\s,]+$/g, '');
}

const riderAppIcon = settings?.rider_app_icon || null;

const statusSteps = ['pending', 'confirmed', 'shipped', 'delivered'];
const statusLabels: Record<string, string> = {
  pending: 'Order Placed',
  confirmed: 'Confirmed',
  shipped: 'Shipped',
  delivered: 'Delivered',
  cancelled: 'Cancelled',
};
const currentStepIndex = order ? statusSteps.indexOf(order.status) : -1;
---

<Layout bodyClass="bg-surface" title="Track Order" description="Track your order status.">
  <div class="bg-surface min-h-screen py-10 md:py-16">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">

      <div class="text-center mb-10">
        <h1 class="text-3xl md:text-4xl font-serif font-bold text-secondary">Track Your Order</h1>
        <p class="text-secondary/60 mt-2">Enter your Order ID to see real-time status.</p>
      </div>

      {/* Search Form */}
      <form method="GET" action="/track-order" class="flex flex-col md:flex-row gap-3 mb-10 max-w-xl mx-auto">
        <input
          type="text"
          name="id"
          value={searchedId}
          placeholder="Order ID (e.g. OD123456)"
          required
          class="flex-1 px-4 py-3 rounded-xl border border-gray-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none text-sm"
        />
        <input
          type="tel"
          name="phone"
          value={searchedPhone}
          placeholder="Phone Number"
          required
          class="flex-1 px-4 py-3 rounded-xl border border-gray-200 focus:border-primary focus:ring-1 focus:ring-primary outline-none text-sm"
        />
        <button type="submit" class="btn-primary !py-3 !px-6 whitespace-nowrap">Track Order</button>
      </form>

      {/* Results */}
      {searchedId && searchedPhone && !order && (
        <div class="bg-red-50 border border-red-200 rounded-2xl p-8 text-center max-w-xl mx-auto">
          <p class="text-red-700 font-medium">Order not found</p>
          <p class="text-red-500 text-sm mt-1">We couldn't find an order matching that ID and phone number. Please check your details and try again.</p>
        </div>
      )}

      {order && (
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          {/* Order Header */}
          <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center">
            <div>
              <p class="font-bold text-secondary">Order {order.masterOrderId ? (order.masterOrderId.startsWith('#') ? order.masterOrderId : `#${order.masterOrderId}`) : (order.order_number ? (order.order_number.startsWith('#') ? order.order_number : `#${order.order_number}`) : `#${order.orderId}`)}</p>
              <p class="text-xs text-secondary/50 mt-0.5">
                {new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
              </p>
            </div>
            <span class="text-lg font-bold text-secondary">₹{order.amount}</span>
          </div>

          {/* Status Tracker */}
          {order.status !== 'cancelled' ? (
            <div class="px-6 py-8">
              <div class="flex items-center justify-between relative">
                {/* Connecting line */}
                <div class="absolute top-5 left-0 right-0 h-0.5 bg-gray-200"></div>
                <div class="absolute top-5 left-0 h-0.5 bg-primary transition-all" style={`width: ${Math.max(0, currentStepIndex) / (statusSteps.length - 1) * 100}%`}></div>

                {statusSteps.map((step, i) => (
                  <div class="relative flex flex-col items-center z-10">
                    <div class={`w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold ${i <= currentStepIndex ? 'bg-primary text-white' : 'bg-gray-200 text-secondary/40'}`}>
                      {i <= currentStepIndex ? (
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                      ) : (
                        <span>{i + 1}</span>
                      )}
                    </div>
                    <span class={`text-xs mt-2 font-medium ${i <= currentStepIndex ? 'text-primary' : 'text-secondary/40'}`}>
                      {statusLabels[step]}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <div class="px-6 py-8 text-center">
              <span class="bg-red-100 text-red-700 text-sm font-bold px-4 py-2 rounded-full">Order Cancelled</span>
            </div>
          )}

          {/* Items */}
          <div class="px-6 pb-6 border-t border-gray-100 pt-4">
            <p class="text-xs text-secondary/50 uppercase font-bold mb-3">Items</p>
            <div class="space-y-2">
              {(order.items || []).map((item: any) => (
                <div class="flex justify-between text-sm">
                  <span class="text-secondary">{item.quantity}× {item.name} {item.weight ? `(${item.weight})` : (item.variant ? `(${item.variant})` : '')}</span>
                  <span class="text-secondary font-medium">₹{item.price * item.quantity}</span>
                </div>
              ))}
            </div>
          </div>

          {/* Fulfillments & Tracking */}
          {order.fulfillments && order.fulfillments.length > 0 && (
            <div class="px-6 pb-6 border-t border-gray-100 pt-6">
              <p class="text-xs text-secondary/50 uppercase font-bold mb-4">Shipments & Tracking</p>
              <div class="space-y-4">
                {order.fulfillments.map((f: any, index: number) => (
                  <div class="bg-gray-50 rounded-xl p-4 border border-gray-100">
                    <div class="flex justify-between items-center mb-2">
                      <span class="text-xs font-bold uppercase text-primary">Shipment {index + 1}</span>
                      <span class={`text-[10px] font-bold px-2 py-0.5 rounded capitalize ${
                        f.status === 'delivered' ? 'bg-green-100 text-green-700' :
                        f.status === 'shipped' ? 'bg-blue-100 text-blue-700' :
                        f.status === 'cancelled' ? 'bg-red-100 text-red-700' :
                        'bg-gray-200 text-gray-700'
                      }`}>{f.status}</span>
                    </div>
                    
                    {f.awb_number && (
                       <p class="text-sm font-semibold text-secondary">AWB: {f.awb_number} <span class="text-xs font-normal text-secondary/60">via {f.courier_name || 'Standard Courier'}</span></p>
                    )}
                    
                    {f.rider_name && (
                       <div class="mt-2 flex items-start gap-2">
                         <div class="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center shrink-0">
                           <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                         </div>
                         <div>
                           <p class="text-sm font-semibold text-secondary">Rider: {f.rider_name}</p>
                           <p class="text-xs text-secondary/60">{f.rider_phone || 'Number Hidden'}</p>
                           {f.rider_status && <p class="text-[10px] font-bold uppercase mt-0.5 text-purple-600">{f.rider_status.replace('_', ' ')}</p>}
                         </div>
                       </div>
                    )}

                    {f.rider_status === 'out_for_delivery' && (
                        <div class="mt-4 rounded-xl overflow-hidden border border-gray-200" style="height: 250px;">
                          <div id={`map_${f.id}`} class="w-full h-full rider-map" data-fid={f.id} data-lat={f.last_known_location?.lat} data-lon={f.last_known_location?.lon}></div>
                       </div>
                    )}

                    {f.tracking_url && (
                       <a href={f.tracking_url} target="_blank" class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-primary hover:underline">
                         Live Track Delivery <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                       </a>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Delivery Address */}
          {order.customer && (
            <div class="px-6 pb-6 border-t border-gray-100 pt-4">
              <p class="text-xs text-secondary/50 uppercase font-bold mb-2">Delivery Address</p>
              <p class="text-sm text-secondary">{order.customer.name}</p>
              <p class="text-xs text-secondary/60">{order.customer.address}, {order.customer.city}, {order.customer.state} - {order.customer.pincode}</p>
              <p class="text-xs text-secondary/60 mt-1">Phone: {order.customer.phone}</p>
            </div>
          )}
        </div>
      )}

    </div>
  </div>
</Layout>

{googleMapsApiKey ? (
  <script is:inline src={`https://maps.googleapis.com/maps/api/js?key=${googleMapsApiKey}&libraries=geometry`}></script>
) : (
  <>
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script is:inline src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  </>
)}
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, googleMapsApiKey, destStr, riderAppIcon }}>
  document.addEventListener('DOMContentLoaded', () => {
    const mapElements = document.querySelectorAll('.rider-map');
    if (mapElements.length === 0) return;

    const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    const riderIconUrl = riderAppIcon;

    mapElements.forEach((el) => {
      const fid = el.getAttribute('data-fid');
      const startLat = parseFloat(el.getAttribute('data-lat'));
      const startLon = parseFloat(el.getAttribute('data-lon'));
      
      const initialLat = !isNaN(startLat) ? startLat : 20.5937;
      const initialLon = !isNaN(startLon) ? startLon : 78.9629;
      const initialZoom = !isNaN(startLat) ? 15 : 5;

      let marker = null;
      let map = null;

      if (googleMapsApiKey && window.google) {
        // --- GOOGLE MAPS ZOMATO-STYLE IMPLEMENTATION ---
        map = new google.maps.Map(document.getElementById(el.id), {
          center: { lat: initialLat, lng: initialLon },
          zoom: initialZoom,
          mapTypeControl: false,
          streetViewControl: false,
        });

        const icon = riderIconUrl ? {
          url: riderIconUrl,
          scaledSize: new google.maps.Size(40, 40),
          anchor: new google.maps.Point(20, 40),
        } : null;

        if (!isNaN(startLat) && !isNaN(startLon)) {
          marker = new google.maps.Marker({
            position: { lat: startLat, lng: startLon },
            map: map,
            ...(icon ? { icon } : {})
          });

          // Draw the blue route from Rider to Customer (Calculated once)
          if (destStr) {
            const directionsService = new google.maps.DirectionsService();
            const directionsRenderer = new google.maps.DirectionsRenderer({
              map: map,
              suppressMarkers: true, // We draw our own rider marker
              polylineOptions: { strokeColor: '#3b82f6', strokeWeight: 5 }
            });

            directionsService.route({
              origin: { lat: startLat, lng: startLon },
              destination: destStr + ', India',
              travelMode: google.maps.TravelMode.DRIVING
            }, (response, status) => {
              if (status === 'OK') {
                directionsRenderer.setDirections(response);
              }
            });
          }
        }

        // Listen to Supabase Broadcast
        const channel = supabaseClient.channel(`tracking_${fid}`);
        channel.on('broadcast', { event: 'location_update' }, (payload) => {
          const { latitude, longitude } = payload.payload;
          const newPos = { lat: latitude, lng: longitude };
          
          if (!marker) {
            marker = new google.maps.Marker({ position: newPos, map: map, ...(icon ? { icon } : {}) });
            map.setCenter(newPos);
            map.setZoom(15);
          } else {
            // Smoothly animate marker instead of snapping
            const startPos = marker.getPosition();
            let start = null;
            const duration = 1500; // 1.5 seconds

            function animate(timestamp) {
              if (!start) start = timestamp;
              const progress = (timestamp - start) / duration;
              if (progress < 1) {
                const lat = startPos.lat() + (newPos.lat - startPos.lat()) * progress;
                const lng = startPos.lng() + (newPos.lng - startPos.lng()) * progress;
                marker.setPosition({ lat, lng });
                requestAnimationFrame(animate);
              } else {
                marker.setPosition(newPos);
              }
            }
            requestAnimationFrame(animate);
            map.panTo(newPos);
          }
        }).subscribe();

      } else {
        // --- LEAFLET OPEN-SOURCE IMPLEMENTATION ---
        map = L.map(el.id).setView([initialLat, initialLon], initialZoom);
        
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        const riderIconL = riderIconUrl ? L.icon({
          iconUrl: riderIconUrl,
          iconSize: [40, 40],
          iconAnchor: [20, 40],
        }) : L.divIcon({ 
          html: '<div style="font-size:24px;text-align:center;background:white;border-radius:50%;padding:2px;box-shadow:0 4px 6px rgba(0,0,0,0.1);line-height:1;width:36px;height:36px;display:flex;align-items:center;justify-content:center;margin:0;">🛵</div>', 
          className: 'bg-transparent', 
          iconSize: [36, 36],
          iconAnchor: [18, 18]
        });

        if (!isNaN(startLat) && !isNaN(startLon)) {
          marker = L.marker([startLat, startLon], { icon: riderIconL }).addTo(map);
          if (marker._icon) marker._icon.style.transition = 'transform 1.5s linear';
          if (marker._shadow) marker._shadow.style.transition = 'transform 1.5s linear';
        }

        const channel = supabaseClient.channel(`tracking_${fid}`);
        channel.on('broadcast', { event: 'location_update' }, (payload) => {
          const { latitude, longitude } = payload.payload;
          
          if (!marker) {
            marker = L.marker([latitude, longitude], { icon: riderIconL }).addTo(map);
            if (marker._icon) marker._icon.style.transition = 'transform 1.5s linear';
            if (marker._shadow) marker._shadow.style.transition = 'transform 1.5s linear';
            map.setView([latitude, longitude], 15); 
          } else {
            marker.setLatLng([latitude, longitude]);
            map.panTo([latitude, longitude], { animate: true, duration: 1.5 });
          }
        }).subscribe();
      }
    });
  });
</script>
