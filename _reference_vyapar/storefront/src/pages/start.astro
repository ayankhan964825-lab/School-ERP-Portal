---
import '../styles/global.css';
import { getPlatformSettings } from '../lib/platform-settings';
import { getCsrfToken } from '../lib/csrf';

const settings = await getPlatformSettings();
const authMode = settings.auth_mode || 'email_only';
const expectedOtpLength = settings.otp_length || '4';
const otpPlaceholder = expectedOtpLength === '6' ? '••••••' : '••••';
const csrfToken = getCsrfToken(Astro.cookies);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Your Store | VyaparPe</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .fade-in { animation: fadeIn 0.4s ease-out forwards; }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body data-csrf={csrfToken} class="bg-slate-50 min-h-screen flex flex-col selection:bg-indigo-200">

  <!-- Header -->
  <header class="py-6 px-6 lg:px-8 border-b border-slate-200 bg-white">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
          <a href="/" class="flex items-center gap-2">
            <div class="w-8 h-8 bg-slate-900 rounded-lg flex items-center justify-center">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <span class="text-xl font-bold tracking-tight text-slate-900">VyaparPe</span>
          </a>
          <div class="text-sm text-slate-500 font-medium">Step <span id="step-indicator">1</span> of 3</div>
      </div>
  </header>

  <main class="flex-1 flex flex-col justify-center py-12 px-6 sm:px-8">
    <div class="w-full max-w-md mx-auto">
        
        <!-- Step 1: Basic Info -->
        <div id="step-1" class="fade-in">
            <div class="text-center mb-10">
                <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Let's get started</h1>
                <p class="text-slate-500 mt-2">Tell us a bit about your business</p>
            </div>

            <form id="form-step-1" class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200 space-y-6">
                {authMode === 'phone_only' || authMode === 'both' ? (
                  <div>
                      <label for="identifier" class="block text-sm font-semibold text-slate-700 mb-1.5">Mobile Number</label>
                      <div class="flex">
                          <span class="inline-flex items-center px-4 rounded-l-xl border border-r-0 border-slate-200 bg-slate-50 text-slate-500 font-medium sm:text-sm">
                              +91
                          </span>
                          <input type="tel" id="identifier" required placeholder="9876543210" pattern="[0-9]{10}" data-type="phone" class="flex-1 block w-full px-4 py-3 rounded-none rounded-r-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-shadow">
                      </div>
                  </div>
                ) : (
                  <div>
                      <label for="identifier" class="block text-sm font-semibold text-slate-700 mb-1.5">Email Address</label>
                      <input type="email" id="identifier" required placeholder="owner@example.com" data-type="email" class="block w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-shadow">
                  </div>
                )}

                <div id="error-msg-1" class="hidden text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-100"></div>

                <button type="submit" id="btn-step-1" class="w-full py-3.5 bg-slate-900 text-white rounded-xl font-semibold hover:bg-indigo-600 hover:shadow-lg hover:shadow-indigo-200 transition-all duration-300 flex items-center justify-center gap-2">
                    <span class="btn-text">Continue</span>
                    <svg class="w-4 h-4 hidden spinner" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                </button>
                <p class="text-center text-xs text-slate-400 mt-4">By continuing, you agree to our Terms & Conditions.</p>
            </form>
        </div>

        <!-- Step 1.5: OTP Verification -->
        <div id="step-otp" class="hidden">
            <div class="text-center mb-10">
                <div class="w-16 h-16 bg-indigo-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                </div>
                <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Verify it's you</h1>
                <p class="text-slate-500 mt-2">Enter the OTP sent to <span id="display-identifier" class="font-semibold text-slate-700"></span></p>
            </div>

            <form id="form-step-otp" class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200 space-y-6">
                <div>
                    <label for="otp" class="block text-sm font-semibold text-slate-700 mb-1.5">Enter OTP</label>
                    <input type="text" id="otp" required placeholder={otpPlaceholder} maxlength={expectedOtpLength} pattern="[0-9]*" inputmode="numeric" class="block w-full px-4 py-3 text-center tracking-[0.5em] text-lg font-bold rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow">
                </div>

                <div id="error-msg-otp" class="hidden text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-100"></div>

                <button type="submit" id="btn-step-otp" class="w-full py-3.5 bg-slate-900 text-white rounded-xl font-semibold hover:bg-indigo-600 hover:shadow-lg hover:shadow-indigo-200 transition-all duration-300 flex items-center justify-center gap-2">
                    <span class="btn-text">Verify & Continue</span>
                    <svg class="w-4 h-4 hidden spinner" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                </button>
                <button type="button" onclick="goBackTo1()" class="w-full py-3 bg-white text-slate-600 rounded-xl font-medium hover:bg-slate-50 border border-slate-200 transition-colors">
                    ← Change Details
                </button>
            </form>
        </div>

        </div>

        <!-- Step 1.5.1: Existing Stores (Optional) -->
        <div id="step-existing-stores" class="hidden">
            <div class="text-center mb-10">
                <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Welcome Back!</h1>
                <p class="text-slate-500 mt-2">We found existing stores linked to your account.</p>
            </div>

            <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200 space-y-6">
                <div id="existing-stores-list" class="space-y-3">
                    <!-- Stores will be injected here via JS -->
                </div>

                <div class="relative py-4">
                    <div class="absolute inset-0 flex items-center" aria-hidden="true">
                        <div class="w-full border-t border-slate-200"></div>
                    </div>
                    <div class="relative flex justify-center">
                        <span class="bg-white px-3 text-sm text-slate-500 font-medium">Or</span>
                    </div>
                </div>

                <button type="button" onclick="goToStep2()" class="w-full py-3.5 bg-slate-900 text-white rounded-xl font-semibold hover:bg-indigo-600 hover:shadow-lg hover:shadow-indigo-200 transition-all duration-300 flex items-center justify-center gap-2">
                    Create New Store
                </button>
                <button type="button" onclick="goBackTo1()" class="w-full py-3 bg-white text-slate-600 rounded-xl font-medium hover:bg-slate-50 border border-slate-200 transition-colors">
                    ← Use Different Account
                </button>
            </div>
        </div>

        </div>

        <!-- Step 2: Subdomain -->
        <div id="step-2" class="hidden">
            <div class="text-center mb-10">
                <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Choose your URL</h1>
                <p class="text-slate-500 mt-2">Your customers will visit this link to buy from you</p>
            </div>

            <form id="form-step-2" class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200 space-y-6">
                <div>
                    <label for="store_name" class="block text-sm font-semibold text-slate-700 mb-1.5">Store Name</label>
                    <input type="text" id="store_name" required placeholder="e.g. My Fresh Foods" class="block w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-shadow mb-4">
                </div>
                <div>
                    <label for="subdomain" class="block text-sm font-semibold text-slate-700 mb-1.5">Store URL</label>
                    <div class="flex items-center">
                        <input type="text" id="subdomain" required placeholder="my-store" class="block w-full px-4 py-3 rounded-l-xl border border-r-0 border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-shadow font-semibold text-right">
                        <span class="inline-flex items-center px-4 py-3 rounded-r-xl border border-l-0 border-slate-200 bg-slate-50 text-slate-500 sm:text-sm font-medium">
                            .vyaparpe.in
                        </span>
                    </div>
                    <p class="mt-2 text-xs text-slate-500">You can add a custom `.com` domain later.</p>
                </div>

                <div id="error-msg-2" class="hidden text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-100"></div>

                <button type="submit" id="btn-next-2" class="w-full py-3.5 bg-slate-900 text-white rounded-xl font-semibold hover:bg-indigo-600 hover:shadow-lg hover:shadow-indigo-200 transition-all duration-300 flex items-center justify-center gap-2">
                    Continue →
                </button>
                <button type="button" onclick="goBackTo1()" class="w-full py-3 bg-white text-slate-600 rounded-xl font-medium hover:bg-slate-50 border border-slate-200 transition-colors">
                    ← Back
                </button>
            </form>
        </div>

        <!-- Step 3: L0 Admin Password Setup -->
        <div id="step-3" class="hidden">
            <div class="text-center mb-10">
                <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Secure your store</h1>
                <p class="text-slate-500 mt-2">Set up a password for your new store</p>
            </div>

            <form id="form-step-3" class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200 space-y-6">
                <div>
                    <label for="l0-password" class="block text-sm font-semibold text-slate-700 mb-1.5">Store Password</label>
                    <input type="password" id="l0-password" required minlength="6" placeholder="Min 6 characters" class="block w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-shadow mb-4">
                </div>
                <div>
                    <label for="l0-confirm-password" class="block text-sm font-semibold text-slate-700 mb-1.5">Confirm Password</label>
                    <input type="password" id="l0-confirm-password" required minlength="6" placeholder="Re-enter password" class="block w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-shadow">
                </div>
                <div id="error-msg-3" class="hidden text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-100"></div>

                <button type="submit" id="btn-next-3" class="w-full py-3.5 bg-slate-900 text-white rounded-xl font-semibold hover:bg-indigo-600 hover:shadow-lg hover:shadow-indigo-200 transition-all duration-300 flex items-center justify-center gap-2">
                    Continue →
                </button>
                <button type="button" onclick="goBackTo2()" class="w-full py-3 bg-white text-slate-600 rounded-xl font-medium hover:bg-slate-50 border border-slate-200 transition-colors">
                    ← Back
                </button>
            </form>
        </div>

        <!-- Step 4: Choose Plan -->
        <div id="step-4" class="hidden">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Choose your Plan</h1>
                <p class="text-slate-500 mt-2">Select the pricing model that fits your business</p>
            </div>

            <form id="form-step-4" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Free Tier -->
                    <label class="cursor-pointer relative flex flex-col bg-white p-5 rounded-3xl border-2 border-indigo-600 shadow-sm hover:border-indigo-600 transition-all">
                        <input type="radio" name="plan_id" value="00000000-0000-0000-0000-000000000005" class="absolute h-0 w-0 opacity-0" checked onchange="updatePlanSelection(this)">
                        <div class="flex justify-between items-start mb-3">
                            <div>
                                <h3 class="text-base font-bold text-slate-900">Free Tier</h3>
                                <p class="text-xs text-slate-500">Perfect for exploring.</p>
                            </div>
                            <div class="h-5 w-5 rounded-full border-2 border-indigo-600 bg-indigo-600 flex items-center justify-center check-circle">
                                <div class="h-1.5 w-1.5 rounded-full bg-white"></div>
                            </div>
                        </div>
                        <div class="space-y-1 mb-2 flex-1">
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-green-500 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> ₹0 Monthly Fees</p>
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-green-500 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 50 Products Limit</p>
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-amber-500 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg> 5% Commission</p>
                        </div>
                    </label>

                    <!-- Growth Plan -->
                    <label class="cursor-pointer relative flex flex-col bg-white p-5 rounded-3xl border-2 border-slate-200 shadow-sm hover:border-indigo-300 transition-all">
                        <input type="radio" name="plan_id" value="00000000-0000-0000-0000-000000000006" class="absolute h-0 w-0 opacity-0" onchange="updatePlanSelection(this)">
                        <div class="flex justify-between items-start mb-3">
                            <div>
                                <h3 class="text-base font-bold text-slate-900">Growth Plan</h3>
                                <p class="text-xs text-slate-500">₹1000/month</p>
                            </div>
                            <div class="h-5 w-5 rounded-full border-2 border-slate-300 bg-white flex items-center justify-center check-circle">
                                <div class="h-1.5 w-1.5 rounded-full bg-white hidden"></div>
                            </div>
                        </div>
                        <div class="space-y-1 mb-2 flex-1">
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-green-500 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Custom Domain (.com)</p>
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-green-500 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 1000 Products Limit</p>
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-amber-500 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg> 2% Commission</p>
                        </div>
                    </label>

                    <!-- Ad-Spend Partner -->
                    <label class="cursor-pointer relative flex flex-col bg-white p-5 rounded-3xl border-2 border-slate-200 shadow-sm hover:border-indigo-300 transition-all">
                        <input type="radio" name="plan_id" value="00000000-0000-0000-0000-000000000007" class="absolute h-0 w-0 opacity-0" onchange="updatePlanSelection(this)">
                        <div class="flex justify-between items-start mb-3">
                            <div>
                                <h3 class="text-base font-bold text-slate-900">Ad-Spend Partner</h3>
                                <p class="text-xs text-slate-500">Zero upfront fees.</p>
                            </div>
                            <div class="h-5 w-5 rounded-full border-2 border-slate-300 bg-white flex items-center justify-center check-circle">
                                <div class="h-1.5 w-1.5 rounded-full bg-white hidden"></div>
                            </div>
                        </div>
                        <div class="space-y-1 mb-2 flex-1">
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-green-500 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Min. ₹1000/day Ad Spend</p>
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-green-500 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 500 Products Limit</p>
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-amber-500 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg> 3% Commission</p>
                        </div>
                    </label>

                    <!-- Lifetime Ownership -->
                    <label class="cursor-pointer relative flex flex-col bg-white p-5 rounded-3xl border-2 border-slate-200 shadow-sm hover:border-indigo-300 transition-all">
                        <input type="radio" name="plan_id" value="00000000-0000-0000-0000-000000000008" class="absolute h-0 w-0 opacity-0" onchange="updatePlanSelection(this)">
                        <div class="flex justify-between items-start mb-3">
                            <div>
                                <h3 class="text-base font-bold text-slate-900">Lifetime Ownership</h3>
                                <p class="text-xs text-slate-500 font-bold text-indigo-600">Price on Request</p>
                            </div>
                            <div class="h-5 w-5 rounded-full border-2 border-slate-300 bg-white flex items-center justify-center check-circle">
                                <div class="h-1.5 w-1.5 rounded-full bg-white hidden"></div>
                            </div>
                        </div>
                        <div class="space-y-1 mb-2 flex-1">
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-green-500 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Custom Domain (.com)</p>
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-green-500 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Unlimited Products</p>
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-amber-500 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg> 1% Commission</p>
                            <p class="flex items-center text-xs text-slate-700"><svg class="h-3 w-3 text-slate-400 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 3h12M6 8h12m-6 5l8.5 8M6 13h3M9 13c6.667 0 6.667-10 0-10"/></svg> ₹2000 Yearly Maintenance</p>
                        </div>
                    </label>
                </div>

                <div id="error-msg-3" class="hidden text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-100"></div>

                <button type="submit" id="btn-create" class="w-full py-3.5 bg-indigo-600 text-white rounded-xl font-semibold hover:bg-indigo-700 hover:shadow-lg hover:shadow-indigo-200 transition-all duration-300 flex items-center justify-center gap-2">
                    Create Store Now
                </button>
                <button type="button" onclick="goBackTo2()" class="w-full py-3 bg-white text-slate-600 rounded-xl font-medium hover:bg-slate-50 border border-slate-200 transition-colors">
                    ← Back
                </button>
            </form>
        </div>

        <!-- Loading State -->
        <div id="step-loading" class="hidden text-center fade-in py-12">
            <div class="inline-flex h-12 w-12 relative mb-6">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-12 w-12 bg-indigo-600"></span>
            </div>
            <h2 class="text-2xl font-bold text-slate-900 mb-2">Creating your store...</h2>
            <p class="text-slate-500">Setting up database, analytics, and storefront.</p>
        </div>

        <!-- Step 4: Request Access -->
        <div id="step-4-request" class="hidden">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Request Access</h1>
                <p class="text-slate-500 mt-2">Our team will get in touch to set up your plan.</p>
            </div>

            <form id="form-step-4-request" class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200 space-y-6">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Business Name</label>
                    <input type="text" id="req_business_name" required class="block w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-shadow">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Expected Monthly Revenue</label>
                    <select id="req_revenue" class="block w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                        <option value="Under 1 Lakh">Under 1 Lakh</option>
                        <option value="1L - 10L">1 Lakh - 10 Lakhs</option>
                        <option value="10L+">More than 10 Lakhs</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Message / Requirements</label>
                    <textarea id="req_message" rows="3" class="block w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" placeholder="Any specific feature requests?"></textarea>
                </div>

                <div id="error-msg-4" class="hidden text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-100"></div>

                <button type="submit" id="btn-request-submit" class="w-full py-3.5 bg-indigo-600 text-white rounded-xl font-semibold hover:bg-indigo-700 hover:shadow-lg hover:shadow-indigo-200 transition-all duration-300">
                    Submit Request
                </button>
                <button type="button" onclick="goBackTo3From4()" class="w-full py-3 bg-white text-slate-600 rounded-xl font-medium hover:bg-slate-50 border border-slate-200 transition-colors">
                    ← Back
                </button>
            </form>
        </div>

        <!-- Success Message -->
        <div id="step-success" class="hidden text-center fade-in py-12">
            <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h2 class="text-3xl font-bold text-slate-900 mb-2">Request Received!</h2>
            <p class="text-slate-500 mb-8">Our expert team will contact you within 24 hours to proceed with the setup.</p>
            <a href="/" class="inline-flex items-center justify-center py-3 px-6 bg-slate-900 text-white rounded-xl font-medium hover:bg-slate-800 transition-colors">
                Return to Homepage
            </a>
        </div>

    </div>
  </main>

  <script is:inline>
    let formData = {
        name: '',
        identifierType: 'email', // phone or email
        identifierValue: '',     // the actual value
        subdomain: '',
        plan_id: '00000000-0000-0000-0000-000000000005',
        hash: '',
        expiry: ''
    };

    const step1 = document.getElementById('step-1');
    const stepOtp = document.getElementById('step-otp');
    const stepExistingStores = document.getElementById('step-existing-stores');
    const step2 = document.getElementById('step-2');
    const step3 = document.getElementById('step-3');
    const step4 = document.getElementById('step-4');
    const stepLoading = document.getElementById('step-loading');
    const stepIndicator = document.getElementById('step-indicator');

    // Auto-generate subdomain from store name
    document.getElementById('store_name').addEventListener('input', (e) => {
        const val = e.target.value;
        const slug = val.toLowerCase().replace(/[^a-z0-9]/g, '');
        document.getElementById('subdomain').value = slug;
    });

    // Helper to toggle buttons
    function setLoading(btnId, isLoading) {
        const btn = document.getElementById(btnId);
        const spinner = btn.querySelector('.spinner');
        const text = btn.querySelector('.btn-text');
        if (isLoading) {
            btn.disabled = true;
            spinner.classList.remove('hidden');
            text.style.opacity = '0.5';
        } else {
            btn.disabled = false;
            spinner.classList.add('hidden');
            text.style.opacity = '1';
        }
    }

    document.getElementById('form-step-1').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const errorMsg = document.getElementById('error-msg-1');
        errorMsg.classList.add('hidden');
        
        const identInput = document.getElementById('identifier');
        formData.identifierType = identInput.getAttribute('data-type');
        formData.identifierValue = identInput.value.trim();
        
        setLoading('btn-step-1', true);
        
        try {
            const body = { isOnboarding: true };
            if (formData.identifierType === 'email') body.email = formData.identifierValue;
            else body.phone = formData.identifierValue;

            const res = await fetch('/api/admin/request-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });

            const data = await res.json();
            
            if (!res.ok) {
                errorMsg.innerText = data.error || 'Failed to send OTP';
                errorMsg.classList.remove('hidden');
                setLoading('btn-step-1', false);
                return;
            }

            formData.hash = data.sessionHash;
            formData.expiry = data.sessionExpiry;

            document.getElementById('display-identifier').innerText = formData.identifierValue;

            step1.classList.add('hidden');
            step1.classList.remove('fade-in');
            stepOtp.classList.remove('hidden');
            stepOtp.classList.add('fade-in');
        } catch (err) {
            errorMsg.innerText = 'Network error occurred.';
            errorMsg.classList.remove('hidden');
        } finally {
            setLoading('btn-step-1', false);
        }
    });

    document.getElementById('form-step-otp').addEventListener('submit', async (e) => {
        e.preventDefault();
        const otpVal = document.getElementById('otp').value.trim();
        const errorMsg = document.getElementById('error-msg-otp');
        errorMsg.classList.add('hidden');
        setLoading('btn-step-otp', true);

        try {
            const body = { 
                isOnboarding: true,
                otp: otpVal,
                hash: formData.hash,
                expiry: formData.expiry
            };
            if (formData.identifierType === 'email') body.email = formData.identifierValue;
            else body.phone = formData.identifierValue;

            const res = await fetch('/api/admin/verify-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });

            const data = await res.json();
            
            if (!res.ok) {
                errorMsg.innerText = data.error || 'Invalid OTP';
                errorMsg.classList.remove('hidden');
                setLoading('btn-step-otp', false);
                return;
            }

            if (data.existingStores && data.existingStores.length > 0) {
                // Show existing stores
                renderExistingStores(data.existingStores);
                stepOtp.classList.add('hidden');
                stepOtp.classList.remove('fade-in');
                stepExistingStores.classList.remove('hidden');
                stepExistingStores.classList.add('fade-in');
            } else {
                // Move to Step 2 (Subdomain)
                goToStep2FromOtp();
            }
        } catch (err) {
            errorMsg.innerText = 'Network error occurred.';
            errorMsg.classList.remove('hidden');
        } finally {
            setLoading('btn-step-otp', false);
        }
    });

    function renderExistingStores(stores) {
        const listContainer = document.getElementById('existing-stores-list');
        listContainer.innerHTML = '';
        stores.forEach(store => {
            const storeBtn = document.createElement('button');
            storeBtn.type = 'button';
            storeBtn.className = 'w-full text-left px-4 py-4 rounded-xl border border-slate-200 hover:border-indigo-500 hover:shadow-sm transition-all flex justify-between items-center bg-slate-50 hover:bg-white group';
            storeBtn.innerHTML = `
                <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-indigo-500 hidden spinner" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="spinner-${store.id}"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                    <div>
                        <div class="font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">${store.name}</div>
                        <div class="text-xs text-slate-500 mt-0.5">${store.subdomain}.vyaparpe.in</div>
                    </div>
                </div>
                <svg class="w-5 h-5 text-slate-400 group-hover:text-indigo-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            `;
            storeBtn.onclick = () => loginToExistingStore(store.id, storeBtn);
            listContainer.appendChild(storeBtn);
        });
    }

    async function loginToExistingStore(storeId, btnElement) {
        const spinner = btnElement.querySelector('.spinner');
        if (spinner) spinner.classList.remove('hidden');
        btnElement.disabled = true;
        btnElement.classList.add('opacity-75');

        try {
            const res = await fetch('/api/admin/login-cross-store', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ storeId })
            });

            const data = await res.json();
            if (!res.ok) {
                alert(data.error || 'Login failed');
                if (spinner) spinner.classList.add('hidden');
                btnElement.disabled = false;
                btnElement.classList.remove('opacity-75');
                return;
            }

            // Redirect to the store's admin panel
            window.location.href = data.redirectUrl;
        } catch (err) {
            alert('Network error occurred.');
            if (spinner) spinner.classList.add('hidden');
            btnElement.disabled = false;
            btnElement.classList.remove('opacity-75');
        }
    }

    function goToStep2FromOtp() {
        stepOtp.classList.add('hidden');
        stepOtp.classList.remove('fade-in');
        step2.classList.remove('hidden');
        step2.classList.add('fade-in');
        stepIndicator.innerText = '2';
    }

    function goToStep2() {
        stepExistingStores.classList.add('hidden');
        stepExistingStores.classList.remove('fade-in');
        step2.classList.remove('hidden');
        step2.classList.add('fade-in');
        stepIndicator.innerText = '2';
    }

    function goBackTo1() {
        stepOtp.classList.add('hidden');
        stepOtp.classList.remove('fade-in');
        stepExistingStores.classList.add('hidden');
        stepExistingStores.classList.remove('fade-in');
        step2.classList.add('hidden');
        step2.classList.remove('fade-in');
        step1.classList.remove('hidden');
        step1.classList.add('fade-in');
        stepIndicator.innerText = '1';
        document.getElementById('error-msg-2').classList.add('hidden');
    }

    document.getElementById('form-step-2').addEventListener('submit', (e) => {
        e.preventDefault();
        formData.name = document.getElementById('store_name').value.trim();
        formData.subdomain = document.getElementById('subdomain').value.trim().toLowerCase();
        
        step2.classList.add('hidden');
        step2.classList.remove('fade-in');
        step3.classList.remove('hidden');
        step3.classList.add('fade-in');
        stepIndicator.innerText = '3';
    });

    function goBackTo2() {
        step3.classList.add('hidden');
        step3.classList.remove('fade-in');
        step2.classList.remove('hidden');
        step2.classList.add('fade-in');
        stepIndicator.innerText = '2';
        document.getElementById('error-msg-3').classList.add('hidden');
    }

    document.getElementById('form-step-3').addEventListener('submit', (e) => {
        e.preventDefault();
        const pwd = document.getElementById('l0-password').value;
        const confirm = document.getElementById('l0-confirm-password').value;
        const errorMsg = document.getElementById('error-msg-3');

        if (pwd !== confirm) {
            errorMsg.innerText = "Passwords do not match.";
            errorMsg.classList.remove('hidden');
            return;
        }

        formData.password = pwd; // Store unhashed password, backend will hash it
        
        step3.classList.add('hidden');
        step3.classList.remove('fade-in');
        step4.classList.remove('hidden');
        step4.classList.add('fade-in');
        stepIndicator.innerText = '4';
    });

    function goBackTo3() {
        step4.classList.add('hidden');
        step4.classList.remove('fade-in');
        step3.classList.remove('hidden');
        step3.classList.add('fade-in');
        stepIndicator.innerText = '3';
        document.getElementById('error-msg-4')?.classList.add('hidden');
    }

    function updatePlanSelection(radio) {
        formData.plan_id = radio.value;
        const labels = document.querySelectorAll('input[name="plan_id"]');
        labels.forEach(input => {
            const label = input.closest('label');
            const circle = label.querySelector('.check-circle');
            const innerDot = circle.querySelector('div');
            if (input.checked) {
                label.classList.add('border-indigo-600');
                label.classList.remove('border-slate-200');
                circle.classList.add('border-indigo-600', 'bg-indigo-600');
                circle.classList.remove('border-slate-300', 'bg-white');
                innerDot.classList.remove('hidden');
            } else {
                label.classList.remove('border-indigo-600');
                label.classList.add('border-slate-200');
                circle.classList.remove('border-indigo-600', 'bg-indigo-600');
                circle.classList.add('border-slate-300', 'bg-white');
                innerDot.classList.add('hidden');
            }
        });
    }

    document.getElementById('form-step-4').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const errorMsg = document.getElementById('error-msg-4');
        
        // Check if plan requires manual contact (Ad-Spend Partner or Lifetime Ownership)
        if (formData.plan_id === '00000000-0000-0000-0000-000000000007' || formData.plan_id === '00000000-0000-0000-0000-000000000008') {
            document.getElementById('req_business_name').value = formData.name;
            step4.classList.add('hidden');
            step4.classList.remove('fade-in');
            document.getElementById('step-5-request').classList.remove('hidden');
            document.getElementById('step-5-request').classList.add('fade-in');
            stepIndicator.innerText = '5';
            return;
        }

        // Show loading state for standard plans
        step4.classList.add('hidden');
        stepLoading.classList.remove('hidden');

        const payload = {
            name: formData.name,
            subdomain: formData.subdomain,
            plan_id: formData.plan_id,
            password: formData.password
        };
        if (formData.identifierType === 'email') payload.email = formData.identifierValue;
        else payload.phone = formData.identifierValue;

        const csrfToken = document.body.getAttribute('data-csrf');

        try {
            const res = await fetch('/api/admin/provision-tenant', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'x-csrf-token': csrfToken
                },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            
            if (data.success) {
                // Instantly redirect to the tenant admin dashboard onboarding flow using the current host
                let currentHost = window.location.host.replace('www.', '');
                window.location.href = `${window.location.protocol}//${formData.subdomain}.${currentHost}/admin/onboarding`;
            } else {
                // Show error and go back to step 3
                stepLoading.classList.add('hidden');
                step3.classList.remove('hidden');
                errorMsg.innerText = data.error || 'Failed to create store';
                errorMsg.classList.remove('hidden');
            }
        } catch (err) {
            stepLoading.classList.add('hidden');
            step3.classList.remove('hidden');
            errorMsg.innerText = 'Network error. Please try again.';
            errorMsg.classList.remove('hidden');
        }
    });

    function goBackTo3From4() {
        document.getElementById('step-4-request').classList.add('hidden');
        document.getElementById('step-4-request').classList.remove('fade-in');
        step3.classList.remove('hidden');
        step3.classList.add('fade-in');
        stepIndicator.innerText = '3';
        document.getElementById('error-msg-4').classList.add('hidden');
    }

    document.getElementById('form-step-4-request').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const errorMsg = document.getElementById('error-msg-4');
        errorMsg.classList.add('hidden');
        
        const btn = document.getElementById('btn-request-submit');
        const ogText = btn.innerHTML;
        btn.innerHTML = 'Submitting...';
        btn.disabled = true;

        const payload = {
            businessName: document.getElementById('req_business_name').value.trim(),
            revenue: document.getElementById('req_revenue').value,
            message: document.getElementById('req_message').value.trim(),
            plan_id: formData.plan_id,
            email: formData.identifierType === 'email' ? formData.identifierValue : null,
            phone: formData.identifierType === 'phone' ? formData.identifierValue : null
        };

        try {
            const res = await fetch('/api/admin/submit-lead', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            
            if (data.success) {
                document.getElementById('step-4-request').classList.add('hidden');
                document.getElementById('step-success').classList.remove('hidden');
            } else {
                errorMsg.innerText = data.error || 'Failed to submit request';
                errorMsg.classList.remove('hidden');
                btn.innerHTML = ogText;
                btn.disabled = false;
            }
        } catch (err) {
            errorMsg.innerText = 'Network error. Please try again.';
            errorMsg.classList.remove('hidden');
            btn.innerHTML = ogText;
            btn.disabled = false;
        }
    });
  </script>

</body>
</html>
