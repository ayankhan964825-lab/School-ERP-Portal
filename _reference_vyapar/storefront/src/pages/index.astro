---
const isGlobalRoot = Astro.url.hostname === 'vyaparpe.com' || Astro.url.hostname === 'www.vyaparpe.com' || Astro.url.hostname === 'vyaparpe.in' || Astro.url.hostname === 'www.vyaparpe.in';

import Layout from '../layouts/Layout.astro';
import SaasLanding from '../components/saas/SaasLanding.astro';
import HeroSection from '../components/HeroSection.astro';
import ProductCard from '../components/ProductCard.astro';
import FlashSaleSection from '../components/FlashSaleSection.astro';
import FeaturedVideosSection from '../components/FeaturedVideosSection.astro';
import { getStorefrontProducts, getCategories, getHeroSlides, getSettings, getFlashSales } from '../lib/database';
import { optimizeImage } from '../lib/image-utils';
import categoryIcons from '../data/categoryIcons';
import { uspIcons } from '../data/uspIcons';

// Smart cache: serve from CDN for 60s, revalidate in background
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=120');
Astro.response.headers.set('Vary', 'Host');

// Extract storeId to bypass Astro SSR context loss
const forceStoreId = Astro.locals.storeId;

// Load from DB in parallel for max performance
let allProductsRaw: any = [];
let dbCategories: any = [];
let dbSlides: any = [];
let settings: any = {};
let dbSalesRaw: any = [];

if (!isGlobalRoot) {
  const res = await Promise.all([
    getStorefrontProducts(forceStoreId, Astro.cookies.get('delivery_pincode')?.value, Astro.cookies.get('qc_eligible')?.value),
    getCategories(forceStoreId),
    getHeroSlides(forceStoreId),
    getSettings(forceStoreId),
    getFlashSales(forceStoreId)
  ]);
  allProductsRaw = res[0];
  dbCategories = res[1];
  dbSlides = res[2];
  settings = res[3];
  dbSalesRaw = res[4];
}

const storeName = settings?.brand_name || settings?.store_name || 'WarpDeal';

// ===== Q-COMMERCE THEME INTERCEPT =====
if (!isGlobalRoot) {
  let qcWebConfig: any = {};
  try {
    if (settings?.website_configuration) {
      qcWebConfig = typeof settings.website_configuration === 'string'
        ? JSON.parse(settings.website_configuration)
        : settings.website_configuration;
    }
  } catch(e) {}
  if (qcWebConfig?.theme === 'qcommerce') {
    return Astro.rewrite('/qcommerce-home');
  }
}
// ======================================


const now = new Date();
const activeFlashSales = dbSalesRaw.filter((s: any) => {
  const start = new Date(s.startDate);
  const end = new Date(s.endDate);
  let status = s.status || 'scheduled';
  if (status !== 'expired') {
    if (start <= now && end > now) status = 'active';
    else if (end <= now) status = 'expired';
    else if (start > now) status = 'scheduled';
  }
  return status === 'active';
});

let hideOutOfStock = false;
try {
  if (settings?.website_configuration) {
    const parsed = typeof settings.website_configuration === 'string' 
      ? JSON.parse(settings.website_configuration) 
      : settings.website_configuration;
    if (parsed.hide_out_of_stock === true || parsed.hide_out_of_stock === 'true') {
      hideOutOfStock = true;
    }
  }
} catch (e) {}

const allProducts = allProductsRaw
  .filter((p: any) => p.is_active !== false)
  .filter((p: any) => {
    if (!hideOutOfStock) return true;
    // Keep product if any variant is not out of stock
    return (p.variants || []).some((v: any) => !v.is_hidden && !v.is_out_of_stock);
  })
  .map((p: any) => {
    return {
      ...p,
      variants: p.variants?.filter((v: any) => !v.is_hidden) || []
    };
  })
  .filter((p: any) => p.variants.length > 0);

const flashSaleConfig = settings?.flash_sale_config || { active: false };

const activeCampaigns = [];
// Only render if the master switch is active AND there are active sales in the DB
if (flashSaleConfig.active && activeFlashSales.length > 0) {
  if (flashSaleConfig.campaigns && flashSaleConfig.campaigns.length > 0) {
    flashSaleConfig.campaigns.forEach((campaign: any) => {
       const campaignProducts = allProducts.map((p: any) => {
         const campaignVariants = p.variants.filter((v: any) => v.isFlashSale);
         if (campaignVariants.length > 0) {
           return { ...p, variants: campaignVariants };
         }
         return null;
       }).filter(Boolean);
       
       if (campaignProducts.length > 0) {
         activeCampaigns.push({ 
           config: { type: 'theme', title: 'Flash Sale', ...campaign }, 
           products: campaignProducts 
         });
       }
    });
  } else {
    // Legacy support (fallback to single config or DB driven sales)
    const flashSaleProducts = allProducts.map((p: any) => {
       const saleVariants = p.variants.filter((v: any) => v.isFlashSale);
       if (saleVariants.length > 0) return { ...p, variants: saleVariants };
       return null;
    }).filter(Boolean);
    
    if (flashSaleProducts.length > 0) {
       activeCampaigns.push({ 
         config: { type: 'theme', title: 'Flash Sale', active: true, ...flashSaleConfig }, 
         products: flashSaleProducts 
       });
    }
  }
}

// Featured: bestsellers first, then top 8
const featuredProducts = [...allProducts]
  .sort((a: any, b: any) => {
    const aBest = a.badges?.some((badge: string) => badge.toLowerCase().includes('best'));
    const bBest = b.badges?.some((badge: string) => badge.toLowerCase().includes('best'));
    if (aBest && !bBest) return -1;
    if (!aBest && bBest) return 1;
    return (b.rating?.value || 0) - (a.rating?.value || 0);
  })
  .slice(0, 8);

// Trending Slider Products
let trendingProducts = [];
const isTrendingSliderEnabled = settings?.trending_slider_enabled !== 'false' && settings?.trending_slider_enabled !== false;
const trendingSliderTitle = settings?.trending_slider_title || 'Trending Now';
if (isTrendingSliderEnabled) {
  const customSlugs = settings.trending_slider_products
    ? settings.trending_slider_products.split(',').map((s: string) => s.trim()).filter(Boolean)
    : [];
  
  if (customSlugs.length > 0) {
    trendingProducts = allProducts.filter((p: any) => 
      customSlugs.includes(p.slug) && 
      p.variants.some((v: any) => !v.is_out_of_stock)
    );
  } else {
    // Randomly select 8 products if no custom slugs provided, excluding out of stock
    trendingProducts = [...allProducts]
      .filter((p: any) => p.variants.some((v: any) => !v.is_out_of_stock))
      .sort(() => 0.5 - Math.random())
      .slice(0, 8);
  }
}


const parseJson = (str: any, fallback: any) => {
    if (!str) return fallback;
    try { return typeof str === 'string' ? JSON.parse(str) : str; } catch { return fallback; }
  };

const homeStoryStats = parseJson(settings?.home_story_stats, []);

const homeTestimonials = parseJson(settings?.home_testimonials, []);

const defaultBullets: string[] = [];
let homeStoryBullets = defaultBullets;
try {
  if (settings?.home_story_bullets) {
    const parsed = typeof settings.home_story_bullets === 'string' ? JSON.parse(settings.home_story_bullets) : settings.home_story_bullets;
    if (Array.isArray(parsed)) {
      homeStoryBullets = parsed;
    } else {
      homeStoryBullets = settings.home_story_bullets.split(',');
    }
  }
} catch (e) {
  homeStoryBullets = settings.home_story_bullets ? settings.home_story_bullets.split(',') : defaultBullets;
}

const defaultUSPs: any[] = [];
const rawUSPs = parseJson(settings?.home_usps, defaultUSPs);

const uspIconKeys = [uspIcons.pure, uspIcons.noPreservatives, uspIcons.vegan, uspIcons.makeInIndia];
const dynamicUsps = rawUSPs.map((u: any, i: number) => ({
    icon: u.iconSvg || uspIconKeys[i % 4], // Support custom svg in future
    title: u.title,
  desc: u.desc
}));


// Build categories from DB with live product counts — only top-level (no parent_id)
const categoryImages: Record<string, string> = {};

const categories = dbCategories
  .filter((c: any) => !c.parent_id)
  .map((c: any) => {
    // Count products in this category + all child category slugs
    const childSlugs = dbCategories.filter((ch: any) => ch.parent_id === c.id).map((ch: any) => ch.slug);
    const allSlugs = [c.slug, ...childSlugs];
    const count = allProducts.filter((p: any) => allSlugs.includes(p.category)).length;
    return {
      label: c.name,
      slug:  c.slug,
      href:  `/products?category=${c.slug}`,
      count,
      icon:  categoryIcons[c.slug] || categoryIcons['default'],
      image: c.image || categoryImages[c.slug] || null,
    };
  })
  .filter((c: any) => c.count > 0);

// Read category display style from configuration
let categoryDisplayStyle = 'circular_slider';
try {
  if (settings?.website_configuration) {
    const parsed = typeof settings.website_configuration === 'string'
      ? JSON.parse(settings.website_configuration)
      : settings.website_configuration;
    if (parsed.category_display_style) categoryDisplayStyle = parsed.category_display_style;
  }
} catch (e) {}

let activeDesign = 'classic';
try {
  if (settings?.website_design) {
    const parsed = typeof settings.website_design === 'string'
      ? JSON.parse(settings.website_design)
      : settings.website_design;
    activeDesign = parsed.active_design || 'classic';
  }
} catch (e) {}

const isVibrantDesign = activeDesign === 'vibrant' || activeDesign === 'energy';
const isEditorialDesign = activeDesign === 'editorial' || activeDesign === 'earthy';
const isModernDesign = activeDesign === 'modern' || activeDesign === 'beauty';

const rawFirstSlideImg = dbSlides && dbSlides.length > 0 ? (dbSlides[0].media_url || '/images/hero-1.jpg') : '/images/hero-1.jpg';
const firstSlideImg = optimizeImage(rawFirstSlideImg, { width: 1200, quality: 80, format: 'webp' });
---

{isGlobalRoot ? (
  <SaasLanding />
) : (
<Layout 
  title={settings?.page_seo_home?.title || storeName} 
  description={settings?.page_seo_home?.desc || settings?.global_seo_desc || settings?.seo_default_description || `Shop premium quality products online at ${storeName}. Fast delivery, best prices, guaranteed quality.`} 
  keywords={settings?.seo_keywords || `buy products online, shop ${storeName.toLowerCase()}, best deals, quality products`} 
  ogImage={firstSlideImg}>
  <link slot="head" rel="preload" as="image" href={firstSlideImg} fetchpriority="high" />
  
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": `${Astro.url.origin}/#website`,
        "url": Astro.url.origin,
        "name": storeName,
        "potentialAction": {
          "@type": "SearchAction",
          "target": `${Astro.url.origin}/products?search={search_term_string}`,
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "Organization",
        "@id": `${Astro.url.origin}/#organization`,
        "name": storeName,
        "url": Astro.url.origin,
        "logo": settings?.logo_url ? (settings.logo_url.startsWith('http') ? settings.logo_url : `${Astro.url.origin}${settings.logo_url}`) : (settings?.brand_logo ? settings.brand_logo : `${Astro.url.origin}/logo.png`),
        "sameAs": [
          settings?.social_instagram || "",
          settings?.social_facebook || ""
        ].filter(Boolean)
      }
    ]
  }).replace(/</g, '\\u003c')} />

  <style>
    @keyframes scroll-marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .marquee-track {
      animation: scroll-marquee 30s linear infinite;
      display: flex;
      width: max-content;
    }
    .marquee-track:hover {
      animation-play-state: paused;
    }
    /* Add touch support for pausing */
    .marquee-track:active {
      animation-play-state: paused;
    }
  </style>

  <!-- Hero -->
  <HeroSection initialSlides={dbSlides} />

  <!-- ── USP Strip ───────────────────────────────────────────── -->
  {dynamicUsps.length > 0 && (
    <section id="usps" class="bg-primary py-1.5 lg:py-3 border-y border-white/10" aria-label="Our USPs">
      <div class="max-w-7xl mx-auto px-1 sm:px-8 lg:px-12">
        {isVibrantDesign ? (
           <div class="flex overflow-x-auto gap-4 py-2 px-4 no-scrollbar snap-x">
             {dynamicUsps.map((usp: any, i: number) => (
               <div class="flex items-center gap-3 bg-white/10 rounded-full px-5 py-2.5 shrink-0 snap-center border border-white/20">
                 <span class="text-xl text-accent" aria-hidden="true" set:html={usp.icon} />
                 <span class="text-white font-medium text-sm whitespace-nowrap">{usp.title === 'No Preservatives' ? '0% Added' : usp.title}</span>
               </div>
            ))}
          </div>
        ) : (
          <div class={`grid grid-cols-4 gap-1 lg:gap-6 items-start lg:items-center ${isEditorialDesign ? 'divide-x divide-white/20' : ''}`}>
            {dynamicUsps.map((usp: any, i: number) => (
              <div class={`flex flex-col lg:flex-row items-center justify-start lg:justify-center gap-0.5 lg:gap-3 group text-center lg:text-left hover-lift ${isEditorialDesign ? 'px-2' : ''}`} style={`transition-delay:${i*0.05}s`}>
              <span class="text-lg lg:text-3xl flex-shrink-0 leading-none mt-0.5 lg:mt-0 text-accent group-hover:text-accent-warm transition-colors" aria-hidden="true" set:html={usp.icon} />
              <div>
                <h3 class="text-white/90 font-serif font-semibold text-[9px] sm:text-xs lg:text-sm leading-tight">{usp.title === 'No Preservatives' ? '0% Added' : usp.title}</h3>
                <p class="text-white/60 text-xs mt-0.5 hidden lg:block">{usp.desc}</p>
              </div>
            </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ── Flash Sale Section ───────────────────────────────────── -->
  {activeCampaigns.map(({ config, products }: any) => (
    <FlashSaleSection config={config} products={products} />
  ))}

  <!-- ── Categories ─────────────────────────────────────────── -->
  {categories.length > 0 && (
  <section id="categories" class="py-12 md:py-20 bg-surface" aria-label="Browse Categories">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="text-center mb-12">
        <span class="text-xs font-semibold text-accent uppercase tracking-[0.2em]">Browse By Category</span>
        <h2 class="font-serif text-4xl font-bold mt-2">Find What You Need</h2>
      </div>

      {/* ── Style 1: Circular Slider (marquee) ── */}
      {categoryDisplayStyle === 'circular_slider' && (
        <div class="category-carousel-container overflow-x-auto no-scrollbar pb-4 pt-2 px-2 flex w-full" style="-webkit-overflow-scrolling: touch;">
            <div class="carousel-set flex gap-3 sm:gap-6 md:gap-8 pr-3 sm:pr-6 md:pr-8 shrink-0">
              {[...categories, ...categories, ...categories].map((cat: any) => (
                <a href={cat.href} class="flex flex-col items-center flex-shrink-0 group w-16 sm:w-24">
                  <div class="w-12 h-12 sm:w-20 sm:h-20 rounded-full bg-white flex items-center justify-center shadow-sm border border-background-alt group-hover:border-primary group-hover:shadow-md transition-all duration-300 mb-1.5 overflow-hidden">
                    {cat.image ? (
                      <img src={cat.image} alt={cat.label} class="w-full h-full object-cover" loading="lazy" />
                    ) : (
                      <span class="text-primary group-hover:text-primary transition-colors duration-300 [&>svg]:w-5 [&>svg]:h-5 sm:[&>svg]:w-8 sm:[&>svg]:h-8" aria-hidden="true" set:html={cat.icon} />
                    )}
                  </div>
                  <p class="font-medium text-[9px] sm:text-sm text-primary group-hover:text-primary transition-colors duration-200 text-center leading-tight">{cat.label}</p>
                </a>
              ))}
            </div>
            <div class="carousel-set flex gap-3 sm:gap-6 md:gap-8 pr-3 sm:pr-6 md:pr-8 shrink-0" aria-hidden="true">
              {[...categories, ...categories, ...categories].map((cat: any) => (
                <a href={cat.href} class="flex flex-col items-center flex-shrink-0 group w-16 sm:w-24" tabindex="-1">
                  <div class="w-12 h-12 sm:w-20 sm:h-20 rounded-full bg-white flex items-center justify-center shadow-sm border border-background-alt group-hover:border-primary group-hover:shadow-md transition-all duration-300 mb-1.5 overflow-hidden">
                    {cat.image ? (
                      <img src={cat.image} alt={cat.label} class="w-full h-full object-cover" loading="lazy" />
                    ) : (
                      <span class="text-primary group-hover:text-primary transition-colors duration-300 [&>svg]:w-5 [&>svg]:h-5 sm:[&>svg]:w-8 sm:[&>svg]:h-8" aria-hidden="true" set:html={cat.icon} />
                    )}
                  </div>
                  <p class="font-medium text-[9px] sm:text-sm text-primary group-hover:text-primary transition-colors duration-200 text-center leading-tight">{cat.label}</p>
                </a>
              ))}
            </div>
        </div>
      )}

      {/* ── Style 2: Grid Cards ── */}
      {categoryDisplayStyle === 'grid_cards' && (
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          {categories.map((cat: any) => (
            <a href={cat.href} class="group relative rounded-2xl overflow-hidden aspect-[4/3] shadow-md hover:shadow-xl transition-all duration-300">
              {cat.image ? (
                <img src={cat.image} alt={cat.label} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-primary/10 to-primary/5 flex items-center justify-center">
                  <span class="text-primary [&>svg]:w-12 [&>svg]:h-12" set:html={cat.icon} />
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />
              <div class="absolute bottom-0 left-0 right-0 p-4">
                <h3 class="text-white font-serif font-bold text-base sm:text-lg leading-tight">{cat.label}</h3>
                <p class="text-white/70 text-xs mt-0.5">{cat.count} products</p>
              </div>
            </a>
          ))}
        </div>
      )}

      {/* ── Style 3: Image Carousel ── */}
      {categoryDisplayStyle === 'image_carousel' && (
        <div class="flex overflow-x-auto gap-5 pb-4 snap-x snap-mandatory no-scrollbar" style="-webkit-overflow-scrolling: touch;">
          {categories.map((cat: any) => (
            <a href={cat.href} class="flex-shrink-0 w-64 sm:w-80 group snap-start">
              <div class="relative rounded-2xl overflow-hidden aspect-[16/10] shadow-md group-hover:shadow-xl transition-all duration-300">
                {cat.image ? (
                  <img src={cat.image} alt={cat.label} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-primary/10 to-primary/5 flex items-center justify-center">
                    <span class="text-primary [&>svg]:w-12 [&>svg]:h-12" set:html={cat.icon} />
                  </div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
                <div class="absolute bottom-0 left-0 right-0 p-4">
                  <h3 class="text-white font-serif font-bold text-lg">{cat.label}</h3>
                  <p class="text-white/60 text-xs">{cat.count} products →</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}

    </div>
  </section>
  )}

  <!-- ── Featured Products ──────────────────────────────────── -->
  {featuredProducts.length > 0 && (
  <section id="featured-products" class="py-12 md:py-20 bg-background-alt" aria-label="Featured Products">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="flex items-end justify-between mb-12">
        <div>
          <span class="text-xs font-semibold text-accent uppercase tracking-[0.2em]">Our Bestsellers</span>
          <h2 class="font-serif text-4xl font-bold mt-2">Featured Products</h2>
        </div>
        <div class="flex items-center gap-3">
          <!-- Grid Toggle (mobile only) -->
          <div class="flex items-center gap-1 bg-white p-1 rounded-xl shadow-sm border border-gray-100 sm:hidden">
            <button id="home-grid-1col" aria-label="Single column view" class="p-2 rounded-lg transition-all duration-200" title="Large view">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="8" rx="2" />
                <rect x="3" y="13" width="18" height="8" rx="2" />
              </svg>
            </button>
            <button id="home-grid-2col" aria-label="Two column view" class="p-2 rounded-lg transition-all duration-200" title="Grid view">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="9" height="9" rx="1.5" />
                <rect x="12" y="3" width="9" height="9" rx="1.5" />
                <rect x="3" y="12" width="9" height="9" rx="1.5" />
                <rect x="12" y="12" width="9" height="9" rx="1.5" />
              </svg>
            </button>
          </div>
          <a href="/products" class="btn-secondary hidden sm:inline-flex">View All</a>
        </div>
      </div>

      <div id="home-product-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
        {featuredProducts.map((product: any, i: number) => (
          <div class="reveal min-w-0" style={`transition-delay: ${i * 0.06}s`}>
            <ProductCard
              id={product.id}
              name={product.name}
              slug={product.slug}
              description={product.description}
              variants={product.variants}
              image={product.image}
              rating={product.rating}
              badge={product.badges?.[0] ?? (i < 2 ? 'Best Seller' : null)}
              track_inventory={product.track_inventory}
              is_q_commerce_only={product.is_q_commerce_only}
            />
          </div>
        ))}
      </div>

      <div class="text-center mt-10 sm:hidden">
        <a href="/products" class="btn-secondary">View All Products</a>
      </div>
    </div>
  </section>
  )}

  <!-- ── Featured Videos Section ────────────────────────────────────── -->
  <FeaturedVideosSection />

  <!-- ── Trending Slider ────────────────────────────────────── -->
  {isTrendingSliderEnabled && trendingProducts.length > 0 && (
    <section id="trending-slider" class="py-12 bg-white overflow-x-hidden border-t border-background-alt" aria-label="Trending Products">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 mb-8 text-center">
        <h2 class="font-serif text-3xl font-bold text-primary">{trendingSliderTitle}</h2>
      </div>
      
      <div class="w-full relative [mask-image:_linear-gradient(to_right,transparent_0,_black_64px,_black_calc(100%-64px),transparent_100%)]">
        <div class="flex overflow-x-auto gap-6 pb-8 pt-2 no-scrollbar snap-x snap-mandatory scroll-smooth px-6 sm:px-8 lg:px-12" id="trending-scroll-container">
          {trendingProducts.map((product: any) => (
            <div class="shrink-0 w-64 sm:w-72 snap-start">
              <ProductCard
                id={product.id}
                name={product.name}
                slug={product.slug}
                description={product.description}
                variants={product.variants}
                image={product.image}
                rating={product.rating}
                badge={null}
                track_inventory={product.track_inventory}
                is_q_commerce_only={product.is_q_commerce_only}
              />
            </div>
          ))}
          {/* Spacer to allow last item to scroll past the mask fade */}
          <div class="shrink-0 w-12 sm:w-16" aria-hidden="true"></div>
        </div>
      </div>
    </section>
  )}

  <!-- ── Why Your Brand Banner ────────────────────────────────── -->
  {settings?.home_story_text && (
  <section id={`why-${storeName.replace(/\s+/g, '-').toLowerCase()}`} class={`py-12 lg:py-24 ${isVibrantDesign ? 'bg-background-alt' : 'bg-primary'}`} aria-label={`Why Choose ${storeName}`}>
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class={`grid ${isEditorialDesign ? 'lg:grid-cols-3' : 'lg:grid-cols-2'} gap-16 items-center`}>
          <div class={`flex flex-col gap-6 ${isEditorialDesign ? 'lg:col-span-2' : ''}`}>
            <span class={`text-xs font-semibold uppercase tracking-[0.2em] ${isVibrantDesign ? 'text-primary' : 'text-accent-orange'}`}>Our Story</span>
            <h2 class={`font-serif text-4xl lg:text-5xl font-bold leading-tight ${isVibrantDesign ? 'text-primary' : 'text-surface'}`}>
              {storeName} — <span class={`${isVibrantDesign ? 'text-primary-light' : 'text-accent-orange'} italic`} data-setting="home_story_year">{settings?.home_story_year || 'Founded in 2026'}</span>
            </h2>
            <div class={`${isVibrantDesign ? 'text-text-muted' : 'text-surface/70'} leading-relaxed space-y-4`} data-setting="home_story_text" set:html={settings?.home_story_text || `${storeName} was born from a passion for delivering premium quality products directly to you. We source the finest materials and use advanced techniques to bring you exceptional homeware.`}></div>
            <ul class="flex flex-col gap-3">
              {homeStoryBullets.map((item: string) => (
                <li class={`flex items-center gap-3 ${isVibrantDesign ? 'text-text' : 'text-surface/80'} text-sm`}>
                  <svg class={`h-5 w-5 flex-shrink-0 ${isVibrantDesign ? 'text-primary' : 'text-accent-orange'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
            <div>
              <a href="/about" class={isVibrantDesign ? 'btn-primary' : 'btn-accent'}>Our Story</a>
            </div>
        </div>
          {homeStoryStats.length > 0 && (
            <div class={`hidden lg:block ${isEditorialDesign ? 'lg:col-span-1' : ''}`}>
              <div class={`grid grid-cols-2 gap-4 ${isEditorialDesign ? 'grid-cols-1 gap-8' : ''}`}>
                {homeStoryStats.map((stat: any) => (
                  <div class={`${isVibrantDesign ? 'bg-white border-background-alt' : 'bg-white/5 border-white/10'} border rounded-2xl p-6 text-center backdrop-blur-sm`}>
                    <span class={`font-serif text-4xl font-bold ${isVibrantDesign ? 'text-primary' : 'text-accent-orange'}`}>{stat.num}</span>
                    <p class={`${isVibrantDesign ? 'text-text-muted' : 'text-surface/60'} text-sm mt-1`}>{stat.label}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
      </div>
    </div>
  </section>
  )}

  <!-- ── Testimonial ────────────────────────────────────────── -->
  {homeTestimonials.length > 0 && (
    <section id="testimonials" class="py-12 md:py-20 bg-surface" aria-label="Customer Reviews">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="text-center mb-12">
          <span class="text-xs font-semibold text-accent uppercase tracking-[0.2em]">Customer Love</span>
          <h2 class="font-serif text-4xl font-bold mt-2">What People Are Saying</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {homeTestimonials.map((t: any, i: number) => (
            <div class={`bg-white p-6 shadow-sm hover:shadow-md transition-shadow duration-300 reveal hover-lift ${isModernDesign ? 'rounded-3xl border border-background-alt' : isEditorialDesign ? 'rounded-none border-t-2 border-primary' : isVibrantDesign ? 'rounded-[2rem] border-2 border-background-alt' : 'rounded-2xl border border-background-alt'}`} style={`transition-delay:${i*0.08}s`}>
              <div class="flex items-center gap-1 mb-4 text-accent">
                <div class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, starIndex) => (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill={starIndex < Math.floor(t.rating || 5) ? "currentColor" : "none"} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                    </svg>
                  ))}
                </div>
                <span class="ml-1.5 font-medium text-primary text-sm font-sans">{t.rating || '5.0'}</span>
              </div>
              <p class={`text-primary/70 text-sm leading-relaxed ${isEditorialDesign ? 'font-serif text-lg' : 'italic'}`}>"{t.review}"</p>
              <div class={`flex items-center gap-3 mt-5 pt-4 ${isEditorialDesign ? '' : 'border-t border-background-alt'}`}>
                {!isEditorialDesign && (
                  <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm font-serif shrink-0">
                    {t.name[0]}
                  </div>
                )}
                <div>
                  <p class="font-semibold text-sm text-primary">{t.name}</p>
                  <p class="text-xs text-primary/50">{t.city}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Newsletter CTA ─────────────────────────────────────── -->
  <section id="newsletter" class="pt-10 pb-10 md:pt-16 md:pb-16 bg-background-alt" aria-label="Newsletter Signup">
    <div class="max-w-2xl mx-auto px-6 sm:px-8 lg:px-12 text-center">
      <span class="text-2xl inline-block" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3"/><rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V13a4 4 0 0 0-8 0v8"/></svg>
      </span>
      <h2 class="font-serif text-3xl font-bold text-primary mt-3 mb-3" data-setting="newsletter_title">{settings?.newsletter_title || 'Subscribe to our Newsletter'}</h2>
      <p class="text-primary/60 text-sm mb-6" data-setting="newsletter_subtitle">{settings?.newsletter_subtitle || 'Join our community to get the latest updates, exclusive offers, and early access to new products.'}</p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" id="newsletter-form">
        <input
          type="email"
          name="email"
          id="newsletter-email"
          placeholder="Your email address"
          required
          class="flex-1 px-4 py-3 rounded-full border border-background-alt bg-white text-primary text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all duration-200"
        />
        <button type="submit" class="btn-primary whitespace-nowrap">
          Subscribe
        </button>
      </form>
      <p class="text-xs text-primary/40 mt-3">No spam ever. Unsubscribe anytime.</p>
    </div>
  </section>

</Layout>

<script is:inline>
  // ── Newsletter Form Handler — re-init on every ClientRouter navigation ──
  function initNewsletter() {
    var newsletterForm = document.getElementById('newsletter-form');
    if (!newsletterForm) return;

    // Clone to remove any stale submit listeners
    var newForm = newsletterForm.cloneNode(true);
    newsletterForm.parentNode.replaceChild(newForm, newsletterForm);

    newForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      var emailInput = document.getElementById('newsletter-email');
      var email = emailInput ? emailInput.value.trim() : '';
      var btn = newForm.querySelector('button[type="submit"]');

      if (!email) return;

      try {
        var subscribers = JSON.parse(localStorage.getItem(`vyaparpe-subscribers-${window.location.hostname}`) || '[]');
        if (!subscribers.includes(email)) {
          subscribers.push(email);
          localStorage.setItem(`vyaparpe-subscribers-${window.location.hostname}`, JSON.stringify(subscribers));
        }
      } catch(err) {}

      try {
        await fetch('/api/admin/newsletter-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
      } catch(err) {}

      if (btn) {
        var originalText = btn.textContent;
        btn.textContent = '✓ Subscribed!';
        btn.classList.add('!bg-green-600');
        btn.disabled = true;
        setTimeout(function() {
          btn.textContent = originalText;
          btn.classList.remove('!bg-green-600');
          btn.disabled = false;
          if (emailInput) emailInput.value = '';
        }, 3000);
      }

      var successMsg = document.createElement('p');
      successMsg.className = 'text-sm text-green-600 font-medium mt-3 animate-pulse';
      successMsg.textContent = '🎉 Thank you! You\'re now on the list.';
      newForm.after(successMsg);
      setTimeout(function() { successMsg.remove(); }, 4000);
    });
  }

  document.addEventListener('DOMContentLoaded', initNewsletter);
</script>

<script is:inline>
  // ── Home Grid Toggle — runs on every ClientRouter navigation ──
  function initHomeGrid() {
    var grid = document.getElementById('home-product-grid');
    var btn1 = document.getElementById('home-grid-1col');
    var btn2 = document.getElementById('home-grid-2col');
    var GRID_KEY = `vyaparpe-grid-cols-${window.location.hostname}`;
    if (!grid) return; // Not on home page

    function setGrid(cols) {
      if (cols === 1) {
        grid.classList.remove('grid-cols-2');
        grid.classList.add('grid-cols-1');
        if (btn1) { btn1.classList.add('bg-primary/10', 'text-primary'); btn1.classList.remove('text-primary/50'); }
        if (btn2) { btn2.classList.remove('bg-primary/10', 'text-primary'); btn2.classList.add('text-primary/50'); }
      } else {
        grid.classList.add('grid-cols-2');
        grid.classList.remove('grid-cols-1');
        if (btn2) { btn2.classList.add('bg-primary/10', 'text-primary'); btn2.classList.remove('text-primary/50'); }
        if (btn1) { btn1.classList.remove('bg-primary/10', 'text-primary'); btn1.classList.add('text-primary/50'); }
      }
      try { localStorage.setItem(GRID_KEY, String(cols)); } catch(e) {}
    }

    var savedCols = 2;
    try { savedCols = parseInt(localStorage.getItem(GRID_KEY) || '2'); } catch(e) {}
    setGrid(savedCols);

    // Remove old listeners before adding new ones
    var newBtn1 = btn1 ? btn1.cloneNode(true) : null;
    var newBtn2 = btn2 ? btn2.cloneNode(true) : null;
    if (newBtn1 && btn1) { btn1.parentNode.replaceChild(newBtn1, btn1); newBtn1.addEventListener('click', function() { setGrid(1); }); }
    if (newBtn2 && btn2) { btn2.parentNode.replaceChild(newBtn2, btn2); newBtn2.addEventListener('click', function() { setGrid(2); }); }
  }

  // Run on first load AND every ClientRouter navigation
  document.addEventListener('DOMContentLoaded', initHomeGrid);



</script>
)}
