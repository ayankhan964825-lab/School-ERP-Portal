---

import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist. Browse our premium products.">
  <div class="min-h-screen flex items-center justify-center px-6 py-12 md:py-24 bg-background">
    <div class="text-center max-w-lg mx-auto">
      <!-- Animated 404 -->
      <div class="relative mb-8">
        <div class="text-[9rem] font-serif font-black text-primary/10 leading-none select-none">404</div>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="text-6xl animate-bounce">🌿</div>
        </div>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-secondary mb-4">
        Page Not Found
      </h1>
      <p class="text-secondary/60 text-base mb-8 leading-relaxed">
        Yeh page toh dhund nahi paaye! Shayad link galat hai ya page move ho gaya.
        Hamari shop explore karo — acha kuch zaroor milega. 🌱
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a href="/" class="btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Go Home
        </a>
        <a href="/products" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border-2 border-primary text-primary font-semibold text-sm hover:bg-primary hover:text-white transition-all duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          Shop Products
        </a>
      </div>

      <!-- Quick Links -->
      <div class="border-t border-background-alt pt-8">
        <p class="text-xs font-semibold text-secondary/40 uppercase tracking-widest mb-4">Popular Pages</p>
        <div class="flex flex-wrap gap-2 justify-center">
          {[
            { label: '🛒 All Products', href: '/products' },
            { label: '📖 Blog', href: '/blog' },
            { label: '📦 Track Order', href: '/track-order' },
            { label: '📞 Contact Us', href: '/contact' },
            { label: '❓ FAQ', href: '/faq' },
          ].map(link => (
            <a
              href={link.href}
              class="text-sm px-4 py-2 rounded-full bg-white border border-background-alt text-secondary/70 hover:border-primary hover:text-primary hover:bg-primary/5 transition-all duration-200"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

