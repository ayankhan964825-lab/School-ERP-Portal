---
import Layout from '../../layouts/Layout.astro';
import { getAffiliates, getAffiliateOffers, getSettings, getOrders, getPayouts, getCoupons } from '../../lib/database';

const id = Astro.cookies.get('vyaparpe_affiliate_id')?.value;
if (!id) {
  return Astro.redirect('/affiliate/login');
}

const affiliates = await getAffiliates();
const user = affiliates.find((a: any) => a.id === id);

if (!user) {
  Astro.cookies.delete('vyaparpe_affiliate_id');
  return Astro.redirect('/affiliate/login');
}

if (user.status === 'banned') {
  Astro.cookies.delete('vyaparpe_affiliate_id');
  return Astro.redirect('/affiliate/login');
}

const allOffers = await getAffiliateOffers();
const activeOffers = allOffers.filter((o: any) => o.is_active);

if (activeOffers.length === 0) {
  activeOffers.push({
    title: 'Your Brand Partner Program',
    description: 'Share your link. Customers get 10% off and you get 10% commission.',
    commission_percentage: 10,
    customer_discount_percentage: 10,
  });
}

const origin = Astro.url.origin;
const referralLink = `${origin}/?ref=${user.referral_code}`;

const settings = await getSettings(Astro.locals?.storeId);
const payoutDays = parseInt(settings.affiliate_payout_days) || 30;
const payoutThreshold = parseInt(settings.affiliate_payout_threshold) || 100;

const orders = await getOrders(Astro.locals?.storeId);
const myOrders = orders.filter((o: any) => o.affiliate_id === user.id && !['cancelled', 'returned', 'rto'].includes(o.status));

const cutoffDate = new Date();
cutoffDate.setDate(cutoffDate.getDate() - payoutDays);

let earned = 0;
let pending = 0;

myOrders.forEach((o: any) => {
  const orderDate = new Date(o.created_at || o.createdAt);
  const commission = o.affiliate_commission || 0;
  if (o.status === 'delivered' && orderDate <= cutoffDate) {
    earned += commission;
  } else {
    pending += commission;
  }
});

const paidEarnings = user.paid_earnings || 0;
const totalEarnings = earned + pending; // Re-calculate dynamically instead of relying on DB total
const allPayouts = await getPayouts();
const myPayouts = allPayouts.filter((p: any) => p.affiliate_id === user.id && p.status !== 'pending');
const pendingPayouts = allPayouts.filter((p: any) => p.affiliate_id === user.id && p.status === 'pending');
const hasPendingWithdrawal = pendingPayouts.length > 0;
const requestedAmount = pendingPayouts.reduce((acc: number, p: any) => acc + (p.amount || 0), 0);

const available = Math.max(0, earned - paidEarnings - requestedAmount);

const coupons = await getCoupons();
const myCoupon = coupons.find((c: any) => c.affiliate_id === user.id);
// Dynamic affiliate links don't exist in the coupons table, so use order count as the truest metric
const usedCount = myCoupon ? (myCoupon.used_count || 0) : myOrders.length;
---

<Layout title="Partner Dashboard" hideHeader={true} hideFooter={true} hideWhatsApp={true}>
  <div class="min-h-screen bg-gray-50 pb-12">
    <!-- Header -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
      <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-xl font-serif font-bold text-primary">Your Brand</span>
          <span class="text-xs uppercase tracking-wider font-bold bg-primary/10 text-primary px-2 py-0.5 rounded">Partner</span>
        </div>
        <div class="flex items-center gap-4">
          <span class="text-sm font-medium text-secondary hidden sm:block">Hi, {user.name.split(' ')[0]}</span>
          <button id="logout-btn" class="text-xs text-red-500 hover:bg-red-50 px-3 py-1.5 rounded-lg font-medium transition-colors">Sign Out</button>
        </div>
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-4 mt-8 space-y-6">
      
      {!user.is_approved && (
        <div class="bg-orange-50 border-l-4 border-orange-500 p-4 rounded-r-xl mb-6 shadow-sm">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-orange-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-orange-700 font-medium">
                Your partner account is pending admin approval.
              </p>
              <p class="text-xs text-orange-600 mt-1">
                Your referral code will not work and earnings will not be tracked until your account is approved by our team.
              </p>
            </div>
          </div>
        </div>
      )}

      <!-- Stats Overview -->
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <div class="bg-white p-4 md:p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between relative overflow-hidden">
          <div class="absolute -right-4 -top-4 w-24 h-24 bg-primary/5 rounded-full blur-xl"></div>
          <span class="text-[10px] md:text-xs font-bold text-secondary/60 uppercase tracking-wider">Coupon Uses</span>
          <div class="mt-2 text-2xl md:text-3xl font-bold text-blue-600">{usedCount}</div>
        </div>
        <div class="bg-white p-4 md:p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between relative overflow-hidden">
          <div class="absolute -right-4 -top-4 w-24 h-24 bg-primary/5 rounded-full blur-xl"></div>
          <span class="text-[10px] md:text-xs font-bold text-secondary/60 uppercase tracking-wider">Total Earnings</span>
          <div class="mt-2 text-2xl md:text-3xl font-bold text-primary">₹{totalEarnings}</div>
        </div>
        <div class="bg-white p-4 md:p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
          <span class="text-[10px] md:text-xs font-bold text-secondary/60 uppercase tracking-wider">Paid to You</span>
          <div class="mt-2 text-2xl md:text-3xl font-bold text-gray-400">₹{paidEarnings}</div>
        </div>
        <div class="bg-white p-4 md:p-6 rounded-2xl shadow-sm border border-orange-100 flex flex-col justify-between bg-orange-50/30">
          <span class="text-[10px] md:text-xs font-bold text-orange-800/60 uppercase tracking-wider">Pending (Return)</span>
          <div class="mt-2 text-2xl md:text-3xl font-bold text-orange-600">₹{pending}</div>
          {pending > 0 && <p class="text-[9px] md:text-[10px] text-orange-600/70 mt-1 leading-tight">Clears after {payoutDays} days.</p>}
        </div>
        <div class="bg-white p-4 md:p-6 rounded-2xl shadow-sm border border-green-100 flex flex-col justify-between bg-green-50/30">
          <span class="text-[10px] md:text-xs font-bold text-green-800/60 uppercase tracking-wider">Available</span>
          <div class="mt-2 text-2xl md:text-3xl font-bold text-green-600">₹{available}</div>
          
          {hasPendingWithdrawal ? (
            <div class="mt-2 text-[10px] md:text-xs text-orange-600 font-bold bg-orange-100/50 px-2 py-1 rounded-md text-center">Withdrawal Pending (₹{requestedAmount})</div>
          ) : available >= payoutThreshold ? (
            <button id="withdraw-btn" class="mt-2 w-full text-[10px] md:text-xs font-bold text-white bg-green-600 hover:bg-green-700 py-1.5 rounded-md transition-colors shadow-sm">
              Request Withdrawal
            </button>
          ) : (
            <p class="text-[9px] md:text-[10px] text-green-600/70 mt-1 leading-tight">
              Min threshold: ₹{payoutThreshold}
            </p>
          )}
        </div>
      </div>

      <!-- Referral Link Section -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <h2 class="text-lg font-bold text-secondary mb-1">Your Referral Link & Coupon</h2>
        <p class="text-sm text-secondary/60 mb-4">Share this link. When users click it, your coupon code <strong>{user.referral_code}</strong> is automatically applied at checkout.</p>
        
        <div class="flex items-center gap-2">
          <input type="text" readonly value={referralLink} id="ref-link" class="flex-1 bg-gray-50 border border-gray-200 text-sm px-4 py-3 rounded-xl outline-none text-secondary font-mono" />
          <button onclick="copyLink(this)" class="bg-primary text-white font-bold px-6 py-3 rounded-xl hover:bg-primary/90 transition-colors whitespace-nowrap">
            Copy Link
          </button>
        </div>
      </div>

      <!-- Active Campaigns -->
      <div>
        <h2 class="text-lg font-bold text-secondary mb-4">Active Campaigns</h2>
        {activeOffers.length === 0 ? (
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 text-center">
            <p class="text-secondary/60">No active campaigns right now. Check back later!</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {activeOffers.map((offer: any) => (
              <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 relative overflow-hidden group hover:border-primary/30 transition-colors">
                <div class="absolute right-0 top-0 w-2 h-full bg-gradient-to-b from-primary to-emerald-600 opacity-80"></div>
                <h3 class="font-bold text-secondary text-lg mb-1">{offer.title}</h3>
                <p class="text-sm text-secondary/70 mb-4 h-10 line-clamp-2">{offer.description}</p>
                
                <div class="flex items-center justify-between border-t border-gray-50 pt-4 mt-auto">
                  <div>
                    <div class="text-[10px] uppercase font-bold text-secondary/50">Your Commission</div>
                    <div class="font-bold text-green-600">{offer.commission_percentage}% per sale</div>
                  </div>
                  <div class="text-right">
                    <div class="text-[10px] uppercase font-bold text-secondary/50">Customer Gets</div>
                    <div class="font-bold text-blue-600">{offer.customer_discount_percentage}% OFF</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Payment Details -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 mt-6">
        <h2 class="text-lg font-bold text-secondary mb-1">Your Profile & Payment Details</h2>
        <p class="text-sm text-secondary/60 mb-4">Customize your link and payment methods.</p>
        <form id="payment-details-form" class="space-y-4 max-w-2xl">
          <div>
            <label class="block text-xs font-bold text-secondary mb-1">Custom Referral Code</label>
            <input type="text" name="referral_code" value={user.referral_code || ''} class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm uppercase" placeholder="e.g. RAHUL10" />
            <p class="text-[10px] text-gray-400 mt-1">This changes your shareable link and coupon code.</p>
          </div>
          <hr class="border-gray-100 my-4" />
          <div>
            <label class="block text-xs font-bold text-secondary mb-1">UPI ID</label>
            <input type="text" name="upi_id" value={user.upi_id || ''} class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="yourname@upi" />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div class="md:col-span-2">
              <label class="block text-xs font-bold text-secondary mb-1">Bank Account Name</label>
              <input type="text" name="bank_account_name" value={user.bank_account_name || ''} class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="As per bank records" />
            </div>
            <div>
              <label class="block text-xs font-bold text-secondary mb-1">Account Number</label>
              <input type="text" name="bank_account_number" value={user.bank_account_number || ''} class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="0000..." />
            </div>
            <div>
              <label class="block text-xs font-bold text-secondary mb-1">IFSC Code</label>
              <input type="text" name="bank_ifsc" value={user.bank_ifsc || ''} class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="SBIN000..." />
            </div>
          </div>
          <button type="submit" id="save-payment-btn" class="py-3 px-6 bg-primary text-white font-bold rounded-xl hover:bg-primary/90 transition-colors mt-2">Save Details</button>
          <p id="payment-msg" class="text-xs font-medium mt-2 hidden"></p>
        </form>
      </div>

      <!-- Payout History -->
      <div class="mt-6">
        <h2 class="text-lg font-bold text-secondary mb-4">Payout History</h2>
        {myPayouts.length === 0 ? (
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 text-center">
            <p class="text-secondary/60">No payouts processed yet. Keep sharing!</p>
          </div>
        ) : (
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead class="bg-gray-50 text-secondary/70 uppercase text-xs">
                  <tr>
                    <th class="px-6 py-4 font-bold">Date</th>
                    <th class="px-6 py-4 font-bold">Amount</th>
                    <th class="px-6 py-4 font-bold">Reference (UTR)</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  {myPayouts.map((p: any) => (
                    <tr class="hover:bg-gray-50/50 transition-colors">
                      <td class="px-6 py-4 whitespace-nowrap text-secondary font-medium">
                        {new Date(p.created_at || p.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-green-600 font-bold">₹{p.amount}</td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <span class="bg-gray-100 text-secondary/80 px-2.5 py-1 rounded-md font-mono text-xs border border-gray-200 inline-block">{p.transaction_id}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>

    </div>
  </div>

  <script>
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/affiliate/logout');
      window.location.href = '/affiliate/login';
    });

    document.getElementById('withdraw-btn')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      btn.innerText = 'Requesting...';
      try {
        const res = await fetch('/api/affiliate/withdraw', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          btn.innerText = 'Success!';
          btn.classList.replace('bg-green-600', 'bg-primary');
          setTimeout(() => window.location.reload(), 1500);
        } else {
          alert(data.error || 'Failed to request withdrawal.');
          btn.disabled = false;
          btn.innerText = 'Request Withdrawal';
        }
      } catch (err) {
        alert('Something went wrong.');
        btn.disabled = false;
        btn.innerText = 'Request Withdrawal';
      }
    });

    (window as any).copyLink = function(btn: HTMLButtonElement) {
      const input = document.getElementById('ref-link') as HTMLInputElement;
      if (!input) return;
      
      // Modern clipboard API
      navigator.clipboard.writeText(input.value).then(() => {
        if (btn) {
          const orig = btn.innerText;
          btn.innerText = 'Copied!';
          btn.classList.remove('bg-primary');
          btn.classList.add('bg-green-600');
          setTimeout(() => {
            btn.innerText = orig;
            btn.classList.remove('bg-green-600');
            btn.classList.add('bg-primary');
          }, 2000);
        }
      }).catch(() => {
        // Fallback for older browsers
        input.select();
        document.execCommand('copy');
      });
    }

    const paymentForm = document.getElementById('payment-details-form') as HTMLFormElement;
    if (paymentForm) {
      paymentForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('save-payment-btn') as HTMLButtonElement;
        const msg = document.getElementById('payment-msg') as HTMLParagraphElement;
        
        btn.disabled = true;
        btn.innerText = 'Saving...';
        msg.classList.add('hidden');
        
        const formData = new FormData(paymentForm);
        try {
          const res = await fetch('/api/affiliate/profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(formData))
          });
          
          if (res.ok) {
            msg.innerText = 'Details saved! Reloading to apply changes...';
            msg.classList.remove('hidden', 'text-red-500');
            msg.classList.add('text-green-600');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            const errBody = await res.json().catch(()=>({}));
            msg.innerText = errBody.error || 'Failed to save details.';
            msg.classList.remove('hidden', 'text-green-600');
            msg.classList.add('text-red-500');
          }
        } catch (err) {
          msg.innerText = 'Network error.';
          msg.classList.remove('hidden', 'text-green-600');
          msg.classList.add('text-red-500');
        } finally {
          btn.disabled = false;
          btn.innerText = 'Save Details';
        }
      });
    }
  </script>
</Layout>
