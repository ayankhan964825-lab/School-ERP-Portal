---
import Layout from '../layouts/Layout.astro';
import { getSettings } from '../lib/database';

const rawSettings = await getSettings();
const settings = rawSettings || {};
const s = (key: string, fallback?: string) => {
  const val = settings[key];
  return (val !== undefined && val !== null && val !== '') ? val : '';
};
const brandName = settings?.brand_name || 'Your Brand';
---

<Layout bodyClass="bg-surface" title={`Contact Us - ${brandName}`} description={`Get in touch with ${brandName} for questions, bulk orders, or support.`}>
  <div class="bg-surface min-h-screen pt-12 pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-secondary mb-4" data-setting="contact_title">{s('contact_title')}</h1>
        <p class="text-secondary/70 text-lg" data-setting="contact_subtitle">
          {s('contact_subtitle')}
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-24">
        
        <!-- Contact Info -->
        <div>
          <div class="bg-background-alt p-8 rounded-3xl border border-background-alt mb-8">
            <h2 class="text-2xl font-serif font-bold text-secondary mb-6">Contact Information</h2>
            
            <div class="space-y-6">
              <!-- Phone -->
              {s('contact_phone') && (
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
                  <div>
                    <h3 class="font-bold text-secondary mb-1">Phone</h3>
                    <a href={`tel:${s('contact_phone')}`} class="block text-secondary/70 hover:text-primary transition-colors">{s('contact_phone')}</a>
                  </div>
                </div>
              )}

              <!-- Email -->
              {s('contact_email') && (
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div>
                  <div>
                    <h3 class="font-bold text-secondary mb-1">Email</h3>
                    <a href={`mailto:${s('contact_email')}`} class="text-secondary/70 hover:text-primary transition-colors">{s('contact_email')}</a>
                  </div>
                </div>
              )}

              <!-- Location -->
              {s('contact_address') && (
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
                  <div>
                    <h3 class="font-bold text-secondary mb-1">Location</h3>
                    <p class="text-secondary/70 leading-relaxed whitespace-pre-line">
                      <div data-setting="contact_address" data-setting-html><Fragment set:html={s('contact_address')} /></div>
                    </p>
                  </div>
                </div>
              )}
              
              <!-- Business Hours -->
              {s('contact_hours') && (
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
                  <div>
                    <h3 class="font-bold text-secondary mb-1">Business Hours</h3>
                    <p class="text-secondary/70 leading-relaxed">
                      <div data-setting="contact_hours" data-setting-html><Fragment set:html={s('contact_hours')} /></div>
                    </p>
                  </div>
                </div>
              )}

            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <form class="bg-white p-8 rounded-3xl border border-background-alt shadow-sm">
            <h2 class="text-2xl font-serif font-bold text-secondary mb-6">Send Us a Message</h2>
            
            <div class="space-y-4">
              <div>
                <label for="name" class="block text-sm font-medium text-secondary/70 mb-1">Full Name</label>
                <input type="text" id="name" class="w-full px-4 py-3 rounded-xl border border-background-alt focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="John Doe" required />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-secondary/70 mb-1">Email Address</label>
                <input type="email" id="email" class="w-full px-4 py-3 rounded-xl border border-background-alt focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="john@example.com" required />
              </div>
              <div>
                <label for="subject" class="block text-sm font-medium text-secondary/70 mb-1">Subject</label>
                <select id="subject" class="w-full px-4 py-3 rounded-xl border border-background-alt focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
                  <option>General Inquiry</option>
                  <option>Bulk Order Request</option>
                  <option>Order Support</option>
                </select>
              </div>
              <div>
                <label for="message" class="block text-sm font-medium text-secondary/70 mb-1">Message</label>
                <textarea id="message" rows="4" class="w-full px-4 py-3 rounded-xl border border-background-alt focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all resize-none" placeholder="How can we help you?" required></textarea>
              </div>
              <button type="button" class="btn-primary w-full justify-center mt-2">Send Message</button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </div>
</Layout>
