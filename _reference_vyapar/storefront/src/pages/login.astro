---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Store Login | VyaparPe</title>
</head>
<body class="bg-gray-50 flex items-center justify-center min-h-screen font-sans">
    <div class="max-w-md w-full mx-4 bg-white p-8 rounded-2xl shadow-xl shadow-black/5 border border-gray-200">
        <div class="flex justify-center mb-6">
            <div class="w-12 h-12 bg-black rounded-xl flex items-center justify-center shadow-sm">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
        </div>
        <h1 class="text-2xl font-extrabold text-gray-900 mb-2 text-center tracking-tight">Store Login</h1>
        <p class="text-gray-500 text-sm text-center mb-8">Enter your store's subdomain to access your admin portal.</p>
        
        <form onsubmit="event.preventDefault(); goToStore();" class="space-y-6">
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Store Subdomain</label>
                <div class="flex items-stretch shadow-sm rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-black">
                    <input type="text" id="subdomain" required placeholder="mystore" class="flex-1 border border-gray-300 border-r-0 rounded-l-lg px-4 py-3 focus:outline-none text-gray-900 font-medium">
                    <span class="bg-gray-50 border border-l-0 border-gray-300 text-gray-500 px-4 py-3 rounded-r-lg font-mono text-sm flex items-center">.vyaparpe.in</span>
                </div>
            </div>
            <button type="submit" class="w-full bg-black text-white font-bold py-3.5 rounded-lg hover:bg-gray-800 transition-transform active:scale-[0.98] shadow-md">
                Continue to Admin
            </button>
            <div class="text-center mt-4 text-sm text-gray-500">
                <a href="/" class="hover:text-black hover:underline font-medium">← Back to VyaparPe</a>
            </div>
        </form>
    </div>

    <script is:inline>
        function goToStore() {
            let subdomain = document.getElementById('subdomain').value.trim().toLowerCase();
            // Remove .vyaparpe.in if they typed it
            subdomain = subdomain.replace(/\.vyaparpe\.in$/, '');
            
            if (subdomain) {
                const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
                const port = window.location.port ? ':' + window.location.port : '';
                
                if (isLocal) {
                    window.location.href = `http://${subdomain}.localhost${port}/admin/login`;
                } else {
                    window.location.href = `https://${subdomain}.vyaparpe.in/admin/login`;
                }
            }
        }
    </script>
</body>
</html>
